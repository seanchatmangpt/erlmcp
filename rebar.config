%% -*- erlang -*-
%% vim: set ft=erlang ts=4 sw=4 et:

%% Rebar3 configuration for erlmcp
%% Purpose: Multi-application (umbrella) project for Model Context Protocol SDK
%% Structure: apps/{erlmcp_core, erlmcp_transports, erlmcp_observability, erlmcp_validation}

%% Minimum OTP version - STRICT: Only OTP 27+ allowed
{minimum_otp_vsn, "27"}.

%% Dependencies (shared across all apps)
{deps,
 [% JSON Schema validation (jesse maintained fork)
  {jesse, "1.8.1"},
  % Process registry (O(log N) lookup)
  {gproc, "0.9.0"},
  % HTTP client (gun for HTTP/2 and WebSocket)
  {gun, "2.0.1"},
  % TCP acceptor pool (ranch)
  {ranch, "2.1.0"},
  % Connection pooling (poolboy)
  {poolboy, "1.5.2"},
  % HTTP server (cowboy for HTTP/WebSocket/SSE)
  {cowboy, "2.10.0"},
  % Template engine (bbmustache)
  {bbmustache, "1.12.2"},
  % JWT validation (CRITICAL - security dependency)
  {jose, "1.11.1"},
  % OpenTelemetry (observability)
  {opentelemetry_api, "1.5.0"},
  {opentelemetry, "1.7.0"},
  {opentelemetry_exporter, "1.10.0"},
  % Petri Net-based workflow management
  {gen_pnet, {git, "https://github.com/joergen7/gen_pnet.git", {branch, "master"}}},
  {lib_combin, {git, "https://github.com/joergen7/lib_combin.git", {branch, "master"}}}]}.

%% Shell (for `rebar3 shell`)
{shell,
 [{apps, [erlmcp_core, erlmcp_transports, erlmcp_observability, erlmcp_validation]},
  {config, "config/sys.config"},
  {vm_args, "vm.args"},
  {apps, [syntax_tools, runtime_tools]}]}.

%% EUnit configuration
{eunit_opts, [verbose, {report, {eunit_surefire, [{dir, "log/eunit"}]}}, {cover_enabled, true}]}.

%% Common Test configuration
{ct_opts, [{logdir, "log/ct"}, {cover_enabled, true}]}.

%% Coverage configuration
{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.

%% Dialyzer configuration
{dialyzer,
 [{warnings, [error_handling, underspecs, unknown, unmatched_returns]},
  {get_warnings, true},
  {plt_apps, all_deps},
  {plt_location, local},
  {plt_prefix, "erlmcp"},
  {dialyzer_options, [incremental]},
  {base_plt_apps, [stdlib, kernel, erts, sasl, mnesia, crypto, ssl, inets, public_key, asn1, ssh]},
  {base_plt_location, global}]}.

%% Xref configuration
{xref_checks,
 [undefined_function_calls,
  undefined_functions,
  locals_not_used,
  deprecated_function_calls,
  deprecated_functions]}.

%% Plugins
{plugins,
 [rebar3_hex,
  rebar3_format,
  rebar3_lint,
  rebar3_proper,
  rebar3_auto]}.

%% Global compiler options
{erl_opts,
 [debug_info,
  {doc, chunk},
  {i, "include"},
  {i, "apps/erlmcp_core/include"},
  {i, "apps/erlmcp_transports/include"},
  {i, "apps/erlmcp_observability/include"},
  {i, "apps/erlmcp_validation/include"},
  {warn_missing_spec_all, false}]}.

%% Profiles
{profiles,
 [%% Observability-only test profile (T007/T008)
  {obs,
   [{project_app_dirs, ["apps/erlmcp_observability"]},
    {erl_opts,
     [debug_info,
      {i, "apps/erlmcp_observability/include"},
      {d, 'TEST'}]},
    {cover_enabled, false}]},
  %% Test profile
  {test,
   [{erl_opts,
     [debug_info,
      {i, "include"},
      {i, "apps/erlmcp_core/include"},
      {i, "apps/erlmcp_transports/include"},
      {i, "apps/erlmcp_observability/include"},
      {i, "apps/erlmcp_validation/include"},
      {i, "_build/test/lib/*/include"},
      {d, 'TEST'}]},
    {deps, [{proper, "1.4.0"}, {meck, "0.9.2"}]},
    {cover_enabled, true},
    {cover_export_enabled, true}]},
  %% Production profile
  {prod,
   [{erl_opts,
     [no_debug_info,
      %% warnings_as_errors,  %% Temporarily disabled for v3.0.0 release - many deprecations
      {i, "include"},
      {i, "apps/erlmcp_core/include"},
      {i, "apps/erlmcp_transports/include"},
      {i, "apps/erlmcp_observability/include"},
      {i, "apps/erlmcp_validation/include"}]},
    {shell, [{config, "config/sys.config.prod"}]},
    {relx, [{lib_dirs, []}]}]},
  %% Development profile
  {dev,
   [{erl_opts,
     [debug_info,
      {i, "include"},
      {i, "apps/erlmcp_core/include"},
      {i, "apps/erlmcp_transports/include"},
      {i, "apps/erlmcp_observability/include"},
      {i, "apps/erlmcp_validation/include"},
      {d, 'DEBUG'}]}]},
  %% Debug profile
  {debug,
   [{erl_opts,
     [debug_info,
      bin_opt_info,
      %% warnings_as_errors,  %% Temporarily disabled for v3.0.0 release
      {d, 'DEBUG'},
      {d, 'OTP_DEBUG_ENABLED'},
      {i, "include"},
      {i, "apps/erlmcp_core/include"},
      {i, "apps/erlmcp_transports/include"},
      {i, "apps/erlmcp_observability/include"},
      {i, "apps/erlmcp_validation/include"}]},
    {deps, [{proper, "1.4.0"}, {meck, "0.9.2"}]},
    {cover_enabled, true},
    {cover_export_enabled, true}]}]}.

%% Format configuration
{format,
 [{files,
   ["rebar.config",
    "{src,include,test}/**/*.{erl,hrl,app.src}",
    "apps/*/src/**/*.{erl,hrl}",
    "apps/*/include/**/*.hrl",
    "apps/*/test/**/*.{erl,hrl}"]},
  {formatter, default_formatter},
  {options,
   #{paper => 100,
     ribbon => 100,
     break_indent => 4}}]}.

%% Hex.pm configuration
{hex, [{doc, #{provider => ex_doc}}]}.

%% EDoc configuration
{edoc_opts,
 [{preprocess, true},
  {includes, ["include"]},
  {title, "ErlMCP - Model Context Protocol SDK for Erlang/OTP"},
  {overview, "apps/erlmcp_core/doc/overview.edoc"},
  {dir, "doc"}]}.

%% Relx configuration
{relx,
 [{release,
   {erlmcp, "3.0.0"},
   [erlmcp_core,
    erlmcp_transports,
    erlmcp_observability,
    erlmcp_validation,
    jesse,
    gproc,
    gun,
    ranch,
    poolboy,
    cowboy,
    bbmustache,
    jose,
    opentelemetry_api,
    opentelemetry,
    opentelemetry_exporter,
    mnesia,
    sasl]},
  {lib_dirs, []},
  {sys_config, "./config/sys.config"},
  {vm_args, "./vm.args"},
  {dev_mode, true},
  {include_erts, false},
  {include_src, false},
  {extended_start_script, true},
  {overlay,
   [{mkdir, "log"},
    {mkdir, "data"},
    {mkdir, "etc"},
    {copy, "config/sys.config", "etc/sys.config"}]}]}.

%% Overrides
{overrides, []}.
