    {protocol_checker,       "apps/erlmcp_validation/test/erlmcp_protocol_checker_SUITE.erl"},
    {transport_validator,    "apps/erlmcp_validation/test/erlmcp_transport_validator_SUITE.erl"},
    {transport_compliance,   "apps/erlmcp_transports/test/erlmcp_transport_compliance_SUITE.erl"},
    {transport_http,         "apps/erlmcp_transports/test/erlmcp_transport_http_SUITE.erl"},
    {transport_behavior,     "apps/erlmcp_transports/test/erlmcp_transport_behavior_SUITE.erl"},
    {mcp_spec_2025,          "apps/erlmcp_core/test/erlmcp_mcp_spec_2025_SUITE.erl"},
    {cli_compliance,         "apps/erlmcp_cli/test/erlmcp_cli_compliance_SUITE.erl"}
