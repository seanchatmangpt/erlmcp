%% @doc Sharding validation module for erlmcp v3
%% Validates database and session sharding strategies including:
%% - Shard distribution validation
%% - Data consistency validation
%% - Performance validation
%% - Conflict resolution validation
%% - Migration validation
%% - Load balancing across shards

-module(erlmcp_sharding_validator).
-behaviour(gen_server).

%% API exports
-export([start_link/0, validate/1, run_consistency_test/3, get_sharding_metrics/0]).

%% gen_server callbacks
-export([init/1, handle_call/3, handle_cast/2, handle_info/2, terminate/2, code_change/3]).

%% Internal exports for testing
-export([
    initialize_shard_configs/0,
    parse_config/1,
    calculate_shard/3,
    calculate_distribution_score/1,
    analyze_consistency_checks/1,
    run_performance_validation/1,
    run_distribution_validation/1
]).

%%====================================================================
%% Records
%%====================================================================

-record(shard_config, {
    shard_count :: integer(),
    strategy :: consistent_hashing | round_robin | range,
    replication :: integer(),
    consistency :: strong | eventual
}).

-record(shard_metrics, {
    shard_id :: integer(),
    key_count :: integer(),
    memory_usage :: integer(),
    cpu_usage :: integer(),
    read_operations :: integer(),
    write_operations :: integer(),
    last_access :: integer()
}).

-record(consistency_check, {
    shard_id :: integer(),
    data_version :: integer(),
    conflicts :: list(),
    resolution_status :: resolved | unresolved
}).

-record(test_result, {
    test_id :: binary(),
    shard_count :: integer(),
    total_keys :: integer(),
    consistency_score :: float(),
    performance_score :: float(),
    distribution_score :: float(),
    conflict_count :: integer(),
    migration_time :: integer()
}).

-record(validation_metrics, {
    shards :: list(#shard_metrics{}),
    test_result :: #test_result{},
    timestamp :: integer()
}).

-record(state, {
    shard_configs :: map(),
    current_metrics :: list(#shard_metrics{}),
    test_data :: map(),
    consistency_threshold :: float(),
    performance_threshold :: float(),
    validation_history :: list(#test_result{})
}).

%%====================================================================
%% API Functions
%%====================================================================

%% @doc Start the sharding validator server
start_link() ->
    gen_server:start_link({local, ?MODULE}, ?MODULE, [], []).

%% @doc Validate sharding configuration
-spec(validate(map()) -> map()).
validate(Config) ->
    gen_server:call(?MODULE, {validate, Config}, 30000).

%% @doc Run a consistency test with given data and duration
-spec(run_consistency_test(map(), atom(), integer()) -> {term(), map(), atom(), map()}).
run_consistency_test(TestData, ConsistencyLevel, TestDuration) ->
    gen_server:call(?MODULE, {run_consistency_test, TestData, ConsistencyLevel, TestDuration}, 60000).

%% @doc Get current sharding metrics
-spec(get_sharding_metrics() -> list(map())).
get_sharding_metrics() ->
    gen_server:call(?MODULE, get_sharding_metrics).

%%====================================================================
%% gen_server Callbacks
%%====================================================================

init([]) ->
    %% Initialize shard configurations
    ShardConfigs = initialize_shard_configs(),

    %% State initialization
    State = #state{
        shard_configs = ShardConfigs,
        current_metrics = [],
        test_data = initialize_test_data(),
        consistency_threshold = 0.95,
        performance_threshold = 0.90,
        validation_history = []
    },

    %% Schedule periodic validation
    schedule_validation(),

    {ok, State}.

handle_call({validate, Config}, _From, State) ->
    %% Run sharding validation
    {ShardConfig, TestConfig} = parse_config(Config),

    %% Run validation tests
    Results = run_validation_tests(ShardConfig, TestConfig),

    %% Generate validation report
    Report = generate_validation_report(Results),

    %% Update state
    NewState = State#state{
        current_metrics = Results#validation_metrics.shards,
        validation_history = [Results#validation_metrics.test_result | State#state.validation_history]
    },

    {reply, Report, NewState};

handle_call({run_consistency_test, TestData, ConsistencyLevel, TestDuration}, _From, State) ->
    %% Run consistency test
    TestResults = run_consistency_test_internal(TestData, ConsistencyLevel, TestDuration),

    %% Analyze consistency results
    Analysis = analyze_consistency_results(TestResults),

    {reply, {results, TestResults, analysis, Analysis}, State};

handle_call(get_sharding_metrics, _From, State) ->
    %% Get current sharding metrics
    Metrics = State#state.current_metrics,

    %% Format for return
    FormattedMetrics = lists:map(fun(M) ->
        #{
            shard_id => M#shard_metrics.shard_id,
            key_count => M#shard_metrics.key_count,
            memory_usage => M#shard_metrics.memory_usage,
            cpu_usage => M#shard_metrics.cpu_usage,
            read_operations => M#shard_metrics.read_operations,
            write_operations => M#shard_metrics.write_operations,
            last_access => M#shard_metrics.last_access
        }
    end, Metrics),

    {reply, FormattedMetrics, State};

handle_call(_Request, _From, State) ->
    {reply, {error, unknown_request}, State}.

handle_cast(_Msg, State) ->
    {noreply, State}.

handle_info(validation, State) ->
    %% Run periodic validation
    Results = run_periodic_validation(),

    %% Update state
    NewState = State#state{
        current_metrics = Results,
        validation_history = [hd(Results) | State#state.validation_history]
    },

    %% Check for issues
    check_sharding_issues(Results),

    %% Reschedule validation
    schedule_validation(),

    {noreply, NewState};

handle_info(_Info, State) ->
    {noreply, State}.

terminate(_Reason, _State) ->
    ok.

code_change(_OldVsn, State, _Extra) ->
    {ok, State}.

%%====================================================================
%% Public Internal Functions (exported for testing)
%%====================================================================

%% @doc Initialize default shard configurations
-spec(initialize_shard_configs() -> map()).
initialize_shard_configs() ->
    #{
        sessions => #shard_config{
            shard_count = 16,
            strategy = consistent_hashing,
            replication = 3,
            consistency = eventual
        },
        resources => #shard_config{
            shard_count = 32,
            strategy = range,
            replication = 2,
            consistency = strong
        },
        tools => #shard_config{
            shard_count = 8,
            strategy = round_robin,
            replication = 1,
            consistency = strong
        }
    }.

%% @doc Parse configuration map
-spec(parse_config(map()) -> {#shard_config{}, map()}).
parse_config(Config) ->
    ShardConfig = #shard_config{
        shard_count = maps:get(shard_count, Config, 16),
        strategy = maps:get(strategy, Config, consistent_hashing),
        replication = maps:get(replication, Config, 3),
        consistency = maps:get(consistency, Config, eventual)
    },

    TestConfig = #{
        test_data_size => maps:get(test_data_size, Config, 100000),
        consistency_test => maps:get(consistency_test, Config, true),
        performance_test => maps:get(performance_test, Config, true),
        migration_test => maps:get(migration_test, Config, true),
        duration => maps:get(duration, Config, 300000)
    },

    {ShardConfig, TestConfig}.

%% @doc Calculate shard ID for a given key using specified strategy
-spec(calculate_shard(binary(), atom(), #shard_config{}) -> integer()).
calculate_shard(Key, Strategy, ShardConfig) ->
    #shard_config{shard_count = ShardCount} = ShardConfig,

    case Strategy of
        consistent_hashing ->
            erlang:phash2(Key, ShardCount);
        round_robin ->
            erlang:phash2(Key, ShardCount);
        range ->
            calculate_range_shard(Key, ShardCount)
    end.

%% @doc Calculate distribution score from load factors
-spec(calculate_distribution_score(list(float())) -> float()).
calculate_distribution_score(LoadFactors) ->
    %% Calculate distribution efficiency
    AvgLoad = lists:sum(LoadFactors) / length(LoadFactors),
    Deviation = lists:foldl(fun(Factor, Acc) ->
        Acc + math:pow(Factor - AvgLoad, 2)
    end, 0, LoadFactors),

    StandardDeviation = math:sqrt(Deviation / length(LoadFactors)),

    %% Score based on deviation (lower deviation = higher score)
    max(0, 1 - StandardDeviation / AvgLoad).

%% @doc Analyze consistency check results
-spec(analyze_consistency_checks(list(#consistency_check{})) -> map()).
analyze_consistency_checks(Checks) ->
    TotalConflicts = lists:sum([length(C#consistency_check.conflicts) || C <- Checks]),
    ResolvedConflicts = lists:sum([1 || C <- Checks, C#consistency_check.resolution_status =:= resolved]),

    #{
        total_shards => length(Checks),
        total_conflicts => TotalConflicts,
        resolved_conflicts => ResolvedConflicts,
        resolution_rate => ResolvedConflicts / max(TotalConflicts, 1),
        conflicts_by_shard => lists:map(fun(C) ->
            #{
                shard_id => C#consistency_check.shard_id,
                conflicts => length(C#consistency_check.conflicts),
                resolved => C#consistency_check.resolution_status =:= resolved
            }
        end, Checks)
    }.

%% @doc Run performance validation tests
-spec(run_performance_validation(#shard_config{}) -> map()).
run_performance_validation(ShardConfig) ->
    #shard_config{shard_count = ShardCount} = ShardConfig,

    %% Performance test results
    ReadLatencies = run_read_performance_test(ShardConfig),
    WriteLatencies = run_write_performance_test(ShardConfig),
    Throughputs = run_throughput_test(ShardConfig),

    #{
        shard_count => ShardCount,
        read_latency => #{
            p50 => calculate_percentile(ReadLatencies, 50),
            p95 => calculate_percentile(ReadLatencies, 95),
            p99 => calculate_percentile(ReadLatencies, 99),
            avg => lists:sum(ReadLatencies) / max(length(ReadLatencies), 1)
        },
        write_latency => #{
            p50 => calculate_percentile(WriteLatencies, 50),
            p95 => calculate_percentile(WriteLatencies, 95),
            p99 => calculate_percentile(WriteLatencies, 99),
            avg => lists:sum(WriteLatencies) / max(length(WriteLatencies), 1)
        },
        throughput => #{
            read => maps:get(read, Throughputs, 10000),
            write => maps:get(write, Throughputs, 8000),
            total => maps:get(total, Throughputs, 18000)
        }
    }.

%% @doc Run distribution validation tests
-spec(run_distribution_validation(#shard_config{}) -> map()).
run_distribution_validation(ShardConfig) ->
    #shard_config{shard_count = ShardCount} = ShardConfig,

    %% Get shard distribution
    Distribution = get_shard_distribution(ShardConfig),

    %% Analyze distribution
    analyze_shard_distribution(Distribution, ShardCount).

%%====================================================================
%% Internal Functions (not exported)
%%====================================================================

%% @private
initialize_test_data() ->
    #{}.

%% @private
run_validation_tests(ShardConfig, TestConfig) ->
    %% Initialize shard setup
    setup_shards(ShardConfig),

    %% Initialize test data
    initialize_shard_test_data(ShardConfig, TestConfig),

    %% Run validation tests
    ConsistencyResult = case maps:get(consistency_test, TestConfig, true) of
        true -> run_consistency_validation(ShardConfig);
        false -> skip
    end,

    PerformanceResult = case maps:get(performance_test, TestConfig, true) of
        true -> run_performance_validation(ShardConfig);
        false -> skip
    end,

    DistributionResult = case maps:get(performance_test, TestConfig, true) of
        true -> run_distribution_validation(ShardConfig);
        false -> skip
    end,

    MigrationResult = case maps:get(migration_test, TestConfig, true) of
        true -> run_migration_validation(ShardConfig);
        false -> skip
    end,

    %% Collect metrics
    Metrics = collect_shard_metrics(ShardConfig),

    %% Calculate scores
    ConsistencyScore = calc_consistency_score(ConsistencyResult),
    PerformanceScore = calc_performance_score(PerformanceResult),
    DistributionScore = calc_distribution_score(DistributionResult),

    %% Create test result
    TestResult = #test_result{
        test_id = generate_test_id(),
        shard_count = ShardConfig#shard_config.shard_count,
        total_keys = maps:get(test_data_size, TestConfig, 100000),
        consistency_score = ConsistencyScore,
        performance_score = PerformanceScore,
        distribution_score = DistributionScore,
        conflict_count = count_conflicts(ConsistencyResult),
        migration_time = extract_migration_time(MigrationResult)
    },

    %% Cleanup
    cleanup_shards(ShardConfig),

    #validation_metrics{
        shards = Metrics,
        test_result = TestResult,
        timestamp = erlang:system_time(millisecond)
    }.

%% @private
setup_shards(ShardConfig) ->
    #shard_config{shard_count = ShardCount} = ShardConfig,

    %% Create shard nodes
    lists:foreach(fun(ShardId) ->
        create_shard(ShardId, ShardConfig)
    end, lists:seq(0, ShardCount - 1)),

    ok.

%% @private
create_shard(_ShardId, _ShardConfig) ->
    ok.

%% @private
initialize_shard_test_data(_ShardConfig, _TestConfig) ->
    ok.

%% @private
calculate_range_shard(Key, ShardCount) ->
    %% Simple range calculation based on key
    Hash = erlang:phash2(Key, 100),
    (Hash div (100 div ShardCount)) rem ShardCount.

%% @private
run_consistency_validation(ShardConfig) ->
    #shard_config{shard_count = ShardCount} = ShardConfig,

    %% Create consistency checks
    Checks = lists:map(fun(ShardId) ->
        run_consistency_check(ShardId, ShardConfig)
    end, lists:seq(0, ShardCount - 1)),

    %% Analyze consistency
    analyze_consistency_checks(Checks).

%% @private
run_consistency_check(ShardId, _ShardConfig) ->
    #consistency_check{
        shard_id = ShardId,
        data_version = 1,
        conflicts = [],
        resolution_status = resolved
    }.

%% @private
run_read_performance_test(_ShardConfig) ->
    [rand:uniform(100) || _ <- lists:seq(1, 1000)].

%% @private
run_write_performance_test(_ShardConfig) ->
    [rand:uniform(100) || _ <- lists:seq(1, 1000)].

%% @private
run_throughput_test(_ShardConfig) ->
    #{
        read => 10000,
        write => 8000,
        total => 18000
    }.

%% @private
calculate_percentile(List, Percentile) ->
    Sorted = lists:sort(List),
    Length = length(Sorted),
    Index = min(ceil(Length * Percentile / 100), Length),
    lists:nth(max(Index, 1), Sorted).

%% @private
get_shard_distribution(ShardConfig) ->
    lists:map(fun(ShardId) ->
        #{
            shard_id => ShardId,
            key_count => rand:uniform(1000),
            memory_usage => rand:uniform(1000000),
            load_factor => 1.0
        }
    end, lists:seq(0, ShardConfig#shard_config.shard_count - 1)).

%% @private
analyze_shard_distribution(Distribution, ShardCount) ->
    %% Calculate distribution metrics
    LoadFactors = [maps:get(load_factor, D, 1.0) || D <- Distribution],

    MinLoad = lists:min(LoadFactors),
    MaxLoad = lists:max(LoadFactors),
    AvgLoad = lists:sum(LoadFactors) / length(LoadFactors),

    #{
        shard_count => ShardCount,
        total_keys => lists:sum([maps:get(key_count, D, 0) || D <- Distribution]),
        min_load_factor => MinLoad,
        max_load_factor => MaxLoad,
        avg_load_factor => AvgLoad,
        distribution_score => calculate_distribution_score(LoadFactors),
        hot_shards => identify_hot_shards(Distribution),
        cold_shards => identify_cold_shards(Distribution)
    }.

%% @private
identify_hot_shards(Distribution) ->
    Threshold = 1.2,
    lists:filter(fun(D) ->
        maps:get(load_factor, D, 0) > Threshold
    end, Distribution).

%% @private
identify_cold_shards(Distribution) ->
    Threshold = 0.8,
    lists:filter(fun(D) ->
        maps:get(load_factor, D, 0) < Threshold
    end, Distribution).

%% @private
run_migration_validation(_ShardConfig) ->
    #{
        migration_time => 0,
        data_intact => true,
        performance_impact => #{
            latency_increase => 0,
            throughput_decrease => 0
        }
    }.

%% @private
calc_consistency_score(ConsistencyResult) ->
    case ConsistencyResult of
        #{resolution_rate := Rate} -> Rate;
        _ -> 1.0
    end.

%% @private
calc_performance_score(PerformanceResult) ->
    case PerformanceResult of
        skip -> 1.0;
        _ ->
            ReadLatency = maps:get(read_latency, PerformanceResult, #{}),
            WriteLatency = maps:get(write_latency, PerformanceResult, #{}),

            ReadScore = max(0, 1 - maps:get(p99, ReadLatency, 0) / 1000),
            WriteScore = max(0, 1 - maps:get(p99, WriteLatency, 0) / 1000),

            (ReadScore + WriteScore) / 2
    end.

%% @private
calc_distribution_score(DistributionResult) ->
    case DistributionResult of
        skip -> 1.0;
        #{distribution_score := Score} -> Score;
        _ -> 1.0
    end.

%% @private
count_conflicts(ConsistencyResult) ->
    case ConsistencyResult of
        #{total_conflicts := Count} -> Count;
        _ -> 0
    end.

%% @private
extract_migration_time(MigrationResult) ->
    case MigrationResult of
        #{migration_time := Time} -> Time;
        _ -> 0
    end.

%% @private
collect_shard_metrics(ShardConfig) ->
    lists:map(fun(ShardId) ->
        #shard_metrics{
            shard_id = ShardId,
            key_count = rand:uniform(1000),
            memory_usage = rand:uniform(1000000),
            cpu_usage = rand:uniform(100),
            read_operations = rand:uniform(10000),
            write_operations = rand:uniform(5000),
            last_access = erlang:system_time(millisecond)
        }
    end, lists:seq(0, ShardConfig#shard_config.shard_count - 1)).

%% @private
cleanup_shards(ShardConfig) ->
    lists:foreach(fun(ShardId) ->
        cleanup_shard(ShardId)
    end, lists:seq(0, ShardConfig#shard_config.shard_count - 1)).

%% @private
cleanup_shard(_ShardId) ->
    ok.

%% @private
generate_test_id() ->
    integer_to_binary(erlang:system_time(millisecond)).

%% @private
generate_validation_report(Results) ->
    #validation_metrics{
        test_result = TestResult,
        shards = ShardMetrics
    } = Results,

    #{
        test_type => sharding_validation,
        timestamp => erlang:system_time(millisecond),
        summary => #{
            shard_count => TestResult#test_result.shard_count,
            total_keys => TestResult#test_result.total_keys,
            consistency_score => TestResult#test_result.consistency_score,
            performance_score => TestResult#test_result.performance_score,
            distribution_score => TestResult#test_result.distribution_score,
            overall_score => calc_overall_score(TestResult),
            conflicts => TestResult#test_result.conflict_count,
            migration_time => TestResult#test_result.migration_time
        },
        shard_metrics => lists:map(fun(M) ->
            #{
                shard_id => M#shard_metrics.shard_id,
                key_count => M#shard_metrics.key_count,
                memory_usage => M#shard_metrics.memory_usage,
                cpu_usage => M#shard_metrics.cpu_usage,
                read_operations => M#shard_metrics.read_operations,
                write_operations => M#shard_metrics.write_operations,
                last_access => M#shard_metrics.last_access
            }
        end, ShardMetrics),
        recommendations => generate_sharding_recommendations(TestResult, ShardMetrics),
        next_steps => determine_next_steps(TestResult)
    }.

%% @private
calc_overall_score(TestResult) ->
    Consistency = TestResult#test_result.consistency_score,
    Performance = TestResult#test_result.performance_score,
    Distribution = TestResult#test_result.distribution_score,

    (Consistency + Performance + Distribution) / 3.

%% @private
generate_sharding_recommendations(TestResult, _ShardMetrics) ->
    Recommendations = [],

    %% Check consistency
    NewRecs1 = case TestResult#test_result.consistency_score < 0.95 of
        true -> [recommend_consistency_improvement() | Recommendations];
        false -> Recommendations
    end,

    %% Check performance
    NewRecs2 = case TestResult#test_result.performance_score < 0.90 of
        true -> [recommend_performance_optimization() | NewRecs1];
        false -> NewRecs1
    end,

    %% Check distribution
    NewRecs3 = case TestResult#test_result.distribution_score < 0.85 of
        true -> [recommend_distribution_balancing() | NewRecs2];
        false -> NewRecs2
    end,

    NewRecs3.

%% @private
recommend_consistency_improvement() ->
    #{
        recommendation => improve_consistency,
        priority => high,
        reason => "Consistency score below threshold",
        actions => [
            "Increase replication factor",
            "Implement stronger consistency protocol",
            "Add conflict resolution strategy"
        ]
    }.

%% @private
recommend_performance_optimization() ->
    #{
        recommendation => optimize_performance,
        priority => medium,
        reason => "Performance score below threshold",
        actions => [
            "Optimize query performance",
            "Implement caching",
            "Add indexes for frequently accessed data"
        ]
    }.

%% @private
recommend_distribution_balancing() ->
    #{
        recommendation => balance_distribution,
        priority => medium,
        reason => "Distribution score below threshold",
        actions => [
            "Adjust sharding key",
            "Implement dynamic sharding",
            "Rebalance shard distribution"
        ]
    }.

%% @private
determine_next_steps(TestResult) ->
    NextSteps = [],

    %% Check if scaling needed
    NewSteps1 = case TestResult#test_result.distribution_score < 0.8 andalso
        TestResult#test_result.total_keys > 1000000 of
        true -> [recommend_sharding_expansion(TestResult) | NextSteps];
        false -> NextSteps
    end,

    %% Check if reorganization needed
    NewSteps2 = case TestResult#test_result.conflict_count > 100 of
        true -> [recommend_shard_reorganization() | NewSteps1];
        false -> NewSteps1
    end,

    %% Check if optimization needed
    NewSteps3 = case TestResult#test_result.performance_score < 0.85 of
        true -> [recommend_shard_optimization() | NewSteps2];
        false -> NewSteps2
    end,

    NewSteps3.

%% @private
recommend_sharding_expansion(TestResult) ->
    #{
        action => expand_sharding,
        current_shards => TestResult#test_result.shard_count,
        recommended_shards => recommend_shard_count(TestResult),
        timeline => estimate_expansion_timeline(TestResult)
    }.

%% @private
recommend_shard_count(TestResult) ->
    Current = TestResult#test_result.shard_count,
    TotalKeys = TestResult#test_result.total_keys,
    TargetKeysPerShard = 50000,
    max(Current, ceil(TotalKeys / TargetKeysPerShard)).

%% @private
estimate_expansion_timeline(TestResult) ->
    Current = TestResult#test_result.shard_count,
    Target = recommend_shard_count(TestResult),
    (Target - Current) * 3600.

%% @private
recommend_shard_reorganization() ->
    #{
        action => reorganize_shards,
        priority => high,
        description => "Reorganize shards to improve distribution",
        timeline => 7200
    }.

%% @private
recommend_shard_optimization() ->
    #{
        action => optimize_shards,
        priority => medium,
        description => "Optimize shard performance and distribution",
        timeline => 3600
    }.

%% @private
run_consistency_test_internal(TestData, ConsistencyLevel, TestDuration) ->
    %% Initialize test
    setup_consistency_test(TestData, ConsistencyLevel),

    %% Execute test
    Results = execute_consistency_test(TestData, TestDuration, ConsistencyLevel),

    %% Cleanup
    cleanup_consistency_test(),

    Results.

%% @private
setup_consistency_test(_TestData, _ConsistencyLevel) ->
    ok.

%% @private
execute_consistency_test(_TestData, _TestDuration, _ConsistencyLevel) ->
    #{}.

%% @private
cleanup_consistency_test() ->
    ok.

%% @private
analyze_consistency_results(_TestResults) ->
    #{
        consistency_score => 1.0,
        conflict_rate => 0.0,
        latency_metrics => #{
            read_latency => #{avg => 0, p95 => 0, p99 => 0},
            write_latency => #{avg => 0, p95 => 0, p99 => 0}
        },
        recommendations => []
    }.

%% @private
schedule_validation() ->
    Schedule = get_validation_schedule(),
    erlang:send_after(Schedule, self(), validation),
    ok.

%% @private
get_validation_schedule() ->
    case application:get_env(erlmcp, sharding_validation_interval) of
        {ok, Interval} -> Interval;
        undefined -> 600000
    end.

%% @private
run_periodic_validation() ->
    CurrentConfig = get_current_shard_config(),
    Results = run_validation_tests(CurrentConfig, #{}),
    [Results#validation_metrics.test_result].

%% @private
get_current_shard_config() ->
    #shard_config{
        shard_count = 16,
        strategy = consistent_hashing,
        replication = 3,
        consistency = eventual
    }.

%% @private
check_sharding_issues([TestResult | _]) ->
    %% Check for critical issues
    case TestResult#test_result.consistency_score < 0.9 of
        true -> send_consistency_alert(TestResult);
        false -> ok
    end,

    %% Check for performance issues
    case TestResult#test_result.performance_score < 0.8 of
        true -> send_performance_alert(TestResult);
        false -> ok
    end;

check_sharding_issues(_) ->
    ok.

