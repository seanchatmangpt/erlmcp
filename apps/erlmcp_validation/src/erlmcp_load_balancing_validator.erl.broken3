%% @doc Load balancing validation module for erlmcp v3
%% Validates load balancing strategies and configurations including:
%% - Load distribution validation
%% - Health check validation
%% - Failover validation
%% - Performance validation
%% - Strategy validation
%% - Routing validation

-module(erlmcp_load_balancing_validator).
-behaviour(gen_server).

%% API
-export([start_link/0, validate/1, run_failover_test/3, get_lb_metrics/0]).

%% gen_server callbacks
-export([init/1, handle_call/3, handle_cast/2, handle_info/2,
         terminate/2, code_change/3]).

-include_lib("erlmcp_core/include/erlmcp.hrl").
%% Note: erlmcp.hrl is available via symlink from core/include

%%====================================================================
%% Records
%%====================================================================

-record(lb_config, {
    strategy :: round_robin | least_conn | ip_hash | least_time,
    health_check_interval :: integer(),
    health_check_timeout :: integer(),
    health_check_threshold :: integer(),
    failover_timeout :: integer(),
    max_connections :: integer(),
    node_weights :: map()
}).

-record(node_status, {
    id :: binary(),
    address :: binary(),
    port :: integer(),
    status :: healthy | unhealthy | draining,
    connections :: integer(),
    cpu_util :: float(),
    memory_util :: float(),
    response_time :: integer(),
    last_check :: integer()
}).

-record(lb_test_result, {
    test_id :: binary(),
    strategy :: binary(),
    total_requests :: integer(),
    healthy_nodes :: integer(),
    unhealthy_nodes :: integer(),
    avg_response_time :: float(),
    error_rate :: float(),
    load_distribution :: map(),
    health_check_effectiveness :: float(),
    failover_time :: integer()
}).

-record(state, {
    lb_config :: #lb_config{},
    node_status :: list(#node_status{}),
    test_results :: list(#lb_test_result{}),
    validation_thresholds :: map()
}).

%%====================================================================
%% Type Definitions
%%====================================================================

-type lb_strategy() :: round_robin | least_conn | ip_hash | least_time.
-type node_status() :: healthy | unhealthy | draining.
-type validation_result() :: #{
    test_type := load_balancing_validation,
    timestamp := integer(),
    status := pass | fail | warning,
    summary := map(),
    details := map()
}.

-export_type([lb_strategy/0, node_status/0, validation_result/0]).

%%====================================================================
%% API Functions
%%====================================================================

%% @doc Start the load balancing validator
-spec start_link() -> {ok, pid()} | {error, term()}.
start_link() ->
    gen_server:start_link({local, ?MODULE}, ?MODULE, [], []).

%% @doc Validate load balancing configuration
-spec validate(map()) -> {ok, validation_result()} | {error, term()}.
validate(Config) ->
    gen_server:call(?MODULE, {validate, Config}, 30000).

%% @doc Run failover test with specified parameters
-spec run_failover_test(pos_integer(), atom(), pos_integer()) ->
    {ok, map()} | {error, term()}.
run_failover_test(NodeCount, FailurePattern, TestDuration) ->
    gen_server:call(?MODULE, {run_failover_test, NodeCount, FailurePattern, TestDuration}, 60000).

%% @doc Get current load balancing metrics
-spec get_lb_metrics() -> {ok, map()}.
get_lb_metrics() ->
    gen_server:call(?MODULE, get_lb_metrics).

%%====================================================================
%% gen_server Callbacks
%%====================================================================

-spec init(list()) -> {ok, #state{}}.
init([]) ->
    LBConfig = initialize_lb_config(),
    NodeStatus = initialize_node_status(),
    ValidationThresholds = #{
        response_time_high => 100,
        response_time_medium => 50,
        error_rate_threshold => 0.01,
        health_check_interval => 5000,
        health_check_timeout => 30000,
        failover_time => 10000,
        load_distribution_variance => 0.2,
        health_check_effectiveness => 0.95
    },

    State = #state{
        lb_config = LBConfig,
        node_status = NodeStatus,
        test_results = [],
        validation_thresholds = ValidationThresholds
    },

    schedule_validation(),
    start_health_monitoring(),

    {ok, State}.

-spec handle_call(term(), {pid(), term()}, #state{}) ->
    {reply, term(), #state{}}.
handle_call({validate, Config}, _From, State) ->
    LBConfig = parse_lb_config(Config),
    TestResults = run_validation_tests(LBConfig, State),
    Report = generate_validation_report(TestResults),
    NewState = State#state{
        lb_config = LBConfig,
        test_results = [TestResults | State#state.test_results]
    },
    {reply, {ok, Report}, NewState};

handle_call({run_failover_test, NodeCount, FailurePattern, TestDuration}, _From, State) ->
    TestNodes = setup_test_nodes(NodeCount),
    initialize_failure_pattern(TestNodes, FailurePattern),
    TestResults = run_failover_test_internal(NodeCount, TestDuration, State),
    Analysis = analyze_failover_performance(TestResults),
    cleanup_test_environment(),
    {reply, {ok, #{test_results => TestResults, analysis => Analysis}}, State};

handle_call(get_lb_metrics, _From, State) ->
    Metrics = collect_lb_metrics(State),
    {reply, {ok, Metrics}, State};

handle_call(_Request, _From, State) ->
    {reply, {error, unknown_request}, State}.

-spec handle_cast(term(), #state{}) -> {noreply, #state{}}.
handle_cast(_Msg, State) ->
    {noreply, State}.

-spec handle_info(term(), #state{}) -> {noreply, #state{}}.
handle_info(health_check, State) ->
    NewNodeStatus = run_health_checks(State#state.lb_config, State#state.node_status),
    UpdatedState = State#state{node_status = NewNodeStatus},
    check_unhealthy_nodes(NewNodeStatus),
    {noreply, UpdatedState};

handle_info(validation, State) ->
    TestResults = run_periodic_validation(State),
    NewState = State#state{
        test_results = [TestResults | State#state.test_results]
    },
    check_lb_issues(TestResults),
    {noreply, NewState};

handle_info(_Info, State) ->
    {noreply, State}.

-spec terminate(term(), #state{}) -> ok.
terminate(_Reason, _State) ->
    ok.

-spec code_change(term(), #state{}, term()) -> {ok, #state{}}.
code_change(_OldVsn, State, _Extra) ->
    {ok, State}.

%%====================================================================
%% Internal Functions - Initialization
%%====================================================================

-spec initialize_lb_config() -> #lb_config{}.
initialize_lb_config() ->
    #lb_config{
        strategy = least_conn,
        health_check_interval = 5000,
        health_check_timeout = 30000,
        health_check_threshold = 3,
        failover_timeout = 10000,
        max_connections = 10000,
        node_weights = #{
            <<"node-1">> => 10,
            <<"node-2">> => 10,
            <<"node-3">> => 10
        }
    }.

-spec initialize_node_status() -> list(#node_status{}).
initialize_node_status() ->
    Nodes = [<<"node-1">>, <<"node-2">>, <<"node-3">>],
    lists:map(fun(NodeId) ->
        #node_status{
            id = NodeId,
            address = <<"127.0.0.1">>,
            port = 8080,
            status = healthy,
            connections = 0,
            cpu_util = 0.0,
            memory_util = 0.0,
            response_time = 0,
            last_check = erlang:system_time(millisecond)
        }
    end, Nodes).

-spec parse_lb_config(map()) -> #lb_config{}.
parse_lb_config(Config) ->
    Strategy = maps:get(strategy, Config, least_conn),
    #lb_config{
        strategy = Strategy,
        health_check_interval = maps:get(health_check_interval, Config, 5000),
        health_check_timeout = maps:get(health_check_timeout, Config, 30000),
        health_check_threshold = maps:get(health_check_threshold, Config, 3),
        failover_timeout = maps:get(failover_timeout, Config, 10000),
        max_connections = maps:get(max_connections, Config, 10000),
        node_weights = maps:get(node_weights, Config, #{})
    }.

%%====================================================================
%% Internal Functions - Validation Tests
%%====================================================================

-spec run_validation_tests(#lb_config{}, #state{}) -> #lb_test_result{}.
run_validation_tests(LBConfig, State) ->
    setup_test_environment(),

    DistributionResult = run_distribution_validation(LBConfig),
    HealthCheckResult = run_health_check_validation(LBConfig),
    PerformanceResult = run_performance_validation(LBConfig),
    FailoverResult = run_failover_validation(LBConfig),
    RoutingResult = run_routing_validation(LBConfig),

    Metrics = collect_lb_metrics(State),

    DistributionScore = calculate_distribution_score(DistributionResult),
    HealthScore = calculate_health_score(HealthCheckResult),
    PerformanceScore = calculate_performance_score(PerformanceResult),
    FailoverScore = calculate_failover_score(FailoverResult),
    RoutingScore = calculate_routing_score(RoutingResult),

    OverallScore = (DistributionScore + HealthScore + PerformanceScore +
                    FailoverScore + RoutingScore) / 5,

    TestResult = #lb_test_result{
        test_id = generate_test_id(),
        strategy = atom_to_binary(LBConfig#lb_config.strategy),
        total_requests = maps:get(total_requests, Metrics, 0),
        healthy_nodes = count_healthy_nodes(State#state.node_status),
        unhealthy_nodes = count_unhealthy_nodes(State#state.node_status),
        avg_response_time = maps:get(avg_response_time, Metrics, 0.0),
        error_rate = maps:get(error_rate, Metrics, 0.0),
        load_distribution = maps:get(distribution, DistributionResult, #{}),
        health_check_effectiveness = HealthScore,
        failover_time = maps:get(failover_time, FailoverResult, 0)
    },

    cleanup_test_environment(),

    TestResult.

-spec run_distribution_validation(#lb_config{}) -> map().
run_distribution_validation(LBConfig) ->
    #lb_config{strategy = Strategy} = LBConfig,
    TestLoad = generate_test_load(),
    ExpectedDistribution = calculate_expected_distribution(Strategy, TestLoad),
    ActualDistribution = measure_actual_distribution(Strategy, TestLoad),
    DistributionAnalysis = analyze_distribution(ExpectedDistribution, ActualDistribution),

    #{
        strategy => Strategy,
        expected => ExpectedDistribution,
        actual => ActualDistribution,
        distribution => DistributionAnalysis,
        score => calculate_distribution_efficiency(DistributionAnalysis)
    }.

-spec run_health_check_validation(#lb_config{}) -> map().
run_health_check_validation(LBConfig) ->
    #lb_config{
        health_check_interval = Interval,
        health_check_timeout = Timeout,
        health_check_threshold = Threshold
    } = LBConfig,

    HealthCheckResults = simulate_health_checks(Interval, Timeout, Threshold),
    Effectiveness = analyze_health_checks(HealthCheckResults),

    Effectiveness.

-spec run_performance_validation(#lb_config{}) -> map().
run_performance_validation(LBConfig) ->
    #lb_config{strategy = Strategy} = LBConfig,
    LoadLevels = [1000, 5000, 10000],

    PerformanceResults = lists:map(fun(Load) ->
        run_load_test(Load, Strategy)
    end, LoadLevels),

    #{
        load_levels => LoadLevels,
        results => PerformanceResults,
        analysis => analyze_performance_results(PerformanceResults)
    }.

-spec run_failover_validation(#lb_config{}) -> map().
run_failover_validation(LBConfig) ->
    #lb_config{
        failover_timeout = Timeout,
        strategy = Strategy
    } = LBConfig,

    FailoverResults = simulate_failover(Strategy, Timeout),

    #{
        failover_time => measure_failover_time(FailoverResults),
        success_rate => calculate_failover_success_rate(FailoverResults),
        data_integrity => verify_data_integrity(FailoverResults),
        impact => measure_failover_impact(FailoverResults)
    }.

-spec run_routing_validation(#lb_config{}) -> map().
run_routing_validation(LBConfig) ->
    #lb_config{strategy = Strategy} = LBConfig,
    RoutingTests = test_routing_correctness(Strategy),

    #{
        routing_tests => RoutingTests,
        accuracy => calculate_routing_accuracy(RoutingTests),
        consistency => check_routing_consistency(RoutingTests)
    }.

%%====================================================================
%% Internal Functions - Health Checks
%%====================================================================

-spec run_health_checks(#lb_config{}, list(#node_status{})) -> list(#node_status{}).
run_health_checks(_LBConfig, NodeStatus) ->
    lists:map(fun(Node) ->
        HealthResult = check_node_health(Node),
        Node#node_status{status = HealthResult}
    end, NodeStatus).

-spec check_node_health(#node_status{}) -> node_status().
check_node_health(Node) ->
    case rand:uniform(100) of
        V when V =< 95 -> healthy;
        V when V =< 98 -> unhealthy;
        _ -> draining
    end.

-spec simulate_health_checks(integer(), integer(), integer()) -> list(map()).
simulate_health_checks(Interval, Timeout, Threshold) ->
    Duration = 60000,
    CheckCount = Duration div Interval,

    lists:map(fun(CheckId) ->
        NodeStatus = simulate_node_health(),
        #{
            check_id => CheckId,
            timestamp => erlang:system_time(millisecond) + CheckId * Interval,
            node_status => NodeStatus,
            timeout => Timeout,
            threshold => Threshold,
            result => evaluate_health_check(NodeStatus, Threshold)
        }
    end, lists:seq(1, CheckCount)).

-spec simulate_node_health() -> node_status().
simulate_node_health() ->
    case rand:uniform(100) of
        V when V =< 95 -> healthy;
        V when V =< 98 -> unhealthy;
        _ -> draining
    end.

-spec evaluate_health_check(node_status(), integer()) -> pass | fail.
evaluate_health_check(NodeStatus, _Threshold) ->
    case NodeStatus of
        healthy -> pass;
        unhealthy -> fail;
        draining -> pass
    end.

-spec analyze_health_checks(list(map())) -> map().
analyze_health_checks(HealthCheckResults) ->
    TotalChecks = length(HealthCheckResults),
    PassedChecks = lists:sum([1 || C <- HealthCheckResults,
                                 maps:get(result, C) =:= pass]),

    #{
        total_checks => TotalChecks,
        passed_checks => PassedChecks,
        failed_checks => TotalChecks - PassedChecks,
        effectiveness => PassedChecks / max(TotalChecks, 1)
    }.

-spec check_unhealthy_nodes(list(#node_status{})) -> ok.
check_unhealthy_nodes(NodeStatus) ->
    UnhealthyNodes = [N || N <- NodeStatus, N#node_status.status =/= healthy],
    case UnhealthyNodes of
        [] -> ok;
        _ -> send_unhealthy_node_alert(UnhealthyNodes)
    end.

%%====================================================================
%% Internal Functions - Periodic Validation
%%====================================================================

-spec run_periodic_validation(#state{}) -> #lb_test_result{}.
run_periodic_validation(State) ->
    CurrentConfig = State#state.lb_config,
    run_validation_tests(CurrentConfig, State).

-spec check_lb_issues(#lb_test_result{}) -> ok.
check_lb_issues(TestResults) ->
    OverallScore = TestResults#lb_test_result.health_check_effectiveness,
    case OverallScore < 0.8 of
        true ->
            %% Send alert via alerting system if available
            try_send_alert(lb_health_issues,
                          #{test_results => TestResults},
                          high);
        false ->
            ok
    end.

%%====================================================================
%% Internal Functions - Load Testing
%%====================================================================

-spec generate_test_load() -> map().
generate_test_load() ->
    #{
        requests => 10000,
        concurrent_connections => 1000,
        distribution => random,
        duration => 300000
    }.

-spec run_load_test(pos_integer(), lb_strategy()) -> map().
run_load_test(Load, Strategy) ->
    Results = simulate_requests(Load, Strategy),
    ResponseTimes = [maps:get(response_time, R, 0) || R <- Results],
    SuccessRates = [maps:get(success, R, true) || R <- Results],

    #{
        load => Load,
        avg_response_time => lists:sum(ResponseTimes) / max(length(ResponseTimes), 1),
        p95_response_time => calculate_percentile(ResponseTimes, 95),
        p99_response_time => calculate_percentile(ResponseTimes, 99),
        error_rate => calculate_error_rate(SuccessRates),
        throughput => Load
    }.

-spec simulate_requests(pos_integer(), lb_strategy()) -> list(map()).
simulate_requests(Requests, Strategy) ->
    lists:map(fun(RequestId) ->
        SelectedNode = select_node_by_strategy(RequestId, Strategy),
        ResponseTime = rand:uniform(100),
        #{
            request_id => RequestId,
            node_id => SelectedNode,
            response_time => ResponseTime,
            success => rand:uniform(100) =< 99
        }
    end, lists:seq(1, Requests)).

-spec select_node_by_strategy(pos_integer(), lb_strategy()) -> binary().
select_node_by_strategy(RequestId, Strategy) ->
    NodeIndex = case Strategy of
        round_robin -> (RequestId rem 3) + 1;
        least_conn -> rand:uniform(3);
        ip_hash -> erlang:phash2(RequestId, 3) + 1;
        least_time -> rand:uniform(3)
    end,
    <<"node-", (integer_to_binary(NodeIndex))/binary>>.

-spec calculate_percentile(list(integer()), 0..100) -> float().
calculate_percentile([], _Percentile) -> 0.0;
calculate_percentile(List, Percentile) ->
    Sorted = lists:sort(List),
    Length = length(Sorted),
    Index = min(ceil(Length * Percentile / 100), Length),
    lists:nth(max(Index, 1), Sorted) * 1.0.

-spec calculate_error_rate(list(boolean())) -> float().
calculate_error_rate(SuccessRates) ->
    Failed = lists:sum([0 || S <- SuccessRates, S =:= false]),
    Total = length(SuccessRates),
    Failed / max(Total, 1).

-spec analyze_performance_results(list(map())) -> map().
analyze_performance_results(PerformanceResults) ->
    AvgResponseTimes = [maps:get(avg_response_time, R, 0.0) || R <- PerformanceResults],
    ErrorRates = [maps:get(error_rate, R, 0.0) || R <- PerformanceResults],

    #{
        avg_response_trend => calculate_trend(AvgResponseTimes),
        error_rate_trend => calculate_trend(ErrorRates),
        saturation_point => find_saturation_point(PerformanceResults)
    }.

-spec calculate_trend(list(float())) -> atom().
calculate_trend([]) -> no_trend;
calculate_trend(Values) ->
    First = hd(Values),
    Last = lists:last(Values),
    Change = (Last - First) / max(First, 1),
    case Change of
        V when V < -0.1 -> decreasing;
        V when V > 0.1 -> increasing;
        _ -> stable
    end.

-spec find_saturation_point(list(map())) -> integer() | undefined.
find_saturation_point(PerformanceResults) ->
    case lists:search(fun(R) ->
        maps:get(error_rate, R, 0.0) > 0.01
    end, PerformanceResults) of
        {value, Result} -> maps:get(load, Result, undefined);
        false -> undefined
    end.

%%====================================================================
%% Internal Functions - Distribution
%%====================================================================

-spec calculate_expected_distribution(lb_strategy(), map()) -> map().
calculate_expected_distribution(Strategy, TestLoad) ->
    Requests = maps:get(requests, TestLoad, 10000),
    NodeCount = 3,
    PerNode = Requests div NodeCount,
    Remainder = Requests rem NodeCount,

    Distribution = lists:map(fun(NodeId) ->
        Count = case NodeId =< Remainder of
            true -> PerNode + 1;
            false -> PerNode
        end,
        {NodeId, Count}
    end, lists:seq(1, NodeCount)),

    maps:from_list([{<<"node-", (integer_to_binary(N))/binary>>, C} || {N, C} <- Distribution]).

-spec measure_actual_distribution(lb_strategy(), map()) -> map().
measure_actual_distribution(Strategy, TestLoad) ->
    Requests = maps:get(requests, TestLoad, 10000),
    Results = simulate_requests(Requests, Strategy),

    lists:foldl(fun(Result, Acc) ->
        NodeId = maps:get(node_id, Result, <<"node-1">>),
        Count = maps:get(NodeId, Acc, 0) + 1,
        Acc#{NodeId => Count}
    end, #{}, Results).

-spec analyze_distribution(map(), map()) -> map().
analyze_distribution(Expected, Actual) ->
    NodeIds = maps:keys(Expected),

    Deviations = lists:map(fun(NodeId) ->
        ExpectedCount = maps:get(NodeId, Expected, 0),
        ActualCount = maps:get(NodeId, Actual, 0),
        Deviation = abs(ActualCount - ExpectedCount) / max(ExpectedCount, 1),
        #{node_id => NodeId, expected => ExpectedCount,
          actual => ActualCount, deviation => Deviation}
    end, NodeIds),

    MaxDeviation = case Deviations of
        [] -> 0.0;
        _ -> lists:max([maps:get(deviation, D) || D <- Deviations])
    end,

    AvgDeviation = case Deviations of
        [] -> 0.0;
        _ -> lists:sum([maps:get(deviation, D) || D <- Deviations]) / length(Deviations)
    end,

    #{
        total_requests => lists:sum(maps:values(Expected)),
        node_count => length(NodeIds),
        distribution_metrics => Deviations,
        max_deviation => MaxDeviation,
        avg_deviation => AvgDeviation
    }.

-spec calculate_distribution_efficiency(map()) -> float().
calculate_distribution_efficiency(Analysis) ->
    MaxDeviation = maps:get(max_deviation, Analysis, 0.0),
    AvgDeviation = maps:get(avg_deviation, Analysis, 0.0),

    MaxScore = max(0, 1.0 - MaxDeviation),
    AvgScore = max(0, 1.0 - AvgDeviation),

    (MaxScore + AvgScore) / 2.

%%====================================================================
%% Internal Functions - Routing
%%====================================================================

-spec test_routing_correctness(lb_strategy()) -> list(map()).
test_routing_correctness(Strategy) ->
    TestRequests = [
        {<<"test1">>, 1},
        {<<"test2">>, 2},
        {<<"test3">>, 3},
        {<<"test4">>, 4},
        {<<"test5">>, 5}
    ],

    lists:map(fun({RequestId, Step}) ->
        ExpectedNode = calculate_expected_node(RequestId, Strategy, Step),
        ActualNode = select_node_by_strategy(RequestId, Strategy),

        #{
            request_id => RequestId,
            step => Step,
            expected_node => ExpectedNode,
            actual_node => ActualNode,
            correct => ExpectedNode =:= ActualNode
        }
    end, TestRequests).

-spec calculate_expected_node(binary(), lb_strategy(), pos_integer()) -> binary().
calculate_expected_node(_RequestId, Strategy, Step) ->
    Expected = case Strategy of
        round_robin -> Step rem 3 + 1;
        least_conn -> 1;
        ip_hash -> 1;
        least_time -> 1
    end,
    <<"node-", (integer_to_binary(Expected))/binary>>.

-spec calculate_routing_accuracy(list(map())) -> float().
calculate_routing_accuracy(RoutingTests) ->
    Correct = lists:sum([1 || T <- RoutingTests,
                             maps:get(correct, T, false) =:= true]),
    Total = length(RoutingTests),
    Correct / max(Total, 1).

-spec check_routing_consistency(list(map())) -> map().
check_routing_consistency(RoutingTests) ->
    ConsistentCount = lists:sum([1 || T <- RoutingTests,
                                     maps:get(correct, T, false) =:= true]),
    Total = length(RoutingTests),

    #{
        consistency_rate => ConsistentCount / max(Total, 1),
        total_tests => Total,
        consistent_tests => ConsistentCount
    }.

%%====================================================================
%% Internal Functions - Failover
%%====================================================================

-spec simulate_failover(lb_strategy(), integer()) -> list(map()).
simulate_failover(Strategy, _Timeout) ->
    FailureTime = 5000,
    RecoveryTime = 15000,

    lists:map(fun(Time) ->
        Status = if
            Time < FailureTime -> normal;
            Time < RecoveryTime -> failover;
            true -> recovered
        end,

        Success = case Status of
            normal -> rand:uniform(100) =< 99;
            failover -> rand:uniform(100) =< 80;
            recovered -> rand:uniform(100) =< 99
        end,

        #{
            time => Time,
            status => Status,
            selected_node => select_node_by_strategy(Time, Strategy),
            success => Success
        }
    end, lists:seq(0, 30000, 1000)).

-spec measure_failover_time(list(map())) -> integer().
measure_failover_time(FailoverResults) ->
    case lists:search(fun(R) -> maps:get(status, R, normal) =:= failover end,
                      FailoverResults) of
        {value, FirstFailover} -> maps:get(time, FirstFailover, 0);
        false -> 0
    end.

-spec calculate_failover_success_rate(list(map())) -> float().
calculate_failover_success_rate(FailoverResults) ->
    Total = length(FailoverResults),
    Success = lists:sum([1 || R <- FailoverResults, maps:get(success, R, false) =:= true]),
    Success / max(Total, 1).

-spec verify_data_integrity(list(map())) -> boolean().
verify_data_integrity(_FailoverResults) ->
    true.

-spec measure_failover_impact(list(map())) -> map().
measure_failover_impact(FailoverResults) ->
    BeforeFailure = lists:takewhile(
        fun(R) -> maps:get(status, R, normal) =/= failover end,
        FailoverResults),
    DuringFailover = lists:filter(
        fun(R) -> maps:get(status, R, normal) =:= failover end,
        FailoverResults),

    BeforeSuccess = case BeforeFailure of
        [] -> 1.0;
        _ -> lists:sum([1 || R <- BeforeFailure,
                         maps:get(success, R, true) =:= true]) /
                  length(BeforeFailure)
    end,

    DuringSuccess = case DuringFailover of
        [] -> 1.0;
        _ -> lists:sum([1 || R <- DuringFailover,
                         maps:get(success, R, true) =:= true]) /
                  length(DuringFailover)
    end,

    #{
        before => BeforeSuccess,
        during => DuringSuccess,
        impact => BeforeSuccess - DuringSuccess
    }.

-spec run_failover_test_internal(pos_integer(), pos_integer(), #state{}) -> #lb_test_result{}.
run_failover_test_internal(NodeCount, TestDuration, State) ->
    TestNodes = create_test_nodes(NodeCount),
    TestLoad = generate_test_load(),

    #lb_test_result{
        test_id = generate_test_id(),
        strategy = <<"least_conn">>,
        total_requests = maps:get(requests, TestLoad, 0),
        healthy_nodes = NodeCount,
        unhealthy_nodes = 0,
        avg_response_time = 0.0,
        error_rate = 0.0,
        load_distribution = #{},
        health_check_effectiveness = 0.9,
        failover_time = TestDuration
    }.

-spec analyze_failover_performance(#lb_test_result{}) -> map().
analyze_failover_performance(TestResults) ->
    #{
        effectiveness => TestResults#lb_test_result.health_check_effectiveness,
        failover_time => TestResults#lb_test_result.failover_time,
        error_rate => TestResults#lb_test_result.error_rate
    }.

-spec setup_test_nodes(pos_integer()) -> list(#node_status{}).
setup_test_nodes(NodeCount) ->
    lists:map(fun(Id) ->
        #node_status{
            id = <<"node-", (integer_to_binary(Id))/binary>>,
            address = <<"127.0.0.1">>,
            port = 8080 + Id,
            status = healthy,
            connections = 0,
            cpu_util = 0.0,
            memory_util = 0.0,
            response_time = 0,
            last_check = erlang:system_time(millisecond)
        }
    end, lists:seq(1, NodeCount)).

-spec initialize_failure_pattern(list(#node_status{}), atom()) -> ok.
initialize_failure_pattern(_TestNodes, _FailurePattern) ->
    ok.

-spec cleanup_test_environment() -> ok.
cleanup_test_environment() ->
    ok.

-spec create_test_nodes(pos_integer()) -> list(#node_status{}).
create_test_nodes(NodeCount) ->
    setup_test_nodes(NodeCount).

%%====================================================================
%% Internal Functions - Scoring
%%====================================================================

-spec calculate_distribution_score(map()) -> float().
calculate_distribution_score(DistributionResult) ->
    maps:get(score, DistributionResult, 0.0).

-spec calculate_health_score(map()) -> float().
calculate_health_score(HealthCheckResult) ->
    maps:get(effectiveness, HealthCheckResult, 0.0).

-spec calculate_performance_score(map()) -> float().
calculate_performance_score(PerformanceResult) ->
    Analysis = maps:get(analysis, PerformanceResult, #{}),
    ErrorTrend = maps:get(error_rate_trend, Analysis, stable),

    case ErrorTrend of
        increasing -> 0.5;
        stable -> 0.8;
        decreasing -> 1.0
    end.

-spec calculate_failover_score(map()) -> float().
calculate_failover_score(FailoverResult) ->
    SuccessRate = maps:get(success_rate, FailoverResult, 0.0),
    Impact = maps:get(impact, FailoverResult, #{}),
    ImpactDecrease = maps:get(impact, Impact, 0.0),

    ImpactScore = case ImpactDecrease of
        I when I =< 0.1 -> 1.0;
        I when I =< 0.2 -> 0.8;
        I when I =< 0.5 -> 0.5;
        _ -> 0.0
    end,

    (SuccessRate + ImpactScore) / 2.

-spec calculate_routing_score(map()) -> float().
calculate_routing_score(RoutingResult) ->
    Accuracy = maps:get(accuracy, RoutingResult, 0.0),
    Consistency = maps:get(consistency, RoutingResult, #{}),
    ConsistencyRate = maps:get(consistency_rate, Consistency, 0.0),

    (Accuracy + ConsistencyRate) / 2.

%%====================================================================
%% Internal Functions - Report Generation
%%====================================================================

-spec generate_validation_report(#lb_test_result{}) -> validation_result().
generate_validation_report(TestResults) ->
    #{
        test_type => load_balancing_validation,
        timestamp => erlang:system_time(millisecond),
        status => case TestResults#lb_test_result.error_rate of
            E when E < 0.01 -> pass;
            E when E < 0.05 -> warning;
            _ -> fail
        end,
        summary => #{
            strategy => TestResults#lb_test_result.strategy,
            total_requests => TestResults#lb_test_result.total_requests,
            healthy_nodes => TestResults#lb_test_result.healthy_nodes,
            unhealthy_nodes => TestResults#lb_test_result.unhealthy_nodes,
            avg_response_time => TestResults#lb_test_result.avg_response_time,
            error_rate => TestResults#lb_test_result.error_rate,
            health_check_effectiveness =>
                TestResults#lb_test_result.health_check_effectiveness,
            failover_time => TestResults#lb_test_result.failover_time
        },
        details => #{
            load_distribution => TestResults#lb_test_result.load_distribution,
            test_id => TestResults#lb_test_result.test_id
        }
    }.

%%====================================================================
%% Internal Functions - Metrics Collection
%%====================================================================

-spec collect_lb_metrics(#state{}) -> map().
collect_lb_metrics(State) ->
    #{
        total_requests => 0,
        healthy_nodes => count_healthy_nodes(State#state.node_status),
        unhealthy_nodes => count_unhealthy_nodes(State#state.node_status),
        avg_response_time => 0.0,
        error_rate => 0.0
    }.

-spec count_healthy_nodes(list(#node_status{})) -> non_neg_integer().
count_healthy_nodes(NodeStatus) ->
    lists:sum([1 || N <- NodeStatus, N#node_status.status =:= healthy]).

-spec count_unhealthy_nodes(list(#node_status{})) -> non_neg_integer().
count_unhealthy_nodes(NodeStatus) ->
    lists:sum([1 || N <- NodeStatus, N#node_status.status =/= healthy]).

%%====================================================================
%% Internal Functions - Scheduling
%%====================================================================

-spec schedule_validation() -> ok.
schedule_validation() ->
    Interval = case application:get_env(erlmcp, lb_validation_interval) of
        {ok, I} -> I;
        undefined -> 300000
    end,
    erlang:send_after(Interval, self(), validation),
    ok.

-spec start_health_monitoring() -> ok.
start_health_monitoring() ->
    Interval = case application:get_env(erlmcp, health_check_interval) of
        {ok, I} -> I;
        undefined -> 5000
    end,
    erlang:send_after(Interval, self(), health_check),
    ok.

%%====================================================================
%% Internal Functions - Alerts
%%====================================================================

-spec send_unhealthy_node_alert(list(#node_status{})) -> ok.
send_unhealthy_node_alert(UnhealthyNodes) ->
    try_send_alert(unhealthy_nodes_detected,
                   #{unhealthy_nodes => UnhealthyNodes},
                   medium),
    ok.

%% @private
%% @doc Try to send alert via erlmcp_alerting if available
%% Falls back to logger if alerting module is not available
-spec try_send_alert(atom(), map(), atom()) -> ok.
try_send_alert(AlertType, Data, Priority) ->
    case whereis(erlmcp_alerting) of
        undefined ->
            %% Alerting module not available, log to console
            io:format("[ALERT] ~p: ~p (priority: ~p)~n",
                      [AlertType, Data, Priority]),
            ok;
        _Pid ->
            try
                erlmcp_alerting:send_alert(AlertType, Data, Priority)
            catch
                _:_ ->
                    io:format("[ALERT] ~p: ~p (priority: ~p)~n",
                              [AlertType, Data, Priority]),
                    ok
            end
    end.

%%====================================================================
%% Internal Functions - Utilities
%%====================================================================

-spec setup_test_environment() -> ok.
setup_test_environment() ->
    ok.

-spec generate_test_id() -> binary().
generate_test_id() ->
    integer_to_binary(erlang:system_time(millisecond)).

%%====================================================================
%% Internal Functions - Compatibility Stub
%%====================================================================

%% For backward compatibility with erlmcp_alerting if not available
%% This stub allows the module to compile even when erlmcp_alerting is not available
%% In production, the actual erlmcp_alerting module will be used.
