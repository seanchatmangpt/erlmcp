%%%-------------------------------------------------------------------
%%% @doc Quality Gates Unit Tests
%%%
%%% Comprehensive EUnit tests for erlmcp_quality_gates module
%%% Tests all 8 quality gates: security, type safety, input sanitization,
%%% error handling, protocol compliance, OTP patterns, testing, and performance.
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_quality_gates_unit_tests).
-author("erlmcp").

-include_lib("eunit/include/eunit.hrl").

%%%=============================================================================
%%% Test State
%%%=============================================================================

-record(qg_test_state, {
    original_env :: [tuple()]
}).

%%%=============================================================================
%%% Setup and Teardown
%%%=============================================================================

setup_quality_gates() ->
    %% Save original environment
    OriginalEnv = application:get_all_env(erlmcp),
    #qg_test_state{original_env = OriginalEnv}.

cleanup_quality_gates(#qg_test_state{original_env = OriginalEnv}) ->
    %% Restore original environment
    lists:foreach(fun({App, Env}) ->
        lists:foreach(fun({Key, Val}) ->
            application:set_env(App, Key, Val)
        end, Env)
    end, OriginalEnv),
    ok.

%%%=============================================================================
%%% Test Generators
%%%=============================================================================

quality_gates_test_() ->
    {setup,
     fun setup_quality_gates/0,
     fun cleanup_quality_gates/1,
     [
      fun test_run_all_gates/1,
      fun test_gate_security/1,
      fun test_gate_type_safety/1,
      fun test_gate_input_sanitization/1,
      fun test_gate_error_handling/1,
      fun test_gate_protocol_compliance/1,
      fun test_gate_otp_patterns/1,
      fun test_gate_testing/1,
      fun test_gate_performance/1,
      fun test_run_individual_gates/1,
      fun test_generate_report/1,
      fun test_format_report/1
     ]}.

%%%=============================================================================
%%% Main Execution Tests
%%%=============================================================================

test_run_all_gates(_State) ->
    %% Run all gates and verify structure
    Results = erlmcp_quality_gates:run_all_gates(),
    ?assert(is_list(Results)),
    ?assertEqual(8, length(Results)),  % 8 gates total

    %% Verify each result has required fields
    lists:foreach(fun(Result) ->
        ?assert(maps:is_key(gate, Result)),
        ?assert(maps:is_key(status, Result)),
        ?assert(maps:is_key(mandatory, Result)),
        ?assert(maps:is_key(pass_count, Result)),
        ?assert(maps:is_key(fail_count, Result)),
        ?assert(maps:is_key(checks, Result)),
        ?assert(is_list(maps:get(checks, Result, [])))
    end, Results).

test_run_individual_gates(_State) ->
    %% Test each individual gate
    Gates = [security, type_safety, input_sanitization, error_handling,
            protocol_compliance, otp_patterns, testing, performance],

    lists:foreach(fun(Gate) ->
        Result = erlmcp_quality_gates:run_gate(Gate),
        ?assertEqual(Gate, maps:get(gate, Result)),
        ?assert(is_list(maps:get(checks, Result, [])))
    end, Gates).

%%%=============================================================================
%%% Security Gate Tests
%%%=============================================================================

test_gate_security(_State) ->
    Result = erlmcp_quality_gates:gate_security(),

    %% Verify gate structure
    ?assertEqual(security, maps:get(gate, Result)),
    ?assert(is_list(maps:get(checks, Result))),

    %% Security gate is mandatory
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for specific security checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key security checks exist
    ?assert(lists:member(<<"Authentication required">>, CheckNames)),
    ?assert(lists:member(<<"TLS requirement">>, CheckNames)),
    ?assert(lists:member(<<"Rate limiting">>, CheckNames)),
    ?assert(lists:member(<<"Message size limits">>, CheckNames)).

%%%=============================================================================
%%% Type Safety Gate Tests
%%%=============================================================================

test_gate_type_safety(_State) ->
    Result = erlmcp_quality_gates:gate_type_safety(),

    %% Verify gate structure
    ?assertEqual(type_safety, maps:get(gate, Result)),
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for type safety checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key type safety checks
    ?assert(lists:member(<<"UTF-8 validation">>, CheckNames)),
    ?assert(lists:member(<<"JSON depth limit">>, CheckNames)),
    ?assert(lists:member(<<"String length limits">>, CheckNames)).

%%%=============================================================================
%%% Input Sanitization Gate Tests
%%%=============================================================================

test_gate_input_sanitization(_State) ->
    Result = erlmcp_quality_gates:gate_input_sanitization(),

    %% Verify gate structure
    ?assertEqual(input_sanitization, maps:get(gate, Result)),
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for input sanitization checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key input checks
    ?assert(lists:member(<<"JSON depth <= 20">>, CheckNames)),
    ?assert(lists:member(<<"String <= 1 MB">>, CheckNames)),
    ?assert(lists:member(<<"Array <= 10K elements">>, CheckNames)),
    ?assert(lists:member(<<"URI canonicalization impl">>, CheckNames)).

%%%=============================================================================
%%% Error Handling Gate Tests
%%%=============================================================================

test_gate_error_handling(_State) ->
    Result = erlmcp_quality_gates:gate_error_handling(),

    %% Verify gate structure
    ?assertEqual(error_handling, maps:get(gate, Result)),
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for error handling checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key error checks
    ?assert(lists:member(<<"Error -32700 (parse)">>, CheckNames)),
    ?assert(lists:member(<<"Error -32600 (invalid request)">>, CheckNames)),
    ?assert(lists:member(<<"Timeout enforcement">>, CheckNames)),
    ?assert(lists:member(<<"Circuit breaker">>, CheckNames)).

%%%=============================================================================
%%% Protocol Compliance Gate Tests
%%%=============================================================================

test_gate_protocol_compliance(_State) ->
    Result = erlmcp_quality_gates:gate_protocol_compliance(),

    %% Verify gate structure
    ?assertEqual(protocol_compliance, maps:get(gate, Result)),
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for protocol compliance checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key protocol checks
    ?assert(lists:member(<<"Initialize first">>, CheckNames)),
    ?assert(lists:member(<<"Request ID correlation">>, CheckNames)),
    ?assert(lists:member(<<"Capability negotiation">>, CheckNames)),
    ?assert(lists:member(<<"TCP framing">>, CheckNames)).

%%%=============================================================================
%%% OTP Patterns Gate Tests
%%%=============================================================================

test_gate_otp_patterns(_State) ->
    Result = erlmcp_quality_gates:gate_otp_patterns(),

    %% Verify gate structure
    ?assertEqual(otp_patterns, maps:get(gate, Result)),
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for OTP pattern checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key OTP checks
    ?assert(lists:member(<<"gen_server callbacks">>, CheckNames)),
    ?assert(lists:member(<<"Supervision tree">>, CheckNames)),
    ?assert(lists:member(<<"Let it crash">>, CheckNames)),
    ?assert(lists:member(<<"Registry registration">>, CheckNames)).

%%%=============================================================================
%%% Testing Gate Tests
%%%=============================================================================

test_gate_testing(_State) ->
    Result = erlmcp_quality_gates:gate_testing(),

    %% Verify gate structure
    ?assertEqual(testing, maps:get(gate, Result)),
    ?assertEqual(true, maps:get(mandatory, Result)),

    %% Check for testing checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key testing checks
    ?assert(lists:member(<<"Coverage >= 80%">>, CheckNames)),
    ?assert(lists:member(<<"EUnit tests">>, CheckNames)),
    ?assert(lists:member(<<"Common Test suites">>, CheckNames)),
    ?assert(lists:member(<<"TCP tested">>, CheckNames)).

%%%=============================================================================
%%% Performance Gate Tests
%%%=============================================================================

test_gate_performance(_State) ->
    Result = erlmcp_quality_gates:gate_performance(),

    %% Verify gate structure
    ?assertEqual(performance, maps:get(gate, Result)),
    %% Performance gate is advisory
    ?assertEqual(false, maps:get(mandatory, Result)),

    %% Check for performance checks
    Checks = maps:get(checks, Result),
    CheckNames = [maps:get(check, C) || C <- Checks],

    %% Verify key performance checks
    ?assert(lists:member(<<"p50 < 100us">>, CheckNames)),
    ?assert(lists:member(<<"Throughput > 40K msg/sec">>, CheckNames)),
    ?assert(lists:member(<<"40K concurrent connections">>, CheckNames)).

%%%=============================================================================
%%% Report Generation Tests
%%%=============================================================================

test_generate_report(_State) ->
    %% Run gates and generate report
    GateResults = erlmcp_quality_gates:run_all_gates(),
    Report = erlmcp_quality_gates:generate_report(GateResults),

    %% Verify report structure
    ?assert(maps:is_key(overall_status, Report)),
    ?assert(maps:is_key(mandatory_gates, Report)),
    ?assert(maps:is_key(advisory_gates, Report)),
    ?assert(maps::is_key(blockers, Report)),
    ?assert(maps:is_key(gate_results, Report)),
    ?assert(maps:is_key(timestamp, Report)),

    %% Verify mandatory gates structure
    Mandatory = maps:get(mandatory_gates, Report),
    ?assert(maps:is_key(total, Mandatory)),
    ?assert(maps:is_key(passed, Mandatory)),
    ?assert(maps:is_key(failed, Mandatory)),

    %% Verify advisory gates structure
    Advisory = maps:get(advisory_gates, Report),
    ?assert(maps:is_key(total, Advisory)),
    ?assert(maps:is_key(passed, Advisory)).

test_format_report(_State) ->
    %% Generate a test report
    TestReport = #{
        overall_status => pass,
        mandatory_gates => #{
            total => 7,
            passed => 7,
            failed => 0
        },
        advisory_gates => #{
            total => 1,
            passed => 1
        },
        blockers => [],
        gate_results => [],
        timestamp => erlang:system_time(second)
    },

    Formatted = erlmcp_quality_gates:format_report(TestReport),

    %% Verify report is a binary
    ?assert(is_binary(Formatted)),
    ?assert(byte_size(Formatted) > 0),

    %% Verify report contains expected sections
    ?assert(<<>> /= binary:match(Formatted, <<"QUALITY GATES REPORT">>)),
    ?assert(<<>> /= binary:match(Formatted, <<"Overall Status">>)),
    ?assert(<<>> /= binary:match(Formatted, <<"Mandatory Gates">>)).

%%%=============================================================================
%%% Check Result Tests
%%%=============================================================================

check_result_types_test_() ->
    %% Test that check results have proper structure
    Result = erlmcp_quality_gates:run_gate(security),
    Checks = maps:get(checks, Result),

    lists:foreach(fun(Check) ->
        ?assert(maps:is_key(check, Check)),
        ?assert(maps:is_key(status, Check)),
        ?assert(maps:is_key(details, Check)),

        Status = maps:get(status, Check),
        ?assert(lists:member(Status, [pass, fail, warning, skip]))
    end, Checks).

check_status_values_test_() ->
    %% Test that all gate statuses are valid
    Results = erlmcp_quality_gates:run_all_gates(),

    lists:foreach(fun(Result) ->
        Status = maps:get(status, Result),
        ?assert(lists:member(Status, [pass, fail, warning]))
    end, Results).

%%%=============================================================================
%%% Edge Case Tests
%%%=============================================================================

unknown_gate_test_() ->
    %% Test handling of unknown gate (should not crash)
    ?assertMatch({error, unknown_gate},
                 catch erlmcp_quality_gates:run_gate(unknown_gate)).

empty_report_test_() ->
    %% Test formatting with minimal data
    EmptyReport = #{
        overall_status => pass,
        mandatory_gates => #{total => 0, passed => 0, failed => 0},
        advisory_gates => #{total => 0, passed => 0},
        blockers => [],
        gate_results => [],
        timestamp => 0
    },
    Formatted = erlmcp_quality_gates:format_report(EmptyReport),
    ?assert(is_binary(Formatted)),
    ?assert(byte_size(Formatted) > 0).

all_fail_gates_test_() ->
    %% Test report with all gates failed
    FailResults = [
        #{gate => security, status => fail, mandatory => true,
          checks => [], pass_count => 0, fail_count => 1,
          warning_count => 0, blockers => [<<"Security failed">>],
          timestamp => 0}
    ],
    Report = erlmcp_quality_gates:generate_report(FailResults),
    ?assertEqual(fail, maps:get(overall_status, Report)),
    ?assertEqual([<<"Security failed">>], maps:get(blockers, Report)).
