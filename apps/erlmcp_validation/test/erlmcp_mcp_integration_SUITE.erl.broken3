test_sampling_different_models(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing sampling/create with different models"),

    %% Test with different model types
    ModelConfigs = [
        #{<<"model">> => <<"claude-3-sonnet-20240229">>, <<"parameters">> => #{<<"temperature">> => 0.8}},
        #{<<"model">> => <<"claude-3-opus-20240229">>, <<"parameters">> => #{<<"temperature">> => 0.6}},
        #{<<"model">> => <<"local-model">>, <<"parameters">> => #{<<"temperature">> => 0.7}}
    ],

    lists:foreach(fun(ModelConfig) ->
        SamplingCall = #{
            <<"method">> => <<"sampling/create">>,
            <<"params">> => ModelConfig
        },

        {ok, Result} = erlmcp_mcp_server:handle_call(SamplingCall, #{}),
        ?assert(map_size(Result) > 0),
        ?assert(maps:is_key(<<"result">>, Result)),
        ?assert(maps:is_key(<<"samplingId">>, Result))
    end, ModelConfigs),

    ct:pal("Sampling with different models test completed"),
    Config.

%%====================================================================
%% Enterprise Feature Tests
%%====================================================================

test_circuit_breaker_under_load(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing circuit breaker under load"),

    %% Create high load scenario
    LoadConfig = #{
        concurrent_requests => 100,
        requests_per_second => 50,
        duration_seconds => 30
    },

    %% Monitor circuit breaker state
    InitialState = erlmcp_circuit_breaker:get_state(),

    %% Execute load test
    LoadResults = execute_load_test(LoadConfig),

    %% Analyze results
    FailureRate = calculate_failure_rate(LoadResults),

    %% Validate circuit breaker behavior
    ?assert(FailureRate < 0.1, "Circuit breaker should prevent cascading failures"),

    %% Check if circuit breaker tripped appropriately
    FinalState = erlmcp_circuit_breaker:get_state(),
    ?assert_not_equal(InitialState, FinalState, "Circuit breaker state should change under load"),

    ct:pal("Circuit breaker load test completed with failure rate: ~p", [FailureRate]),
    Config.

test_connection_pool_efficiency(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing connection pool efficiency"),

    %% Monitor pool metrics
    InitialMetrics = erlmcp_pool:get_metrics(),

    %% Execute parallel requests
    ParallelRequests = lists:seq(1, 50),
    StartTime = erlang:monotonic_time(millisecond),

    Results = lists:map(fun(_) ->
        %% Simulate multiple connection uses
        Connection = erlmcp_pool:get_connection(),
        Result = erlmcp_transport:send(Connection, <<"test">>),
        erlmcp_pool:return_connection(Connection),
        Result
    end, ParallelRequests),

    EndTime = erlang:monotonic_time(millisecond),
    Duration = EndTime - StartTime,

    %% Calculate efficiency metrics
    TotalRequests = length(Results),
    SuccessfulRequests = length([R || R <- Results, R =:= ok]),
    SuccessRate = SuccessfulRequests / TotalRequests,

    AverageTime = Duration / TotalRequests,

    %% Validate efficiency
    ?assert(SuccessRate > 0.95, "Connection pool should have high success rate"),
    ?assert(AverageTime < 100, "Average request time should be < 100ms"),

    %% Check pool metrics after load
    FinalMetrics = erlmcp_pool:get_metrics(),
    ?assert(FinalMetrics#pool_metrics.active_connections > 0, "Pool should be active"),

    ct:pal("Connection pool efficiency test: Success rate=~p, Avg time=~pms",
          [SuccessRate, AverageTime]),
    Config.

test_metrics_emission(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing metrics emission for all operations"),

    %% Clear existing metrics
    erlmcp_metrics:reset(),

    %% Execute various operations
    Operations = [
        fun() -> test_metrics_operation("tools/call") end,
        fun() -> test_metrics_operation("prompts/get") end,
        fun() -> test_metrics_operation("resources/read") end,
        fun() -> test_metrics_operation("roots/list") end,
        fun() -> test_metrics_operation("sampling/create") end
    ],

    %% Execute all operations
    lists:foreach(fun(Operation) -> Operation() end, Operations),

    %% Collect metrics
    Metrics = erlmcp_metrics:get_all_metrics(),

    %% Validate metrics structure
    ?assert(is_map(Metrics), "Metrics should be a map"),
    ?assert(map_size(Metrics) > 0, "Should have collected metrics"),

    %% Check specific metrics
    ExpectedMetrics = [
        "mcp_requests_total",
        "mcp_requests_duration",
        "mcp_errors_total",
        "mcp_tools_calls",
        "mcp_prompts_get",
        "mcp_resources_read",
        "mcp_roots_list",
        "mcp_sampling_create"
    ],

    lists:foreach(fun(MetricName) ->
        ?assert(maps:is_key(MetricName, Metrics),
                "Missing expected metric: " ++ binary_to_list(MetricName))
    end, ExpectedMetrics),

    ct:pal("Metrics emission test completed, collected ~p metrics", [map_size(Metrics)]),
    Config.

test_metrics_operation(Operation) ->
    Call = #{
        <<"method">> => Operation,
        <<"params">> => #{}
    },

    {ok, _Result} = erlmcp_mcp_server:handle_call(Call, #{}),
    ok.

test_distributed_registry(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing distributed registry across cluster nodes"),

    %% Assume we have a cluster setup for testing
    Nodes = [node() | nodes()],
    ?assert(length(Nodes) > 1, "Should have multiple nodes in cluster"),

    %% Register a resource on each node
    RegistrationResults = lists:map(fun(Node) ->
        rpc:call(Node, erlmcp_registry, register, [
            <<"test_resource">>,
            test_resource_info()
        ])
    end, Nodes),

    %% Verify registration across nodes
    lists:foreach(fun(Result) ->
        ?assert(Result =:= ok, "Resource registration should succeed on all nodes")
    end, RegistrationResults),

    %% Check registry consistency
    RegistryContents = lists:map(fun(Node) ->
        rpc:call(Node, erlmcp_registry, list, [])
    end, Nodes),

    %% All registries should be consistent
    UniqueContents = lists:usort(RegistryContents),
    ?assert(length(UniqueContents) =:= 1, "All registries should be identical"),

    %% Cleanup
    lists:foreach(fun(Node) ->
        rpc:call(Node, erlmcp_registry, unregister, [<<"test_resource">>])
    end, Nodes),

    ct:pal("Distributed registry test completed successfully"),
    Config.

test_auth_middleware_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing auth middleware integration"),

    %% Test requests with and without authentication
    TestCases = [
        {<<"tools/call">>, #{}, expected_unauthorized},
        {<<"prompts/get">>, #{}, expected_unauthorized},
        {<<"tools/call">>, #{<<"auth">> => <<"valid_token">>}, expected_success},
        {<<"prompts/get">>, #{<<"auth">> => <<"valid_token">>}, expected_success}
    ],

    lists:foreach(fun({Method, Params, Expected}) ->
        Call = #{
            <<"method">> => Method,
            <<"params">> => Params
        },

        case erlmcp_mcp_server:handle_call(Call, #{}) of
            {ok, _Result} when Expected =:= expected_success ->
                ok;
            {error, #{<<"code">> := Code}} when Expected =:= expected_unauthorized ->
                ?assert(Code =:= 401, "Should return 401 for unauthorized access");
            _ ->
                ct:fail("Unexpected response for " ++ binary_to_list(Method))
        end
    end, TestCases),

    ct:pal("Auth middleware integration test completed"),
    Config.

%%====================================================================
%% End-to-End Flow Tests
%%====================================================================

test_complete_mcp_protocol_compliance(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing complete MCP protocol compliance"),

    %% Test full MCP protocol sequence
    ProtocolSequence = [
        fun() -> register_test_resources() end,
        fun() -> execute_workflow_sequence() end,
        fun() -> cleanup_test_resources() end
    ],

    %% Execute protocol sequence
    lists:foreach(fun(Step) -> Step() end, ProtocolSequence),

    %% Validate all steps completed successfully
    ct:pal("Complete MCP protocol compliance test passed"),
    Config.

register_test_resources() ->
    %% Register test resources
    erlmcp_registry:register(<<"test_resource_1">>, test_resource_info()),
    erlmcp_registry:register(<<"test_resource_2">>, test_resource_info()),
    ok.

execute_workflow_sequence() ->
    %% Execute a complete workflow
    Steps = [
        #{
            <<"method">> => <<"tools/call">>,
            <<"params">> => #{
                <<"name">> => <<"data_processor">>,
                <<"arguments">> => #{<<"input">> => "test data"}
            }
        },
        #{
            <<"method">> => <<"prompts/get">>,
            <<"params">> => #{
                <<"name">> => <<"workflow_template">>,
                <<"arguments">> => #{<<"context">> => "workflow"}
            }
        },
        #{
            <<"method">> => <<"resources/read">>,
            <<"params">> => #{
                <<"uri">> => <<"file:///test/data.json">>,
                <<"mimeType">> => <<"application/json">>
            }
        }
    ],

    lists:foreach(fun(Step) ->
        {ok, _} = erlmcp_mcp_server:handle_call(Step, #{}),
        ok
    end, Steps),
    ok.

cleanup_test_resources() ->
    %% Cleanup test resources
    erlmcp_registry:unregister(<<"test_resource_1">>),
    erlmcp_registry:unregister(<<"test_resource_2">>),
    ok.

test_enterprise_features_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing enterprise features integration"),

    %% Test integration of multiple enterprise features
    IntegrationTest = fun() ->
        %% Enable circuit breaker
        erlmcp_circuit_breaker:enable(),

        %% Configure connection pool
        erlmcp_pool:configure(#{size => 10, max_overflow => 5}),

        %% Start metrics collection
        erlmcp_metrics:start_collection(),

        %% Execute a complex operation that uses all features
        ComplexCall = #{
            <<"method">> => <<"tools/call">>,
            <<"params">> => #{
                <<"name">> => <<"enterprise_processor">>,
                <<"arguments">> => #{
                    <<"circuit_breaker">> => true,
                    <<"connection_pool">> => true,
                    <<"metrics_enabled">> => true,
                    <<"distributed_registry">> => true
                }
            }
        },

        {ok, Result} = erlmcp_mcp_server:handle_call(ComplexCall, #{}),
        ?assert(map_size(Result) > 0),

        %% Verify all features were used
        ?assert(maps:is_key(<<"circuit_breaker_status">>, Result)),
        ?assert(maps:is_key(<<"connection_pool_metrics">>, Result)),
        ?assert(maps:is_key(<<"metrics_collected">>, Result)),
        ?assert(maps:is_key(<<"registry_synced">>, Result))
    end,

    %% Execute integration test
    IntegrationTest(),

    %% Cleanup
    erlmcp_circuit_breaker:disable(),
    erlmcp_pool:reset(),
    erlmcp_metrics:stop_collection(),

    ct:pal("Enterprise features integration test completed"),
    Config.

test_failure_scenarios_recovery(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing failure scenarios and recovery"),

    %% Test various failure scenarios
    FailureScenarios = [
        fun() -> test_network_failure() end,
        fun() -> test_resource_unavailable() end,
        fun() -> test_authentication_failure() end,
        fun() -> test_timeout_scenario() end
    ],

    %% Test each failure scenario
    lists:foreach(fun(Scenario) ->
        try
            Scenario(),
            ct:pal("Scenario passed with proper recovery")
        catch
            Error:Reason ->
                ct:fail("Scenario failed: " ++ atom_to_list(Error) ++ ": " ++
                        io_lib:format("~p", [Reason]))
        end
    end, FailureScenarios),

    ct:pal("Failure scenarios and recovery test completed"),
    Config.

test_network_failure() ->
    %% Simulate network failure
    erlmcp_transport:disable_network(),

    %% Attempt operation that should fail gracefully
    Call = #{
        <<"method">> => <<"resources/read">>,
        <<"params">> => #{<<"uri">> => <<"http://unreachable.com/data">>}
    },

    {error, Error} = erlmcp_mcp_server:handle_call(Call, #{}),
    ?assert(maps:is_key(<<"code">>, Error)),

    %% Enable network and verify recovery
    erlmcp_transport:enable_network(),
    ok.

test_resource_unavailable() ->
    %% Test with unavailable resource
    Call = #{
        <<"method">> => <<"resources/read">>,
        <<"params">> => #{<<"uri">> => <<"file:///nonexistent/file.txt">>}
    },

    {error, Error} = erlmcp_mcp_server:handle_call(Call, #{}),
    ?assert(maps:is_key(<<"code">>, Error)),
    ok.

test_authentication_failure() ->
    %% Test with invalid authentication
    Call = #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"secure_tool">>,
            <<"arguments">> => #{},
            <<"auth">> => <<"invalid_token">>
        }
    },

    {error, Error} = erlmcp_mcp_server:handle_call(Call, #{}),
    ?assert(maps:is_key(<<"code">>, Error)),
    ok.

test_timeout_scenario() ->
    %% Set up a slow operation
    SlowCall = #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"slow_operation">>,
            <<"arguments">> => #{<<"delay_ms">> => 5000}
        }
    },

    %% Execute with timeout
    Timeout = 1000,
    StartTime = erlang:monotonic_time(millisecond),

    {error, timeout} = erlmcp_mcp_server:handle_call(SlowCall, #{}),

    EndTime = erlang:monotonic_time(millisecond),
    ActualTimeout = EndTime - StartTime,

    ?assert(ActualTimeout >= Timeout, "Should respect timeout"),
    ok.

test_performance_under_load(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing performance under load"),

    %% Define load test parameters
    LoadParams = #{
        duration => 30000,  % 30 seconds
        requests_per_second => 100,
        concurrent_users => 10
    },

    %% Execute load test
    LoadResults = execute_load_test(LoadParams),

    AnalyzeResults = fun() ->
        Metrics = erlmcp_metrics:get_all_metrics(),

        %% Calculate performance metrics
        TotalRequests = maps:get("mcp_requests_total", Metrics, 0),
        TotalDuration = maps:get("mcp_requests_duration", Metrics, 0),
        AverageLatency = case TotalRequests of
            0 -> 0;
            _ -> TotalDuration / TotalRequests
        end,

        ErrorRate = case maps:get("mcp_errors_total", Metrics, 0) of
            0 -> 0;
            _ -> maps:get("mcp_errors_total", Metrics) / TotalRequests
        end,

        #{
            total_requests => TotalRequests,
            average_latency => AverageLatency,
            error_rate => ErrorRate,
            throughput => TotalRequests / 30  % requests per second
        }
    end,

    PerformanceMetrics = AnalyzeResults(),

    %% Validate performance requirements
    ?assert(PerformanceMetrics#{
        average_latency} < 200,  % Average latency < 200ms
    ?assert(PerformanceMetrics#{
        error_rate} < 0.01,      % Error rate < 1%
    ?assert(PerformanceMetrics#{
        throughput} > 80,        % Throughput > 80 req/s
    ),

    ct:pal("Performance test results: ~p", [PerformanceMetrics]),
    Config.

%%====================================================================
%% Memory and Resource Tests
%%----------------------------------------------------------------------

test_memory_leak_detection(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing memory leak detection"),

    %% Get initial memory usage
    InitialMemory = erlang:memory(total),

    %% Execute operations to test for memory leaks
    Operations = lists:seq(1, 100),

    lists:foreach(fun(_) ->
        %% Perform various MCP operations
        ToolsCall = #{
            <<"method">> => <<"tools/call">>,
            <<"params">> => #{<<"name">> => <<"test_tool">>, <<"arguments">> => #{}}
        },

        {ok, _} = erlmcp_mcp_server:handle_call(ToolsCall, #{}),

        %% Subscribe and unsubscribe to test resource cleanup
        SubscribeCall = #{
            <<"method">> => <<"resources/subscribe">>,
            <<"params">> => #{
                <<"uri">> => <<"file:///test/temp.txt">>,
                <<"mimeType">> => <<"text/plain">>
            }
        },

        {ok, SubscribeResult} = erlmcp_mcp_server:handle_call(SubscribeCall, #{}),
        SubscriptionId = maps:get(<<"subscriptionId">>, SubscribeResult),

        UnsubscribeCall = #{
            <<"method">> => <<"resources/unsubscribe">>,
            <<"params">> => #{<<"subscriptionId">> => SubscriptionId}
        },

        {ok, _} = erlmcp_mcp_server:handle_call(UnsubscribeCall, #{}),

        ok
    end, Operations),

    %% Force garbage collection
    erlang:garbage_collect(),

    %% Get final memory usage
    FinalMemory = erlang:memory(total),
    MemoryIncrease = FinalMemory - InitialMemory,

    %% Validate memory increase is minimal
    AllowedIncrease = 10 * 1024 * 1024,  % 10MB
    ?assert(MemoryIncrease < AllowedIncrease,
            "Memory leak detected: increase of ~p bytes", [MemoryIncrease]),

    ct:pal("Memory leak detection test: ~p bytes increase", [MemoryIncrease]),
    Config.

test_process_supervision(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing process supervision"),

    %% Monitor supervised processes
    ProcessCount = erlang:system_info(process_count),

    %% Create test operations that spawn processes
    TestOperations = lists:seq(1, 20),

    lists:foreach(fun(_) ->
        %% Simulate operation that spawns supervised processes
        erlmcp_tasks:create_task(#{
            name => test_task,
            operation => spawn_test_process
        }),

        %% Clean up after test
        receive
            after 1000 -> ok
        end,
        ok
    end, TestOperations),

    %% Wait for processes to finish
    timer:sleep(2000),

    %% Check process count
    NewProcessCount = erlang:system_info(process_count),
    ProcessDifference = abs(NewProcessCount - ProcessCount),

    %% Validate process cleanup
    ?assert(ProcessDifference < 10,
            "Process supervision failed: ~p processes remain", [ProcessDifference]),

    ct:pal("Process supervision test: ~p process difference", [ProcessDifference]),
    Config.

test_resource_cleanup(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing resource cleanup"),

    %% Create test resources
    ResourceIds = lists:seq(1, 10),

    lists:foreach(fun(Id) ->
        ResourceId = list_to_binary("test_resource_" ++ integer_to_list(Id)),
        erlmcp_registry:register(ResourceId, test_resource_info()),
        ok
    end, ResourceIds),

    %% Verify resources were created
    RegisteredResources = erlmcp_registry:list(),
    ?assert(length(RegisteredResources) >= 10, "Resources should be registered"),

    %% Clean up resources
    lists:foreach(fun(Id) ->
        ResourceId = list_to_binary("test_resource_" ++ integer_to_list(Id)),
        erlmcp_registry:unregister(ResourceId),
        ok
    end, ResourceIds),

    %% Verify cleanup
    FinalResources = erlmcp_registry:list(),
    ?assert(length(FinalResources) < 10, "Resources should be cleaned up"),

    ct:pal("Resource cleanup test completed"),
    Config.

%%====================================================================
%% Specification Compliance Tests
%%====================================================================

test_mcp_spec_required_methods(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing MCP specification required methods"),

    %% List of required MCP methods according to specification
    RequiredMethods = [
        <<"tools/call">>,
        <<"prompts/get">>,
        <<"resources/read">>,
        <<"resources/subscribe">>,
        <<"resources/unsubscribe">>,
        <<"roots/list">>,
        <<"sampling/create">>
    ],

    %% Test each required method exists and is callable
    lists:foreach(fun(Method) ->
        Call = #{
            <<"method">> => Method,
            <<"params">> => #{}
        },

        case erlmcp_mcp_server:handle_call(Call, #{}) of
            {ok, Result} ->
                ?assert(map_size(Result) > 0, "Method " ++ binary_to_list(Method) ++ " should return result"),
                ?assert(maps:is_key(<<"result">>, Result),
                        "Method " ++ binary_to_list(Method) ++ " should have result field");
            {error, Error} ->
                case Method of
                    <<"resources/subscribe">> ->
                        %% Subscribe might legitimately fail if no resources available
                        ct:pal("Subscribe failed (expected): ~p", [Error]);
                    _ ->
                        ct:fail("Method " ++ binary_to_list(Method) ++ " failed: ~p", [Error])
                end
        end
    end, RequiredMethods),

    ct:pal("MCP specification required methods test completed"),
    Config.

test_response_format_compliance(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing MCP response format compliance"),

    %% Test response format for various methods
    FormatTests = [
        {<<"tools/call">>, #{<<"name">> => <<"test">>, <<"arguments">> => #{}}},
        {<<"prompts/get">>, #{<<"name">> => <<"test">>, <<"arguments">> => #{}}},
        {<<"resources/read">>, #{<<"uri">> => <<"test://">>, <<"mimeType">> => <<"text/plain">>}},
        {<<"roots/list">>, #{}}
    ],

    lists:foreach(fun({Method, Params}) ->
        Call = #{
            <<"method">> => Method,
            <<"params">> => Params
        },

        {ok, Response} = erlmcp_mcp_server:handle_call(Call, #{}),

        %% Validate response structure
        ?assert(is_map(Response), "Response should be a map"),
        ?assert(maps:is_key(<<"result">>, Response), "Response should have result field"),
        ?assert(maps:is_key(<<"jsonrpc">>, Response), "Response should have jsonrpc field"),
        ?assert(maps:is_key(<<"id">>, Response), "Response should have id field"),

        %% Validate content format
        Result = maps:get(<<"result">>, Response),
        validate_result_format(Method, Result)
    end, FormatTests),

    ct:pal("MCP response format compliance test completed"),
    Config.

validate_result_format(Method, Result) ->
    case Method of
        <<"tools/call">> ->
            ?assert(is_list(maps:get(<<"content">>, Result, [])));
        <<"prompts/get">> ->
            ?assert(is_map(maps:get(<<"description">>, Result, #{}))),
            ?assert(is_list(maps:get(<<"variables">>, Result, []))),
            ?assert(is_list(maps:get(<<"messages">>, Result, [])));
        <<"resources/read">> ->
            ?assert(is_list(maps:get(<<"contents">>, Result, []))),
            ?assert(is_binary(maps:get(<<"mimeType">>, Result, <<>>)));
        <<"roots/list">> ->
            ?assert(is_list(maps:get(<<"roots">>, Result, []))),
            lists:foreach(fun(Root) ->
                ?assert(is_map(Root)),
                ?assert(maps:is_key(<<"uri">>, Root)),
                ?assert(maps:is_key(<<"name">>, Root))
            end, maps:get(<<"roots">>, Result, []));
        _ ->
            ok
    end.

test_error_handling_edge_cases(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing error handling and edge cases"),

    %% Test various error scenarios
    ErrorTests = [
        {<<"tools/call">>, #{<<"name">> => <<"nonexistent_tool">>}, tool_not_found},
        {<<"prompts/get">>, #{<<"name">> => <<"nonexistent_prompt">>}, prompt_not_found},
        {<<"resources/read">>, #{<<"uri">> => <<>>}, invalid_uri},
        {<<"roots/list">>, #{<<"invalid_param">> => true>, invalid_params},
        {<<"sampling/create">>, #{<<"invalid_config">> => true>, invalid_config}
    ],

    lists:foreach(fun({Method, Params, ExpectedError}) ->
        Call = #{
            <<"method">> => Method,
            <<"params">> => Params
        },

        {error, Error} = erlmcp_mcp_server:handle_call(Call, #{}),

        %% Validate error structure
        ?assert(is_map(Error), "Error should be a map"),
        ?assert(maps:is_key(<<"code">>, Error), "Error should have code"),
        ?assert(maps:is_key(<<"message">>, Error), "Error should have message"),

        %% Validate specific error codes
        ErrorCode = maps:get(<<"code">>, Error),
        case ExpectedError of
            tool_not_found ->
                ?assert(ErrorCode =:= -32601, "Tool not found should return -32601");
            prompt_not_found ->
                ?assert(ErrorCode =:= -32601, "Prompt not found should return -32601");
            invalid_uri ->
                ?assert(ErrorCode =:= -32602, "Invalid URI should return -32602");
            invalid_params ->
                ?assert(ErrorCode =:= -32602, "Invalid params should return -32602");
            invalid_config ->
                ?assert(ErrorCode =:= -32602, "Invalid config should return -32602");
            _ ->
                ok
        end
    end, ErrorTests),

    %% Test edge case: missing method
    MissingMethodCall = #{<<"params">> => #{}},
    {error, MissingMethodError} = erlmcp_mcp_server:handle_call(MissingMethodCall, #{}),
    ?assert(maps:get(<<"code">>, MissingMethodError) =:= -32601),

    %% Test edge case: malformed JSON
    MalformedCall = #{<<"method">> => <<"invalid_json">>},
    {error, MalformedError} = erlmcp_mcp_server:handle_call(MalformedCall, #{}),
    ?assert(maps:get(<<"code">>, MalformedError) =:= -32700),

    ct:pal("Error handling edge cases test completed"),
    Config.

%%====================================================================
%% Helper Functions
%%====================================================================

create_test_data() ->
    #{
        test_resources => [
            #{name => calculator, type => function},
            #{name => json_validator, type => function},
            #{name => file_reader, type => function},
            #{name => http_client, type => function}
        ],
        test_prompts => [
            #{name => test_template, variables => [user_input]},
            #{name => complex_analysis, variables => [data, context, threshold, max_iterations]}
        ],
        test_sampling_configs => [
            #{model => claude-3-sonnet-20240229, temperature => 0.7},
            #{model => claude-3-opus-20240229, temperature => 0.6},
            #{model => local-model, temperature => 0.7}
        ]
    }.

cleanup_test_data(TestData) ->
    %% Cleanup any test data that was created
    ok.

test_resource_info() ->
    #{
        uri => <<"test://resource">>,
        name => <<"test_resource">>,
        description => <<"Test resource for integration">>,
        capabilities => [read, write],
        mimeType => <<"application/json">>
    }.

execute_load_test(LoadConfig) ->
    #{concurrent_requests := ConcReq, requests_per_second := RPS, duration := Duration} = LoadConfig,

    Results = [],

    StartTime = erlang:monotonic_time(millisecond),

    spawn(fun() ->
        load_test_worker(Results, ConcReq, RPS, StartTime, StartTime + Duration)
    end),

    %% Wait for test to complete
    receive
        after Duration + 5000 -> ok
    end,

    Results.

load_test_worker(Results, ConcReq, RPS, StartTime, EndTime) ->
    CurrentTime = erlang:monotonic_time(millisecond),

    if CurrentTime >= EndTime ->
        load_test_complete(Results);
    true ->
        %% Calculate how many requests to send in this batch
        TimeElapsed = CurrentTime - StartTime,
        TimeRemaining = EndTime - CurrentTime,

        if TimeRemaining > 0 ->
            RequestRate = RPS * TimeRemaining / (TimeElapsed + TimeRemaining),
            BatchSize = erlang:max(1, floor(RequestRate / 10)),  % Send batches every 100ms

            BatchResults = load_test_batch(BatchSize, CurrentTime),
            load_test_worker(Results ++ BatchResults, ConcReq, RPS, StartTime, EndTime);
        true ->
            load_test_complete(Results)
        end
    end.

load_test_batch(BatchSize, CurrentTime) ->
    BatchResults = [],

    load_test_batch_worker(BatchSize, CurrentTime, BatchResults).

load_test_batch_worker(0, _CurrentTime, Results) ->
    Results;

load_test_batch_worker(Count, CurrentTime, Results) ->
    %% Perform a test request
    TestCall = #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"test_load">>,
            <<"arguments">> => #{<<"timestamp">> => CurrentTime}
        }
    },

    StartTime = erlang:monotonic_time(millisecond),
    Result = erlmcp_mcp_server:handle_call(TestCall, #{}),
    EndTime = erlang:monotonic_time(millisecond),

    TestResult = #{
        request_id => Count,
        timestamp => CurrentTime,
        result => Result,
        duration => EndTime - StartTime,
        success => case Result of
            {ok, _} -> true;
            {error, _} -> false
        end
    },

    load_test_batch_worker(Count - 1, CurrentTime, Results ++ [TestResult]).

load_test_complete(Results) ->
    %% Send completion signal
    self() ! {load_test_complete, Results},
    ok.

calculate_failure_rate(Results) ->
    TotalRequests = length(Results),
    if TotalRequests =:= 0 ->
        0;
    true ->
        FailedRequests = length([R || R <- Results, maps:get(success, R) =:= false]),
        FailedRequests / TotalRequests
    end.