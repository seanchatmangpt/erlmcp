test_resources_read_different_content(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing resources/read with different content types"),

    %% Test different content types
    ContentTypes = [
        {<<"text/plain">>, <<"file:///test/plain.txt">>},
        {<<"application/json">>, <<"file:///test/data.json">>},
        {<<"image/png">>, <<"file:///test/image.png">>},
        {<<"application/pdf">>, <<"file:///test/document.pdf">>}
    ],

    lists:foreach(fun({MimeType, Uri}) ->
        ResourceCall = #{
            <<"method">> => <<"resources/read">>,
            <<"params">> => #{
                <<"uri">> => Uri,
                <<"mimeType">> => MimeType
            }
        },

        {ok, Result} = erlmcp_mcp_server:handle_call(ResourceCall, #{}),
        ?assert(map_size(Result) > 0),
        ?assert(maps:is_key(<<"result">>, Result)),
        ?assert(maps:is_key(<<"contents">>, Result)),
        ?assert(maps:is_key(<<"mimeType">>, Result))
    end, ContentTypes),

    ct:pal("Resources/read with different content types test completed"),
    Config.

test_resources_subscribe_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Starting resources/subscribe integration test"),

    %% Test subscription to resource
    SubscribeCall = #{
        <<"method">> => <<"resources/subscribe">>,
        <<"params">> => #{
            <<"uri">> => <<"file:///test/live.txt">>,
            <<"mimeType">> => <<"text/plain">>,
            <<"options">> => #{<<"subscribe">> => true}
        }
    },

    {ok, Result} = erlmcp_mcp_server:handle_call(SubscribeCall, #{}),

    %% Validate response structure
    ?assert(map_size(Result) > 0),
    ?assert(maps:is_key(<<"result">>, Result)),
    ?assert(maps:is_key(<<"subscriptionId">>, Result)),
    ?assert(maps:is_key(<<"uri">>, Result)),

    SubscriptionId = maps:get(<<"subscriptionId">>, Result),
    ?assert(is_binary(SubscriptionId)),

    ct:pal("Resources/subscribe integration test completed"),
    Config.

test_resources_unsubscribe_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Starting resources/unsubscribe integration test"),

    %% First subscribe to get a subscription ID
    SubscribeCall = #{
        <<"method">> => <<"resources/subscribe">>,
        <<"params">> => #{
            <<"uri">> => <<"file:///test/live.txt">>,
            <<"mimeType">> => <<"text/plain">>,
            <<"options">> => #{<<"subscribe">> => true}
        }
    },

    {ok, SubscribeResult} = erlmcp_mcp_server:handle_call(SubscribeCall, #{}),
    SubscriptionId = maps:get(<<"subscriptionId">>, SubscribeResult),

    %% Now unsubscribe
    UnsubscribeCall = #{
        <<"method">> => <<"resources/unsubscribe">>,
        <<"params">> => #{
            <<"subscriptionId">> => SubscriptionId
        }
    },

    {ok, UnsubscribeResult} = erlmcp_mcp_server:handle_call(UnsubscribeCall, #{}),

    %% Validate response
    ?assert(map_size(UnsubscribeResult) > 0),
    ?assert(maps:is_key(<<"result">>, UnsubscribeResult)),
    ?assert(maps:is_key(<<"subscriptionId">>, UnsubscribeResult)),
    ?assert(maps:is_key(<<"success">>, UnsubscribeResult)),

    ct:pal("Resources/unsubscribe integration test completed"),
    Config.

test_roots_list_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Starting roots/list integration test"),

    %% Test roots listing
    RootsCall = #{
        <<"method">> => <<"roots/list">>,
        <<"params">> => #{}
    },

    {ok, Result} = erlmcp_mcp_server:handle_call(RootsCall, #{}),

    %% Validate response structure
    ?assert(map_size(Result) > 0),
    ?assert(maps:is_key(<<"result">>, Result)),
    ?assert(maps:is_key(<<"roots">>, Result)),

    Roots = maps:get(<<"roots">>, Result),
    ?assert(is_list(Roots)),
    ?assert(length(Roots) > 0),

    %% Validate root structure
    FirstRoot = lists:nth(1, Roots),
    ?assert(maps:is_key(<<"uri">>, FirstRoot)),
    ?assert(maps:is_key(<<"name">>, FirstRoot)),
    ?assert(maps:is_key(<<"description">>, FirstRoot)),

    ct:pal("Roots/list integration test completed"),
    Config.

