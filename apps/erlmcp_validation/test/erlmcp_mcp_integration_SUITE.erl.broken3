%%%-------------------------------------------------------------------
%%% @doc
%%% Integration test suite for MCP protocol compliance
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_mcp_integration_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("eunit/include/eunit.hrl").
-include("erlmcp_server_types.hrl").

-export([all/0, groups/0, init_per_suite/1, end_per_suite/1]).
-export([init_per_group/2, end_per_group/2]).
-export([
    %% MCP Method Tests
    test_tools_call_integration/1,
    test_tools_call_with_different_types/1,
    test_prompts_get_integration/1,
    test_prompts_get_with_rendering/1,
    test_resources_read_integration/1,
    test_resources_read_different_content/1,
    test_resources_subscribe_integration/1,
    test_resources_unsubscribe_integration/1,
    test_roots_list_integration/1,
    test_sampling_create_integration/1,
    test_sampling_different_models/1,

    %% Enterprise Feature Tests
    test_circuit_breaker_under_load/1,
    test_connection_pool_efficiency/1,
    test_metrics_emission/1,
    test_distributed_registry/1,
    test_auth_middleware_integration/1,

    %% End-to-End Flow Tests
    test_complete_mcp_protocol_compliance/1,
    test_enterprise_features_integration/1,
    test_failure_scenarios_recovery/1,
    test_performance_under_load/1,

    %% Memory and Resource Tests
    test_memory_leak_detection/1,
    test_process_supervision/1,
    test_resource_cleanup/1,

    %% Specification Compliance Tests
    test_mcp_spec_required_methods/1,
    test_response_format_compliance/1,
    test_error_handling_edge_cases/1
]).

%%====================================================================
%% Test configuration
%%====================================================================

all() ->
    [
        {group, mcp_methods},
        {group, enterprise_features},
        {group, end_to_end_flows},
        {group, memory_resources},
        {group, specification_compliance}
    ].

groups() ->
    [
        {mcp_methods, [], [
            test_tools_call_integration,
            test_tools_call_with_different_types,
            test_prompts_get_integration,
            test_prompts_get_with_rendering,
            test_resources_read_integration,
            test_resources_read_different_content,
            test_resources_subscribe_integration,
            test_resources_unsubscribe_integration,
            test_roots_list_integration,
            test_sampling_create_integration,
            test_sampling_different_models
        ]},
        {enterprise_features, [], [
            test_circuit_breaker_under_load,
            test_connection_pool_efficiency,
            test_metrics_emission,
            test_distributed_registry,
            test_auth_middleware_integration
        ]},
        {end_to_end_flows, [], [
            test_complete_mcp_protocol_compliance,
            test_enterprise_features_integration,
            test_failure_scenarios_recovery,
            test_performance_under_load
        ]},
        {memory_resources, [], [
            test_memory_leak_detection,
            test_process_supervision,
            test_resource_cleanup
        ]},
        {specification_compliance, [], [
            test_mcp_spec_required_methods,
            test_response_format_compliance,
            test_error_handling_edge_cases
        ]}
    ].

%%====================================================================
%% Suite setup/teardown
%%====================================================================

init_per_suite(Config) ->
    %% Start Erlang node with application
    {ok, _} = application:ensure_all_started(erlmcp_core),

    %% Initialize test environment
    TestConfig = #{
        base_url => "http://localhost:8080",
        timeout => 30000,
        retry_count => 3,
        concurrent_requests => 50,
        test_duration => 60000
    },

    %% Initialize monitoring tools
    ok = erlmcp_monitoring:start_test_environment(),

    %% Create test data
    TestData = create_test_data(),

    Config ++ [
        test_config => TestConfig,
        test_data => TestData,
        node_name => node()
    ].

end_per_suite(Config) ->
    %% Clean up test environment
    ok = erlmcp_monitoring:stop_test_environment(),

    %% Stop application
    application:stop(erlmcp_core),

    %% Cleanup
    cleanup_test_data(proplists:get_value(test_data, Config)),

    ok.

%%====================================================================
%% Group setup/teardown
%%====================================================================

init_per_group(_Group, Config) ->
    Config.

end_per_group(_Group, Config) ->
    Config.

%%====================================================================
%% MCP Method Tests
%%====================================================================

test_tools_call_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Starting tools/call integration test"),

    %% Test with basic calculator tool
    ToolCall = #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"calculator">>,
            <<"arguments">> => #{
                <<"expression">> => "2 + 2"
            }
        }
    },

    %% Execute RPC call
    {ok, Result} = erlmcp_mcp_server:handle_call(ToolCall, #{}),

    %% Validate response structure
    ?assert(map_size(Result) > 0),
    ?assert(maps:is_key(<<"result">>, Result)),
    ?assert(maps:is_key(<<"content">>, Result)),

    %% Validate calculation result
    Content = maps:get(<<"content">>, Result),
    ?assert(is_list(Content)),
    ?assert(length(Content) > 0),

    %% Check for expected content
    HasText = lists:any(fun(C) ->
        case C of
            #{<<"type">> := <<"text">>, <<"text">> := Text} ->
                string:find(Text, "4") =/= nomatch;
            _ -> false
        end
    end, Content),

    ?assert(HasText, "Expected calculation result not found"),

    ct:pal("Tools/call integration test completed successfully"),
    Config.

test_tools_call_with_different_types(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing tools/call with different tool types"),

    %% Test with different tool types
    ToolTypes = [
        #{<<"type">> => <<"function">>, <<"name">> => <<"json_validator">>},
        #{<<"type">> => <<"function">>, <<"name">> => <<"file_reader">>},
        #{<<"type">> => <<"function">>, <<"name">> => <<"http_client">>}
    ],

    lists:foreach(fun(ToolType) ->
        ToolCall = #{
            <<"method">> => <<"tools/call">>,
            <<"params">> => ToolType
        },

        {ok, Result} = erlmcp_mcp_server:handle_call(ToolCall, #{}),
        ?assert(map_size(Result) > 0),
        ?assert(maps:is_key(<<"result">>, Result)),
        ?assert(maps:is_key(<<"content">>, Result))
    end, ToolTypes),

    ct:pal("Tools/call with different types test completed"),
    Config.

test_prompts_get_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Starting prompts/get integration test"),

    %% Test with simple prompt template
    PromptCall = #{
        <<"method">> => <<"prompts/get">>,
        <<"params">> => #{
            <<"name">> => <<"test_template">>,
            <<"arguments">> => #{
                <<"user_input">> => "Hello world"
            }
        }
    },

    {ok, Result} = erlmcp_mcp_server:handle_call(PromptCall, #{}),

    %% Validate response structure
    ?assert(map_size(Result) > 0),
    ?assert(maps:is_key(<<"result">>, Result)),
    ?assert(maps:is_key(<<"description">>, Result)),
    ?assert(maps:is_key(<<"variables">>, Result)),
    ?assert(maps:is_key(<<"messages">>, Result)),

    %% Validate content
    Messages = maps:get(<<"messages">>, Result),
    ?assert(is_list(Messages)),
    ?assert(length(Messages) > 0),

    ct:pal("Prompts/get integration test completed"),
    Config.

test_prompts_get_with_rendering(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing prompts/get with argument rendering"),

    %% Test with complex template and multiple arguments
    ComplexPrompt = #{
        <<"method">> => <<"prompts/get">>,
        <<"params">> => #{
            <<"name">> => <<"complex_analysis">>,
            <<"arguments">> => #{
                <<"data">> => #{<<"key">> => <<"value">>},
                <<"context">> => "analysis context",
                <<"threshold">> => 0.85,
                <<"max_iterations">> => 100
            }
        }
    },

    {ok, Result} = erlmcp_mcp_server:handle_call(ComplexPrompt, #{}),

    %% Validate all expected fields are present
    ?assert(maps:is_key(<<"result">>, Result)),
    ?assert(maps:is_key(<<"description">>, Result)),
    ?assert(maps:is_key(<<"variables">>, Result)),
    ?assert(maps:is_key(<<"messages">>, Result)),

    %% Check if arguments were properly rendered
    Messages = maps:get(<<"messages">>, Result),
    MessagesWithRenderedArgs = lists:any(fun(Message) ->
        case Message of
            #{<<"role">> := <<"user">>, <<"content">> := Content} ->
                case Content of
                    #{<<"type">> := <<"text">>, <<"text">> := Text} ->
                        string:find(Text, "value") =/= nomatch;
                    _ -> false
                end;
            _ -> false
        end
    end, Messages),

    ?assert(MessagesWithRenderedArgs, "Expected rendered arguments not found"),

    ct:pal("Prompts/get with rendering test completed"),
    Config.

