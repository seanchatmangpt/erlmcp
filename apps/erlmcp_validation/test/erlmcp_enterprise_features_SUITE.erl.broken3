%%%-------------------------------------------------------------------
%%% @doc
%%% Enterprise features validation test suite
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_enterprise_features_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("eunit/include/eunit.hrl").

-export([all/0, init_per_suite/1, end_per_suite/1]).
-export([
    %% Circuit Breaker Tests
    test_circuit_breaker_basic_functionality/1,
    test_circuit_breaker_state_transitions/1,
    test_circuit_breaker_timeout_handling/1,
    test_circuit_breaker_reset_mechanism/1,

    %% Connection Pool Tests
    test_connection_pool_basic_operations/1,
    test_connection_pool_concurrent_access/1,
    test_connection_pool_timeout_handling/1,
    test_connection_pool_metrics/1,

    %% Metrics Collection Tests
    test_metrics_collection_all_operations/1,
    test_metrics_aggregation/1,
    test_metrics_persistence/1,
    test_metrics_alerting/1,

    %% Distributed Registry Tests
    test_registry_basic_operations/1,
    test_registry_cross_node_operations/1,
    test_registry_consistency/1,
    test_registry_fault_tolerance/1,

    %% Authentication Tests
    test_auth_middleware_basic/1,
    test_auth_middleware_permission_levels/1,
    test_auth_middleware_rate_limiting/1,
    test_auth_middleware_audit_logging/1,

    %% Integration Tests
    test_circuit_breaker_pool_integration/1,
    test_metrics_registry_integration/1,
    test_auth_circuit_breaker_integration/1,
    test_full_enterprise_integration/1
]).

%%====================================================================
%% Test configuration
%%====================================================================

all() ->
    [
        test_circuit_breaker_basic_functionality,
        test_circuit_breaker_state_transitions,
        test_circuit_breaker_timeout_handling,
        test_circuit_breaker_reset_mechanism,

        test_connection_pool_basic_operations,
        test_connection_pool_concurrent_access,
        test_connection_pool_timeout_handling,
        test_connection_pool_metrics,

        test_metrics_collection_all_operations,
        test_metrics_aggregation,
        test_metrics_persistence,
        test_metrics_alerting,

        test_registry_basic_operations,
        test_registry_cross_node_operations,
        test_registry_consistency,
        test_registry_fault_tolerance,

        test_auth_middleware_basic,
        test_auth_middleware_permission_levels,
        test_auth_middleware_rate_limiting,
        test_auth_middleware_audit_logging,

        test_circuit_breaker_pool_integration,
        test_metrics_registry_integration,
        test_auth_circuit_breaker_integration,
        test_full_enterprise_integration
    ].

%%====================================================================
%% Suite setup/teardown
%%====================================================================

init_per_suite(Config) ->
    %% Start the application
    {ok, _} = application:ensure_all_started(erlmcp_core),

    %% Initialize enterprise features
    ok = erlmcp_circuit_breaker:initialize(),
    ok = erlmcp_connection_pool:initialize(),
    ok = erlmcp_metrics:initialize(),
    ok = erlmcp_distributed_registry:initialize(),
    ok = erlmcp_auth:initialize(),

    %% Configure test environment
    TestConfig = #{
        pool_size => 10,
        pool_max_overflow => 5,
        circuit_breaker_threshold => 5,
        circuit_breaker_timeout => 1000,
        metrics_retention => 3600,
        auth_cache_size => 1000,
        cluster_nodes => [node()]
    },

    %% Start monitoring
    ok = erlmcp_monitoring:start_enterprise_test(),

    Config ++ [
        test_config => TestConfig,
        test_start_time => erlang:monotonic_time(millisecond)
    ].

end_per_suite(Config) ->
    %% Stop monitoring
    ok = erlmcp_monitoring:stop_enterprise_test(),

    %% Cleanup enterprise features
    erlmcp_circuit_breaker:cleanup(),
    erlmcp_connection_pool:cleanup(),
    erlmcp_metrics:cleanup(),
    erlmcp_distributed_registry:cleanup(),
    erlmcp_auth:cleanup(),

    %% Stop application
    application:stop(erlmcp_core),

    ok.

%%====================================================================
%% Circuit Breaker Tests
%%====================================================================

test_circuit_breaker_basic_functionality(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing circuit breaker basic functionality"),

    %% Enable circuit breaker
    erlmcp_circuit_breaker:enable(),

    %% Test normal operation
    NormalResults = lists:map(fun(_) ->
        erlmcp_circuit_breaker:execute(success_operation)
    end, lists:seq(1, 10)),

    %% All should succeed
    lists:foreach(fun(Result) ->
        ?assertEqual(ok, Result)
    end, NormalResults),

    %% Simulate failures
    FailureResults = lists:map(fun(_) ->
        erlmcp_circuit_breaker:execute(failure_operation)
    end, lists:seq(1, 10)),

    %% Should have some failures
    FailedCount = length([R || R <- FailureResults, R =:= error]),
    ?assert(FailedCount > 0, "Should have some failures"),

    ct:pal("Circuit breaker basic functionality test completed"),
    Config.

test_circuit_breaker_state_transitions(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing circuit breaker state transitions"),

    %% Start with closed state
    InitialState = erlmcp_circuit_breaker:get_state(),
    ?assertEqual(closed, InitialState),

    %% Simulate failures to trip breaker
    lists:foreach(fun(_) ->
        erlmcp_circuit_breaker:execute(failure_operation)
    end, lists:seq(1, 5)),

    %% Should be in open state
    OpenState = erlmcp_circuit_breaker:get_state(),
    ?assertEqual(open, OpenState),

    %% Wait for half-open timeout
    timer:sleep(2000),

    %% Try a request in half-open state
    HalfOpenResult = erlmcp_circuit_breaker:execute(success_operation),
    ?assertEqual(ok, HalfOpenResult),

    ct:pal("Circuit breaker state transitions test completed"),
    Config.

test_circuit_breaker_timeout_handling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing circuit breaker timeout handling"),

    %% Enable circuit breaker with timeout
    erlmcp_circuit_breaker:configure(#{
        timeout => 500,  % 500ms timeout
        threshold => 3
    }),

    %% Execute slow operation that should timeout
    SlowOpResult = erlmcp_circuit_breaker:execute(slow_operation),
    ?assertEqual(timeout, SlowOpResult),

    %% Check circuit breaker state
    State = erlmcp_circuit_breaker:get_state(),
    ?assertNotEqual(closed, State, "Should have tripped due to timeout"),

    ct:pal("Circuit breaker timeout handling test completed"),
    Config.

test_circuit_breaker_reset_mechanism(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing circuit breaker reset mechanism"),

    %% Trip the circuit breaker
    lists:foreach(fun(_) ->
        erlmcp_circuit_breaker:execute(failure_operation)
    end, lists:seq(1, 5)),

    %% Should be in open state
    ?assertEqual(open, erlmcp_circuit_breaker:get_state()),

    ManuallyReset = erlmcp_circuit_breaker:reset(),
    ?assertEqual(ok, ManuallyReset),

    %% Should be in closed state after reset
    ?assertEqual(closed, erlmcp_circuit_breaker:get_state()),

    ct:pal("Circuit breaker reset mechanism test completed"),
    Config.

%%====================================================================
%% Connection Pool Tests
%%====================================================================

test_connection_pool_basic_operations(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing connection pool basic operations"),

    %% Configure pool
    PoolConfig = #{
        size => 5,
        max_overflow => 2,
        idle_timeout => 30000
    },

    erlmcp_connection_pool:configure(PoolConfig),

    %% Test connection acquisition
    Connections = lists:map(fun(_) ->
        Connection = erlmcp_connection_pool:get_connection(),
        ?assert(is_pid(Connection), "Should return a process"),
        Connection
    end, lists:seq(1, 5)),

    %% Test connection return
    lists:foreach(fun(Connection) ->
        erlmcp_connection_pool:return_connection(Connection),
        ok
    end, Connections),

    ct:pal("Connection pool basic operations test completed"),
    Config.

test_connection_pool_concurrent_access(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing connection pool concurrent access"),

    %% Configure pool
    PoolConfig = #{
        size => 10,
        max_overflow => 5,
        timeout => 1000
    },

    erlmcp_connection_pool:configure(PoolConfig),

    %% Create concurrent workers
    WorkerCount = 20,
    Results = [],

    Pids = lists:map(fun(_) ->
        spawn_link(fun() ->
            connection_worker(WorkerCount, Results)
        end)
    end, lists:seq(1, WorkerCount)),

    %% Wait for all workers to complete
    lists:foreach(fun(Pid) ->
        monitor(process, Pid),
        receive
            {'DOWN', _, process, Pid, _} -> ok
        end
    end, Pids),

    %% Analyze results
    SuccessCount = length([R || R <- Results, R =:= ok]),
    FailureCount = length([R || R <- Results, R =:= error]),

    ?assert(SuccessCount > 0, "Should have successful connections"),
    ?assert(FailureCount < WorkerCount, "Should not fail all connections"),

    ct:pal("Connection pool concurrent access test: ~p success, ~p failures",
          [SuccessCount, FailureCount]),
    Config.

connection_worker(WorkerCount, Results) ->
    case erlmcp_connection_pool:get_connection() of
        {ok, Connection} ->
            %% Use connection
            timer:sleep(100),  % Simulate work

            %% Return connection
            erlmcp_connection_pool:return_connection(Connection),
            WorkerCount ! {self(), ok},
            Results ! {self(), ok};
        {error, timeout} ->
            WorkerCount ! {self(), error},
            Results ! {self(), error}
    end.

test_connection_pool_timeout_handling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing connection pool timeout handling"),

    %% Configure pool with small size and timeout
    PoolConfig = #{
        size => 1,
        max_overflow => 0,
        timeout => 500
    },

    erlmcp_connection_pool:configure(PoolConfig),

    %% Get the only connection
    {ok, Connection1} = erlmcp_connection_pool:get_connection(),

    %% Try to get another connection (should timeout)
    StartTime = erlang:monotonic_time(millisecond),
    {error, timeout} = erlmcp_connection_pool:get_connection(),
    EndTime = erlang:monotonic_time(millisecond),

    %% Verify timeout was respected
    TimeoutElapsed = EndTime - StartTime,
    ?assert(TimeoutElapsed >= 500, "Should respect timeout"),

    %% Return connection and try again
    erlmcp_connection_pool:return_connection(Connection1),

    {ok, Connection2} = erlmcp_connection_pool:get_connection(),
    erlmcp_connection_pool:return_connection(Connection2),

    ct:pal("Connection pool timeout handling test completed"),
    Config.

test_connection_pool_metrics(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing connection pool metrics")

    %% Configure pool
    PoolConfig = #{
        size => 5,
        max_overflow => 2
    },

    erlmcp_connection_pool:configure(PoolConfig),

    %% Get metrics before operations
    InitialMetrics = erlmcp_connection_pool:get_metrics(),

    %% Perform some operations
    lists:map(fun(_) ->
        {ok, Connection} = erlmcp_connection_pool:get_connection(),
        erlmcp_connection_pool:return_connection(Connection)
    end, lists:seq(1, 10)),

    %% Get metrics after operations
    FinalMetrics = erlmcp_connection_pool:get_metrics(),

    %% Verify metrics changed
    ?assert(FinalMetrics#pool_metrics.total_gets > InitialMetrics#pool_metrics.total_gets),
    ?assert(FinalMetrics#pool_metrics.total_returns > InitialMetrics#pool_metrics.total_returns),

    ct:pal("Connection pool metrics test completed"),
    Config.

%%====================================================================
%% Metrics Collection Tests
%%====================================================================

test_metrics_collection_all_operations(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing metrics collection for all operations")

    %% Start metrics collection
    erlmcp_metrics:start_collection(),

    %% Clear existing metrics
    erlmcp_metrics:reset(),

    %% Perform various operations
    Operations = [
        fun() -> erlmcp_circuit_breaker:execute(success_operation) end,
        fun() -> erlmcp_connection_pool:get_connection() end,
        fun() -> erlmcp_registry:list() end,
        fun() -> erlmcp_auth:validate_token(test_token) end
    ],

    lists:foreach(fun(Operation) -> Operation() end, Operations),

    %% Stop collection and get metrics
    erlmcp_metrics:stop_collection(),
    AllMetrics = erlmcp_metrics:get_all_metrics(),

    %% Verify metrics were collected
    ?assert(map_size(AllMetrics) > 0, "Should have collected metrics"),
    ?assert(maps:is_key("circuit_breaker_operations", AllMetrics)),
    ?assert(maps:is_key("connection_pool_operations", AllMetrics)),
    ?assert(maps:is_key("registry_operations", AllMetrics)),
    ?assert(maps:is_key("auth_operations", AllMetrics)),

    ct:pal("Metrics collection test completed, ~p metrics collected",
          [map_size(AllMetrics)]),
    Config.

test_metrics_aggregation(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing metrics aggregation")

    %% Clear metrics
    erlmcp_metrics:reset(),

    %% Perform multiple operations
    lists:map(fun(_) ->
        erlmcp_circuit_breaker:execute(success_operation)
    end, lists:seq(1, 10)),

    %% Get aggregated metrics
    Metrics = erlmcp_metrics:get_aggregated_metrics(#{
        operation => circuit_breaker,
        time_window => 30000  % 30 seconds
    }),

    %% Verify aggregation
    ?assert(is_number(maps:get("count", Metrics, 0))),
    ?assert(is_number(maps:get("average_duration", Metrics, 0))),
    ?assert(is_number(maps:get("success_rate", Metrics, 0))),

    ct:pal("Metrics aggregation test completed"),
    Config.

test_metrics_persistence(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing metrics persistence")

    %% Clear metrics
    erlmcp_metrics:reset(),

    %% Perform some operations
    lists:map(fun(_) ->
        erlmcp_circuit_breaker:execute(success_operation)
    end, lists:seq(1, 5)),

    %% Save metrics
    erlmcp_metrics:save_metrics_to_disk(),

    %% Clear in-memory metrics
    erlmcp_metrics:reset(),

    %% Load metrics from disk
    LoadedMetrics = erlmcp_metrics:load_metrics_from_disk(),

    %% Verify persistence
    ?assert(map_size(LoadedMetrics) > 0, "Should have persisted metrics"),

    ct:pal("Metrics persistence test completed"),
    Config.

test_metrics_alerting(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing metrics alerting")

    %% Configure alerting
    AlertConfig = #{
        operation => "circuit_breaker",
        threshold => 0.5,
        window => 30000,
        callback => fun alert_callback/1
    },

    erlmcp_metrics:configure_alerting(AlertConfig),

    %% Trigger alert condition
    lists:map(fun(_) ->
        erlmcp_circuit_breaker:execute(failure_operation)
    end, lists:seq(1, 10)),

    %% Wait for alert to trigger
    timer:sleep(1000),

    ct:pal("Metrics alerting test completed"),
    Config.

alert_callback(Metrics) ->
    ct:pal("Alert triggered: ~p", [Metrics]),
    ok.

%%====================================================================
%% Distributed Registry Tests
%%====================================================================

test_registry_basic_operations(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing distributed registry basic operations")

    %% Register a resource
    ResourceInfo = #{
        uri => <<"test://resource1">>,
        name => <<"resource1">>,
        description => <<"Test resource">>,
        capabilities => [read, write],
        metadata => #{<<"created">> => erlang:system_time(millisecond)}
    },

    ok = erlmcp_distributed_registry:register(<<"resource1">>, ResourceInfo),

    %% Retrieve the resource
    {ok, RetrievedInfo} = erlmcp_distributed_registry:get(<<"resource1">>),
    ?assertEqual(ResourceInfo, RetrievedInfo),

    ListResult = erlmcp_distributed_registry:list(),
    ?assert(lists:member(<<"resource1">>, ListResult)),

    %% Unregister the resource
    ok = erlmcp_distributed_registry:unregister(<<"resource1">>),

    %% Verify it's gone
    {error, not_found} = erlmcp_distributed_registry:get(<<"resource1">>),

    ct:pal("Registry basic operations test completed"),
    Config.

test_registry_cross_node_operations(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing registry cross-node operations")

    %% Get cluster nodes
    Nodes = [node() | nodes()],
    ?assert(length(Nodes) > 1, "Should have multiple nodes for cross-node test"),

    %% Register on current node
    ResourceInfo = #{
        uri => <<"cross://resource">>,
        name => <<"cross_node_resource">>,
        description => <<"Cross node test resource">>
    },

    ok = erlmcp_distributed_registry:register(<<"cross_node_resource">>, ResourceInfo),

    %% Verify registration on all nodes
    lists:foreach(fun(Node) ->
        case rpc:call(Node, erlmcp_distributed_registry, get,
                     [<<"cross_node_resource">>]) of
            {ok, RetrievedInfo} ->
                ?assertEqual(ResourceInfo, RetrievedInfo);
            {error, not_found} ->
                ct:fail("Resource not found on node: " ++ atom_to_list(Node))
        end
    end, Nodes),

    %% Unregister from current node
    ok = erlmcp_distributed_registry:unregister(<<"cross_node_resource">>),

    %% Verify removal on all nodes
    lists:foreach(fun(Node) ->
        {error, not_found} = rpc:call(Node, erlmcp_distributed_registry, get,
                                     [<<"cross_node_resource">>])
    end, Nodes),

    ct:pal("Registry cross-node operations test completed"),
    Config.

test_registry_consistency(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing registry consistency")

    %% Register multiple resources
    Resources = lists:seq(1, 10),
    lists:foreach(fun(Id) ->
        ResourceId = list_to_binary("resource_" ++ integer_to_list(Id)),
        ResourceInfo = #{
            uri => <<"test://resource_", ResourceId/binary>>,
            name => ResourceId,
            description => <<"Test resource ", ResourceId/binary>>,
            metadata => #{<<"id">> => Id}
        },
        ok = erlmcp_distributed_registry:register(ResourceId, ResourceInfo)
    end, Resources),

    %% Verify consistency across nodes
    Nodes = [node() | nodes()],
    lists:foreach(fun(Node) ->
        NodeResources = rpc:call(Node, erlmcp_distributed_registry, list, []),
        ?assertEqual(Resources, NodeResources, "Registry should be consistent")
    end, Nodes),

    %% Clean up
    lists:foreach(fun(Id) ->
        ResourceId = list_to_binary("resource_" ++ integer_to_list(Id)),
        ok = erlmcp_distributed_registry:unregister(ResourceId)
    end, Resources),

    ct:pal("Registry consistency test completed"),
    Config.

test_registry_fault_tolerance(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing registry fault tolerance")

    %% Register a resource
    ResourceInfo = #{
        uri => <<"fault://resource">>,
        name => <<"fault_tolerant_resource">>,
        description => <<"Fault tolerance test resource">>
    },

    ok = erlmcp_distributed_registry:register(<<"fault_tolerant_resource">>, ResourceInfo),

    %% Get initial list
    InitialList = erlmcp_distributed_registry:list(),

    %% Simulate node failure by stopping a mock node
    FailingNode = get_mock_failing_node(),
    case FailingNode of
        undefined ->
            ct:pal("No mock failing node available");
        _ ->
            %% Registry should continue to function
            ContinueResult = erlmcp_distributed_registry:list(),
            ?assert(lists:member(<<"fault_tolerant_resource">>, ContinueResult),
                    "Registry should continue functioning despite node failure")
    end,

    %% Test get operation with failing node
    case erlmcp_distributed_registry:get(<<"fault_tolerant_resource">>) of
        {ok, RetrievedInfo} ->
            ?assertEqual(ResourceInfo, RetrievedInfo);
        {error, Reason} ->
            ct:fail("Registry failed: ~p", [Reason])
    end,

    ct:pal("Registry fault tolerance test completed"),
    Config.

get_mock_failing_node() ->
    %% In a real scenario, this would identify a failing node
    %% For testing, we return undefined as we don't have multiple nodes
    undefined.

%%====================================================================
%% Authentication Tests
%%====================================================================

test_auth_middleware_basic(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing auth middleware basic functionality")

    %% Test valid token
    ValidToken = generate_valid_token(),
    case erlmcp_auth:validate_token(ValidToken) of
        {ok, Claims} ->
            ?assert(is_map(Claims)),
            ?assert(maps:is_key(<<"sub">>, Claims));
        {error, invalid_token} ->
            ct:fail("Valid token should be accepted")
    end,

    %% Test invalid token
    InvalidToken = <<"invalid_token">>,
    {error, invalid_token} = erlmcp_auth:validate_token(InvalidToken),

    %% Test expired token
    ExpiredToken = generate_expired_token(),
    {error, expired_token} = erlmcp_auth:validate_token(ExpiredToken),

    ct:pal("Auth middleware basic test completed"),
    Config.

test_auth_middleware_permission_levels(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing auth middleware permission levels")

    %% Test tokens with different permission levels
    Tokens = [
        {<<"read_token">>, #{<<"permissions">> => [<<"read">>]}},
        {<<"write_token">>, #{<<"permissions">> => [<<"read", "write">>]}},
        {<<"admin_token">>, #{<<"permissions">> => [<<"read", "write", "admin">>]}}
    ],

    %% Test permission validation
    lists:foreach(fun({Token, ExpectedPerms}) ->
        {ok, Claims} = erlmcp_auth:validate_token(Token),
        UserPerms = maps:get(<<"permissions">>, Claims, []),
        ?assertEqual(ExpectedPerms, UserPerms)
    end, Tokens),

    %% Test permission checking
    AdminToken = <<"admin_token">>,
    ReadToken = <<"read_token">>,

    %% Admin can read
    true = erlmcp_auth:has_permission(AdminToken, <<"read">>),
    %% Admin can write
    true = erlmcp_auth:has_permission(AdminToken, <<"write">>),
    %% Read-only cannot write
    false = erlmcp_auth:has_permission(ReadToken, <<"write">>),

    ct:pal("Auth middleware permission levels test completed"),
    Config.

test_auth_middleware_rate_limiting(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing auth middleware rate limiting")

    %% Configure rate limiting
    RateConfig = #{
        limit => 5,
        window => 1000  % 1 second
    },

    erlmcp_auth:configure_rate_limiting(RateConfig),

    %% Test token validation rate limit
    ValidToken = generate_valid_token(),
    Results = lists:map(fun(_) ->
        erlmcp_auth:validate_token(ValidToken)
    end, lists:seq(1, 10)),

    %% Should have some rate limit errors
    RateLimited = [R || R <- Results, R =:= {error, rate_limited}],
    ?assert(length(RateLimited) > 0, "Should have rate limited requests"),

    ct:pal("Auth middleware rate limiting test completed: ~p rate limited",
          [length(RateLimited)]),
    Config.

test_auth_middleware_audit_logging(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing auth middleware audit logging")

    %% Enable audit logging
    erlmcp_auth:enable_audit_logging(),

    %% Perform various authentication operations
    Tokens = [
        generate_valid_token(),
        generate_expired_token(),
        <<"invalid">>
    ],

    lists:foreach(fun(Token) ->
        _ = erlmcp_auth:validate_token(Token),
        ok
    end, Tokens),

    %% Get audit logs
    AuditLogs = erlmcp_auth:get_audit_logs(),

    %% Verify audit logs
    ?assert(length(AuditLogs) >= 3, "Should have audit logs for all requests"),
    ?assert(lists:any(fun(Log) ->
        maps:get(<<"action">>, Log) =:= "validate_token"
    end, AuditLogs)),

    ct:pal("Auth middleware audit logging test completed: ~p audit logs",
          [length(AuditLogs)]),
    Config.

%%====================================================================
%% Integration Tests
%%====================================================================

test_circuit_breaker_pool_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing circuit breaker and connection pool integration")

    %% Configure both systems
    PoolConfig = #{
        size => 5,
        max_overflow => 2,
        timeout => 1000
    },

    CircuitConfig = #{
        threshold => 3,
        timeout => 2000,
        reset_timeout => 5000
    },

    erlmcp_connection_pool:configure(PoolConfig),
    erlmcp_circuit_breaker:configure(CircuitConfig),
    erlmcp_circuit_breaker:enable(),

    %% Test integration with connection failures
    IntegrationResults = lists:map(fun(_) ->
        case erlmcp_circuit_breaker:execute(connection_failure_operation) of
            ok ->
                %% Get connection from pool
                {ok, Connection} = erlmcp_connection_pool:get_connection(),
                erlmcp_connection_pool:return_connection(Connection),
                success;
            {error, _} ->
                failure
        end
    end, lists:seq(1, 10)),

    %% Analyze integration results
    SuccessCount = length([R || R <- IntegrationResults, R =:= success]),
    FailureCount = length([R || R <- IntegrationResults, R =:= failure]),

    ?assert(SuccessCount > 0, "Should have some successful operations"),
    ?assert(FailureCount > 0, "Should have some failures due to circuit breaker"),

    ct:pal("Integration test results: ~p success, ~p failures",
          [SuccessCount, FailureCount]),
    Config.

test_metrics_registry_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing metrics and registry integration")

    %% Enable metrics collection
    erlmcp_metrics:start_collection(),

    %% Perform registry operations while collecting metrics
    RegistryOperations = [
        fun() -> erlmcp_distributed_registry:register(test_resource, #{}) end,
        fun() -> erlmcp_distributed_registry:get(test_resource) end,
        fun() -> erlmcp_distributed_registry:list() end,
        fun() -> erlmcp_distributed_registry:unregister(test_resource) end
    ],

    lists:foreach(fun(Operation) -> Operation() end, RegistryOperations),

    %% Get metrics for registry operations
    RegistryMetrics = erlmcp_metrics:get_operation_metrics(#{
        operation => "registry",
        time_window => 30000
    }),

    %% Verify registry metrics were collected
    ?assert(is_number(maps:get("count", RegistryMetrics, 0))),
    ?assert(is_number(maps:get("average_duration", RegistryMetrics, 0))),

    ct:pal("Metrics registry integration test completed"),
    Config.

test_auth_circuit_breaker_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing auth and circuit breaker integration")

    %% Enable circuit breaker
    erlmcp_circuit_breaker:enable(),

    %% Configure rate limiting
    RateConfig = #{
        limit => 5,
        window => 1000
    },

    erlmcp_auth:configure_rate_limiting(RateConfig),

    %% Test integration with authentication failures
    IntegrationTest = fun() ->
        case erlmcp_circuit_breaker:execute(auth_failure_operation) of
            ok ->
                case erlmcp_auth:validate_token(invalid_token) of
                    {ok, _} -> auth_success;
                    {error, _} -> auth_failure
                end;
            {error, _} -> circuit_breaker_tripped
        end
    end,

    Results = lists:map(fun(_) -> IntegrationTest() end, lists:seq(1, 10)),

    %% Analyze results
    AuthSuccess = [R || R <- Results, R =:= auth_success],
    AuthFailure = [R || R <- Results, R =:= auth_failure],
    CircuitTripped = [R || R <- Results, R =:= circuit_breaker_tripped],

    ?assert(length(AuthFailure) > 0, "Should have auth failures"),
    ?assert(length(CircuitTripped) > 0, "Should have circuit breaker trips"),

    ct:pal("Auth-circuit breaker integration: ~p auth success, ~p auth failure, ~p circuit trips",
          [length(AuthSuccess), length(AuthFailure), length(CircuitTripped)]),
    Config.

test_full_enterprise_integration(Config) ->
    TestConfig = proplists:get_value(test_config, Config),

    ct:pal("Testing full enterprise integration")

    %% Configure all enterprise features
    EnterpriseConfig = #{
        connection_pool => #{size => 10, max_overflow => 5},
        circuit_breaker => #{threshold => 5, timeout => 1000},
        metrics => #{retention => 3600},
        registry => #{consistency => strong},
        auth => #{rate_limit => #{limit => 10, window => 1000}}
    },

    %% Initialize all systems
    erlmcp_connection_pool:configure(EnterpriseConfig.connection_pool),
    erlmcp_circuit_breaker:configure(EnterpriseConfig.circuit_breaker),
    erlmcp_metrics:start_collection(),
    erlmcp_distributed_registry:initialize(),
    erlmcp_auth:configure_rate_limiting(EnterpriseConfig.auth.rate_limit),
    erlmcp_circuit_breaker:enable(),

    %% Create a complex workflow that uses all features
    ComplexWorkflow = fun() ->
        %% Step 1: Authenticate
        case erlmcp_auth:validate_token(generate_valid_token()) of
            {ok, _} ->
                %% Step 2: Get connection from pool
                case erlmcp_connection_pool:get_connection() of
                    {ok, Connection} ->
                        %% Step 3: Perform operation with circuit breaker
                        case erlmcp_circuit_breaker:execute(complex_operation) of
                            ok ->
                                %% Step 4: Update registry
                                erlmcp_distributed_registry:update(
                                    workflow_state,
                                    #{status => in_progress}
                                ),
                                %% Step 5: Log metrics
                                erlmcp_metrics:record_operation(complex_workflow, success),
                                success;
                            {error, Reason} ->
                                erlmcp_metrics:record_operation(complex_workflow, {error, Reason}),
                                {error, Reason}
                        end;
                    {error, Reason} ->
                        erlmcp_metrics:record_operation(complex_workflow, {error, Reason}),
                        {error, Reason}
                end;
            {error, Reason} ->
                erlmcp_metrics:record_operation(complex_workflow, {error, Reason}),
                {error, Reason}
        end
    end,

    %% Execute workflow multiple times
    WorkflowResults = lists:map(fun(_) -> ComplexWorkflow() end, lists:seq(1, 20)),

    %% Analyze results
    SuccessCount = length([R || R <- WorkflowResults, R =:= success]),
    ErrorCount = length([R || R <- WorkflowResults, R =/= success]),

    %% Validate performance
    ?assert(SuccessCount > 0, "Should have successful operations"),
    ?assert(SuccessCount / length(WorkflowResults) > 0.8,
            "Should have >80% success rate"),

    %% Get final metrics
    FinalMetrics = erlmcp_metrics:get_all_metrics(),
    ?assert(map_size(FinalMetrics) > 0, "Should have collected metrics"),

    ct:pal("Full enterprise integration test: ~p success, ~p errors, ~p metrics collected",
          [SuccessCount, ErrorCount, map_size(FinalMetrics)]),
    Config.

%%====================================================================
%% Helper Functions
%%====================================================================

generate_valid_token() ->
    %% Generate a mock valid token
    base64:encode(<<"valid_token_", erlang:system_time(millisecond):/binary>>).

generate_expired_token() ->
    %% Generate a mock expired token
    base64:encode(<<"expired_token_", erlang:system_time(millisecond) - 86400000:binary>>).