%%%-------------------------------------------------------------------
%%% @doc Policy Enforcer Unit Tests
%%%
%%% EUnit tests for erlmcp_policy_enforcer module
%%% Tests policy evaluation, enforcement actions, and policy lifecycle.
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_policy_enforcer_unit_tests).
-author("erlmcp").

-include_lib("eunit/include/eunit.hrl").

%%%=============================================================================
%%% Test State
%%%=============================================================================

-record(policy_test_state, {
    enforcer_pid :: pid() | undefined
}).

%%%=============================================================================
%%% Setup and Teardown
%%%=============================================================================

setup_policy_enforcer() ->
    {ok, Pid} = erlmcp_policy_enforcer:start_link(#{}),
    #policy_test_state{enforcer_pid = Pid}.

cleanup_policy_enforcer(#policy_test_state{enforcer_pid = Pid}) ->
    catch gen_server:stop(Pid),
    ok.

%%%=============================================================================
%%% Test Generators
%%%=============================================================================

policy_enforcer_test_() ->
    {setup,
     fun setup_policy_enforcer/0,
     fun cleanup_policy_enforcer/1,
     [
      fun test_start_stop/1,
      fun test_add_policy/1,
      fun test_remove_policy/1,
      fun test_evaluate_policy/1,
      fun test_enforce_policy/1,
      fun test_policy_whitelist/1,
      fun test_policy_blacklist/1,
      fun test_resource_limits/1
     ]}.

%%%=============================================================================
%%% Basic Lifecycle Tests
%%%=============================================================================

test_start_stop(_State) ->
    ?assertMatch({ok, _Pid}, erlmcp_policy_enforcer:start_link(#{})),
    ?assert(is_pid(whereis(erlmcp_policy_enforcer))).

test_add_policy(#policy_test_state{enforcer_pid = Pid}) ->
    %% Add a policy
    Policy = #{
        id => <<"test-policy-1">>,
        name => <<"Test Policy">>,
        type => resource_limit,
        rules => [
            #{
                resource => <<"tool">>,
                action => <<"invoke">>,
                limit => 100,
                window => <<"1m">>
            }
        ]
    },

    ?assertEqual(ok, gen_server:call(Pid, {add_policy, Policy})),

    %% Verify policy was added
    Policies = gen_server:call(Pid, get_policies),
    ?assert(length(Policies) > 0).

test_remove_policy(#policy_test_state{enforcer_pid = Pid}) ->
    %% Add then remove a policy
    Policy = #{
        id => <<"remove-policy">>,
        name => <<"Removable Policy">>,
        type => test,
        rules => []
    },

    ok = gen_server:call(Pid, {add_policy, Policy}),
    ?assertEqual(ok, gen_server:call(Pid, {remove_policy, <<"remove-policy">>})),

    %% Verify policy was removed
    Policies = gen_server:call(Pid, get_policies),
    ?assertNot(lists:any(fun(P) -> maps:get(id, P) =:= <<"remove-policy">> end, Policies)).

test_evaluate_policy(#policy_test_state{enforcer_pid = Pid}) ->
    %% Evaluate policy against a request
    Request = #{
        type => tool,
        action => <<"invoke">>,
        tool_name => <<"test_tool">>,
        session_id => <<"session-123">>
    },

    Decision = gen_server:call(Pid, {evaluate, Request}),
    ?assert(is_map(Decision)),
    ?assert(maps:is_key(action, Decision)),
    ?assert(lists:member(maps:get(action, Decision), [allow, deny, throttle])).

test_enforce_policy(#policy_test_state{enforcer_pid = Pid}) ->
    %% Test policy enforcement action
    Policy = #{
        id => <<"enforce-policy">>,
        name => <<"Enforcement Policy">>,
        type => authorization,
        action => deny,
        rules => [#{condition => fun(_) -> false end}]
    },

    ok = gen_server:call(Pid, {add_policy, Policy}),

    %% Test enforcement
    Request = #{type => tool, action => <<"invoke">>},
    Result = gen_server:call(Pid, {enforce, Request}),
    ?assert(is_map(Result)).

test_policy_whitelist(_State) ->
    %% Test whitelist functionality
    Whitelist = [<<"allowed_tool_1">>, <<"allowed_tool_2">>],

    Request = #{tool_name => <<"allowed_tool_1">>},
    Decision = check_whitelist(Whitelist, Request),
    ?assertEqual(allow, Decision),

    %% Test not in whitelist
    Request2 = #{tool_name => <<"blocked_tool">>},
    Decision2 = check_whitelist(Whitelist, Request2),
    ?assertEqual(deny, Decision2).

test_policy_blacklist(_State) ->
    %% Test blacklist functionality
    Blacklist = [<<"blocked_tool_1">>, <<"blocked_tool_2">>],

    Request = #{tool_name => <<"blocked_tool_1">>},
    Decision = check_blacklist(Blacklist, Request),
    ?assertEqual(deny, Decision),

    %% Test not in blacklist
    Request2 = #{tool_name => <<"safe_tool">>},
    Decision2 = check_blacklist(Blacklist, Request2),
    ?assertEqual(allow, Decision2).

test_resource_limits(_State) ->
    %% Test resource limit enforcement
    Limit = #{max_calls => 100, window => <<"1m">>},

    %% Under limit
    ?assertEqual(allow, check_limit(Limit, 50)),
    %% At limit
    ?assertEqual(deny, check_limit(Limit, 100)),
    %% Over limit
    ?assertEqual(deny, check_limit(Limit, 150)).

%%%=============================================================================
%%% Policy Type Tests
%%%=============================================================================

policy_type_test_() ->
    [
      fun test_resource_limit_policy/0,
      fun test_rate_limit_policy/0,
      fun test_authorization_policy/0,
      fun test_content_filter_policy/0
     ].

test_resource_limit_policy() ->
    Policy = #{
        id => <<"resource-limit">>,
        type => resource_limit,
        resource => <<"tool">>,
        limit => 1000,
        period <<"hour">>
    },

    ?assertEqual(resource_limit, maps:get(type, Policy)),
    ?assertEqual(<<"tool">>, maps:get(resource, Policy)).

test_rate_limit_policy() ->
    Policy = #{
        id => <<"rate-limit">>,
        type => rate_limit,
        rate => 100,
        burst => 10,
        window => <<"1m">>
    },

    ?assertEqual(rate_limit, maps:get(type, Policy)),
    ?assert(is_integer(maps:get(rate, Policy))).

test_authorization_policy() ->
    Policy = #{
        id => <<"authz-policy">>,
        type => authorization,
        permissions => [<<"read">>, <<"write">>],
        roles => [<<"admin">>, <<"user">>]
    },

    ?assertEqual(authorization, maps:get(type, Policy)),
    ?assert(is_list(maps:get(permissions, Policy))).

test_content_filter_policy() ->
    Policy = #{
        id => <<"content-filter">>,
        type => content_filter,
        rules => [
            #{field => <<"input">>, pattern => <<"safe.*">>},
            #{field => <<"output">>, pattern => <<".*safe">>}
        ]
    },

    ?assertEqual(content_filter, maps:get(type, Policy)),
    ?assert(is_list(maps:get(rules, Policy))).

%%%=============================================================================
%%% Enforcement Action Tests
%%%=============================================================================

enforcement_action_test_() ->
    [
      fun test_allow_action/0,
      fun test_deny_action/0,
      fun test_throttle_action/0,
      fun test_modify_action/0
     ].

test_allow_action() ->
    Decision = #{action => allow, reason => <<"Allowed">>},
    ?assertEqual(allow, maps:get(action, Decision)).

test_deny_action() ->
    Decision = #{action => deny, reason => <<"Blocked">>},
    ?assertEqual(deny, maps:get(action, Decision)).

test_throttle_action() ->
    Decision = #{action => throttle, reason => <<"Throttled">>},
    ?assertEqual(throttle, maps:get(action, Decision)),
    ?assertEqual(<<"Throttled">>, maps:get(reason, Decision)).

test_modify_action() ->
    Decision = #{
        action => modify,
        modifications => [
            #{field => <<"input">>, operation => redact}
        ]
    },
    ?assertEqual(modify, maps:get(action, Decision)),
    ?assert(is_list(maps:get(modifications, Decision))).

%%%=============================================================================
%%% Helper Functions
%%%=============================================================================

check_whitelist(Whitelist, Request) ->
    ToolName = maps:get(tool_name, Request, <<>>),
    case lists:member(ToolName, Whitelist) of
        true -> allow;
        false -> deny
    end.

check_blacklist(Blacklist, Request) ->
    ToolName = maps:get(tool_name, Request, <<>>),
    case lists:member(ToolName, Blacklist) of
        true -> deny;
        false -> allow
    end.

check_limit(Limit, Value) ->
    Max = maps:get(max_calls, Limit, infinity),
    case Value =< Max of
        true -> allow;
        false -> deny
    end.
