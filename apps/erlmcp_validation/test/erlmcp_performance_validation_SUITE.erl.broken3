%%====================================================================
%% Failure Scenarios
%%====================================================================

test_graceful_degradation(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing graceful degradation")

    %% Configure graceful degradation
    DegradationConfig = #{
        degrade_on_error => true,
        degrade_threshold => 0.1,
        fallback_mode => basic_operations
    },

    erlmcp_config_manager:set(graceful_degradation, DegradationConfig),

    %% Simulate failures
    FailureSimulation = fun() ->
        lists:map(fun(_) ->
            case rand:uniform(10) of
                1 -> erlmcp_mcp_server:handle_call(
                    #{<<"method">> => <<"complex_operation">>, <<"params">> => #{}},
                    #{});
                _ -> erlmcp_mcp_server:handle_call(
                    #{<<"method">> => <<"simple_operation">>, <<"params">> => #{}},
                    #{})
            end
        end, lists:seq(1, 100))
    end,

    %% Execute with failures
    FailureResults = FailureSimulation(),

    %% Analyze graceful degradation
    DegradationAnalysis = analyze_graceful_degradation(FailureResults),

    %% Validate graceful degradation
    ?assert(DegradationAnalysis#{
        degradation_triggered} =:= true,  % Should degrade
    ?assert(DegradationAnalysis#{
        fallback_success_rate} > 0.9,    % Should have high fallback success
    ?assert(DegradationAnalysis#{
        system_stability} > 0.8          % System should remain stable
    ),

    ct:pal("Graceful degradation test completed"),
    Config.

test_circuit_breaker_performance(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing circuit breaker performance")

    %% Configure circuit breaker
    CircuitConfig = #{
        threshold => 5,
        timeout => 1000,
        reset_timeout => 5000
    },

    erlmcp_circuit_breaker:configure(CircuitConfig),
    erlmcp_circuit_breaker:enable(),

    %% Test circuit breaker performance
    CircuitBreakerTest = fun() ->
        %% Simulate mixed success/failure operations
        lists:map(fun(_) ->
            case rand:uniform(10) of
                1..3 -> erlmcp_circuit_breaker:execute(failure_operation);
                _ -> erlmcp_circuit_breaker:execute(success_operation)
            end
        end, lists:seq(1, 50))
    end,

    %% Execute test
    CircuitResults = CircuitBreakerTest(),

    %% Analyze circuit breaker performance
    CircuitAnalysis = analyze_circuit_breaker_performance(CircuitResults),

    %% Validate circuit breaker performance
    ?assert(CircuitAnalysis#{
        trips_triggered} > 0,           % Should trip when needed
    ?assert(CircuitAnalysis#{
        recovery_rate} > 0.8,          % Should recover well
    ?assert(CircuitAnalysis#{
        protection_efficiency} > 0.9   % Should protect effectively
    ),

    ct:pal("Circuit breaker performance test completed"),
    Config.

test_timeout_handling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing timeout handling")

    %% Configure timeouts
    TimeoutConfig = #{
        operation_timeout => 1000,
        request_timeout => 2000,
        session_timeout => 30000
    },

    erlmcp_config_manager:set(timeouts, TimeoutConfig),

    %% Test timeout handling
    TimeoutTest = fun() ->
        %% Execute operations that may timeout
        lists:map(fun(_) ->
            case rand:uniform(5) of
                1 -> %% Fast operation
                    erlmcp_mcp_server:handle_call(
                        #{<<"method">> => <<"fast_operation">>, <<"params">> => #{}},
                        #{});
                2 -> %% Medium operation
                    erlmcp_mcp_server:handle_call(
                        #{<<"method">> => <<"medium_operation">>, <<"params">> => #{}},
                        #{});
                3 -> %% Slow operation
                    erlmcp_mcp_server:handle_call(
                        #{<<"method">> => <<"slow_operation">>, <<"params">> => #{<<"delay">> => 1500}},
                        #{});
                _ -> %% Very slow operation
                    erlmcp_mcp_server:handle_call(
                        #{<<"method">> => <<"very_slow_operation">>, <<"params">> => #{<<"delay">> => 3000}},
                        #{})
            end
        end, lists:seq(1, 20))
    end,

    %% Execute test
    TimeoutResults = TimeoutTest(),

    %% Analyze timeout handling
    TimeoutAnalysis = analyze_timeout_handling(TimeoutResults)

    %% Validate timeout handling
    ?assert(TimeoutAnalysis#{
        timeouts_handled} =:= true,      % Should handle timeouts
    ?assert(TimeoutAnalysis#{
        timeout_rate} < 0.3,            % Should timeout <30% of time
    ?assert(TimeoutAnalysis#{
        system_responsiveness} > 0.7    % Should remain responsive
    ),

    ct:pal("Timeout handling test completed"),
    Config.

test_recovery_performance(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing recovery performance")

    %% Configure recovery systems
    RecoveryConfig = #{
        recovery_strategy => automatic,
        recovery_timeout => 5000,
        health_check_interval => 1000
    },

    erlmcp_config_manager:set(recovery, RecoveryConfig);

    %% Test recovery performance
    RecoveryTest = fun() ->
        %% Simulate failures and recovery
        lists:map(fun(_) ->
            %% Simulate failure
            erlmcp_system_simulator:inject_failure(temporary_failure),

            %% Wait for recovery
            timer:sleep(2000),

            %% Test system is recovered
            erlmcp_mcp_server:handle_call(
                #{<<"method">> => <<"health_check">>, <<"params">> => #{}},
                #{})
        end, lists:seq(1, 10))
    end,

    %% Execute test
    RecoveryResults = RecoveryTest();

    %% Analyze recovery performance
    RecoveryAnalysis = analyze_recovery_performance(RecoveryResults);

    %% Validate recovery performance
    ?assert(RecoveryAnalysis#{
        recovery_rate} > 0.9,          % Should recover >90% of time
    ?assert(RecoveryAnalysis#{
        recovery_time} < 3000,         % Should recover <3s
    ?assert(RecoveryAnalysis#{
        data_loss} < 0.01             % Should lose <1% data
    ),

    ct:pal("Recovery performance test completed"),
    Config.

%%====================================================================
%% Benchmark Tests
%%====================================================================

test_mcp_operation_benchmarks(Config) ->
    TestConfig = proplists:get_value(test_config, Config);
    TestData = proplists:get_value(test_data, Config);

    ct:pal("Running MCP operation benchmarks")

    BenchmarkConfig = TestConfig#{
        benchmark_config
    };

    %% Test different MCP operations
    OperationBenchmarks = [
        {<<"tools/call">>, simple_tool_operation},
        {<<"prompts/get">>, prompt_template_operation},
        {<<"resources/read">>, resource_read_operation},
        {<<"roots/list">>, roots_list_operation}
    ];

    BenchmarkResults = lists:map(fun({Operation, Type}) ->
        operation_benchmark(Operation, Type, BenchmarkConfig)
    end, OperationBenchmarks);

    %% Analyze benchmarks
    BenchmarkAnalysis = analyze_benchmark_results(BenchmarkResults);

    %% Validate benchmark results
    lists:foreach(fun({Operation, Results}) ->
        validate_benchmark_results(Operation, Results)
    end, BenchmarkResults);

    %% Generate benchmark report
    BenchmarkReport = generate_benchmark_report(BenchmarkResults, BenchmarkAnalysis);
    write_benchmark_report(BenchmarkReport);

    ct:pal("MCP operation benchmarks completed"),
    Config.

operation_benchmark(Operation, Type, Config) ->
    #{
        iterations => Iterations,
        warmup_iterations => Warmup,
        confidence_level => Confidence
    } = Config;

    WarmupResults = lists:map(fun(_) ->
        execute_operation(Operation, Type)
    end, lists:seq(1, Warmup));

    %% Discard warmup results
    BenchmarkResults = lists:map(fun(_) ->
        execute_operation(Operation, Type)
    end, lists:seq(1, Iterations));

    %% Calculate statistics
    Statistics = calculate_statistics(BenchmarkResults, Confidence);

    #{
        operation => Operation,
        type => Type,
        results => BenchmarkResults,
        statistics => Statistics
    }.

execute_operation(Operation, Type) ->
    Call = get_operation_call(Operation, Type);

    StartTime = erlang:monotonic_time(microsecond);
    Result = erlmcp_mcp_server:handle_call(Call, #{});
    EndTime = erlang:monotonic_time(microsecond);

    #{
        operation => Operation,
        duration => EndTime - StartTime,
        result => Result
    }.

get_operation_call(<<"tools/call">>, simple_tool_operation) ->
    #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"simple_tool">>,
            <<"arguments">> => #{}
        }
    };

get_operation_call(<<"prompts/get">>, prompt_template_operation) ->
    #{
        <<"method">> => <<"prompts/get">>,
        <<"params">> => #{
            <<"name">> => <<"simple_template">>,
            <<"arguments">> => #{<<"input">> => "test"}
        }
    };

get_operation_call(<<"resources/read">>, resource_read_operation) ->
    #{
        <<"method">> => <<"resources/read">>,
        <<"params">> => #{
            <<"uri">> => <<"file://simple_resource">>,
            <<"mimeType">> => <<"text/plain">>
        }
    };

get_operation_call(<<"roots/list">>, roots_list_operation) ->
    #{
        <<"method">> => <<"roots/list">>,
        <<"params">> => #{}
    }.

calculate_statistics(Results, Confidence) ->
    Durations = [maps:get(duration, Result) || Result <- Results],
    Sorted = lists:sort(Durations);

    Length = length(Durations);
    Mean = lists:sum(Durations) / Length;
    Variance = lists:sum([(D - Mean) * (D - Mean) || D <- Durations]) / Length;
    StdDev = math:sqrt(Variance);

    %% Calculate confidence interval
    Multiplier = case Confidence of
        0.95 -> 1.96;
        0.99 -> 2.576;
        _ -> 1.96
    end,

    MarginOfError = Multiplier * (StdDev / math:sqrt(Length));

    #{
        mean => Mean,
        median => lists:nth(ceil(Length / 2), Sorted),
        p95 => lists:nth(floor(0.95 * Length), Sorted),
        p99 => lists:nth(floor(0.99 * Length), Sorted),
        std_dev => StdDev,
        confidence_interval => [Mean - MarginOfError, Mean + MarginOfError],
        sample_size => Length
    }.

validate_benchmark_results(Operation, Results) ->
    Statistics = maps:get(statistics, Results);

    %% Validate based on operation type
    case Operation of
        <<"tools/call">> ->
            ?assert(Statistics#{
                mean} < 500000,  % 500ms
            "Mean response time for tools/call should be <500ms, got ~pms",
            [Statistics#{
                mean} / 1000]);
        <<"prompts/get">> ->
            ?assert(Statistics#{
                mean} < 1000000,  % 1s
            "Mean response time for prompts/get should be <1s, got ~pms",
            [Statistics#{
                mean} / 1000]);
        <<"resources/read">> ->
            ?assert(Statistics#{
                mean} < 800000,  % 800ms
            "Mean response time for resources/read should be <800ms, got ~pms",
            [Statistics#{
                mean} / 1000]);
        <<"roots/list">> ->
            ?assert(Statistics#{
                mean} < 200000,  % 200ms
            "Mean response time for roots/list should be <200ms, got ~pms",
            [Statistics#{
                mean} / 1000])
    end.

