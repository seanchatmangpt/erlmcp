test_disk_io_monitoring(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing disk I/O monitoring")

    %% Start disk I/O monitoring
    erlmcp_disk_monitor:start(),

    %% Execute disk-intensive operations
    DiskIntensiveTest = fun() ->
        %% Create and write large files
        lists:map(fun(Id) ->
            FileName = "/tmp/test_file_" ++ integer_to_list(Id),
            FileContent = list_to_binary(lists:duplicate(100000, $X)),

            {ok, File} = file:open(FileName, [write]),
            file:write(File, FileContent),
            file:close(File),

            %% Read back
            {ok, ReadContent} = file:read_file(FileName),
            file:delete(FileName),

            ReadContent
        end, lists:seq(1, 100))
    end,

    %% Execute test
    TestResults = DiskIntensiveTest(),

    %% Get disk I/O metrics
    DiskMetrics = erlmcp_disk_monitor:get_metrics(),

    %% Validate disk I/O monitoring
    ?assert(is_number(DiskMetrics#{
        read_bytes})),   "Should have read bytes metric"),
    ?assert(is_number(DiskMetrics#{
        write_bytes})),  "Should have write bytes metric"),
    ?assert(is_number(DiskMetrics#{
        read_operations})), "Should have read operations metric"),
    ?assert(is_number(DiskMetrics#{
        write_operations})), "Should have write operations metric"),

    ct:pal("Disk I/O monitoring test completed"),
    Config.

