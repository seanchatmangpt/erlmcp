%%%-------------------------------------------------------------------
%%% @doc
%%% Performance validation test suite for Phase 3
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_performance_validation_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("eunit/include/eunit.hrl").

-export([all/0, init_per_suite/1, end_per_suite/1]).
-export([
    %% Load Testing
    test_mcp_protocol_load/1,
    test_concurrent_request_handling/1,
    test_resource_concurrency/1,
    test_memory_usage_scaling/1,

    %% Performance Metrics
    test_response_time_validation/1,
    test_throughput_analysis/1,
    test_error_rate_monitoring/1,
    test_resource_efficiency/1,

    %% Scalability Testing
    test_horizontal_scaling/1,
    test_vertical_scaling/1,
    test_cluster_performance/1,
    test_connection_pool_scaling/1,

    %% Resource Monitoring
    test_memory_monitoring/1,
    test_cpu_monitoring/1,
    test_disk_io_monitoring/1,
    test_network_monitoring/1,

    %% Failure Scenarios
    test_graceful_degradation/1,
    test_circuit_breaker_performance/1,
    test_timeout_handling/1,
    test_recovery_performance/1,

    %% Benchmark Tests
    test_mcp_operation_benchmarks/1,
    test_database_benchmarks/1,
    test_cache_benchmarks/1,
    test_network_benchmarks/1
]).

%%====================================================================
%% Test configuration
%%====================================================================

all() ->
    [
        %% Load Testing
        test_mcp_protocol_load,
        test_concurrent_request_handling,
        test_resource_concurrency,
        test_memory_usage_scaling,

        %% Performance Metrics
        test_response_time_validation,
        test_throughput_analysis,
        test_error_rate_monitoring,
        test_resource_efficiency,

        %% Scalability Testing
        test_horizontal_scaling,
        test_vertical_scaling,
        test_cluster_performance,
        test_connection_pool_scaling,

        %% Resource Monitoring
        test_memory_monitoring,
        test_cpu_monitoring,
        test_disk_io_monitoring,
        test_network_monitoring,

        %% Failure Scenarios
        test_graceful_degradation,
        test_circuit_breaker_performance,
        test_timeout_handling,
        test_recovery_performance,

        %% Benchmark Tests
        test_mcp_operation_benchmarks,
        test_database_benchmarks,
        test_cache_benchmarks,
        test_network_benchmarks
    ].

%%====================================================================
%% Suite setup/teardown
%%====================================================================

init_per_suite(Config) ->
    %% Start application
    {ok, _} = application:ensure_all_started(erlmcp_core),

    %% Initialize performance monitoring
    ok = erlmcp_performance_monitor:initialize(),

    %% Configure performance test environment
    TestConfig = #{
        load_test_config => #{
            duration => 300000,  % 5 minutes
            concurrent_users => 100,
            requests_per_second => 50,
            ramp_up_time => 30000  % 30 seconds
        },
        benchmark_config => #{
            iterations => 1000,
            warmup_iterations => 100,
            confidence_level => 0.95
        },
        monitoring_config => #{
            sample_interval => 1000,
            metrics_retention => 3600000,
            alert_threshold => 0.95
        }
    },

    %% Create test data
    TestData = create_performance_test_data(),

    %% Enable performance collection
    erlmcp_performance_monitor:start_collection(),

    Config ++ [
        test_config => TestConfig,
        test_data => TestData,
        test_start_time => erlang:monotonic_time(millisecond)
    ].

end_per_suite(Config) ->
    %% Stop performance monitoring
    erlmcp_performance_monitor:stop_collection(),

    %% Generate performance report
    Report = erlmcp_performance_monitor:generate_report(),
    write_performance_report(Report),

    %% Cleanup test data
    cleanup_performance_test_data(proplists:get_value(test_data, Config)),

    %% Stop application
    application:stop(erlmcp_core),

    ok.

%%====================================================================
%% Load Testing
%%====================================================================

test_mcp_protocol_load(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    LoadConfig = TestConfig#{
        load_test_config
    },

    ct:pal("Starting MCP protocol load test")

    %% Execute load test
    LoadResults = execute_mcp_load_test(LoadConfig),

    %% Analyze results
    Analysis = analyze_load_test_results(LoadResults),

    %% Validate performance requirements
    validate_performance_requirements(Analysis, #{
        max_response_time => 1000,  % 1 second
        min_throughput => 30,      % 30 req/s
        max_error_rate => 0.05,    % 5%
        target_cpu_usage => 0.8    % 80%
    }),

    %% Generate load test report
    LoadReport = generate_load_test_report(LoadResults, Analysis),
    write_load_test_report(LoadReport),

    ct:pal("MCP protocol load test completed"),
    Config.

test_concurrent_request_handling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing concurrent request handling")

    %% Test different concurrency levels
    ConcurrencyLevels = [10, 50, 100, 200, 500],

    Results = lists:map(fun(Concurrency) ->
        LevelConfig = TestConfig#{
            load_test_config => TestConfig#{
                load_test_config
            }#{
                concurrent_users => Concurrency,
                requests_per_second => 100
            }
        },

        LevelResults = execute_concurrent_test(LevelConfig, TestData),
        analyze_concurrent_results(LevelResults)
    end, ConcurrencyLevels),

    %% Analyze scaling behavior
    ScalingAnalysis = analyze_scaling_behavior(Results),

    %% Validate scaling requirements
    ?assert(ScalingAnalysis#{
        efficiency_drop} < 0.3,  % Should not drop more than 30% efficiency
    ?assert(ScalingAnalysis#{
        response_time_increase} < 5,  % Should not increase more than 5x
    ?assert(ScalingAnalysis#{
        error_rate_increase} < 0.1  % Should not increase more than 10%
    ),

    ct:pal("Concurrent request handling test completed"),
    Config.

test_resource_concurrency(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing resource concurrency")

    %% Test resource access under concurrency
    ResourceConcurrencyTest = fun() ->
        %% Create many concurrent resource operations
        Workers = lists:seq(1, 50),

        WorkerPids = lists:map(fun(Id) ->
            spawn_link(fun() ->
                resource_concurrency_worker(Id, TestConfig, TestData)
            end)
        end, Workers),

        %% Wait for all workers to complete
        lists:foreach(fun(Pid) ->
            monitor(process, Pid),
            receive
                {'DOWN', _, process, Pid, _} -> ok
            end
        end, WorkerPids),

        ok
    end,

    %% Execute test
    WorkerResults = ResourceConcurrencyTest(),

    %% Analyze results
    ResourceAnalysis = analyze_resource_concurrency_results(WorkerResults),

    %% Validate resource concurrency requirements
    ?assert(ResourceAnalysis#{
        contention_rate} < 0.1,  % Should have <10% contention
    ?assert(ResourceAnalysis#{
        average_wait_time} < 100,  % Should wait <100ms
    ?assert(ResourceAnalysis#{
        throughput} > 40  % Should process >40 operations/s
    ),

    ct:pal("Resource concurrency test completed"),
    Config.

resource_concurrency_worker(WorkerId, TestConfig, TestData) ->
    %% Perform resource operations
    Operations = lists:seq(1, 20),

    lists:foreach(fun(OpId) ->
        ResourceId = list_to_binary("resource_" ++ integer_to_list(WorkerId) ++
                                     "_" ++ integer_to_list(OpId)),

        %% Simulate resource access
        case erlmcp_registry:register(ResourceId, #{
            uri => <<"test://", ResourceId/binary>>,
            name => ResourceId,
            created_by => WorkerId
        }) of
            ok ->
                %% Use resource
                timer:sleep(10),  % Simulate work
                %% Clean up
                erlmcp_registry:unregister(ResourceId);
            {error, Reason} ->
                ct:pal("Worker ~p operation ~p failed: ~p", [WorkerId, OpId, Reason])
        end,

        ok
    end, Operations).

test_memory_usage_scaling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing memory usage scaling")

    %% Test memory usage at different scales
    ScaleFactors = [1, 10, 50, 100, 200],

    MemoryResults = lists:map(fun(Scale) ->
        ScaleResults = execute_memory_test(Scale, TestConfig, TestData),
        analyze_memory_results(ScaleResults)
    end, ScaleFactors),

    %% Analyze memory scaling behavior
    MemoryAnalysis = analyze_memory_scaling(MemoryResults, ScaleFactors),

    %% Validate memory scaling requirements
    ?assert(MemoryAnalysis#{
        memory_efficiency} > 0.8,  % Should be >80% memory efficient
    ?assert(MemoryAnalysis#{
        gc_frequency_increase} < 5,  % GC should not increase >5x
    ?assert(MemoryAnalysis#{
        leak_rate} < 0.001  % Should leak <0.1% memory per operation
    ),

    ct:pal("Memory usage scaling test completed"),
    Config.

execute_memory_test(Scale, TestConfig, TestData) ->
    %% Get initial memory
    InitialMemory = erlang:memory(total),

    %% Perform scaled operations
    ScaledOperations = lists:seq(1, 100 * Scale),

    lists:foreach(fun(_) ->
        %% Simulate memory-intensive operations
        LargeData = list_to_binary(lists:duplicate(1000, $X)),
        erlang:garbage_collect(),  % Force GC periodically
        timer:sleep(1),  % Small delay
        ok
    end, ScaledOperations),

    %% Get final memory
    FinalMemory = erlang:memory(total),
    MemoryIncrease = FinalMemory - InitialMemory,

    #{
        scale => Scale,
        initial_memory => InitialMemory,
        final_memory => FinalMemory,
        memory_increase => MemoryIncrease,
        operations_per_second => (100 * Scale) / 10  % Assuming 10 seconds
    }.

analyze_memory_scaling(Results, ScaleFactors) ->
    if length(Results) < 2 ->
        #{memory_efficiency => 1.0, gc_frequency_increase => 1.0, leak_rate => 0.0};
    true ->
        %% Calculate memory efficiency (operations per MB)
        [BaseResult | ScaledResults] = Results,
        BaseMemPerOp = maps:get(memory_increase, BaseResult) / maps:get(operations_per_second, BaseResult),

        MemEfficiencies = lists:map(fun(Result) ->
            OpPerMem = maps:get(operations_per_second, Result) / maps:get(memory_increase, Result),
            OpPerMem / BaseMemPerOp  % Relative to base
        end, ScaledResults),

        AverageEfficiency = lists:sum(MemEfficiencies) / length(MemEfficiencies),

        %% Calculate leak rate
        FinalMemory = maps:get(final_memory, lists:last(Results)),
        InitialMemory = maps:get(initial_memory, BaseResult),
        ExpectedMemory = InitialMemory + BaseMemPerOp * maps:get(operations_per_second, lists:last(Results)),
        LeakRate = (FinalMemory - ExpectedMemory) / ExpectedMemory,

        #{
            memory_efficiency => AverageEfficiency,
            gc_frequency_increase => length(ScaleFactors),
            leak_rate => max(0, LeakRate)
        }
    end.

%%====================================================================
%% Performance Metrics
%%====================================================================

test_response_time_validation(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Validating response times")

    %% Test response times for different MCP operations
    Operations = [
        {<<"tools/call">>, simple_operation},
        {<<"prompts/get">>, template_operation},
        {<<"resources/read">>, resource_operation},
        {<<"roots/list">>, list_operation}
    ],

    ResponseTimeResults = lists:map(fun({Method, Type}) ->
        ResponseTest = fun() ->
            Call = #{
                <<"method">> => Method,
                <<"params">> => operation_params(Type)
            },

            StartTime = erlang:monotonic_time(microsecond),
            {ok, _} = erlmcp_mcp_server:handle_call(Call, #{}),
            EndTime = erlang:monotonic_time(microsecond),

            EndTime - StartTime
        end,

        %% Execute multiple tests
        Timings = lists:map(fun(_) -> ResponseTest() end, lists:seq(1, 100)),
        analyze_response_times(Timings, Method)
    end, Operations),

    %% Validate response time requirements
    lists:foreach(fun({Method, Analysis}) ->
        MaxResponseTime = maps:get(p95_response_time, Analysis),
        TargetResponseTime = get_response_time_target(Method),

        ?assert(MaxResponseTime =< TargetResponseTime,
                "Response time for ~p should be <= ~pms, got ~pms",
                [Method, TargetResponseTime, MaxResponseTime])
    end, ResponseTimeResults),

    ct:pal("Response time validation completed"),
    Config.

analyze_response_times(Timings, Method) ->
    SortedTimings = lists:sort(Timings),
    Length = length(Timings),

    %% Calculate percentiles
    P50 = lists:nth(round(0.5 * Length), SortedTimings),
    P95 = lists:nth(round(0.95 * Length), SortedTimings),
    P99 = lists:nth(round(0.99 * Length), SortedTimings),

    #{
        method => Method,
        p50_response_time => P50 / 1000,  % Convert to ms
        p95_response_time => P95 / 1000,
        p99_response_time => P99 / 1000,
        average_response_time => lists:sum(Timings) / Length / 1000,
        min_response_time => lists:nth(1, SortedTimings) / 1000,
        max_response_time => lists:last(SortedTimings) / 1000
    }.

get_response_time_target(<<"tools/call">>) -> 500;   % 500ms
get_response_time_target(<<"prompts/get">>) -> 1000;  % 1s
get_response_time_target(<<"resources/read">>) -> 800; % 800ms
get_response_time_target(<<"roots/list">>) -> 200.   % 200ms

test_throughput_analysis(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Analyzing throughput")

    %% Test throughput for different operation types
    ThroughputTests = [
        {basic_mcp_operations, 1000},
        {complex_mcp_operations, 500},
        {mixed_operations, 750}
    ],

    ThroughputResults = lists:map(fun({TestType, OperationCount}) ->
        ThroughputTest = fun() ->
            StartTime = erlang:monotonic_time(millisecond),

            %% Execute operations
            lists:foreach(fun(_) ->
                Call = test_operation_for_type(TestType),
                _ = erlmcp_mcp_server:handle_call(Call, #{}),
                ok
            end, lists:seq(1, OperationCount)),

            EndTime = erlang:monotonic_time(millisecond),
            {EndTime - StartTime, OperationCount}
        end,

        {Duration, ActualOps} = ThroughputTest(),
        Throughput = ActualOps / (Duration / 1000),  % ops per second

        analyze_throughput(TestType, Throughput, Duration)
    end, ThroughputTests),

    %% Validate throughput requirements
    lists:foreach(fun({_, Analysis}) ->
        Throughput = maps:get(throughput, Analysis),
        TargetThroughput = get_throughput_target(),

        ?assert(Throughput >= TargetThroughput * 0.8,  % Allow 20% variance
                "Throughput should be >= ~p ops/s, got ~p ops/s",
                [TargetThroughput, Throughput])
    end, ThroughputResults),

    ct:pal("Throughput analysis completed"),
    Config.

test_operation_for_type(basic_mcp_operations) ->
    #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"simple_test">>,
            <<"arguments">> => #{}
        }
    };

test_operation_for_type(complex_mcp_operations) ->
    #{
        <<"method">> => <<"prompts/get">>,
        <<"params">> => #{
            <<"name">> => <<"complex_template">>,
            <<"arguments">> => #{
                <<"data">> => #{<<"complex">> => <<"data">>},
                <<"context">> => <<"complex context">>
            }
        }
    };

test_operation_for_type(mixed_operations) ->
    case rand:uniform(3) of
        1 ->
            #{
                <<"method">> => <<"tools/call">>,
                <<"params">> => #{<<"name">> => <<"test_tool">>, <<"arguments">> => #{}}
            };
        2 ->
            #{
                <<"method">> => <<"resources/read">>,
                <<"params">> => #{<<"uri">> => <<"file://test">>, <<"mimeType">> => <<"text/plain">>}
            };
        3 ->
            #{
                <<"method">> => <<"roots/list">>,
                <<"params">> => #{}
            }
    end.

analyze_throughput(TestType, Throughput, Duration) ->
    #{
        test_type => TestType,
        throughput => Throughput,
        duration => Duration,
        efficiency => calculate_throughput_efficiency(TestType, Throughput)
    }.

calculate_throughput_efficiency(TestType, ActualThroughput) ->
    Target = get_throughput_target(),
    case TestType of
        basic_mcp_operations ->
            ActualThroughput / (Target * 1.2);  % Basic ops should exceed target
        complex_mcp_operations ->
            ActualThroughput / (Target * 0.6);  % Complex ops will be slower
        mixed_operations ->
            ActualThroughput / (Target * 0.9)   % Mixed ops should be close to target
    end.

get_throughput_target() -> 50.  % 50 ops/s target

test_error_rate_monitoring(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Monitoring error rates")

    %% Test error rates under different conditions
    ErrorScenarios = [
        {normal_conditions, 0.01},  % Expected 1% error rate
        {high_load, 0.05},         % Expected 5% error rate
        {failure_injection, 0.15}  % Expected 15% error rate
    ],

    ErrorResults = lists:map(fun({Scenario, ExpectedRate}) ->
        ErrorTest = fun() ->
            %% Execute test with scenario-specific conditions
            Results = execute_error_scenario(Scenario, 1000),

            %% Calculate actual error rate
            ErrorCount = length([R || R <- Results, R =:= error]),
            ErrorRate = ErrorCount / length(Results),

            {ErrorRate, Results}
        end,

        {ActualErrorRate, Results} = ErrorTest(),
        analyze_error_results(Scenario, ActualErrorRate, ExpectedRate, Results)
    end, ErrorScenarios),

    %% Validate error rate monitoring
    lists:foreach(fun({Scenario, Analysis}) ->
        ActualRate = maps:get(actual_error_rate, Analysis),
        ExpectedRate = maps:get(expected_error_rate, Analysis),
        AllowedRate = ExpectedRate * 1.5,  % Allow 50% variance

        ?assert(ActualRate =< AllowedRate,
                "Error rate for ~p should be <= ~p, got ~p",
                [Scenario, AllowedRate, ActualRate])
    end, ErrorResults),

    ct:pal("Error rate monitoring completed"),
    Config.

execute_error_scenario(normal_conditions, Count) ->
    lists:map(fun(_) ->
        case rand:uniform(100) of
            100 -> error;  % 1% error rate
            _ -> success
        end
    end, lists:seq(1, Count));

execute_error_scenario(high_load, Count) ->
    lists:map(fun(_) ->
        case rand:uniform(20) of
            1 -> error;  % 5% error rate
            _ -> success
        end
    end, lists:seq(1, Count));

execute_error_scenario(failure_injection, Count) ->
    lists:map(fun(_) ->
        case rand:uniform(7) of
            1 -> error;  % ~14% error rate
            _ -> success
        end
    end, lists:seq(1, Count)).

analyze_error_results(Scenario, ActualRate, ExpectedRate, Results) ->
    #{
        scenario => Scenario,
        actual_error_rate => ActualRate,
        expected_error_rate => ExpectedRate,
        tolerance_factor => calculate_tolerance_factor(Scenario),
        error_distribution => analyze_error_distribution(Results)
    }.

calculate_tolerance_factor(normal_conditions) -> 1.2;
calculate_tolerance_factor(high_load) -> 1.3;
calculate_tolerance_factor(failure_injection) -> 1.5.

analyze_error_distribution(Results) ->
    %% Analyze pattern of errors
    SuccessCount = length([R || R <- Results, R =:= success]),
    ErrorCount = length([R || R <- Results, R =:= error]),
    {SuccessCount, ErrorCount}.

test_resource_efficiency(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing resource efficiency")

    %% Test resource utilization
    ResourceTests = [
        {cpu_efficiency, test_cpu_efficiency},
        {memory_efficiency, test_memory_efficiency},
        {connection_efficiency, test_connection_efficiency},
        {cache_efficiency, test_cache_efficiency}
    ],

    ResourceResults = lists:map(fun({Type, TestFun}) ->
        Analysis = TestFun(TestConfig, TestData),
        validate_resource_efficiency(Type, Analysis)
    end, ResourceTests),

    %% Calculate overall efficiency score
    OverallEfficiency = calculate_overall_efficiency(ResourceResults),

    %% Validate overall efficiency
    ?assert(OverallEfficiency >= 0.75,  % Should be at least 75% efficient
            "Overall resource efficiency should be >= 75%, got ~p%",
            [OverallEfficiency * 100]),

    ct:pal("Resource efficiency test completed: ~p% overall efficiency",
          [OverallEfficiency * 100]),
    Config.

validate_resource_efficiency(Type, Analysis) ->
    ExpectedEfficiency = case Type of
        cpu_efficiency -> 0.85;
        memory_efficiency -> 0.80;
        connection_efficiency -> 0.90;
        cache_efficiency -> 0.95
    end,

    ActualEfficiency = maps:get(efficiency, Analysis),
    ?assert(ActualEfficiency >= ExpectedEfficiency * 0.9,  % 90% of expected
            "Resource efficiency for ~p should be >= ~p, got ~p",
            [Type, ExpectedEfficiency, ActualEfficiency]).

calculate_overall_efficiency(Results) ->
    Efficiencies = [maps:get(efficiency, Analysis) || {_, Analysis} <- Results],
    lists:sum(Efficiencies) / length(Efficiencies).

%%====================================================================
%% Scalability Testing
%%====================================================================

test_horizontal_scaling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing horizontal scaling")

    %% Test scaling with different node counts
    NodeCounts = [1, 2, 3, 5, 10],

    ScalingResults = lists:map(fun(NodeCount) ->
        ScalingTest = fun() ->
            %% Configure cluster with NodeCount nodes
            configure_cluster(NodeCount),

            %% Perform scaling test
            ScalingConfig = TestConfig#{
                load_test_config => TestConfig#{
                    load_test_config
                }#{
                    concurrent_users => NodeCount * 20,
                    requests_per_second => NodeCount * 10
                }
            },

            Results = execute_scaling_test(ScalingConfig),
            analyze_scaling_results(Results)
        end,

        ScalingTest()
    end, NodeCounts),

    %% Analyze horizontal scaling behavior
    HorizontalAnalysis = analyze_horizontal_scaling(ScalingResults, NodeCounts),

    %% Validate scaling requirements
    ?assert(HorizontalAnalysis#{
        scaling_efficiency} > 0.8,  % Should be >80% efficient
    ?assert(HorizontalAnalysis#{
        load_distribution} > 0.9,    % Should be >90% evenly distributed
    ?assert(HorizontalAnalysis#{
        overhead_increase} < 0.2    % Overhead should increase <20%
    ),

    ct:pal("Horizontal scaling test completed"),
    Config.

configure_cluster(NodeCount) ->
    %% Configure cluster with NodeCount nodes
    %% This is a simplified version - in practice, you'd set up actual cluster
    ct:pal("Configuring cluster with ~p nodes", [NodeCount]),
    ok.

test_vertical_scaling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing vertical scaling")

    %% Test with different process counts and thread pool sizes
    Configurations = [
        {processes, [10, 50, 100, 200]},
        {thread_pool, [5, 10, 20, 40]},
        {queue_size, [100, 500, 1000, 2000]}
    ],

    ScalingResults = lists:map(fun({Type, Values}) ->
        VerticalScalingTest = fun(Value) ->
            ConfigureFun = get_vertical_scaling_config(Type),
            ConfigureFun(Value),

            TestConfig = TestConfig#{
                load_test_config => TestConfig#{
                    load_test_config
                }#{
                    concurrent_users => Value * 2,
                    requests_per_second => Value
                }
            },

            Results = execute_scaling_test(TestConfig),
            analyze_scaling_results(Results)
        end,

        Results = lists:map(fun(Value) -> VerticalScalingTest(Value) end, Values),
        analyze_vertical_scaling(Results, Type, Values)
    end, Configurations),

    %% Analyze vertical scaling behavior
    VerticalAnalysis = analyze_vertical_scaling_results(ScalingResults),

    %% Validate vertical scaling requirements
    ?assert(VerticalAnalysis#{
        throughput_scaling} > 0.9,  % Should scale >90% linearly
    ?assert(VerticalAnalysis#{
        latency_increase} < 2.0,      % Latency should increase <2x
    ?assert(VerticalAnalysis#{
        resource_utilization} > 0.85   % Should utilize >85% resources
    ),

    ct:pal("Vertical scaling test completed"),
    Config.

get_vertical_scaling_config(processes) ->
    fun(Value) ->
        erlmcp_config_manager:set(process_count, Value)
    end;

get_vertical_scaling_config(thread_pool) ->
    fun(Value) ->
        erlmcp_config_manager:set(thread_pool_size, Value)
    end;

get_vertical_scaling_config(queue_size) ->
    fun(Value) ->
        erlmcp_config_manager:set(work_queue_size, Value)
    end.

test_cluster_performance(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing cluster performance")

    %% Test cluster with different network conditions
    NetworkScenarios = [
        {fast_network, 10},
        {slow_network, 100},
        {unstable_network, 50}
    ],

    ClusterResults = lists:map(fun({NetworkType, Latency}) ->
        NetworkConfig = #{
            network_latency => Latency,
            packet_loss => get_packet_loss(NetworkType),
            bandwidth => get_bandwidth(NetworkType)
        },

        erlmcp_cluster:configure_network(NetworkConfig),

        ClusterTestConfig = TestConfig#{
            load_test_config => TestConfig#{
                load_test_config
            }#{
                concurrent_users => 50,
                requests_per_second => 25
            }
        },

        Results = execute_cluster_test(ClusterTestConfig, NetworkType),
        analyze_cluster_results(Results)
    end, NetworkScenarios),

    %% Analyze cluster performance
    ClusterAnalysis = analyze_cluster_performance(ClusterResults),

    %% Validate cluster requirements
    ?assert(ClusterAnalysis#{
        cluster_health} > 0.9,      % Should be >90% healthy
    ?assert(ClusterAnalysis#{
        consensus_latency} < 100,     % Consensus <100ms
    ?assert(ClusterAnalysis#{
        failover_time} < 5000       % Failover <5s
    ),

    ct:pal("Cluster performance test completed"),
    Config.

get_packet_loss(fast_network) -> 0.0;
get_packet_loss(slow_network) -> 0.0;
get_packet_loss(unstable_network) -> 0.05.

get_bandwidth(fast_network) -> 1000;
get_bandwidth(slow_network) -> 100;
get_bandwidth(unstable_network) -> 500.

test_connection_pool_scaling(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing connection pool scaling")

    %% Test different pool configurations
    PoolConfigs = [
        #{size => 5, max_overflow => 2},
        #{size => 10, max_overflow => 5},
        #{size => 20, max_overflow => 10},
        #{size => 50, max_overflow => 25}
    ],

    PoolResults = lists:map(fun(Config) ->
        erlmcp_connection_pool:configure(Config),

        ScalingConfig = TestConfig#{
            load_test_config => TestConfig#{
                load_test_config
            }#{
                concurrent_users => Config#{
                    size
                } * 2,
                requests_per_second => Config#{
                    size
                }
            }
        },

        Results = execute_pool_test(ScalingConfig),
        analyze_pool_results(Results, Config)
    end, PoolConfigs),

    %% Analyze pool scaling
    PoolAnalysis = analyze_pool_scaling(PoolResults),

    %% Validate pool scaling requirements
    ?assert(PoolAnalysis#{
        hit_rate} > 0.95,           % Should be >95% cache hit
    ?assert(PoolAnalysis#{
        average_wait_time} < 50,     % Should wait <50ms
    ?assert(PoolAnalysis#{
        utilization} > 0.7           % Should utilize >70%
    ),

    ct:pal("Connection pool scaling test completed"),
    Config.

%%====================================================================
%% Resource Monitoring
%%====================================================================

test_memory_monitoring(Config) ->
    TestConfig = proplists:get_value(test_config, Config),
    TestData = proplists:get_value(test_data, Config),

    ct:pal("Testing memory monitoring")

    %% Start memory monitoring
    erlmcp_memory_monitor:start(),

    %% Execute memory-intensive operations
    MemoryIntensiveTest = fun() ->
        Lists = lists:seq(1, 1000),

        %% Create large data structures
        LargeData = [list_to_binary(lists:duplicate(1000, $X)) || _ <- Lists],

        %% Process data
        Results = lists:map(fun(Data) ->
            binary:part(Data, {0, min(100, byte_size(Data))})
        end, LargeData),

        %% Force garbage collection
        erlang:garbage_collect(),

        Results
    end,

    %% Execute test
    TestResults = MemoryIntensiveTest(),

    %% Get memory metrics
    MemoryMetrics = erlmcp_memory_monitor:get_metrics(),

    %% Validate memory monitoring
    ?assert(is_number(MemoryMetrics#{
        total_memory}),  "Should have total memory metric"),
    ?assert(is_number(MemoryMetrics#{
        used_memory}),   "Should have used memory metric"),
    ?assert(is_number(MemoryMetrics#{
        free_memory}),   "Should have free memory metric"),
    ?assert(is_number(MemoryMetrics#{
        memory_usage})), "Should have memory usage percentage"),

    %% Check memory usage doesn't exceed threshold
    ?assert(MemoryMetrics#{
        memory_usage} < 90,  % Should be <90%
    "Memory usage should be <90%, got ~p%", [MemoryMetrics#{
        memory_usage}]),

    ct:pal("Memory monitoring test completed"),
    Config.

