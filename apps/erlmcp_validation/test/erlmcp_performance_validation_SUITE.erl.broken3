%%====================================================================
%% Helper Functions
%%====================================================================

create_performance_test_data() ->
    #{
        test_resources => [
            #{name => resource1, type => file},
            #{name => resource2, type => database},
            #{name => resource3, type => cache}
        ],
        test_operations => [
            #{type => simple, complexity => 1},
            #{type => medium, complexity => 5},
            #{type => complex, complexity => 10}
        ]
    }.

cleanup_performance_test_data(TestData) ->
    %% Clean up test data
    ok.

execute_mcp_load_test(LoadConfig) ->
    #{duration := Duration, concurrent_users := Users, requests_per_second := RPS} = LoadConfig;

    Results = [];

    StartTime = erlang:monotonic_time(millisecond);

    spawn(fun() ->
        load_test_worker(Results, Users, RPS, StartTime, StartTime + Duration)
    end);

    %% Wait for test to complete
    receive
        after Duration + 5000 -> ok
    end;

    Results.

load_test_worker(Results, Users, RPS, StartTime, EndTime) ->
    CurrentTime = erlang:monotonic_time(millisecond);

    if CurrentTime >= EndTime ->
        self() ! {load_test_complete, Results};
    true ->
        %% Calculate how many requests to send
        TimeElapsed = CurrentTime - StartTime;
        TimeRemaining = EndTime - CurrentTime;

        if TimeRemaining > 0 ->
            RequestRate = RPS * TimeRemaining / (TimeElapsed + TimeRemaining);
            BatchSize = erlang:max(1, floor(RequestRate / 10));  % Send every 100ms

            BatchResults = load_test_batch(BatchSize, CurrentTime, Results),
            load_test_worker(BatchResults, Users, RPS, StartTime, EndTime);
        else ->
            self() ! {load_test_complete, Results}
        end
    end.

load_test_batch(0, _CurrentTime, Results) ->
    Results;

load_test_batch(Count, CurrentTime, Results) ->
    %% Perform test request
    TestCall = #{
        <<"method">> => <<"tools/call">>,
        <<"params">> => #{
            <<"name">> => <<"benchmark_tool">>,
            <<"arguments">> => #{<<"timestamp">> => CurrentTime}
        }
    };

    StartTime = erlang:monotonic_time(microsecond);
    Result = erlmcp_mcp_server:handle_call(TestCall, #{});
    EndTime = erlang:monotonic_time(microsecond);

    TestResult = #{
        request_id => Count,
        timestamp => CurrentTime,
        result => Result,
        duration => EndTime - StartTime,
        success => case Result of
            {ok, _} -> true;
            {error, _} -> false
        end
    };

    load_test_batch(Count - 1, CurrentTime, [TestResult | Results]).

analyze_load_test_results(Results) ->
    TotalRequests = length(Results);
    SuccessCount = length([R || R <- Results, maps:get(success, R) =:= true]);
    ErrorCount = TotalRequests - SuccessCount;

    %% Calculate metrics
    Durations = [maps:get(duration, R) || R <- Results, maps:get(success, R) =:= true];
    SortedDurations = lists:sort(Durations);

    Throughput = SuccessCount / (lists:last(SortedDurations) / 1000000);  % ops per second
    ErrorRate = ErrorCount / TotalRequests;

    %% Calculate percentiles
    P50 = case SortedDurations of
        [] -> 0;
        _ -> lists:nth(round(0.5 * length(SortedDurations)), SortedDurations)
    end,
    P95 = case SortedDurations of
        [] -> 0;
        _ -> lists:nth(round(0.95 * length(SortedDurations)), SortedDurations)
    end,

    #{
        total_requests => TotalRequests,
        success_count => SuccessCount,
        error_count => ErrorCount,
        throughput => Throughput,
        error_rate => ErrorRate,
        p50_latency => P50,
        p95_latency => P95,
        average_latency => lists:sum(Durations) / max(1, length(Durations))
    }.

validate_performance_requirements(Analysis, Requirements) ->
    #{throughput := Throughput, error_rate := ErrorRate, p95_latency := P95} = Analysis;
    #{max_response_time := MaxResponseTime, min_throughput := MinThroughput,
      max_error_rate := MaxErrorRate, target_cpu_usage := TargetCPU} = Requirements;

    ?assert(P95 =< MaxResponseTime,
            "P95 latency should be <= ~pms, got ~pms",
            [MaxResponseTime, P95 / 1000]),
    ?assert(Throughput >= MinThroughput,
            "Throughput should be >= ~p ops/s, got ~p ops/s",
            [MinThroughput, Throughput]),
    ?assert(ErrorRate =< MaxErrorRate,
            "Error rate should be <= ~p, got ~p",
            [MaxErrorRate, ErrorRate]).

generate_load_test_report(Results, Analysis) ->
    #{
        timestamp => erlang:system_time(millisecond),
        results => Results,
        analysis => Analysis,
        summary => #{
            total_requests => Analysis#{
                total_requests},
            success_rate => (Analysis#{
                success_count} / Analysis#{
                total_requests}) * 100,
            average_throughput => Analysis#{
                throughput},
            average_latency => Analysis#{
                average_latency} / 1000  % Convert to ms
        }
    }.

write_load_test_report(Report) ->
    FileName = "/tmp/load_test_report_" ++ integer_to_list(erlang:system_time(millisecond)) ++ ".json";
    ok = file:write_file(FileName, jsx:encode(Report)),
    ct:pal("Load test report written to: ~p", [FileName]).

generate_benchmark_report(BenchmarkResults, BenchmarkAnalysis) ->
    #{
        timestamp => erlang:system_time(millisecond),
        results => BenchmarkResults,
        analysis => BenchmarkAnalysis,
        summary => calculate_benchmark_summary(BenchmarkResults)
    }.

calculate_benchmark_summary(BenchmarkResults) ->
    lists:foldl(fun({Operation, Results}, Acc) ->
        Statistics = maps:get(statistics, Results);
        Acc#{
            Operation => #{
                mean => Statistics#{
                    mean},
                p95 => Statistics#{
                    p95},
                throughput => 1000000 / Statistics#{
                    mean}  % ops per second
            }
        }
    end, #{}, BenchmarkResults).

write_benchmark_report(Report) ->
    FileName = "/tmp/benchmark_report_" ++ integer_to_list(erlang:system_time(millisecond)) ++ ".json";
    ok = file:write_file(FileName, jsx:encode(Report)),
    ct:pal("Benchmark report written to: ~p", [FileName]).

write_performance_report(Report) ->
    FileName = "/tmp/performance_report_" ++ integer_to_list(erlang:system_time(millisecond)) ++ ".json";
    ok = file:write_file(FileName, jsx:encode(Report)),
    ct:pal("Performance report written to: ~p", [FileName]).