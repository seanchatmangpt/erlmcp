%%%-------------------------------------------------------------------
%%% @doc
%%% HTTP/2 SSE Transport using Gun Backend
%%%
%%% This module provides a high-performance Server-Sent Events (SSE)
%%% transport implementation using Gun's HTTP/2 capabilities for enhanced
%%% features like multiplexing, flow control, and automatic recovery.
%%%
%%% Features:
%%% - HTTP/2 multiplexing for efficient streaming
%%% - Automatic connection recovery with exponential backoff
%%% - Connection pooling and backpressure handling
%%% - Enhanced monitoring and metrics collection
%%% - Flow control per stream
%%% - Compression support
%%% - Comprehensive error handling
%%%
%%% == Gun HTTP/2 Advantages ==
%%% - Binary framing for efficient transport
%%% - Header compression (HPACK)
%%% - Multiplexed streams (multiple SSE connections per HTTP/2 connection)
%%% - Flow control prevents buffer overflow
%%% - Automatic protocol negotiation (HTTP/1.1 fallback)
%%% - Better performance under high load
%%%
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_transport_sse_gun).

-behaviour(gen_server).

%% API exports
-export([start_link/1, start_link/2,
         send/2, close/1, get_info/1, get_metrics/1,
         connect/2, disconnect/1, get_status/1,
         acquire_connection/1, release_connection/2]).

%% gen_server callbacks
-export([init/1, handle_call/3, handle_cast/2, handle_info/2, terminate/2, code_change/3]).

%% Transport behavior callbacks (for compatibility)
-export([get_info/1, handle_transport_call/2]).

-include_lib("kernel/include/logger.hrl").
-include("erlmcp.hrl").

%% Records
-record(stream_state, {
    stream_ref :: gun:stream_ref() | undefined,
    client_pid :: pid() | undefined,
    session_id :: binary(),
    connect_time :: integer(),
    last_activity :: integer(),
    messages_sent = 0 :: non_neg_integer(),
    bytes_sent = 0 :: non_neg_integer(),
    retry_count = 0 :: non_neg_integer(),
    backpressure_timer :: reference() | undefined
}).

-record(connection_pool, {
    connections = #{} :: #{gun:stream_ref() => #stream_state{}},
    active_connections = 0 :: non_neg_integer(),
    max_connections = 100 :: pos_integer(),
    pending_requests = queue:new() :: queue:queue(),
    pool_monitor :: reference() | undefined
}).

-record(state, {
    transport_id :: binary(),
    mode :: client | server,
    gun_pid :: pid() | undefined,
    gun_monitor :: reference() | undefined,
    pool :: #connection_pool{},
    host :: inet:hostname(),
    port :: inet:port_number(),
    transport :: tcp | ssl,
    opts :: map(),
    retry_attempts = 0 :: non_neg_integer(),
    max_retries = infinity :: pos_integer() | infinity,
    reconnect_timer :: reference() | undefined,
    metrics :: metrics(),
    shutdown_timer :: reference() | undefined,
    last_activity :: integer()
}).

%% Metrics record
-record(metrics, {
    total_connections = 0 :: non_neg_integer(),
    active_connections = 0 :: non_neg_integer(),
    failed_connections = 0 :: non_neg_integer(),
    total_messages_sent = 0 :: non_neg_integer(),
    total_bytes_sent = 0 :: non_neg_integer(),
    total_bytes_received = 0 :: non_neg_integer(),
    avg_latency_ms = 0.0 :: float(),
    stream_resets = 0 :: non_neg_integer(),
    connection_errors = 0 :: non_neg_integer(),
    recovery_attempts = 0 :: non_neg_integer()
}).

%% Type definitions
-type stream_state() :: #stream_state{}.
-type connection_pool() :: #connection_pool{}.
-type state() :: #state{}.
-type metrics() :: #metrics{}.
-type sse_opts() :: #{
    transport_id := binary(),
    mode => client | server,
    host => inet:hostname(),
    port => inet:port_number(),
    transport => tcp | ssl,
    ssl_options => [ssl:tls_client_option()],
    max_connections => pos_integer(),
    max_retries => pos_integer() | infinity,
    retry_timeout => timeout(),
    flow_control_window => pos_integer(),
    enable_compression => boolean(),
    trace => boolean(),
    pool_name => atom()
}.

-type send_result() :: ok | {error, term()}.
-type info_result() :: #{atom() => term()}.

-export_type([sse_opts/0, send_result/0, info_result/0, stream_state/0]).

%% Default values
-define(DEFAULT_PORT, 8080).
-define(DEFAULT_SSL_PORT, 8443).
-define(DEFAULT_TRANSPORT, tcp).
-define(DEFAULT_MAX_CONNECTIONS, 100).
-define(DEFAULT_MAX_RETRIES, 5).
-define(DEFAULT_RETRY_TIMEOUT, 5000).
-define(DEFAULT_FLOW_WINDOW, 65535).
-define(DEFAULT_IDLE_TIMEOUT, 300000). %% 5 minutes
-define(RECONNECT_BACKOFF_MAX, 30000). %% 30 seconds max backoff
-define(PING_INTERVAL, 30000). %% 30 seconds
-define(DEFAULT_MAX_MESSAGE_SIZE, 16777216). %% 16MB
-define(CONNECTION_MONITOR_INTERVAL, 60000). %% 1 minute
-define(STREAM_TIMEOUT, 300000). %% 5 minutes per stream
-define(BACKPRESSURE_THRESHOLD, 0.8). %% 80% buffer usage
-define(BACKPRESSURE_TIMEOUT, 5000). %% 5 seconds

%%%===================================================================
%%% API
%%%===================================================================

%% @doc Start SSE transport with options
-spec start_link(sse_opts()) -> {ok, pid()} | {error, term()}.
start_link(Opts) when is_map(Opts) ->
    gen_server:start_link(?MODULE, Opts, []).

%% @doc Start named SSE transport (for connection pooling)
-spec start_link(atom(), sse_opts()) -> {ok, pid()} | {error, term()}.
start_link(PoolName, Opts) when is_atom(PoolName), is_map(Opts) ->
    gen_server:start_link({local, PoolName}, ?MODULE, Opts#{pool_name => PoolName}, []).

%% @doc Send SSE event to specific client
-spec send(pid(), binary()) -> send_result().
send(ClientPid, Data) when is_pid(ClientPid), is_binary(Data) ->
    gen_server:call(ClientPid, {send_event, Data}, 5000).

%% @doc Close SSE connection
-spec close(pid()) -> ok.
close(ClientPid) when is_pid(ClientPid) ->
    gen_server:cast(ClientPid, close).

%% @doc Get transport information
-spec get_info(pid() | state()) -> info_result().
get_info(Pid) when is_pid(Pid) ->
    case gen_server:call(Pid, get_info, 5000) of
        {ok, Info} -> Info;
        _ -> #{status => error, transport_id => undefined}
    end;
get_info(#state{} = State) ->
    get_info_from_state(State).

%% @doc Get transport metrics
-spec get_metrics(pid()) -> {ok, map()} | {error, term()}.
get_metrics(Pid) when is_pid(Pid) ->
    gen_server:call(Pid, get_metrics, 5000).

%% @doc Connect to SSE endpoint (client mode)
-spec connect(pid(), sse_opts()) -> ok | {error, term()}.
connect(Pid, Opts) when is_pid(Pid), is_map(Opts) ->
    gen_server:call(Pid, {connect, Opts}, 10000).

%% @brief Disconnect from SSE endpoint
-spec disconnect(pid()) -> ok.
disconnect(Pid) when is_pid(Pid) ->
    gen_server:cast(Pid, disconnect).

%% @brief Get connection status
-spec get_status(pid()) -> {ok, map()} | {error, term()}.
get_status(Pid) when is_pid(Pid) ->
    gen_server:call(Pid, get_status, 5000).

%% @brief Acquire connection from pool
-spec acquire_connection(sse_opts()) -> {ok, pid()} | {error, term()}.
acquire_connection(Opts) when is_map(Opts) ->
    PoolName = maps:get(pool_name, Opts, erlmcp_sse_gun_pool),
    case whereis(PoolName) of
        undefined ->
            {error, pool_not_started};
        _ ->
            gen_server:call(PoolName, {acquire_connection, Opts}, 5000)
    end.

%% @brief Release connection back to pool
-spec release_connection(pid(), term()) -> ok.
release_connection(Connection, _Reason) when is_pid(Connection) ->
    PoolName = erlmcp_sse_gun_pool,
    case whereis(PoolName) of
        undefined -> ok;
        _Pid -> gen_server:cast(PoolName, {release_connection, Connection})
    end.

%%%===================================================================
%%% gen_server Callbacks
%%%===================================================================

%% @doc Initialize gen_server
init(Opts) when is_map(Opts) ->
    process_flag(trap_exit, true),

    TransportId = maps:get(transport_id, Opts),
    Mode = maps:get(mode, Opts, client),
    Host = maps:get(host, Opts, "localhost"),
    Port = maps:get(port, Opts, case maps:get(transport, Opts, ?DEFAULT_TRANSPORT) of
        ssl -> ?DEFAULT_SSL_PORT;
        tcp -> ?DEFAULT_PORT
    end),
    Transport = maps:get(transport, Opts, ?DEFAULT_TRANSPORT),
    MaxConnections = maps:get(max_connections, Opts, ?DEFAULT_MAX_CONNECTIONS),
    MaxRetries = maps:get(max_retries, Opts, ?DEFAULT_MAX_RETRIES),

    %% Initialize connection pool
    Pool = #connection_pool{
        max_connections = MaxConnections
    },

    %% Initialize metrics
    Metrics = initial_metrics(),

    State = #state{
        transport_id = TransportId,
        mode = Mode,
        host = Host,
        port = Port,
        transport = Transport,
        opts = Opts,
        pool = Pool,
        max_retries = MaxRetries,
        metrics = Metrics,
        last_activity = erlang:monotonic_time(millisecond)
    },

    logger:info("SSE Gun transport starting: ~p on ~s:~p mode=~p",
                [TransportId, Host, Port, Mode]),

    case Mode of
        server ->
            {ok, State};
        client ->
            %% Start with initial connection attempt
            self() ! connect,
            {ok, State}
    end.

%% @doc Handle synchronous calls
handle_call({send_event, Data}, _From, #state{gun_pid = GunPid, pool = Pool} = State) ->
    case send_sse_event(GunPid, Pool, Data) of
        {ok, NewPool} ->
            %% Update metrics
            NewState = State#state{
                pool = NewPool,
                metrics = update_send_metrics(State#state.metrics, Data),
                last_activity = erlang:monotonic_time(millisecond)
            },
            {reply, ok, NewState};
        {error, _} = Error ->
            {reply, Error, State, hibernate}
    end;

handle_call({connect, NewOpts}, _From, #state{mode = client} = State) ->
    %% Update connection parameters
    NewState = State#state{
        host = maps:get(host, NewOpts, State#state.host),
        port = maps:get(port, NewOpts, State#state.port),
        opts = NewOpts
    },

    %% Trigger connection
    self() ! connect,
    {reply, ok, NewState};

handle_call({transport_call, Request}, _From, State) ->
    case handle_transport_request(Request, State) of
        {ok, Reply} ->
            {reply, Reply, State};
        {error, Reason} ->
            {reply, {error, Reason}, State, hibernate}
    end;

handle_call(get_info, _From, State) ->
    Info = get_info_from_state(State),
    {reply, {ok, Info}, State, hibernate};

handle_call(get_metrics, _From, #state{metrics = Metrics} = State) ->
    MetricsMap = #{
        total_connections => Metrics#metrics.total_connections,
        active_connections => Metrics#metrics.active_connections,
        failed_connections => Metrics#metrics.failed_connections,
        total_messages_sent => Metrics#metrics.total_messages_sent,
        total_bytes_sent => Metrics#metrics.total_bytes_sent,
        total_bytes_received => Metrics#metrics.total_bytes_received,
        avg_latency_ms => Metrics#metrics.avg_latency_ms,
        stream_resets => Metrics#metrics.stream_resets,
        connection_errors => Metrics#metrics.connection_errors,
        recovery_attempts => Metrics#metrics.recovery_attempts
    },
    {reply, {ok, MetricsMap}, State, hibernate};

handle_call(get_status, _From, State) ->
    Status = #{
        transport_id => State#state.transport_id,
        mode => State#state.mode,
        host => State#state.host,
        port => State#state.port,
        transport => State#state.transport,
        gun_pid => State#state.gun_pid,
        active_connections => State#state.pool#connection_pool.active_connections,
        max_connections => State#state.pool#connection_pool.max_connections,
        retry_attempts => State#state.retry_attempts,
        max_retries => State#state.max_retries,
        last_activity => State#state.last_activity
    },
    {reply, {ok, Status}, State, hibernate};

handle_call({acquire_connection, Opts}, _From, #state{pool = Pool} = State) ->
    case can_add_connection(Pool) of
        true ->
            %% Create new connection
            case create_connection(State#state{opts = Opts}) of
                {ok, ConnPid, NewState} ->
                    {reply, {ok, ConnPid}, NewState};
                {error, _} = Error ->
                    {reply, Error, State}
            end;
        false ->
            %% Queue the request
            Pending = queue:in({acquire_connection, Opts}, Pool#connection_pool.pending_requests),
            NewPool = Pool#connection_pool{pending_requests = Pending},
            {noreply, State#state{pool = NewPool}}
    end;

handle_call(_Request, _From, State) ->
    {reply, {error, unknown_request}, State, hibernate}.

%% @doc Handle asynchronous casts
handle_cast(close, State) ->
    {stop, normal, State};

handle_cast(disconnect, #state{gun_pid = GunPid} = State) ->
    case GunPid of
        undefined ->
            {noreply, State};
        _ ->
            gun:close(GunPid),
            {noreply, State#state{gun_pid = undefined, gun_monitor = undefined}}
    end;

handle_cast({release_connection, Connection}, State) ->
    %% Return connection to pool (implementation depends on pool strategy)
    logger:debug("Releasing connection to pool: ~p", [Connection]),
    {noreply, State};

handle_cast(_Msg, State) ->
    {noreply, State, hibernate}.

%% @doc Handle info messages
handle_info(connect, #state{mode = client, retry_attempts = Attempts, max_retries = MaxRetries} = State) ->
    case attempt_connection(State) of
        {ok, NewState} when is_record(NewState, state) ->
            {noreply, NewState};
        {error, Reason} ->
            case should_retry(Attempts, MaxRetries) of
                true ->
                    %% Schedule retry with backoff
                    Delay = calculate_backoff(Attempts),
                    Timer = erlang:send_after(Delay, self(), connect),
                    logger:warning("Connection failed, retrying in ~p ms: ~p", [Delay, Reason]),
                    {noreply, State#state{reconnect_timer = Timer, retry_attempts = Attempts + 1}};
                false ->
                    logger:error("Max connection attempts reached: ~p", [Reason]),
                    {stop, {connection_failed, Reason}, State}
            end
    end;

handle_info({gun_up, GunPid, Protocol}, #state{gun_pid = GunPid} = State) ->
    logger:info("Gun connection established: ~p protocol=~p", [GunPid, Protocol]),

    %% Start connection monitor
    MonitorRef = erlang:send_after(?CONNECTION_MONITOR_INTERVAL, self(), check_connections),

    %% Update metrics
    UpdatedMetrics = State#state.metrics#metrics{
        total_connections = State#state.metrics#metrics.total_connections + 1,
        active_connections = State#state.metrics#metrics.active_connections + 1
    },

    {noreply, State#state{gun_monitor = MonitorRef, metrics = UpdatedMetrics}};

handle_info({gun_down, GunPid, Reason, _, _}, #state{gun_pid = GunPid} = State) ->
    logger:warning("Gun connection lost: ~p reason=~p", [GunPid, Reason]),

    %% Update metrics
    UpdatedMetrics = State#state.metrics#metrics{
        active_connections = State#state.metrics#metrics.active_connections - 1,
        connection_errors = State#state.metrics#metrics.connection_errors + 1,
        recovery_attempts = State#state.metrics#metrics.recovery_attempts + 1
    },

    %% Try to reconnect if in client mode
    case State#state.mode of
        client ->
            self() ! connect;
        server ->
            %% Server mode, wait for client reconnect
            ok
    end,

    {noreply, State#state{gun_pid = undefined, gun_monitor = undefined, metrics = UpdatedMetrics}};

handle_info({gun_response, GunPid, StreamRef, fin, Status, Headers},
            #state{gun_pid = GunPid, pool = Pool} = State) ->
    case handle_response(StreamRef, Status, Headers, Pool) of
        {ok, NewPool} ->
            {noreply, State#state{pool = NewPool}};
        {error, Reason} ->
            logger:warning("Error handling response: ~p", [Reason]),
            {noreply, State#state{pool = handle_stream_error(Pool, StreamRef, Reason)}}
    end;

handle_info({gun_data, GunPid, StreamRef, fin, Data},
            #state{gun_pid = GunPid, pool = Pool} = State) ->
    case handle_stream_data(StreamRef, Data, Pool) of
        {ok, NewPool} ->
            {noreply, State#state{pool = NewPool}};
        {error, Reason} ->
            logger:warning("Error handling stream data: ~p", [Reason]),
            {noreply, State#state{pool = handle_stream_error(Pool, StreamRef, Reason)}}
    end;

handle_info({gun_error, GunPid, StreamRef, Reason},
            #state{gun_pid = GunPid, pool = Pool} = State) ->
    logger:warning("Gun stream error: ~p reason=~p", [StreamRef, Reason]),

    %% Update metrics
    UpdatedMetrics = State#state.metrics#metrics{
        stream_resets = State#state.metrics#metrics.stream_resets + 1
    },

    {noreply, State#state{pool = handle_stream_error(Pool, StreamRef, Reason),
                          metrics = UpdatedMetrics}};

handle_info(check_connections, State) ->
    %% Check and cleanup idle connections
    case check_and_cleanup_connections(State) of
        {ok, NewState} ->
            %% Reschedule monitor
            MonitorRef = erlang:send_after(?CONNECTION_MONITOR_INTERVAL, self(), check_connections),
            {noreply, NewState#state{gun_monitor = MonitorRef}};
        {error, _} = Error ->
            logger:error("Connection check failed: ~p", [Error]),
            {stop, Error, State}
    end;

handle_info({timeout, Ref, connection_timeout},
            #state{pool = Pool} = State) ->
    logger:warning("Connection timeout for some streams"),
    NewPool = cleanup_timeout_streams(Pool, Ref),
    {noreply, State#state{pool = NewPool}};

handle_info({timeout, Ref, backpressure_timeout},
            #state{pool = Pool} = State) ->
    logger:info("Backpressure timeout, resuming stream"),
    NewPool = resolve_backpressure(Pool, Ref),
    {noreply, State#state{pool = NewPool}};

handle_info(_Info, State) ->
    {noreply, State, hibernate}.

%% @doc Cleanup on termination
terminate(Reason, #state{gun_pid = GunPid, gun_monitor = MonitorRef}) ->
    %% Cancel timers
    case MonitorRef of
        undefined -> ok;
        _ -> erlang:cancel_timer(MonitorRef)
    end,

    case State#state.reconnect_timer of
        undefined -> ok;
        Timer -> erlang:cancel_timer(Timer)
    end,

    %% Close Gun connection if active
    case GunPid of
        undefined -> ok;
        _ -> gun:close(GunPid)
    end,

    logger:info("SSE Gun transport terminating: ~p", [Reason]),
    ok.

%% @doc Handle code upgrades
code_change(_OldVsn, State, _Extra) ->
    {ok, State}.

%%%===================================================================
%%% Internal Functions
%%%===================================================================

%% @doc Attempt to establish Gun connection
-spec attempt_connection(state()) -> {ok, state()} | {error, term()}.
attempt_connection(#state{host = Host, port = Port, transport = Transport,
                          opts = Opts, metrics = Metrics} = State) ->
    %% Build Gun options for HTTP/2
    GunOpts = build_gun_opts(Transport, Opts),

    logger:info("Connecting to ~s:~p via ~p", [Host, Port, Transport]),

    case gun:open(Host, Port, GunOpts) of
        {ok, GunPid} ->
            %% Monitor Gun process
            MonitorRef = monitor(process, GunPid),

            %% Wait for protocol selection
            receive
                {gun_up, GunPid, Protocol} ->
                    logger:info("Gun connected with protocol: ~p", [Protocol]),
                    {ok, State#state{gun_pid = GunPid, gun_monitor = MonitorRef}};
                {'DOWN', MonitorRef, process, GunPid, Reason} ->
                    logger:error("Gun process died during connection: ~p", [Reason]),
                    {error, Reason}
            after 10000 ->
                %% Timeout
                gun:close(GunPid),
                {error, timeout}
            end;
        {error, Reason} ->
            logger:error("Failed to open Gun connection: ~p", [Reason]),
            {error, Reason}
    end.

%% @doc Build Gun options for HTTP/2 connection
-spec build_gun_opts(tcp | ssl, map()) -> map().
build_gun_opts(Transport, Opts) ->
    BaseOpts = #{
        transport => Transport,
        protocols => [http2, http], %% Try HTTP/2 first, fall back to HTTP/1.1
        retry => maps:get(retry, Opts, 3),
        retry_timeout => maps:get(retry_timeout, Opts, ?DEFAULT_RETRY_TIMEOUT),
        trace => maps:get(trace, Opts, false)
    },

    %% Add HTTP/2 specific options
    HTTP2Opts = #{
        max_concurrent_streams => maps:get(max_connections, Opts, ?DEFAULT_MAX_CONNECTIONS),
        initial_connection_window_size => maps:get(flow_control_window, Opts, ?DEFAULT_FLOW_WINDOW) * 10,
        initial_stream_window_size => maps:get(flow_control_window, Opts, ?DEFAULT_FLOW_WINDOW)
    },

    GunOpts1 = BaseOpts#{http2_opts => HTTP2Opts},

    %% Add SSL options if needed
    case Transport of
        ssl ->
            SSLOpts = build_ssl_options(maps:get(ssl_options, Opts, [])),
            GunOpts1#{transport_opts => SSLOpts};
        tcp ->
            GunOpts1
    end.

%% @doc Build SSL options for Gun
-spec build_ssl_options([ssl:tls_client_option()]) -> [ssl:tls_client_option()].
build_ssl_options(SSLOpts) ->
    OTPVersion = get_otp_version(),

    %% OTP 27-28: Prefer TLS 1.3
    Versions = case OTPVersion of
        V when V >= 27 -> ['tlsv1.3', 'tlsv1.2'];
        _ -> ['tlsv1.2', 'tlsv1.3']
    end,

    %% OTP 27-28: TLS 1.3 optimized cipher suites
    Ciphers = case OTPVersion of
        Ver when Ver >= 27 ->
            ["TLS_AES_256_GCM_SHA384",
             "TLS_AES_128_GCM_SHA256",
             "TLS_CHACHA20_POLY1305_SHA256"];
        _ ->
            ["ECDHE-RSA-AES256-GCM-SHA384",
             "ECDHE-RSA-AES128-GCM-SHA256",
             "ECDHE-RSA-CHACHA20-POLY1305"]
    end,

    %% Base SSL options
    BaseOpts = [
        {versions, Versions},
        {ciphers, Ciphers},
        {secure_renegotiate, true},
        {honor_cipher_order, true},
        {verify, verify_none} %% Consider client cert auth
    ],

    BaseOpts ++ SSLOpts.

%% @doc Send SSE event using Gun
-spec send_sse_event(pid(), connection_pool(), binary()) -> {ok, connection_pool()} | {error, term()}.
send_sse_event(GunPid, #connection_pool{connections = Connections}, Data) ->
    case maps:size(Connections) > 0 of
        true ->
            %% For now, send to first available connection
            %% TODO: Implement proper stream selection based on load balancing
            {StreamRef, StreamState} = maps:iterator_next(maps:iterator(Connections)),

            %% Send SSE event
            gun:ws_send(GunPid, StreamRef, {text, Data}),

            %% Update stream state
            UpdatedStreamState = StreamState#stream_state{
                last_activity = erlang:monotonic_time(millisecond),
                messages_sent = StreamState#stream_state.messages_sent + 1,
                bytes_sent = StreamState#stream_state.bytes_sent + byte_size(Data)
            },

            NewConnections = maps:put(StreamRef, UpdatedStreamState, Connections),
            {ok, #connection_pool{connections = NewConnections}};
        false ->
            {error, no_active_connections}
    end.

%% @doc Handle Gun response
-spec handle_response(gun:stream_ref(), integer(), list(), connection_pool()) ->
                        {ok, connection_pool()} | {error, term()}.
handle_response(StreamRef, Status, Headers, Pool) ->
    case Status of
        200 ->
            logger:debug("SSE stream established: ~p", [StreamRef]),
            %% Create new stream state
            StreamState = #stream_state{
                stream_ref = StreamRef,
                session_id = generate_session_id(),
                connect_time = erlang:monotonic_time(millisecond),
                last_activity = erlang:monotonic_time(millisecond)
            },

            NewConnections = maps:put(StreamRef, StreamState, Pool#connection_pool.connections),
            {ok, Pool#connection_pool{
                connections = NewConnections,
                active_connections = Pool#connection_pool.active_connections + 1
            }};
        _ ->
            logger:warning("SSE connection failed: status=~p headers=~p", [Status, Headers]),
            {error, {http_error, Status}}
    end.

%% @doc Handle incoming stream data
-spec handle_stream_data(gun:stream_ref(), binary(), connection_pool()) ->
                           {ok, connection_pool()} | {error, term()}.
handle_stream_data(StreamRef, Data, Pool) ->
    case maps:get(StreamRef, Pool#connection_pool.connections, undefined) of
        #stream_state{} = StreamState ->
            %% Update stream state with received data
            UpdatedStreamState = StreamState#stream_state{
                last_activity = erlang:monotonic_time(millisecond),
                bytes_sent = StreamState#stream_state.bytes_sent + byte_size(Data)
            },

            NewConnections = maps:put(StreamRef, UpdatedStreamState, Pool#connection_pool.connections),
            {ok, Pool#connection_pool{connections = NewConnections}};
        undefined ->
            logger:warning("Received data for unknown stream: ~p", [StreamRef]),
            {error, unknown_stream}
    end.

%% @doc Handle stream errors
-spec handle_stream_error(connection_pool(), gun:stream_ref(), term()) -> connection_pool().
handle_stream_error(Pool, StreamRef, Reason) ->
    case maps:get(StreamRef, Pool#connection_pool.connections, undefined) of
        #stream_state{} = StreamState ->
            logger:warning("Stream error: ~p reason=~p", [StreamRef, Reason]),

            %% Remove failed stream
            NewConnections = maps:remove(StreamRef, Pool#connection_pool.connections),

            %% Attempt to reconnect if this was a client stream
            if StreamState#stream_state.client_pid =/= undefined ->
                StreamState#stream_state.client_pid ! {sse_error, Reason};
            true -> ok
            end,

            Pool#connection_pool{
                connections = NewConnections,
                active_connections = Pool#connection_pool.active_connections - 1
            };
        undefined ->
            %% Unknown stream, just update active connections
            Pool#connection_pool{
                active_connections = Pool#connection_pool.active_connections - 1
            }
    end.

%% @doc Check and cleanup idle/invalid connections
-spec check_and_cleanup_connections(state()) -> {ok, state()} | {error, term()}.
check_and_cleanup_connections(#state{pool = Pool} = State) ->
    Now = erlang:monotonic_time(millisecond),

    %% Filter out idle connections
    IdleConnections = maps:filter(fun(_StreamRef, StreamState) ->
        is_connection_idle(StreamState, Now)
    end, Pool#connection_pool.connections),

    case maps:size(IdleConnections) < maps:size(Pool#connection_pool.connections) of
        true ->
            logger:info("Cleaned up ~p idle connections",
                       [maps:size(Pool#connection_pool.connections) - maps:size(IdleConnections)]),
            NewPool = Pool#connection_pool{
                connections = IdleConnections,
                active_connections = maps:size(IdleConnections)
            },
            {ok, State#state{pool = NewPool}};
        false ->
            {ok, State}
    end.

%% @doc Check if connection is idle
-spec is_connection_idle(stream_state(), integer()) -> boolean().
is_connection_idle(#stream_state{last_activity = LastActivity}, Now) ->
    Diff = Now - LastActivity,
    Diff < ?STREAM_TIMEOUT.

%% @doc Cleanup timeout streams
-spec cleanup_timeout_streams(connection_pool(), reference()) -> connection_pool().
cleanup_timeout_streams(Pool, TimeoutRef) ->
    %% Find and remove streams with timeout
    UpdatedConnections = maps:filter(fun(_StreamRef, StreamState) ->
        case StreamState#stream_state.backpressure_timer of
            TimeoutRef -> false; %% Remove timed out stream
            _ -> true
        end
    end, Pool#connection_pool.connections),

    Pool#connection_pool{
        connections = UpdatedConnections,
        active_connections = maps:size(UpdatedConnections)
    }.

%% @brief Resolve backpressure condition
-spec resolve_backpressure(connection_pool(), reference()) -> connection_pool().
resolve_backpressure(Pool, TimeoutRef) ->
    UpdatedConnections = maps:map(fun(StreamRef, StreamState) ->
        case StreamState#stream_state.backpressure_timer of
            TimeoutRef ->
                %% Clear backpressure timer
                StreamState#stream_state{backpressure_timer = undefined};
            _ ->
                StreamState
        end
    end, Pool#connection_pool.connections),

    Pool#connection_pool{connections = UpdatedConnections}.

%% @doc Create new connection
-spec create_connection(state()) -> {ok, pid(), state()} | {error, term()}.
create_connection(#state{gun_pid = undefined} = State) ->
    %% Need to establish Gun connection first
    case attempt_connection(State) of
        {ok, NewState} ->
            %% Create SSE handler process
            case create_sse_handler(NewState) of
                {ok, HandlerPid, FinalState} ->
                    {ok, HandlerPid, FinalState};
                {error, _} = Error ->
                    Error
            end;
        {error, _} = Error ->
            Error
    end;
create_connection(#state{gun_pid = GunPid} = State) ->
    %% Gun connection exists, create SSE handler directly
    create_sse_handler(State).

%% @brief Create SSE handler process
-spec create_sse_handler(state()) -> {ok, pid(), state()} | {error, term()}.
create_sse_handler(#state{gun_pid = GunPid, transport_id = TransportId} = State) ->
    %% Generate unique session ID
    SessionId = generate_session_id(),

    %% Create new stream for SSE
    StreamRef = gun:ws_send(GunPid, {text, <<"{\"type\":\"ping\"}">>}),

    %% Create stream state
    StreamState = #stream_state{
        stream_ref = StreamRef,
        session_id = SessionId,
        connect_time = erlang:monotonic_time(millisecond),
        last_activity = erlang:monotonic_time(millisecond)
    },

    %% Update pool
    NewConnections = maps:put(StreamRef, StreamState, State#state.pool#connection_pool.connections),
    NewPool = State#state.pool#connection_pool{
        connections = NewConnections,
        active_connections = State#state.pool#connection_pool.active_connections + 1
    },

    %% Update metrics
    UpdatedMetrics = State#state.metrics#metrics{
        active_connections = State#state.metrics#metrics.active_connections + 1
    },

    HandlerPid = self(), %% Use gen_server itself as handler for simplicity

    {ok, HandlerPid, State#state{pool = NewPool, metrics = UpdatedMetrics}}.

%% @doc Check if we can add more connections
-spec can_add_connection(connection_pool()) -> boolean().
can_add_connection(#connection_pool{active_connections = Active, max_connections = Max}) ->
    Active < Max.

%% @doc Check if we should retry connection
-spec should_retry(non_neg_integer(), pos_integer() | infinity) -> boolean().
should_retry(_Attempts, infinity) -> true;
should_retry(Attempts, Max) when is_integer(Max) ->
    Attempts < Max.

%% @doc Calculate exponential backoff delay
-spec calculate_backoff(non_neg_integer()) -> timeout().
calculate_backoff(Attempts) ->
    BaseDelay = min(?DEFAULT_RETRY_TIMEOUT * (1 bsl Attempts), ?RECONNECT_BACKOFF_MAX),
    Jitter = rand:uniform(BaseDelay div 4),
    BaseDelay + Jitter.

%% @brief Generate unique session ID
-spec generate_session_id() -> binary().
generate_session_id() ->
    base64:encode(crypto:strong_rand_bytes(16)).

%% @brief Get OTP version
-spec get_otp_version() -> integer().
get_otp_version() ->
    try
        VersionStr = erlang:system_info(otp_release),
        [MajorStr | _] = string:split(VersionStr, "."),
        list_to_integer(MajorStr)
    catch
        _:_ -> 0
    end.

%% @brief Handle transport-specific requests
-spec handle_transport_request(term(), state()) -> {ok, term()} | {error, term()}.
handle_transport_request(get_connections, State) ->
    {ok, State#state.pool#connection_pool.connections};
handle_transport_request(get_pool_stats, State) ->
    {ok, #{
        size => maps:size(State#state.pool#connection_pool.connections),
        max => State#state.pool#connection_pool.max_connections,
        active => State#state.pool#connection_pool.active_connections,
        pending => queue:len(State#state.pool#connection_pool.pending_requests)
    }};
handle_transport_request(_Request, _State) ->
    {error, unknown_request}.

%% @brief Get transport information from state
-spec get_info_from_state(state()) -> map().
get_info_from_state(#state{transport_id = Id, mode = Mode,
                          host = Host, port = Port, transport = Transport,
                          gun_pid = GunPid, pool = Pool, metrics = Metrics}) ->
    #{
        transport_id => Id,
        mode => Mode,
        host => Host,
        port => Port,
        transport => Transport,
        status => case GunPid of
            undefined -> disconnected;
            _ -> connected
        end,
        connections => maps:size(Pool#connection_pool.connections),
        active_connections => Pool#connection_pool.active_connections,
        max_connections => Pool#connection_pool.max_connections,
        total_messages_sent => Metrics#metrics.total_messages_sent,
        total_bytes_sent => Metrics#metrics.total_bytes_sent,
        connection_errors => Metrics#metrics.connection_errors,
        recovery_attempts => Metrics#metrics.recovery_attempts
    }.

%% @brief Initialize metrics record
-spec initial_metrics() -> metrics().
initial_metrics() ->
    #metrics{}.

%% @brief Update send metrics
-spec update_send_metrics(metrics(), binary()) -> metrics().
update_send_metrics(#metrics{total_messages_sent = Messages} = Metrics, Data) ->
    Metrics#metrics{
        total_messages_sent = Messages + 1,
        total_bytes_sent = Metrics#metrics.total_bytes_sent + byte_size(Data)
    }.

%% @brief Convert term to binary
-spec to_binary(term()) -> binary().
to_binary(B) when is_binary(B) -> B;
to_binary(S) when is_list(S) -> list_to_binary(S);
to_binary(A) when is_atom(A) -> atom_to_binary(A, utf8);
to_binary(I) when is_integer(I) -> integer_to_binary(I).