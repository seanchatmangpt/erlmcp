%%%-------------------------------------------------------------------
%%% @doc
%%% Comprehensive Common Test suite for erlmcp_transport_sse_gun module
%%%
%%% This test suite validates the SSE transport with Gun functionality including:
%%% - SSE connection establishment and management
%%% - Gun HTTP/2 client integration
%%% - Server-Sent Events streaming
%%% - Event parsing and routing
%%% - Connection recovery and reconnection
%%% - Error handling and recovery
%%% - Performance characteristics
%%% - Concurrent SSE connections
%%% - Event message validation
%%% - Integration with transport registry
%%% - WebSocket fallback capabilities
%%% - Gun configuration and optimization
%%% - SSE protocol compliance
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_transport_sse_gun_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("eunit/include/eunit.hrl").
-include("erlmcp.hrl").

%% Suite callbacks
-export([all/0, groups/0, init_per_suite/1, end_per_suite/1, init_per_group/2, end_per_group/2,
         init_per_testcase/2, end_per_testcase/2]).

%% Test cases
-export([module_exists/1,
         sse_connection/1,
         gun_integration/1,
         event_streaming/1,
         event_routing/1,
         connection_recovery/1,
         error_handling/1,
         performance_benchmarks/1,
         concurrent_connections/1,
         event_validation/1,
         integration_tests/1,
         websocket_fallback/1,
         gun_configuration/1,
         sse_protocol_compliance/1]).

%%====================================================================
%% Suite Configuration
%%====================================================================

all() ->
    [{group, core_functionality},
     {group, streaming_tests},
     {group, recovery_tests},
     {group, performance_tests},
     {group, concurrent_tests},
     {group, compliance_tests}].

groups() ->
    [{core_functionality, [parallel],
      [module_exists, sse_connection, gun_integration]},
     {streaming_tests, [parallel],
      [event_streaming, event_routing, event_validation]},
     {recovery_tests, [parallel],
      [connection_recovery, error_handling]},
     {performance_tests, [parallel],
      [performance_benchmarks]},
     {concurrent_tests, [parallel],
      [concurrent_connections]},
     {compliance_tests, [parallel],
      [integration_tests, websocket_fallback, gun_configuration, sse_protocol_compliance]}].

%%====================================================================
%% Suite Setup/Teardown
%%====================================================================

init_per_suite(Config) ->
    ct:pal("Starting SSE Gun transport test suite"),

    % Start required applications
    {ok, Apps} = application:ensure_all_started(crypto),
    ct:pal("Started applications: ~p", [Apps]),

    % Start gun application if available
    case application:ensure_all_started(gun) of
        {ok, GunApps} ->
            ct:pal("Started gun: ~p", [GunApps]);
        {error, {already_started, gun}} ->
            ct:pal("Gun already started");
        {error, Reason} ->
            ct:pal("Warning: Gun not available: ~p", [Reason]),
            ct:pal("Tests requiring Gun will be skipped")
    end,

    % Start gproc for registry
    {ok, _} = application:ensure_all_started(gproc),

    % Start erlmcp_core application
    case application:ensure_all_started(erlmcp_core) of
        {ok, CoreApps} ->
            ct:pal("Started erlmcp_core: ~p", [CoreApps]);
        {error, Reason} ->
            ct:fail("Failed to start erlmcp_core: ~p", [Reason])
    end,

    % Check if Gun is available for tests
    case code:ensure_loaded(gun) of
        {module, gun} ->
            ct:pal("Gun module available - running full test suite");
        {error, _} ->
            ct:pal("Gun module not available - skipping Gun-specific tests"),
            Config = [{skip_gun_tests, true} | Config]
    end,

    % Check if SSE transport is available
    case code:ensure_loaded(erlmcp_transport_sse_gun) of
        {module, erlmcp_transport_sse_gun} ->
            ct:pal("SSE Gun transport available");
        {error, _} ->
            ct:pal("SSE Gun transport not available - creating mock implementation"),
            Config = [{sse_gun_mock, true} | Config]
    end,

    Config.

end_per_suite(_Config) ->
    ct:pal("Ending SSE Gun transport test suite"),
    % Clean up applications
    _ = application:stop(erlmcp_core),
    _ = application:stop(gproc),
    case application:stop(gun) of
        ok -> ok;
        {error, {not_started, gun}} -> ok;
        {error, Reason} -> ct:pal("Error stopping gun: ~p", [Reason])
    end,
    _ = application:stop(crypto),
    ok.

init_per_group(GroupName, Config) ->
    ct:pal("Starting test group: ~p", [GroupName]),
    Config.

end_per_group(GroupName, _Config) ->
    ct:pal("Ending test group: ~p", [GroupName]),
    ok.

init_per_testcase(TestCase, Config) ->
    ct:pal("Starting test case: ~p", [TestCase]),
    % Ensure clean state for each test
    cleanup_sse_connections(),
    Config.

end_per_testcase(TestCase, _Config) ->
    ct:pal("Ending test case: ~p", [TestCase]),
    % Clean up after each test
    cleanup_sse_connections(),
    ok.

%%====================================================================
%% Test Cases - Core Functionality
%%====================================================================

module_exists(Config) ->
    % Verify the SSE Gun transport module exists and loads correctly
    ?assert(code:is_loaded(erlmcp_transport_sse_gun) =/= false,
            "SSE Gun transport module not loaded"),

    % Check module exports
    Exports = erlmcp_transport_sse_gun:module_info(exports),
    ?assert(is_list(Exports), "Exports not a list"),
    ?assert(length(Exports) > 0, "No exports found"),

    % Verify key functions are exported
    RequiredExports = [start_link/1, stop/1, send/2, connect/1, disconnect/1,
                      get_connection/0, list_connections/0, get_stats/0],

    lists:foreach(fun({Func, Arity}) ->
                     ?assert(erlang:function_exported(erlmcp_transport_sse_gun, Func, Arity),
                             "Missing required function: ~p/~p", [Func, Arity])
                  end,
                  RequiredExports),
    ok.

sse_connection(Config) ->
    % Test SSE connection establishment and management

    % Create SSE transport configuration
    TransportId = <<"sse_connection_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  max_retries => 3,
                  retry_interval => 1000},

    % Test connection establishment
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} when is_pid(Pid) ->
            % Verify process is alive
            ?assert(is_process_alive(Pid), "Process not alive after start"),

            % Test connection status
            Status = erlmcp_transport_sse_gun:status(Pid),
            ?assert(is_map(Status), "Status not a map"),
            ?assert(maps:is_key(transport_id, Status), "Missing transport_id in status"),
            ?assert(maps:is_key(connection_state, Status), "Missing connection_state"),
            ?assert(maps:is_key(url, Status), "Missing url in status"),

            % Test explicit connection
            case erlmcp_transport_sse_gun:connect(Pid) of
                {ok, ConnId} ->
                    ?assert(is_binary(ConnId), "Connection ID should be binary"),
                    ct:pal("SSE connection established: ~p", [ConnId]);

                {error, Reason} ->
                    ct:pal("Connection establishment failed (expected in test): ~p", [Reason])
            end,

            % Test message sending
            TestMessage = #{<<"type">> => <<"test">>,
                          <<"data">> => <<"SSE connection test message">>},

            case erlmcp_transport_sse_gun:send(Pid, TestMessage) of
                ok ->
                    ct:pal("Message sent successfully");
                {error, Reason} ->
                    ct:pal("Send failed (expected in test): ~p", [Reason])
            end,

            % Test connection disconnection
            case erlmcp_transport_sse_gun:disconnect(Pid) of
                ok ->
                    ct:pal("Disconnection successful");
                {error, Reason} ->
                    ct:pal("Disconnection failed: ~p", [Reason])
            end,

            % Test process stop
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid)),

            % Verify process is terminated
            timer:sleep(100),
            ?assertNot(is_process_alive(Pid), "Process not terminated after stop");
        {error, Reason} ->
            ct:pal("SSE transport not available: ~p", [Reason])
    end,
    ok.

gun_integration(Config) ->
    % Test Gun HTTP/2 client integration

    case is_gun_available(Config) of
        true ->
            % Test Gun configuration
            GunConfig = #{transport_id => <<"gun_integration_test">>,
                         transport_type => sse_gun,
                         url => <<"http://localhost:8081/mcp/sse">>,
                         owner => self(),
                         test_mode => true,
                         gun_config => #{transport => tcp,
                                       transport_opts => [{verify_none, true}]},
                         max_retries => 2,
                         retry_interval => 500},

            % Start with Gun configuration
            case erlmcp_transport_sse_gun:start_link(GunConfig) of
                {ok, Pid} ->
                    % Verify Gun integration is working
                    Status = erlmcp_transport_sse_gun:status(Pid),
                    ?assert(is_map(Status), "Status not a map"),
                    ?assert(maps:is_key(gun_state, Status), "Missing gun_state"),
                    ?assert(maps:is_key(http2_active, Status), "Missing http2_active"),

                    % Test Gun-specific metrics
                    Stats = erlmcp_transport_sse_gun:get_stats(Pid),
                    ?assert(is_map(Stats), "Stats not a map"),
                    ?assert(maps:is_key(gun_connections, Stats), "Missing gun_connections"),
                    ?assert(maps:is_key(sse_events, Stats), "Missing sse_events"),

                    % Test Gun connection management
                    ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
                {error, Reason} ->
                    ct:fail("Gun integration failed: ~p", [Reason])
            end;
        false ->
            ct:pal("Skipping Gun integration tests - Gun not available")
    end,
    ok.

%%====================================================================
%% Test Cases - Streaming Tests
%%====================================================================

event_streaming(Config) ->
    % Test SSE event streaming functionality

    TransportId = <<"sse_streaming_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  streaming_enabled => true,
                  max_message_size => 1048576}, % 1MB

    % Start SSE transport
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Test event streaming setup
            SetupResult = erlmcp_transport_sse_gun:setup_stream(Pid,
                                                                 <<"test_stream">>,
                                                                 #{filter => <<"all">>}),
            ?assertMatch({ok, _}, SetupResult),

            % Send multiple test events
            Events = lists:map(fun(I) ->
                                     #{<<"event">> => <<"test">>,
                                       <<"data">> => #{<<"index">> => I,
                                                      <<"timestamp">> => erlang:system_time(millisecond)},
                                       <<"id">> => integer_to_binary(I),
                                       <<"retry">> => 5000}
                               end,
                               lists:seq(1, 10)),

            lists:foreach(fun(Event) ->
                             case erlmcp_transport_sse_gun:send(Pid, Event) of
                                 ok ->
                                     ct:pal("Event ~p sent successfully", [maps:get(<<"id">>, Event)]);
                                 {error, Reason} ->
                                     ct:pal("Event ~p send failed: ~p", [maps:get(<<"id">>, Event), Reason])
                             end
                           end,
                           Events),

            % Test stream status
            StreamStatus = erlmcp_transport_sse_gun:stream_status(Pid, <<"test_stream">>),
            ?assert(is_map(StreamStatus), "Stream status should be a map"),
            ?assert(maps:is_key(event_count, StreamStatus), "Missing event_count"),
            ?assert(maps:get(event_count, StreamStatus) >= 10, "Should have processed events"),

            % Test stream cleanup
            ?assertEqual(ok, erlmcp_transport_sse_gun:cleanup_stream(Pid, <<"test_stream">>)),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for streaming test: ~p", [Reason])
    end,
    ok.

event_routing(Config) ->
    % Test SSE event routing functionality

    TransportId = <<"sse_routing_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  routing_enabled => true},

    % Start SSE transport
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Set up event routing
            Routes = [
                {<<"tools.*">>, <<"tools_handler">>},
                {<<"resources.*">>, <<"resources_handler">>},
                {notifications, <<"notification_handler">>}
            ],

            lists:foreach(fun({Pattern, Handler}) ->
                             ?assertEqual(ok,
                                          erlmcp_transport_sse_gun:add_route(Pid, Pattern, Handler))
                           end,
                           Routes),

            % Test event routing with different event types
            ToolEvent = #{<<"event">> => <<"tools.call">>,
                         <<"data">> => #{<<"name">> => <<"test_tool">>}},
            ResourceEvent = #{<<"event">> => <<"resources.read">>,
                            <<"data">> => #{<<"uri">> => <<"test://resource">>}},
            NotificationEvent = #{<<"event">> => notification,
                               <<"data">> => #{<<"type">> => <<"progress">>}},

            lists:foreach(fun(Event) ->
                             case erlmcp_transport_sse_gun:send(Pid, Event) of
                                 ok ->
                                     ct:pal("Event routed successfully");
                                 {error, Reason} ->
                                     ct:pal("Event routing failed: ~p", [Reason])
                             end
                           end,
                           [ToolEvent, ResourceEvent, NotificationEvent]),

            % Test route removal
            ?assertEqual(ok, erlmcp_transport_sse_gun:remove_route(Pid, <<"tools.*">>)),

            % Test route statistics
            RouteStats = erlmcp_transport_sse_gun:get_route_stats(Pid),
            ?assert(is_map(RouteStats), "Route stats should be a map"),
            ?assert(maps:is_key(routers, RouteStats), "Missing routers in stats"),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for routing test: ~p", [Reason])
    end,
    ok.

event_validation(Config) ->
    % Test SSE event validation and compliance

    TransportId = <<"sse_validation_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  strict_validation => true},

    % Start SSE transport
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Test valid SSE events
            ValidEvents = [
                % Standard SSE event
                #{<<"event">> => <<"test">>,
                  <<"data">> => <<"test data">>,
                  <<"id">> => <<"1">>},
                % Event with retry
                #{<<"event">> => <<"retry">>,
                  <<"data">> => <<"retry data">>,
                  <<"id">> => <<"2">>,
                  <<"retry">> => 5000},
                % Comment event
                #{<<"comment">> => <<"Event stream comment">>},
                % Empty event
                #{<<"event">> => <<>>}
            ],

            lists:foreach(fun(Event) ->
                             % Validate event before sending
                             ValidationResult = erlmcp_transport_sse_gun:validate_event(Event),
                             ?assertMatch({ok, _}, ValidationResult),

                             % Send validated event
                             case erlmcp_transport_sse_gun:send(Pid, Event) of
                                 ok ->
                                     ct:pal("Valid event sent successfully");
                                 {error, Reason} ->
                                     ct:pal("Valid event send failed: ~p", [Reason])
                             end
                           end,
                           ValidEvents),

            % Test invalid SSE events
            InvalidEvents = [
                % Missing required fields
                #{},
                % Invalid event type
                #{<<"event">> => 123},
                % Invalid retry value
                #{<<"event">> => <<"test">>, <<"retry">> => not_an_integer},
                % Too large event
                LargeEvent = #{<<"event">> => <<"large">>,
                            <<"data">> => binary:copy(<<"x">>, 1048577)}, % > 1MB
                LargeEvent
            ],

            lists:foreach(fun(Event) ->
                             % Validate should fail
                             ValidationResult = erlmcp_transport_sse_gun:validate_event(Event),
                             ?assertMatch({error, _}, ValidationResult),

                             % Send should also fail
                             case erlmcp_transport_sse_gun:send(Pid, Event) of
                                 ok ->
                                     ct:pal("ERROR: Invalid event was sent successfully");
                                 {error, Reason} ->
                                     ct:pal("Invalid event correctly rejected: ~p", [Reason])
                             end
                           end,
                           InvalidEvents),

            % Test event statistics
            Stats = erlmcp_transport_sse_gun:get_stats(Pid),
            ?assert(is_map(Stats), "Stats should be a map"),
            ?assert(maps:is_key(validated_events, Stats), "Missing validated_events"),
            ?assert(maps:is_key(rejected_events, Stats), "Missing rejected_events"),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for validation test: ~p", [Reason])
    end,
    ok.

%%====================================================================
%% Test Cases - Recovery Tests
%%====================================================================

connection_recovery(Config) ->
    % Test SSE connection recovery and reconnection

    TransportId = <<"sse_recovery_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  auto_reconnect => true,
                  max_retries => 5,
                  retry_interval => 1000,
                  backoff_multiplier => 1.5},

    % Start SSE transport with recovery enabled
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Test initial connection
            InitialConn = erlmcp_transport_sse_gun:get_connection(Pid),
            case InitialConn of
                {ok, _} ->
                    ct:pal("Initial connection established");
                {error, Reason} ->
                    ct:pal("Initial connection failed: ~p", [Reason])
            end,

            % Simulate connection loss
            ?assertEqual(ok, erlmcp_transport_sse_gun:disconnect(Pid)),

            % Wait for reconnection attempt
            timer:sleep(2000),

            % Test recovery status
            RecoveryStatus = erlmcp_transport_sse_gun:recovery_status(Pid),
            ?assert(is_map(RecoveryStatus), "Recovery status should be a map"),
            ?assert(maps:is_key(recovery_attempts, RecoveryStatus), "Missing recovery_attempts"),
            ?assert(maps:is_key(last_recovery, RecoveryStatus), "Missing last_recovery"),

            % Test manual recovery
            RecoveryResult = erlmcp_transport_sse_gun:force_reconnect(Pid),
            ?assertMatch({ok, _}, RecoveryResult),

            % Test event buffer during recovery
            BufferStats = erlmcp_transport_sse_gun:get_buffer_stats(Pid),
            ?assert(is_map(BufferStats), "Buffer stats should be a map"),
            ?assert(maps:is_key(buffered_events, BufferStats), "Missing buffered_events"),
            ?assert(maps:is_key(buffer_size, BufferStats), "Missing buffer_size"),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for recovery test: ~p", [Reason])
    end,
    ok.

error_handling(Config) ->
    % Test SSE error handling and recovery

    % Test with invalid URL
    InvalidConfig = #{transport_id => <<"invalid_url">>,
                     transport_type => sse_gun,
                     url => <<"not-a-valid-url">>,
                     owner => self(),
                     test_mode => true},

    ?assertMatch({error, _}, erlmcp_transport_sse_gun:start_link(InvalidConfig)),

    % Test with missing required fields
    IncompleteConfig = #{transport_id => <<"incomplete">>,
                       transport_type => sse_gun,
                       owner => self()},

    ?assertMatch({error, _}, erlmcp_transport_sse_gun:start_link(IncompleteConfig)),

    % Test connection to non-existent server
    NonExistentConfig = #{transport_id => <<"non_existent">>,
                         transport_type => sse_gun,
                         url => <<"http://nonexistent.example.com/mcp/sse">>,
                         owner => self(),
                         test_mode => true,
                         max_retries => 2},

    case erlmcp_transport_sse_gun:start_link(NonExistentConfig) of
        {ok, Pid} ->
            % Should eventually fail with retries exhausted
            timer:sleep(5000), % Wait for retries
            Status = erlmcp_transport_sse_gun:status(Pid),
            ?assert(maps:get(connection_state, Status) =:= failed,
                     "Connection should be failed after retries"),
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("Expected failure for non-existent server: ~p", [Reason])
    end,

    % Test sending to disconnected transport
    ?assertMatch({error, _}, erlmcp_transport_sse_gun:send(undefined, <<"test">>)),
    ok.

%%====================================================================
%% Test Cases - Performance Tests
%%====================================================================

performance_benchmarks(Config) ->
    % Test SSE transport performance characteristics

    TransportId = <<"sse_perf_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  streaming_enabled => true,
                  batch_size => 100},

    % Start SSE transport
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Benchmark event streaming
            NumEvents = 1000,
            SmallEvents = lists:map(fun(I) ->
                                         #{<<"event">> => <<"benchmark">>,
                                           <<"data">> => #{<<"index">> => I},
                                           <<"id">> => integer_to_binary(I)}
                                     end,
                                     lists:seq(1, NumEvents)),

            Start = erlang:monotonic_time(millisecond),

            lists:foreach(fun(Event) ->
                             case erlmcp_transport_sse_gun:send(Pid, Event) of
                                 ok ->
                                     ok;
                                 {error, Reason} ->
                                     ct:pal("Event send failed: ~p", [Reason])
                             end
                           end,
                           SmallEvents),

            End = erlang:monotonic_time(millisecond),
            Duration = End - Start,

            ct:pal("SSE performance: ~p events in ~p ms", [NumEvents, Duration]),
            ct:pal("Average time per event: ~.2f ms", [Duration / NumEvents]),

            % Performance assertions
            ?assert(Duration < 10000, "Event streaming too slow: ~p ms", [Duration]),
            ?assert((Duration / NumEvents) < 10, "Per-event time too high: ~p ms",
                    [Duration / NumEvents]),

            % Benchmark large event handling
            LargeEvent = #{<<"event">> => <<"large">>,
                          <<"data">> => binary:copy(<<"x">>, 10240)}, % 10KB
            NumLargeEvents = 100,

            LargeStart = erlang:monotonic_time(millisecond),

            lists:repeat(NumLargeEvents, begin
                case erlmcp_transport_sse_gun:send(Pid, LargeEvent) of
                    ok -> ok;
                    {error, Reason} -> ct:pal("Large event failed: ~p", [Reason])
                end
            end),

            LargeEnd = erlang:monotonic_time(millisecond),
            LargeDuration = LargeEnd - LargeStart,

            ct:pal("Large event performance: ~p events x 10KB = ~p KB in ~p ms",
                   [NumLargeEvents, NumLargeEvents * 10, LargeDuration]),
            ct:pal("Average time per large event: ~.2f ms", [LargeDuration / NumLargeEvents]),

            % Performance assertions for large events
            ?assert(LargeDuration < 5000, "Large event streaming too slow: ~p ms",
                    [LargeDuration]),
            ?assert((LargeDuration / NumLargeEvents) < 50, "Per-large-event time too high: ~p ms",
                    [LargeDuration / NumLargeEvents]),

            % Test concurrent event streaming
            NumConcurrent = 10,
            ConcurrentEvents = lists:map(fun(I) ->
                                             #{<<"event">> => <<"concurrent">>,
                                               <<"data">> => #{<<"process">> => I},
                                               <<"id">> => integer_to_binary(I)}
                                         end,
                                         lists:seq(1, NumConcurrent)),

            ConcurrentStart = erlang:monotonic_time(millisecond),

            lists:foreach(fun(Event) ->
                             spawn_link(fun() ->
                                           case erlmcp_transport_sse_gun:send(Pid, Event) of
                                               ok -> ok;
                                               {error, Reason} -> ct:pal("Concurrent failed: ~p", [Reason])
                                           end
                                       end)
                           end,
                           ConcurrentEvents),

            % Wait for concurrent operations to complete
            timer:sleep(2000),

            ConcurrentEnd = erlang:monotonic_time(millisecond),
            ConcurrentDuration = ConcurrentEnd - ConcurrentStart,

            ct:pal("Concurrent performance: ~p concurrent events in ~p ms",
                   [NumConcurrent, ConcurrentDuration]),
            ct:pal("Average time per concurrent event: ~.2f ms",
                   [ConcurrentDuration / NumConcurrent]),

            % Get final statistics
            FinalStats = erlmcp_transport_sse_gun:get_stats(Pid),
            ?assert(is_map(FinalStats), "Final stats should be a map"),
            ?assert(maps:is_key(total_events_sent, FinalStats), "Missing total_events_sent"),
            ?assert(maps:is_key(total_bytes_sent, FinalStats), "Missing total_bytes_sent"),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for performance test: ~p", [Reason])
    end,
    ok.

%%====================================================================
%% Test Cases - Concurrent Tests
%%====================================================================

concurrent_connections(Config) ->
    % Test concurrent SSE connections

    NumConnections = 10,
    EventsPerConnection = 100,
    TransportPrefix = <<"concurrent_sse_">>,

    % Start time measurement
    Start = erlang:monotonic_time(millisecond),

    % Create concurrent SSE connections
    ConnectionPids = lists:map(fun(I) ->
                                    TransportId = <<TransportPrefix/binary, (integer_to_binary(I))/binary>>,
                                    Config = #{transport_id => TransportId,
                                             transport_type => sse_gun,
                                             url => <<"http://localhost:8081/mcp/sse">>,
                                             owner => self(),
                                             test_mode => true,
                                             streaming_enabled => true},

                                    case erlmcp_transport_sse_gun:start_link(Config) of
                                        {ok, Pid} ->
                                            {ok, Pid, I};
                                        {error, Reason} ->
                                            {error, I, Reason}
                                    end
                                end,
                                lists:seq(1, NumConnections)),

    FilteredPids = lists:filter(fun({ok, _, _}) -> true; (_) -> false end, ConnectionPids),
    SuccessfulConnections = length(FilteredPids),

    ct:pal("Started ~p concurrent SSE connections", [SuccessfulConnections]),

    % Send events to each connection
    EventStart = erlang:monotonic_time(millisecond),

    lists:foreach(fun({ok, Pid, I}) ->
                      Events = lists:map(fun(J) ->
                                               #{<<"event">> => <<"concurrent">>,
                                                 <<"data">> => #{<<"connection">> => I, <<"event">> => J},
                                                 <<"id">> => integer_to_binary(I * 1000 + J)}
                                           end,
                                           lists:seq(1, EventsPerConnection)),

                      lists:foreach(fun(Event) ->
                                       case erlmcp_transport_sse_gun:send(Pid, Event) of
                                           ok -> ok;
                                           {error, Reason} -> ct:pal("Event failed: ~p", [Reason])
                                       end
                                     end,
                                     Events)
                    end,
                    FilteredPids),

    EventEnd = erlang:monotonic_time(millisecond),
    EventDuration = EventEnd - EventStart,

    ct:pal("Event sending time: ~p ms for ~p connections x ~p events each = ~p total events",
           [EventDuration, SuccessfulConnections, EventsPerConnection,
            SuccessfulConnections * EventsPerConnection]),
    ct:pal("Average time per event: ~.2f ms",
           [EventDuration / (SuccessfulConnections * EventsPerConnection)]),

    % Test concurrent operations
    ConcurrentStart = erlang:monotonic_time(millisecond),

    ConcurrentOps = lists:map(fun({ok, Pid, I}) ->
                                  spawn_link(fun() ->
                                                % Test status retrieval
                                                Status = erlmcp_transport_sse_gun:status(Pid),
                                                ?assert(is_map(Status), "Status should be a map"),

                                                % Test statistics retrieval
                                                Stats = erlmcp_transport_sse_gun:get_stats(Pid),
                                                ?assert(is_map(Stats), "Stats should be a map"),

                                                ct:pal("Process ~p completed concurrent operations", [I])
                                            end)
                                end,
                                FilteredPids),

    % Wait for all concurrent operations to complete
    lists:foreach(fun(Pid) ->
                     receive
                         {'EXIT', Pid, _} -> ok
                     end
                   end,
                   ConcurrentOps),

    ConcurrentEnd = erlang:monotonic_time(millisecond),
    ConcurrentDuration = ConcurrentEnd - ConcurrentStart,

    ct:pal("Concurrent operations time: ~p ms", [ConcurrentDuration]),

    % Clean up all connections
    CleanupStart = erlmcp_transport_sse_gun:monotonic_time(millisecond),

    lists:foreach(fun({ok, Pid, _}) ->
                     ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid))
                   end,
                   FilteredPids),

    CleanupEnd = erlmcp_transport_sse_gun:monotonic_time(millisecond),
    CleanupDuration = CleanupEnd - CleanupStart,

    ct:pal("Cleanup time: ~p ms", [CleanupDuration]),

    % Final performance summary
    TotalDuration = EventDuration + ConcurrentDuration + CleanupDuration,
    TotalEvents = SuccessfulConnections * EventsPerConnection,

    ct:pal("Total performance summary:"),
    ct:pal("  Connections: ~p", [SuccessfulConnections]),
    ct:pal("  Total events: ~p", [TotalEvents]),
    ct:pal("  Total duration: ~p ms", [TotalDuration]),
    ct:pal("  Average time per event: ~.2f ms", [TotalDuration / TotalEvents]),
    ct:pal("  Average time per connection: ~.2f ms", [TotalDuration / SuccessfulConnections]),

    % Performance assertions
    ?assert(EventDuration < 10000, "Event sending too slow"),
    ?assert(ConcurrentDuration < 5000, "Concurrent operations too slow"),
    ?assert(CleanupDuration < 5000, "Cleanup too slow"),
    ok.

%%====================================================================
%% Test Cases - Compliance Tests
%%====================================================================

integration_tests(Config) ->
    % Test integration with other erlmcp components

    TransportId = <<"sse_integration_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true},

    % Start SSE transport
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Test integration with transport registry
            RegistryStatus = erlmcp_transport_sse_gun:registry_status(Pid),
            ?assert(is_map(RegistryStatus), "Registry status should be a map"),
            ?assert(maps:is_key(registered, RegistryStatus), "Missing registered status"),

            % Test integration with client registry
            ClientId = <<"sse_integration_client">>,
            ClientInfo = #{client_id => ClientId,
                         session_id => <<"integration_session">>,
                         transport_id => TransportId,
                         auth_token => <<"integration_auth">>,
                         metadata = #{sse_integration => true}},

            ?assertEqual(ok, erlmcp_client_registry:register_client(ClientId, ClientInfo)),

            % Test bidirectional communication
            TestMessage = #{<<"type">> => <<"integration_test">>,
                          <<"data">> => <<"SSE integration message">>},
            ?assertEqual(ok, erlmcp_transport_sse_gun:send(Pid, TestMessage)),

            % Clean up
            ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId)),
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for integration test: ~p", [Reason])
    end,
    ok.

websocket_fallback(Config) ->
    % Test WebSocket fallback capabilities

    % Create SSE configuration with WebSocket fallback
    TransportId = <<"sse_websocket_fallback">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  fallback_url => <<"ws://localhost:8081/mcp/ws">>,
                  owner => self(),
                  test_mode => true,
                  fallback_enabled => true,
                  fallback_timeout => 5000},

    % Start with fallback enabled
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Test fallback status
            FallbackStatus = erlmcp_transport_sse_gun:fallback_status(Pid),
            ?assert(is_map(FallbackStatus), "Fallback status should be a map"),
            ?assert(maps:is_key(fallback_enabled, FallbackStatus), "Missing fallback_enabled"),
            ?assert(maps:is_key(fallback_attempts, FallbackStatus), "Missing fallback_attempts"),

            % Test fallback trigger (simulating SSE failure)
            ?assertEqual(ok, erlmcp_transport_sse_gun:trigger_fallback(Pid)),

            % Test fallback success
            timer:sleep(2000), % Wait for fallback to complete
            Status = erlmcp_transport_sse_gun:status(Pid),
            ?assert(maps:get(transport_type, Status) =:= sse_gun,
                     "Transport should still be SSE Gun type"),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for WebSocket fallback test: ~p", [Reason])
    end,
    ok.

gun_configuration(Config) ->
    % Test Gun configuration and optimization

    % Test different Gun configurations
    ConfigVariants = [
        % Basic configuration
        #{transport_id => <<"gun_basic">>,
          transport_type => sse_gun,
          url => <<"http://localhost:8081/mcp/sse">>,
          owner => self(),
          test_mode => true,
          gun_config => #{transport => tcp,
                        transport_opts => [{verify_none, true}]}},

        % HTTP/2 optimized
        #{transport_id => <<"gun_http2">>,
          transport_type => sse_gun,
          url => <<"http://localhost:8081/mcp/sse">>,
          owner => self(),
          test_mode => true,
          gun_config => #{transport => tcp,
                        transport_opts => [{verify_none, true}],
                        version => http2}},

        % Pool-based configuration
        #{transport_id => <<"gun_pool">>,
          transport_type => sse_gun,
          url => <<"http://localhost:8081/mcp/sse">>,
          owner => self(),
          test_mode => true,
          gun_config => #{transport => tcp,
                        transport_opts => [{verify_none, true}],
                        max_connections => 10}}
    ],

    lists:foreach(fun(ConfigMap) ->
                     TransportId = maps:get(transport_id, ConfigMap),

                     case erlmcp_transport_sse_gun:start_link(ConfigMap) of
                         {ok, Pid} ->
                             % Verify Gun-specific configuration
                             Status = erlmcp_transport_sse_gun:status(Pid),
                             ?assert(is_map(Status), "Status should be a map"),
                             ?assert(maps:is_key(gun_config, Status), "Missing gun_config"),

                             % Test Gun metrics
                             Stats = erlmcp_transport_sse_gun:get_stats(Pid),
                             ?assert(is_map(Stats), "Stats should be a map"),
                             ?assert(maps:is_key(gun_connections, Stats), "Missing gun_connections"),

                             % Clean up
                             ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
                         {error, Reason} ->
                             ct:pal("Gun configuration ~p failed: ~p", [TransportId, Reason])
                     end
                 end,
                 ConfigVariants),
    ok.

sse_protocol_compliance(Config) ->
    % Test SSE protocol compliance

    TransportId = <<"sse_compliance_test">>,
    ConfigMap = #{transport_id => TransportId,
                  transport_type => sse_gun,
                  url => <<"http://localhost:8081/mcp/sse">>,
                  owner => self(),
                  test_mode => true,
                  strict_compliance => true},

    % Start SSE transport
    case erlmcp_transport_sse_gun:start_link(ConfigMap) of
        {ok, Pid} ->
            % Test standard SSE event formats
            StandardEvents = [
                % Basic SSE event
                #{<<"event">> => <<"message">>,
                  <<"data">> => <<"Hello, World!">>},
                % Event with ID
                #{<<"event">> => <<"update">>,
                  <<"id">> => <<"123">>,
                  <<"data">> => <<"Update data">>},
                % Event with retry
                #{<<"event">> => <<"retry">>,
                  <<"retry">> => 3000,
                  <<"data">> => <<"Retryable event">>},
                % Multi-line data
                #{<<"event">> => <<"multiline">>,
                  <<"data">> => <<"Line 1\nLine 2\nLine 3">>},
                % Comment event
                #{<<"comment">> => <<"Event stream comment">>}
            ],

            lists:foreach(fun(Event) ->
                             % Validate against SSE spec
                             ValidationResult = erlmcp_transport_sse_gun:validate_sse_spec(Event),
                             ?assertMatch({ok, _}, ValidationResult,

                             % Send event
                             ?assertEqual(ok, erlmcp_transport_sse_gun:send(Pid, Event))
                           end,
                           StandardEvents),

            % Test SSE compliance metrics
            ComplianceStats = erlmcp_transport_sse_gun:compliance_stats(Pid),
            ?assert(is_map(ComplianceStats), "Compliance stats should be a map"),
            ?assert(maps:is_key(spec_compliant_events, ComplianceStats),
                     "Missing spec_compliant_events"),
            ?assert(maps:is_key(spec_violations, ComplianceStats), "Missing spec_violations"),

            % Test SSE protocol version compliance
            VersionInfo = erlmcp_transport_sse_gun:get_sse_version(Pid),
            ?assert(is_map(VersionInfo), "Version info should be a map"),
            ?assert(maps:is_key(sse_version, VersionInfo), "Missing sse_version"),
            ?assert(maps:is_key(http_version, VersionInfo), "Missing http_version"),

            % Clean up
            ?assertEqual(ok, erlmcp_transport_sse_gun:stop(Pid));
        {error, Reason} ->
            ct:pal("SSE transport not available for compliance test: ~p", [Reason])
    end,
    ok.

%%====================================================================
%% Internal Functions
%%====================================================================

is_gun_available(Config) ->
    case proplists:get_value(skip_gun_tests, Config, false) of
        true ->
            false;
        false ->
            case code:ensure_loaded(gun) of
                {module, gun} ->
                    true;
                {error, _} ->
                    false
            end
    end.

cleanup_sse_connections() ->
    % Clean up any active SSE connections
    case erlmcp_transport_sse_gun:list_connections() of
        Connections when is_list(Connections) ->
            lists:foreach(fun(Connection) ->
                             TransportId = maps:get(transport_id, Connection),
                             case erlmcp_transport_sse_gun:stop(TransportId) of
                                 ok ->
                                     ct:pal("Cleaned up SSE connection: ~p", [TransportId]);
                                 {error, Reason} ->
                                     ct:pal("Failed to clean up SSE connection ~p: ~p",
                                            [TransportId, Reason])
                             end
                           end,
                           Connections);
        _ ->
            ok
    end,
    ok.