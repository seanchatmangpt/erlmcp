%%%-------------------------------------------------------------------
%%% @doc Tests for erlmcp_transport_http_gun module
%%%
%%% Test suite covering all aspects of the HTTP Gun transport:
%%% - Basic functionality
%%% - Connection management
%%% - Message sending and receiving
%%% - Error handling and retries
%%% - Transport behavior compliance
%%% - Performance and reliability
%%% - Configuration validation
%%%
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_transport_http_gun_tests).

-include_lib("eunit/include/eunit.hrl").
-include("erlmcp.hrl").

%% Test data
-define(TEST_URL, <<"http://localhost:8080">>).
-define(TEST_CONFIG, #{
    transport_id => test_http_gun,
    url => ?TEST_URL,
    timeout => 5000,
    max_retries => 2,
    retry_delay => 1000
}).

%%====================================================================
%% Test Suite
%%====================================================================

http_gun_transport_test_() ->
    {setup,
        fun setup/0,
        fun cleanup/1,
        [
            {group, basic_functionality},
            {group, connection_management},
            {group, message_handling},
            {group, error_handling},
            {group, behavior_compliance},
            {group, performance_reliability},
            {group, configuration_validation}
        ]
    }.

%%====================================================================
%% Basic Functionality Tests
%%====================================================================

basic_functionality_test_() ->
    [
        {"Module compiles and exports required functions",
            fun module_compiles/0},
        {"Has correct behaviors",
            fun has_correct_behaviors/0},
        {"Initializes properly",
            fun initializes_properly/0}
    ].

module_compiles() ->
    ?assertNotEqual(undefined, erlmcp_transport_http_gun),
    Exports = erlmcp_transport_http_gun:module_info(exports),
    ?assert(lists:member({connect, 1}, Exports)),
    ?assert(lists:member({send, 2}, Exports)),
    ?assert(lists:member({recv, 2}, Exports)),
    ?assert(lists:member({close, 1}, Exports)),
    ?assert(lists:member({get_info, 1}, Exports)).

has_correct_behaviors() ->
    ?assert(lists:member({behaviour_info, 1}, erlmcp_transport_http_gun:module_info(exports))),
    ?assert(lists:member(gen_server, erlmcp_transport_http_gun:module_info(attributes))).

initializes_properly() ->
    {ok, Pid} = erlmcp_transport_http_gun:start_link(?TEST_CONFIG),
    ?assert(is_pid(Pid)),
    erlmcp_transport_http_gun:stop(Pid).

%%====================================================================
%% Connection Management Tests
%%====================================================================

connection_management_test_() ->
    [
        {"Connects successfully",
            fun connects_successfully/0},
        {"Handles invalid URL",
            fun handles_invalid_url/0},
        {"Reconnects automatically",
            fun reconnects_automatically/0},
        {"Manages connection state",
            fun manages_connection_state/0}
    ].

connects_successfully() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    ?assert(is_record(State, http_gun_state)),
    ?assert(State#http_gun_state.conn /= undefined).

handles_invalid_url() ->
    InvalidConfig = ?TEST_CONFIG#{url => <<"invalid://host">>},
    {error, Reason} = erlmcp_transport_http_gun:connect(InvalidConfig),
    ?assert(is_atom(Reason)).

reconnects_automatically() ->
    % This test would need to mock gun processes
    % For now, just verify the mechanism exists
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    ?assert(is_record(State, http_gun_state)).

manages_connection_state() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    ConnectedBefore = is_connected(State),
    ?assert(ConnectedBefore),

    ok = erlmcp_transport_http_gun:close(State),
    ConnectedAfter = is_connected(State),
    ?assertNot(ConnectedAfter).

%%====================================================================
%% Message Handling Tests
%%====================================================================

message_handling_test_() ->
    [
        {"Sends messages successfully",
            fun sends_messages_successfully/0},
        {"Receives responses",
            fun receives_responses/0},
        {"Handles message queuing",
            fun handles_message_queuing/0},
        {"Manages pending requests",
            fun manages_pending_requests/0}
    ].

sends_messages_successfully() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    TestMessage = <<"test message">>,

    {ok, NewState} = erlmcp_transport_http_gun:send(TestMessage, State),
    ?assert(State /= NewState),
    ?assert(NewState#http_gun_state.active_requests > 0).

receives_responses() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    TestMessage = <<"test">>,

    {ok, NewState} = erlmcp_transport_http_gun:send(TestMessage, State),

    % This test would need gun mock for actual response handling
    ?assert(is_record(NewState, http_gun_state)).

handles_message_queuing() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),

    % Send multiple messages
    Messages = [<<"msg1">>, <<"msg2">>, <<"msg3">>],
    States = lists:foldl(fun(Msg, AccState) ->
        {ok, NewState} = erlmcp_transport_http_gun:send(Msg, AccState),
        NewState
    end, State, Messages),

    ?assert(States#http_gun_state.active_requests >= length(Messages)).

manages_pending_requests() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    InitialPending = maps:size(State#http_gun_state.pending_requests),

    TestMessage = <<"test">>,
    {ok, NewState} = erlmcp_transport_http_gun:send(TestMessage, State),

    ?assert(maps:size(NewState#http_gun_state.pending_requests) > InitialPending).

%%====================================================================
%% Error Handling Tests
%%====================================================================

error_handling_test_() ->
    [
        {"Handles connection errors",
            fun handles_connection_errors/0},
        {"Retries failed requests",
            fun retries_failed_requests/0},
        {"Handles timeouts",
            fun handles_timeouts/0},
        {"Provides error information",
            fun provides_error_information/0}
    ].

handles_connection_errors() ->
    % Test with non-existent server
    ErrorConfig = ?TEST_CONFIG#{url => <<"http://localhost:9999">>},
    {error, Reason} = erlmcp_transport_http_gun:connect(ErrorConfig),
    ?assert(is_atom(Reason)).

retries_failed_requests() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),

    % This would need mocking of gun retry logic
    ?assert(is_record(State, http_gun_state)).

handles_timeouts() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),

    TestMessage = <<"test">>,
    {ok, NewState} = erlmcp_transport_http_gun:send(TestMessage, State),

    % Test recv timeout
    {error, timeout} = erlmcp_transport_http_gun:recv(100, NewState).

provides_error_information() ->
    {error, Reason} = erlmcp_transport_http_gun:connect(#{url => <<"bad://url">>}),
    ?assert(is_tuple(Reason) orelse is_atom(Reason)).

%%====================================================================
%% Behavior Compliance Tests
%%====================================================================

behavior_compliance_test_() ->
    [
        {"Implements transport behavior correctly",
            fun implements_behavior_correctly/0},
        {"Returns correct types",
            fun returns_correct_types/0},
        {"Handles all required callbacks",
            fun handles_all_callbacks/0}
    ].

implements_behavior_correctly() ->
    TestState = create_test_state(),

    % Test all required callbacks exist
    ?assert(erlang:function_exported(erlmcp_transport_http_gun, connect, 1)),
    ?assert(erlang:function_exported(erlmcp_transport_http_gun, send, 2)),
    ?assert(erlang:function_exported(erlmcp_transport_http_gun, recv, 2)),
    ?assert(erlang:function_exported(erlmcp_transport_http_gun, close, 1)),
    ?assert(erlang:function_exported(erlmcp_transport_http_gun, get_info, 1)).

returns_correct_types() ->
    TestState = create_test_state(),

    % connect
    case erlmcp_transport_http_gun:connect(?TEST_CONFIG) of
        {ok, State} -> ?assert(is_record(State, http_gun_state));
        {error, _} -> ok
    end,

    % send
    case erlmcp_transport_http_gun:send(<<"test">>, TestState) of
        {ok, _State} -> ok;
        {error, _} -> ok
    end,

    % recv
    case erlmcp_transport_http_gun:recv(1000, TestState) of
        {ok, {_Data, _State}} -> ok;
        {error, _} -> ok
    end,

    % close
    ok = erlmcp_transport_http_gun:close(TestState),

    % get_info
    case erlmcp_transport_http_gun:get_info(TestState) of
        {ok, Info} ->
            ?assert(is_map(Info)),
            ?assert(maps:is_key(id, Info)),
            ?assert(maps:is_key(type, Info));
        {error, _} -> ok
    end.

handles_all_callbacks() ->
    TestState = create_test_state(),

    % All callbacks should not crash
    _ = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    _ = erlmcp_transport_http_gun:send(<<"test">>, TestState),
    _ = erlmcp_transport_http_gun:recv(1000, TestState),
    _ = erlmcp_transport_http_gun:close(TestState),
    _ = erlmcp_transport_http_gun:get_info(TestState).

%%====================================================================
%% Performance and Reliability Tests
%%====================================================================

performance_reliability_test_() ->
    [
        {"Handles concurrent requests",
            fun handles_concurrent_requests/0},
        {"Memory usage is bounded",
            fun memory_usage_is_bounded/0},
        {"Recovers from failures",
            fun recovers_from_failures/0}
    ].

handles_concurrent_requests() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),

    % Concurrent sends
    NumRequests = 5,
    Refs = [make_ref() || _ <- lists:seq(1, NumRequests)],

    Results = lists:map(fun(_) ->
        erlmcp_transport_http_gun:send(<<"concurrent">>, State)
    end, Refs),

    % All should succeed or error due to connection
    ?assert(length(Results) =:= NumRequests).

memory_usage_is_bounded() ->
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    InitialSize = get_memory_usage(),

    % Send many messages
    lists:foreach(fun(_) ->
        erlmcp_transport_http_gun:send(<<"memory_test">>, State)
    end, lists:seq(1, 100)),

    FinalSize = get_memory_usage(),
    % Memory growth should be reasonable
    ?assert(FinalSize - InitialSize =< 1024 * 1024). % 1MB max growth

recovers_from_failures() ->
    % Test transport can recover from errors
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),

    % Send and close connection
    ok = erlmcp_transport_http_gun:close(State),

    % Try to operate on closed connection should handle gracefully
    {error, Reason} = erlmcp_transport_http_gun:send(<<"test">>, State),
    ?assert(is_atom(Reason)).

%%====================================================================
%% Configuration Validation Tests
%%====================================================================

configuration_validation_test_() ->
    [
        {"Validates required fields",
            fun validates_required_fields/0},
        {"Handles optional fields properly",
            fun handles_optional_fields/0},
        {"URL parsing works correctly",
            fun url_parsing_works_correctly/0},
        {"Header normalization",
            fun header_normalization/0}
    ].

validates_required_fields() ->
    % Missing URL
    {error, Reason} = erlmcp_transport_http_gun:connect(#{
        transport_id => test,
        timeout => 5000
    }),
    ?assert(is_atom(Reason)).

handles_optional_fields() ->
    % All optional fields missing
    {ok, State} = erlmcp_transport_http_gun:connect(?TEST_CONFIG),
    ?assert(is_record(State, http_gun_state)).

url_parsing_works_correctly() ->
    TestUrls = [
        {<<"http://example.com:8080/path">>, http, <<"example.com">>, 8080, <<"/path">>},
        {<<"https://example.com">>, https, <<"example.com">>, 443, <<"/">>},
        {<<"http://localhost">>, http, <<"localhost">>, 80, <<"/">>}
    ],

    lists:foreach(fun({Url, ExpectedScheme, ExpectedHost, ExpectedPort, ExpectedPath}) ->
        Config = ?TEST_CONFIG#{url => Url},
        case erlmcp_transport_http_gun:connect(Config) of
            {ok, State} ->
                ?assertEqual(ExpectedScheme, State#http_gun_state.scheme),
                ?assertEqual(ExpectedHost, State#http_gun_state.host),
                ?assertEqual(ExpectedPort, State#http_gun_state.port),
                ?assertEqual(ExpectedPath, State#http_gun_state.path);
            {error, _} ->
                % Connection failed but URL parsing should work
                Parsed = erlmcp_transport_http_gun:parse_url(Url),
                ?assertMatch({ok, ExpectedScheme, ExpectedHost, ExpectedPort, ExpectedPath}, Parsed)
        end
    end, TestUrls).

header_normalization() ->
    Config = ?TEST_CONFIG#{headers => [
        {<<"content-type">>, <<"application/json">>},
        {"user-agent", "test-agent"},
        {<<"accept">>, "application/vnd.api+json"}
    ]},

    {ok, State} = erlmcp_transport_http_gun:connect(Config),

    % Check headers are normalized to binary()
    Headers = State#http_gun_state.headers,
    ?assert(lists:all(fun({K, V}) -> is_binary(K) and is_binary(V) end, Headers)),
    ?assert(lists:keyfind(<<"content-type">>, 1, Headers) /= false),
    ?assert(lists:keyfind(<<"user-agent">>, 1, Headers) /= false).

%%====================================================================
%% Helper Functions
%%====================================================================

setup() ->
    % Start required applications
    application:ensure_all_started(gun),
    application:ensure_all_started(ssl),
    ok.

cleanup(_) ->
    % Clean up
    ok.

create_test_state() ->
    #http_gun_state{
        transport_id => test,
        conn = self(),
        host = <<"localhost">>,
        port = 8080,
        path => <<"/test">>,
        scheme = http,
        headers = [],
        timeout = 5000,
        gun_monitor = undefined,
        pending_requests = #{},
        active_requests = 0,
        max_retries = 3,
        retry_delay = 1000,
        owner = self(),
        transport = tcp,
        connect_timeout = 5000,
        start_time = erlang:system_time(millisecond),
        last_activity = erlang:system_time(millisecond)
    }.

is_connected(#http_gun_state{conn = Conn}) ->
    Conn =/= undefined andalso is_process_alive(Conn).

get_memory_usage() ->
    case process_info(self(), memory) of
        {memory, Size} -> Size;
        undefined -> 0
    end.