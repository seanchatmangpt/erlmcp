%%====================================================================
%% Performance Tests
%%====================================================================

performance_tests() ->
    {foreach,
        fun start_test_server/0,
        fun stop_test_server/1,
        [
            {"test message throughput", fun test_message_throughput/0},
            {"test concurrent connections", fun test_concurrent_performance/0},
            {"test large message handling", fun test_large_message_handling/0},
            {"test connection overhead", fun test_connection_overhead/0},
            {"test memory usage", fun test_memory_usage/0}
        ]
    }.

test_message_throughput() ->
    {ServerPid, Port} = start_test_server(),

    {ok, ClientPid} = erlmcp_transport_sse_gun:start_link(#{
        transport_id => <<"test_throughput">>,
        mode => client,
        host => "localhost",
        port => Port,
        path => "/test-sse"
    }),

    timer:sleep(1000),

    %% Test message throughput
    NumMessages = 1000,
    MessageSize = 100, %% 100 bytes per message

    StartTime = os:system_time(millisecond),

    lists:foreach(fun(I) ->
        Event = <<"data: {\"id\": ", (integer_to_binary(I))/binary, ", \"data\": ", (binary:copy(<<"x">>, MessageSize))/binary, "}\n\n">>,
        erlmcp_transport_sse_gun:send(ClientPid, Event)
    end, lists:seq(1, NumMessages)),

    EndTime = os:system_time(millisecond),

    %% Calculate throughput
    DurationSec = (EndTime - StartTime) / 1000,
    MessagesPerSec = NumMessages / DurationSec,
    BytesPerSec = (NumMessages * MessageSize) / DurationSec,

    %% Verify throughput meets minimum threshold
    ?assert(MessagesPerSec > 100), %% > 100 messages per second
    ?assert(BytesPerSec > 10000), %% > 10KB per second

    logger:info("Throughput: ~p messages/sec, ~p bytes/sec", [MessagesPerSec, BytesPerSec]),

    cleanup_connections(),
    stop_test_server({ServerPid, Port)}.

test_concurrent_performance() ->
    {ServerPid, Port} = start_test_server(),

    %% Start multiple concurrent clients
    NumClients = 10,
    MessagesPerClient = 100,

    ClientPids = lists:map(fun(I) ->
        {ok, Pid} = erlmcp_transport_sse_gun:start_link(#{
            transport_id => <<"test_concurrent_", (integer_to_binary(I))/binary>>,
            mode => client,
            host => "localhost",
            port => Port,
            path => "/test-sse"
        ),
        Pid
    end, lists:seq(1, NumClients)),

    %% Wait for connections
    timer:sleep(1000),

    %% Send messages concurrently
    StartTime = os:system_time(millisecond),

    lists:foreach(fun({Pid, I}) ->
        lists:foreach(fun(J) ->
            Event = <<"data: {\"client\": ", (integer_to_binary(I))/binary, ", \"msg\": ", (integer_to_binary(J))/binary, "}\n\n">>,
            erlmcp_transport_sse_gun:send(Pid, Event)
        end, lists:seq(1, MessagesPerClient))
    end, lists:zip(ClientPids, lists:seq(1, NumClients))),

    EndTime = os:system_time(millisecond),

    %% Calculate throughput
    TotalMessages = NumClients * MessagesPerClient,
    DurationSec = (EndTime - StartTime) / 1000,
    MessagesPerSec = TotalMessages / DurationSec,

    %% Verify concurrent performance
    ?assert(MessagesPerSec > 500), %% > 500 messages per second

    logger:info("Concurrent throughput: ~p messages/sec", [MessagesPerSec]),

    %% Cleanup
    lists:foreach(fun(Pid) ->
        erlmcp_transport_sse_gun:close(Pid)
    end, ClientPids),

    stop_test_server({ServerPid, Port)}.

test_large_message_handling() ->
    {ServerPid, Port} = start_test_server(),

    {ok, ClientPid} = erlmcp_transport_sse_gun:start_link(#{
        transport_id => <<"test_large">>,
        mode => client,
        host => "localhost",
        port => Port,
        path => "/test-sse"
    }),

    timer:sleep(1000),

    %% Test large messages (1MB, 5MB, 10MB)
    MessageSizes = [1024*1024, 5*1024*1024, 10*1024*1024],

    lists:foreach fun(Size) ->
        Event = <<"data: {\"size\": ", (integer_to_binary(Size))/binary, ", \"data\": ", (binary:copy(<<"x">>, Size))/binary, "}\n\n">>,

        StartTime = os:system_time(microsecond),
        Result = erlmcp_transport_sse_gun:send(ClientPid, Event),
        EndTime = os:system_time(microsecond),

        ?assertEqual(ok, Result),

        DurationMs = (EndTime - StartTime) / 1000,
        ThroughputMBs = (Size / 1024 / 1024) / (DurationMs / 1000),

        logger:info("Large message (~p MB): ~p ms, ~p MB/s", [Size/1024/1024, DurationMs, ThroughputMBs])
    end, MessageSizes),

    cleanup_connections(),
    stop_test_server({ServerPid, Port)}).

test_connection_overhead() ->
    {ServerPid, Port} = start_test_server(),

    NumConnections = 50,
    OverheadResults = lists:map(fun(I) ->
        StartTime = os:system_time(microsecond),

        {ok, Pid} = erlmcp_transport_sse_gun:start_link(#{
            transport_id => <<"test_overhead_", (integer_to_binary(I))/binary>>,
            mode => client,
            host => "localhost",
            port => Port,
            path => "/test-sse"
        }),

        %% Wait for connection
        timer:sleep(100),

        EndTime = os:system_time(microsecond),

        DurationMs = (EndTime - StartTime) / 1000,

        erlmcp_transport_sse_gun:close(Pid),

        {I, DurationMs}
    end, lists:seq(1, NumConnections)),

    %% Calculate average overhead
    OverheadTimes = [Time || {_, Time} <- OverheadResults],
    AvgOverhead = lists:sum(OverheadTimes) / length(OverheadTimes),

    %% Verify reasonable connection overhead
    ?assert(AvgOverhead < 1000), %% < 1 second average

    logger:info("Average connection overhead: ~p ms", [AvgOverhead]),

    stop_test_server({ServerPid, Port)}).

test_memory_usage() ->
    {ServerPid, Port} = start_test_server(),

    {ok, ClientPid} = erlmcp_transport_sse_gun:start_link(#{
        transport_id => <<"test_memory">>,
        mode => client,
        host => "localhost",
        port => Port,
        path => "/test-sse"
    }),

    timer:sleep(1000),

    %% Monitor memory usage
    InitialMemory = erlang:memory(process, ClientPid),

    %% Send many messages
    NumMessages = 5000,
    lists:foreach(fun(I) ->
        Event = <<"data: {\"memory_test\": ", (integer_to_binary(I))/binary, "}\n\n">>,
        erlmcp_transport_sse_gun:send(ClientPid, Event)
    end, lists:seq(1, NumMessages)),

    timer:sleep(1000),

    FinalMemory = erlang:memory(process, ClientPid),
    MemoryIncrease = FinalMemory - InitialMemory,

    %% Verify memory usage is reasonable
    ?assert(MemoryIncrease < 50 * 1024 * 1024), %% < 50MB increase

    logger:info("Memory increase: ~p bytes for ~p messages", [MemoryIncrease, NumMessages]),

    cleanup_connections(),
    stop_test_server({ServerPid, Port)}).

