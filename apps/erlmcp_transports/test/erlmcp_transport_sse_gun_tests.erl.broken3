test_window_management() ->
    {ServerPid, Port} = start_test_server(),

    {ok, ClientPid} = erlmcp_transport_sse_gun:start_link(#{
        transport_id => <<"test_window">>,
        mode => client,
        host => "localhost",
        port => Port,
        path => "/test-sse"
