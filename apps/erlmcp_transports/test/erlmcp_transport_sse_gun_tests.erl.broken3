%%====================================================================
%% Helper Functions
%%====================================================================

%% Mock SSE event parsing for testing
parse_sse_event(Data) ->
    try
        case binary:split(Data, <<"\n">>, [global]) of
            [<<"event: ", EventBin/binary>>, <<"data: ", DataBin/binary>>, <<>>] ->
                {ok, #{
                    type => binary:replace(EventBin, <<"\r">>, <<>>, [global]),
                    data => binary:replace(DataBin, <<"\r">>, <<>>, [global]),
                    timestamp => os:system_time(millisecond)
                }};
            [<<"data: ", DataBin/binary>>, <<>>] ->
                {ok, #{
                    type => <<"data">>,
                    data => binary:replace(DataBin, <<"\r">>, <<>>, [global]),
                    timestamp => os:system_time(millisecond)
                }};
            _ ->
                {error, invalid_format}
        end
    catch
        _:Error ->
            {error, {parse_error, Error}}
    end.

%% Mock SSE event formatting for testing
format_sse_event(EventType, Message) ->
    EventBin = atom_to_binary(EventType, utf8),
    MessageBin = unicode:characters_to_binary(Message, utf8),
    <<"event: ", EventBin/binary, "\ndata: ", MessageBin/binary, "\n\n">>.

%% Mock test registry
test_registry_loop(Config) ->
    register(test_registry, self()),
    test_registry_loop([], Config).

test_registry_loop(Connections, Config) ->
    receive
        {register_connection, Id, Pid, Info} ->
            test_registry_loop([{Id, Pid, Info} | Connections], Config);
        {unregister_connection, Id} ->
            test_registry_loop(lists:keydelete(Id, 1, Connections), Config);
        {get_connection, Id} ->
            case lists:keyfind(Id, 1, Connections) of
                {Id, Pid, Info} ->
                    Pid ! {connection_info, Info};
                false ->
                    ok
            end,
            test_registry_loop(Connections, Config);
        {route_event, Id, Event} ->
            case lists:keyfind(Id, 1, Connections) of
                {Id, Pid, _} ->
                    Pid ! {sse_data, Event};
                false ->
                    ok
            end,
            test_registry_loop(Connections, Config);
        shutdown ->
            ok;
        _Other ->
            test_registry_loop(Connections, Config)
    end.

%% Mock server port detection
get_server_port(Pid) ->
    %% This is a mock implementation
    %% In real implementation, would query Gun for actual port
    8080.