{erl_opts, [debug_info, {i, "include"}, {i, "include/swarmflow_os"}]}.

{deps, []}.

%% Rust NIF compilation is optional; the module has Erlang fallbacks.
%% When a Rust toolchain is present, build the NIF into priv/ so the on_load
%% succeeds (an absent .so only logs a warning and falls back — but a failed
%% load breaks cover compilation of swf_rust_nif.beam in test runs).
%% Pre-hooks were removed because cargo in Docker caused permission issues;
%% keep this hook best-effort so Docker builds still pass without cargo.
{post_hooks, [
    {compile, "sh -c 'if command -v cargo >/dev/null 2>&1; then cd \".\" && cargo build --release >/dev/null 2>&1 && mkdir -p priv && cp -f target/release/libswf_rust_nif.dylib priv/swf_rust_nif.so && echo \"SwarmFlow OS NIF: built priv/swf_rust_nif.so\"; else echo \"SwarmFlow OS NIF: Build optional - using Erlang fallbacks\"; fi'"}
]}.
