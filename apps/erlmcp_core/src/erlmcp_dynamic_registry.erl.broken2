%%%-------------------------------------------------------------------
%%% @doc Dynamic Registry for MCP Tools, Resources, and Prompts
%%%
%%% This module provides dynamic registration capabilities for MCP components,
%%% automatically updating server capabilities and maintaining consistency
%%% across the system. Implements clean registration API matching beamai_mcp
%%% patterns with erlmcp's enterprise features.
%%%
%%% == Key Features ==
%%% - Dynamic registration of tools, resources, and prompts
%%% - Automatic capability recalculation on registration changes
%%% - Concurrent access support with proper synchronization
%%% - Comprehensive validation and error handling
%%% - Integration with existing erlmcp infrastructure
%%% - Monitoring and metrics for registry operations
%%%
%%% == Usage Example ==
%%%
%%% ```erlang
%%% %% Start the registry
%%% {ok, RegistryPid} = erlmcp_dynamic_registry:start_link().
%%%
%%% %% Register a tool
%%% Tool = #mcp_tool{
%%%     name = <<"file_reader">>,
%%%     description = <<"Read file contents">>,
%%%     input_schema = #{type => object, properties => #{file => #{type => string}}},
%%%     handler = fun(#{<<"file">> := File}) -> {ok, read_file(File)} end
%%% },
%%% ok = erlmcp_dynamic_registry:register_tool(RegistryPid, Tool).
%%%
%%% %% Register a resource
%%% Resource = #mcp_resource{
%%%     uri = <<"file:///tmp/data.txt">>,
%%%     name = <<"data.txt">>,
%%%     description = <<"Sample data file">>,
%%%     handler = fun() -> {ok, <<"Sample content">>} end
%%% },
%%% ok = erlmcp_dynamic_registry:register_resource(RegistryPid, Resource).
%%%
%%% %% Register a prompt
%%% Prompt = #mcp_prompt{
%%%     name = <<"code_review">>,
%%%     description = <<"Review code quality">>,
%%%     arguments = [
%%%         #mcp_prompt_argument{name = <<"code">>, description = <<"Code to review">>, required = true}
%%%     ],
%%%     handler = fun(#{<<"code">> := Code}) -> {ok, generate_review(Code)} end
%%% },
%%% ok = erlmcp_dynamic_registry:register_prompt(RegistryPid, Prompt).
%%%
%%% %% Unregister components
%%% ok = erlmcp_dynamic_registry:unregister_tool(RegistryPid, <<"file_reader">>),
%%% ok = erlmcp_dynamic_registry:unregister_resource(RegistryPid, <<"file:///tmp/data.txt">>),
%%% ok = erlmcp_dynamic_registry:unregister_prompt(RegistryPid, <<"code_review">>).
%%%
%%% %% Get current registry state
%%% {ok, Tools, Resources, Prompts} = erlmcp_dynamic_registry:list_all(RegistryPid).
%%% ```
%%%
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_dynamic_registry).

-behaviour(gen_server).

%% API exports
-export([
    start_link/0,
    stop/0,
    register_tool/2,
    unregister_tool/1,
    register_resource/2,
    unregister_resource/1,
    register_prompt/2,
    unregister_prompt/1,
    list_all/0,
    list_all/1,
    get_tool/1,
    get_resource/1,
    get_prompt/1,
    has_capability/1,
    get_capabilities/0,
    get_capabilities/1,
    count/0,
    count/1,
    clear_all/0,
    clear_all/1,
    get_metrics/0,
    get_metrics/1
]).

%% gen_server callbacks
-export([
    init/1,
    handle_call/3,
    handle_cast/2,
    handle_info/2,
    terminate/2,
    code_change/3
]).

%% Type exports
-export_type([
    registry_state/0,
    metrics/0,
    capability_type/0
]).

-include("erlmcp.hrl").

%%====================================================================
%% Types and Records
%%====================================================================

%% @type capability_type() - Type of MCP component
-type capability_type() :: tools | resources | prompts.

%% @type tool_registry() - Registry for tools
-type tool_registry() :: #{
    binary() => {#mcp_tool{}, map(), pos_integer()}
}.

%% @type resource_registry() - Registry for resources
-type resource_registry() :: #{
    binary() => {#mcp_resource{}, map(), pos_integer()}
}.

%% @type prompt_registry() - Registry for prompts
-type prompt_registry() :: #{
    binary() => {#mcp_prompt{}, map(), pos_integer()}
}.

%% @type registry_state() - Dynamic registry state
-record(state, {
    tools = #{} :: tool_registry(),
    resources = #{} :: resource_registry(),
    prompts = #{} :: prompt_registry(),
    capabilities :: #mcp_server_capabilities{},
    metrics :: #{atom() => term()},
    lock :: reference()
}).

%% @type metrics() - Registry metrics
-record(metrics, {
    registry_calls = 0 :: non_neg_integer(),
    tool_registrations = 0 :: non_neg_integer(),
    resource_registrations = 0 :: non_neg_integer(),
    prompt_registrations = 0 :: non_neg_integer(),
    unregistrations = 0 :: non_neg_integer(),
    errors = 0 :: non_neg_integer(),
    last_updated :: integer() | undefined
}).

-define(SERVER, ?MODULE).
-define(METRICS_INTERVAL, 60000).  % 1 minute metrics collection
-define(MAX_COMPONENTS, 1000).     % Maximum number of total components

%%====================================================================
%% API Functions
%%===================================================================

%% @doc Start the dynamic registry
-spec start_link() -> {ok, pid()} | {error, term()}.
start_link() ->
    gen_server:start_link({local, ?SERVER}, ?MODULE, [], []).

%% @doc Stop the dynamic registry
-spec stop() -> ok.
stop() ->
    gen_server:stop(?SERVER).

%% @doc Register a tool
-spec register_tool(pid(), #mcp_tool{}) -> ok | {error, term()}.
register_tool(Pid, Tool) when is_pid(Pid) ->
    gen_server:call(Pid, {register_tool, Tool}, 5000);
register_tool(RegistryPid, #mcp_tool{} = Tool) ->
    gen_server:call(RegistryPid, {register_tool, Tool}, 5000).

%% @doc Unregister a tool
-spec unregister_tool(pid(), binary()) -> ok | {error, term()}.
unregister_tool(Pid, ToolName) when is_pid(Pid) ->
    gen_server:call(Pid, {unregister_tool, ToolName}, 5000);
unregister_tool(RegistryPid, ToolName) ->
    gen_server:call(RegistryPid, {unregister_tool, ToolName}, 5000).

%% @doc Register a resource
-spec register_resource(pid(), #mcp_resource{}) -> ok | {error, term()}.
register_resource(Pid, Resource) when is_pid(Pid) ->
    gen_server:call(Pid, {register_resource, Resource}, 5000);
register_resource(RegistryPid, #mcp_resource{} = Resource) ->
    gen_server:call(RegistryPid, {register_resource, Resource}, 5000).

%% @doc Unregister a resource
-spec unregister_resource(pid(), binary()) -> ok | {error, term()}.
unregister_resource(Pid, Uri) when is_pid(Pid) ->
    gen_server:call(Pid, {unregister_resource, Uri}, 5000);
unregister_resource(RegistryPid, Uri) ->
    gen_server:call(RegistryPid, {unregister_resource, Uri}, 5000).

%% @doc Register a prompt
-spec register_prompt(pid(), #mcp_prompt{}) -> ok | {error, term()}.
register_prompt(Pid, Prompt) when is_pid(Pid) ->
    gen_server:call(Pid, {register_prompt, Prompt}, 5000);
register_prompt(RegistryPid, #mcp_prompt{} = Prompt) ->
    gen_server:call(RegistryPid, {register_prompt, Prompt}, 5000).

%% @doc Unregister a prompt
-spec unregister_prompt(pid(), binary()) -> ok | {error, term()}.
unregister_prompt(Pid, PromptName) when is_pid(Pid) ->
    gen_server:call(Pid, {unregister_prompt, PromptName}, 5000);
unregister_prompt(RegistryPid, PromptName) ->
    gen_server:call(RegistryPid, {unregister_prompt, PromptName}, 5000).

%% @doc List all registered components
-spec list_all() -> {ok, tool_registry(), resource_registry(), prompt_registry()}.
list_all() ->
    gen_server:call(?SERVER, list_all, 5000).

%% @doc List all registered components for specific registry
-spec list_all(pid()) -> {ok, tool_registry(), resource_registry(), prompt_registry()}.
list_all(Pid) when is_pid(Pid) ->
    gen_server:call(Pid, list_all, 5000).

%% @doc Get a specific tool
-spec get_tool(binary()) -> {ok, #mcp_tool{}} | {error, not_found}.
get_tool(ToolName) ->
    gen_server:call(?SERVER, {get_tool, ToolName}, 5000).

%% @doc Get a specific resource
-spec get_resource(binary()) -> {ok, #mcp_resource{}} | {error, not_found}.
get_resource(Uri) ->
    gen_server:call(?SERVER, {get_resource, Uri}, 5000).

%% @doc Get a specific prompt
-spec get_prompt(binary()) -> {ok, #mcp_prompt{}} | {error, not_found}.
get_prompt(PromptName) ->
    gen_server:call(?SERVER, {get_prompt, PromptName}, 5000).

%% @doc Check if registry has specific capability type
-spec has_capability(capability_type()) -> boolean().
has_capability(CapabilityType) ->
    gen_server:call(?SERVER, {has_capability, CapabilityType}, 5000).

%% @doc Get current server capabilities
-spec get_capabilities() -> #mcp_server_capabilities{}.
get_capabilities() ->
    gen_server:call(?SERVER, get_capabilities, 5000).

%% @doc Get current server capabilities for specific registry
-spec get_capabilities(pid()) -> #mcp_server_capabilities{}.
get_capabilities(Pid) when is_pid(Pid) ->
    gen_server:call(Pid, get_capabilities, 5000).

%% @doc Count total registered components
-spec count() -> non_neg_integer().
count() ->
    gen_server:call(?SERVER, count, 5000).

%% @doc Count components by type
-spec count(capability_type()) -> non_neg_integer().
count(CapabilityType) ->
    gen_server:call(?SERVER, {count, CapabilityType}, 5000).

%% @doc Clear all registrations
-spec clear_all() -> ok.
clear_all() ->
    gen_server:call(?SERVER, clear_all, 5000).

%% @doc Clear all registrations for specific registry
-spec clear_all(pid()) -> ok.
clear_all(Pid) when is_pid(Pid) ->
    gen_server:call(Pid, clear_all, 5000).

%% @doc Get registry metrics
-spec get_metrics() -> #{atom() => term()}.
get_metrics() ->
    gen_server:call(?SERVER, get_metrics, 5000).

%% @doc Get registry metrics for specific registry
-spec get_metrics(pid()) -> #{atom() => term()}.
get_metrics(Pid) when is_pid(Pid) ->
    gen_server:call(Pid, get_metrics, 5000).

%%====================================================================
%% gen_server callbacks
%%===================================================================

%% @private
-spec init([]) -> {ok, state()} | {stop, term()}.
init([]) ->
    %% Initialize ETS table for fast lookups
    case ets:whereis(?MODULE) of
        undefined ->
            ets:new(?MODULE, [named_table, public, set, {read_concurrency, true}]);
        _ ->
            ok
    end,

    %% Initialize state
    State = #state{
        capabilities = #mcp_server_capabilities{
            tools = #mcp_tools_capability{listChanged = true},
            resources = #mcp_resources_capability{listChanged = true},
            prompts = #mcp_prompts_capability{listChanged = true},
            logging = #mcp_logging_capability{},
            sampling = #mcp_sampling_capability{},
            roots = #mcp_roots_capability{}
        },
        metrics = #metrics{},
        lock = make_ref()
    },

    %% Start metrics collection timer
    erlang:send_after(?METRICS_INTERVAL, self(), collect_metrics),

    {ok, State}.

%% @private
handle_call({register_tool, #mcp_tool{name = Name} = Tool}, _From, State) ->
    case validate_tool(Tool) of
        {ok, ValidatedTool} ->
            do_with_lock(State, fun() ->
                case is_at_capacity(State, tools) of
                    true ->
                        {reply, {error, capacity_exceeded}, State};
                    false ->
                        ToolInfo = {ValidatedTool, tool_metadata(ValidatedTool), erlang:system_time(millisecond)},
                        NewTools = maps:put(Name, ToolInfo, State#state.tools),
                        NewState = update_capabilities(State#state{tools = NewTools}),
                        increment_tool_registrations(NewState),
                        log_registration(tool, Name, registered),
                        {reply, ok, NewState}
                end
            end);
        {error, Reason} ->
            increment_errors(State),
            {reply, {error, Reason}, State}
    end;

handle_call({unregister_tool, ToolName}, _From, State) ->
    do_with_lock(State, fun() ->
        case maps:is_key(ToolName, State#state.tools) of
            true ->
                NewTools = maps:remove(ToolName, State#state.tools),
                NewState = update_capabilities(State#state{tools = NewTools}),
                increment_unregistrations(NewState),
                log_registration(tool, ToolName, unregistered),
                {reply, ok, NewState};
            false ->
                {reply, {error, not_found}, State}
        end
    end);

handle_call({register_resource, #mcp_resource{uri = Uri} = Resource}, _From, State) ->
    case validate_resource(Resource) of
        {ok, ValidatedResource} ->
            do_with_lock(State, fun() ->
                case is_at_capacity(State, resources) of
                    true ->
                        {reply, {error, capacity_exceeded}, State};
                    false ->
                        ResourceInfo = {ValidatedResource, resource_metadata(ValidatedResource), erlang:system_time(millisecond)},
                        NewResources = maps:put(Uri, ResourceInfo, State#state.resources),
                        NewState = update_capabilities(State#state{resources = NewResources}),
                        increment_resource_registrations(NewState),
                        log_registration(resource, Uri, registered),
                        {reply, ok, NewState}
                end
            end);
        {error, Reason} ->
            increment_errors(State),
            {reply, {error, Reason}, State}
    end;

handle_call({unregister_resource, Uri}, _From, State) ->
    do_with_lock(State, fun() ->
        case maps:is_key(Uri, State#state.resources) of
            true ->
                NewResources = maps:remove(Uri, State#state.resources),
                NewState = update_capabilities(State#state{resources = NewResources}),
                increment_unregistrations(NewState),
                log_registration(resource, Uri, unregistered),
                {reply, ok, NewState};
            false ->
                {reply, {error, not_found}, State}
        end
    end);

handle_call({register_prompt, #mcp_prompt{name = Name} = Prompt}, _From, State) ->
    case validate_prompt(Prompt) of
        {ok, ValidatedPrompt} ->
            do_with_lock(State, fun() ->
                case is_at_capacity(State, prompts) of
                    true ->
                        {reply, {error, capacity_exceeded}, State};
                    false ->
                        PromptInfo = {ValidatedPrompt, prompt_metadata(ValidatedPrompt), erlang:system_time(millisecond)},
                        NewPrompts = maps:put(Name, PromptInfo, State#state.prompts),
                        NewState = update_capabilities(State#state{prompts = NewPrompts}),
                        increment_prompt_registrations(NewState),
                        log_registration(prompt, Name, registered),
                        {reply, ok, NewState}
                end
            end);
        {error, Reason} ->
            increment_errors(State),
            {reply, {error, Reason}, State}
    end;

handle_call({unregister_prompt, PromptName}, _From, State) ->
    do_with_lock(State, fun() ->
        case maps:is_key(PromptName, State#state.prompts) of
            true ->
                NewPrompts = maps:remove(PromptName, State#state.prompts),
                NewState = update_capabilities(State#state{prompts = NewPrompts}),
                increment_unregistrations(NewState),
                log_registration(prompt, PromptName, unregistered),
                {reply, ok, NewState};
            false ->
                {reply, {error, not_found}, State}
        end
    end);

handle_call({get_tool, ToolName}, _From, State) ->
    case maps:find(ToolName, State#state.tools) of
        {ok, {Tool, _, _}} -> {reply, {ok, Tool}, State};
        error -> {reply, {error, not_found}, State}
    end;

handle_call({get_resource, Uri}, _From, State) ->
    case maps:find(Uri, State#state.resources) of
        {ok, {Resource, _, _}} -> {reply, {ok, Resource}, State};
        error -> {reply, {error, not_found}, State}
    end;

handle_call({get_prompt, PromptName}, _From, State) ->
    case maps:find(PromptName, State#state.prompts) of
        {ok, {Prompt, _, _}} -> {reply, {ok, Prompt}, State};
        error -> {reply, {error, not_found}, State}
    end;

handle_call({has_capability, CapabilityType}, _From, State) ->
    HasCapability = case CapabilityType of
        tools -> map_size(State#state.tools) > 0;
        resources -> map_size(State#state.resources) > 0;
        prompts -> map_size(State#state.prompts) > 0
    end,
    {reply, HasCapability, State};

handle_call(get_capabilities, _From, State) ->
    {reply, State#state.capabilities, State};

handle_call(count, _From, State) ->
    Total = map_size(State#state.tools) + map_size(State#state.resources) + map_size(State#state.prompts),
    {reply, Total, State};

handle_call({count, tools}, _From, State) ->
    {reply, map_size(State#state.tools), State};

handle_call({count, resources}, _From, State) ->
    {reply, map_size(State#state.resources), State};

handle_call({count, prompts}, _From, State) ->
    {reply, map_size(State#state.prompts), State};

handle_call(clear_all, _From, State) ->
    do_with_lock(State, fun() ->
        NewState = State#state{
            tools = #{},
            resources = #{},
            prompts = #{},
            capabilities = #mcp_server_capabilities{
                tools = #mcp_tools_capability{listChanged = true},
                resources = #mcp_resources_capability{listChanged = true},
                prompts = #mcp_prompts_capability{listChanged = true},
                logging = #mcp_logging_capability{},
                sampling = #mcp_sampling_capability{},
                roots = #mcp_roots_capability{}
            }
        },
        log_registration(clear_all, all, cleared),
        {reply, ok, NewState}
    end);

handle_call(get_metrics, _From, State) ->
    Metrics = State#state.metrics,
    {reply, Metrics, State};

handle_call(list_all, _From, State) ->
    {reply, {ok, State#state.tools, State#state.resources, State#state.prompts}, State};

handle_call(_Request, _From, State) ->
    {reply, {error, unknown_request}, State}.

%% @private
handle_cast(_Msg, State) ->
    {noreply, State}.

%% @private
handle_info(collect_metrics, State) ->
    %% Periodic metrics collection
    NewMetrics = update_metrics(State#state.metrics),
    erlang:send_after(?METRICS_INTERVAL, self(), collect_metrics),
    {noreply, State#state{metrics = NewMetrics}};

handle_info(_Info, State) ->
    {noreply, State}.

%% @private
terminate(_Reason, _State) ->
    %% Clean up ETS table
    ets:delete(?MODULE),
    ok.

%% @private
code_change(_OldVsn, State, _Extra) ->
    {ok, State}.

%%====================================================================
%% Internal Functions
%%====================================================================

%% @private Execute function with lock for thread safety
do_with_lock(State, Fun) ->
    Lock = State#state.lock,
    try
        monitor(process, Lock),
        Fun()
    after
        demonitor(Lock, [flush])
    end.

%% @private Validate tool definition
validate_tool(#mcp_tool{name = Name, description = Desc, input_schema = Schema} = Tool) ->
    case is_binary(Name) andalso byte_size(Name) > 0 of
        false -> {error, invalid_tool_name};
        true ->
            case is_binary(Desc) andalso byte_size(Desc) > 0 of
                false -> {error, invalid_tool_description};
                true ->
                    case Schema of
                        undefined -> {error, missing_input_schema};
                        _ when is_map(Schema) ->
                            {ok, Tool};
                        _ -> {error, invalid_input_schema}
                    end
            end
    end.

%% @private Validate resource definition
validate_resource(#mcp_resource{uri = Uri, name = Name} = Resource) ->
    case is_binary(Uri) andalso byte_size(Uri) > 0 of
        false -> {error, invalid_resource_uri};
        true ->
            case is_binary(Name) andalso byte_size(Name) > 0 of
                false -> {error, invalid_resource_name};
                true ->
                    {ok, Resource}
            end
    end.

%% @private Validate prompt definition
validate_prompt(#mcp_prompt{name = Name} = Prompt) ->
    case is_binary(Name) andalso byte_size(Name) > 0 of
        false -> {error, invalid_prompt_name};
        true ->
            %% Validate arguments if present
            case Prompt#mcp_prompt.arguments of
                undefined -> {ok, Prompt};
                Args when is_list(Args) ->
                    validate_prompt_arguments(Args, Prompt);
                _ -> {error, invalid_prompt_arguments}
            end
            end
    end.

%% @private Validate prompt arguments
validate_prompt_arguments([], Prompt) -> {ok, Prompt};
validate_prompt_arguments([#mcp_prompt_argument{name = Name} | Rest], Prompt) ->
    case is_binary(Name) andalso byte_size(Name) > 0 of
        false -> {error, invalid_prompt_argument_name};
        true -> validate_prompt_arguments(Rest, Prompt)
    end.

%% @private Generate tool metadata
tool_metadata(#mcp_tool{name = Name, description = Desc}) ->
    #{
        name => Name,
        description => Desc,
        created_at => erlang:system_time(millisecond),
        type => tool
    }.

%% @private Generate resource metadata
resource_metadata(#mcp_resource{uri = Uri, name = Name, mime_type = MimeType}) ->
    #{
        uri => Uri,
        name => Name,
        mime_type => MimeType,
        created_at => erlang:system_time(millisecond),
        type => resource
    }.

%% @private Generate prompt metadata
prompt_metadata(#mcp_prompt{name = Name, description = Desc}) ->
    #{
        name => Name,
        description => Desc,
        created_at => erlang:system_time(millisecond),
        type => prompt
    }.

%% @private Check if registry is at capacity
is_at_capacity(#state{tools = Tools, resources = Resources, prompts = Prompts}, Type) ->
    Total = map_size(Tools) + map_size(Resources) + map_size(Prompts),
    case Total >= ?MAX_COMPONENTS of
        true -> true;
        false ->
            case Type of
                tools -> map_size(Tools) >= 1000;
                resources -> map_size(Resources) >= 500;
                prompts -> map_size(Prompts) >= 500
            end
    end.

%% @private Update capabilities based on current registrations
update_capabilities(#state{tools = Tools, resources = Resources, prompts = Prompts} = State) ->
    NewCapabilities = #mcp_server_capabilities{
        tools = case map_size(Tools) of
            0 -> #mcp_tools_capability{listChanged = true};
            _ -> #mcp_tools_capability{listChanged = true}
        end,
        resources = case map_size(Resources) of
            0 -> #mcp_resources_capability{listChanged = true};
            _ -> #mcp_resources_capability{listChanged = true}
        end,
        prompts = case map_size(Prompts) of
            0 -> #mcp_prompts_capability{listChanged = true};
            _ -> #mcp_prompts_capability{listChanged = true}
        end,
        logging = #mcp_logging_capability{},
        sampling = #mcp_sampling_capability{},
        roots = #mcp_roots_capability{}
    },
    State#state{capabilities = NewCapabilities}.

%% @private Increment tool registration counter
increment_tool_registrations(#state{metrics = Metrics} = State) ->
    NewCount = Metrics#metrics.tool_registrations + 1,
    NewMetrics = Metrics#metrics{tool_registrations = NewCount},
    State#state{metrics = NewMetrics}.

%% @private Increment resource registration counter
increment_resource_registrations(#state{metrics = Metrics} = State) ->
    NewCount = Metrics#metrics.resource_registrations + 1,
    NewMetrics = Metrics#metrics{resource_registrations = NewCount},
    State#state{metrics = NewMetrics}.

%% @private Increment prompt registration counter
increment_prompt_registrations(#state{metrics = Metrics} = State) ->
    NewCount = Metrics#metrics.prompt_registrations + 1,
    NewMetrics = Metrics#metrics{prompt_registrations = NewCount},
    State#state{metrics = NewMetrics}.

%% @private Increment unregistration counter
increment_unregistrations(#state{metrics = Metrics} = State) ->
    NewCount = Metrics#metrics.unregistrations + 1,
    NewMetrics = Metrics#metrics{unregistrations = NewCount},
    State#state{metrics = NewMetrics}.

%% @private Increment error counter
increment_errors(#state{metrics = Metrics} = State) ->
    NewCount = Metrics#metrics.errors + 1,
    NewMetrics = Metrics#metrics{errors = NewCount, last_updated = erlang:system_time(millisecond)},
    State#state{metrics = NewMetrics}.

%% @private Log registration events
log_registration(Type, Name, Action) ->
    %% Log registration events for auditing
    ets:insert(?MODULE, {
        log,
        erlang:system_time(millisecond),
        Type,
        Name,
        Action
    }.

%% @private Update metrics
update_metrics(Metrics) ->
    Metrics#metrics{
        registry_calls = Metrics#metrics.registry_calls + 1,
        last_updated = erlang:system_time(millisecond)
    }.