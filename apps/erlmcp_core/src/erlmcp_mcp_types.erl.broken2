-module(erlmcp_mcp_types).

-include("../include/erlmcp.hrl").

%% OTP 28 Nominal Types for MCP Message Category Safety
%% EEP-69: https://www.erlang.org/eeps/eep-0069
%%
%% This module defines nominal types that prevent semantic type confusion
%% at compile-time. Even though types have the same structure (binary()),
%% Dialyzer treats them as distinct types based on their nominal declaration.
%%
%% Additionally, this module provides beamai_mcp compatibility APIs for creating
%% and validating MCP content types with support for metadata and annotations.
%%
%% ## Content Type Constructors
%%
%% The module provides the following constructors for creating MCP content records:
%%
%% - `text(Text)` - Creates a text content record
%% - `text(Text, Metadata)` - Creates a text content record with metadata
%% - `image(Uri, Metadata)` - Creates an image content record
%% - `resource(Uri, Metadata)` - Creates a resource content record
%% - `json(Data)` - Creates a JSON content record
%% - `json(Data, Metadata)` - Creates a JSON content record with metadata
%%
%% ## Example Usage
%%
%% ```erlang
%% %% Create text content
%% TextContent = erlmcp_mcp_types:text(<<"Hello, World!">>),
%%
%% %% Create image content with metadata
%% ImageContent = erlmcp_mcp_types:image(<<"data:image/png;base64,...">>, #{
%%     <<"mimeType">> => <<"image/png">>,
%%     <<"annotations">> => #{<<"author">> => <<"Alice">>}
%% }),
%%
%% %% Create resource content
%% ResourceContent = erlmcp_mcp_types:resource(<<"https://example.com/data.json">>, #{
%%     <<"mimeType">> => <<"application/json">>
%% }),
%%
%% %% Create JSON content
%% JsonContent = erlmcp_mcp_types:json(#{<<"key">> => <<"value">>}),
%%
%% %% Validate content
%% case erlmcp_mcp_types:validate_text_record(TextContent) of
%%     {ok, ValidContent} -> ok;
%%     {error, Reason} -> error(Reason)
%% end.
%% ```
%%
%% Example of prevented bug:
%%   invoke_tool(RequestId, ToolName)  % WRONG - arguments swapped
%%   invoke_tool(ToolName, RequestId)  % CORRECT
%%
%% Without nominal types, Dialyzer would accept both calls.
%% With nominal types, Dialyzer rejects the incorrect call.

%%====================================================================
%% Type Exports
%%====================================================================

-export_type([
    mcp_request_id/0,
    mcp_tool_name/0,
    mcp_resource_uri/0,
    mcp_session_id/0,
    mcp_prompt_name/0,
    mcp_task_id/0,
    mcp_progress_token/0,
    mcp_cursor_token/0,
    mcp_call_message/0,
    mcp_result_message/0,
    mcp_notification_message/0,
    mcp_session_token/0,
    mcp_auth_token/0,
    mcp_api_token/0,
    content_type/0,
    annotation_type/0
]).

%%====================================================================
%% Content Type Definitions (beamai_mcp compatibility)
%%====================================================================

%% @type content_type() - MCP content block types
-type content_type() :: text | image | resource | json.
%% @type annotation_type() - Content annotation metadata
-type annotation_type() :: #{
    name := binary(),
    value := binary() | number() | boolean() | map()
}.

%%====================================================================
%% Type Constructor Functions
%%====================================================================

%% @doc Create request ID from a binary
%% Ensures the binary is non-empty
-spec new_request_id(binary()) -> mcp_request_id().
new_request_id(Id) when is_binary(Id), byte_size(Id) > 0 ->
    Id;
new_request_id(_) ->
    error(badarg).

%% @doc Create a tool name from a binary
-spec new_tool_name(binary()) -> mcp_tool_name().
new_tool_name(Name) when is_binary(Name), byte_size(Name) > 0 ->
    Name;
new_tool_name(_) ->
    error(badarg).

%% @doc Create a resource URI from a binary
-spec new_resource_uri(binary()) -> mcp_resource_uri().
new_resource_uri(Uri) when is_binary(Uri), byte_size(Uri) > 0 ->
    Uri;
new_resource_uri(_) ->
    error(badarg).

%% @doc Create a session ID from a binary
-spec new_session_id(binary()) -> mcp_session_id().
new_session_id(Id) when is_binary(Id), byte_size(Id) > 0 ->
    Id;
new_session_id(_) ->
    error(badarg).

%% @doc Create a prompt name from a binary
-spec new_prompt_name(binary()) -> mcp_prompt_name().
new_prompt_name(Name) when is_binary(Name), byte_size(Name) > 0 ->
    Name;
new_prompt_name(_) ->
    error(badarg).

%% @doc Create a task ID from a binary
-spec new_task_id(binary()) -> mcp_task_id().
new_task_id(Id) when is_binary(Id), byte_size(Id) > 0 ->
    Id;
new_task_id(_) ->
    error(badarg).

%% @doc Create a progress token from a binary or integer
-spec new_progress_token(binary() | integer()) -> mcp_progress_token().
new_progress_token(Token) when is_binary(Token), byte_size(Token) > 0 ->
    Token;
new_progress_token(Token) when is_integer(Token), Token > 0 ->
    Token;
new_progress_token(_) ->
    error(badarg).

%% @doc Create a cursor token from a binary
-spec new_cursor_token(binary()) -> mcp_cursor_token().
new_cursor_token(Token) when is_binary(Token), byte_size(Token) > 0 ->
    Token;
new_cursor_token(_) ->
    error(badarg).

%%====================================================================
%% Content Constructor Functions (beamai_mcp compatibility)
%%====================================================================

%% @doc Create text content record
%% @equiv text(Text, #{})
-spec text(Text :: binary()) -> #mcp_content{}.
text(Text) when is_binary(Text), byte_size(Text) > 0 ->
    #mcp_content{
        type = ?MCP_CONTENT_TYPE_TEXT,
        text = Text,
        annotations = []
    };
text(_) ->
    error({badarg, text_empty_text}).

%% @doc Create text content record with metadata
%% @equiv text_content(Text, Metadata)
-spec text(Text :: binary(), Metadata :: map()) -> #mcp_content{}.
text(Text, Metadata) when is_binary(Text), byte_size(Text) > 0, is_map(Metadata) ->
    Annotations = maps:get(<<"annotations">>, Metadata, []),
    #mcp_content{
        type = ?MCP_CONTENT_TYPE_TEXT,
        text = Text,
        annotations = Annotations
    };
text(_, _) ->
    error({badarg, text_invalid_args}).

%% @doc Create image content record
-spec image(Uri :: binary(), Metadata :: map()) -> #mcp_content{}.
image(Uri, Metadata) when is_binary(Uri), byte_size(Uri) > 0, is_map(Metadata) ->
    MimeType = maps:get(<<"mimeType">>, Metadata, <<"application/octet-stream">>),
    Data = maps:get(<<"data">>, Metadata, <<>>),
    Annotations = maps:get(<<"annotations">>, Metadata, []),
    #mcp_content{
        type = ?MCP_CONTENT_TYPE_IMAGE,
        data = Data,
        mime_type = MimeType,
        annotations = Annotations
    };
image(_, _) ->
    error({badarg, image_invalid_args}).

%% @doc Create resource content record
-spec resource(Uri :: binary(), Metadata :: map()) -> #mcp_content{}.
resource(Uri, Metadata) when is_binary(Uri), byte_size(Uri) > 0, is_map(Metadata) ->
    MimeType = maps:get(<<"mimeType">>, Metadata, <<"application/octet-stream">>),
    Annotations = maps:get(<<"annotations">>, Metadata, []),
    ResourceLink = #mcp_resource_link{
        uri = Uri,
        mime_type = MimeType
    },
    #mcp_content{
        type = ?MCP_CONTENT_TYPE_RESOURCE,
        resource_link = ResourceLink,
        annotations = Annotations
    };
resource(_, _) ->
    error({badarg, resource_invalid_args}).

%% @doc Create JSON content record
-spec json(Data :: term()) -> #mcp_content{}.
json(Data) when is_map(Data) ->
    #mcp_content{
        type = ?MCP_CONTENT_TYPE_JSON,
        text = json_encode(Data)
    };
json(_) ->
    error({badarg, json_not_map}).

%% @doc Create JSON content record with metadata
-spec json(Data :: term(), Metadata :: map()) -> #mcp_content{}.
json(Data, Metadata) when is_map(Data), is_map(Metadata) ->
    Annotations = maps:get(<<"annotations">>, Metadata, []),
    #mcp_content{
        type = ?MCP_CONTENT_TYPE_JSON,
        text = json_encode(Data),
        annotations = Annotations
    };
json(_, _) ->
    error({badarg, json_invalid_args}).

%%====================================================================
%% Content Validation Functions (beamai_mcp compatibility)
%%====================================================================

%% @doc Validate JSON content record
%% Returns the record if valid, error tuple otherwise
-spec validate_json_content(#mcp_content{}) -> {ok, #mcp_content{}} | {error, term()}.
validate_json_content(#mcp_content{type = ?MCP_CONTENT_TYPE_JSON, text = Text})
  when is_binary(Text), byte_size(Text) > 0 ->
    {ok, #mcp_content{type = ?MCP_CONTENT_TYPE_JSON, text = Text}};
validate_json_content(#mcp_content{type = ?MCP_CONTENT_TYPE_JSON}) ->
    {error, {invalid_json_content, missing_text}};
validate_json_content(_) ->
    {error, {invalid_json_content, wrong_type}}.

%% @doc Validate text content record
%% Returns the record if valid, error tuple otherwise
-spec validate_text_record(#mcp_content{}) -> {ok, #mcp_content{}} | {error, term()}.
validate_text_record(#mcp_content{type = ?MCP_CONTENT_TYPE_TEXT, text = Text})
  when is_binary(Text), byte_size(Text) > 0 ->
    {ok, #mcp_content{type = ?MCP_CONTENT_TYPE_TEXT, text = Text}};
validate_text_record(#mcp_content{type = ?MCP_CONTENT_TYPE_TEXT}) ->
    {error, {invalid_text_record, missing_text}};
validate_text_record(_) ->
    {error, {invalid_text_record, wrong_type}}.

%% @doc Validate image content record
%% Returns the record if valid, error tuple otherwise
-spec validate_image_record(#mcp_content{}) -> {ok, #mcp_content{}} | {error, term()}.
validate_image_record(#mcp_content{type = ?MCP_CONTENT_TYPE_IMAGE, data = Data, mime_type = MimeType})
  when is_binary(Data), is_binary(MimeType), byte_size(MimeType) > 0 ->
    {ok, #mcp_content{type = ?MCP_CONTENT_TYPE_IMAGE, data = Data, mime_type = MimeType}};
validate_image_record(#mcp_content{type = ?MCP_CONTENT_TYPE_IMAGE}) ->
    {error, {invalid_image_record, missing_required_fields}};
validate_image_record(_) ->
    {error, {invalid_image_record, wrong_type}}.

%% @doc Validate resource content record
%% Returns the record if valid, error tuple otherwise
-spec validate_resource_record(#mcp_content{}) -> {ok, #mcp_content{}} | {error, term()}.
validate_resource_record(#mcp_content{type = ?MCP_CONTENT_TYPE_RESOURCE, resource_link = ResourceLink})
  when ResourceLink =/= undefined ->
    #mcp_resource_link{uri = Uri, mime_type = MimeType} = ResourceLink,
    case {is_binary(Uri), is_binary(MimeType), byte_size(Uri) > 0, byte_size(MimeType) > 0} of
        {true, true, true, true} ->
            {ok, #mcp_content{type = ?MCP_CONTENT_TYPE_RESOURCE, resource_link = ResourceLink}};
        _ ->
            {error, {invalid_resource_record, invalid_uri_or_mime_type}}
    end;
validate_resource_record(#mcp_content{type = ?MCP_CONTENT_TYPE_RESOURCE}) ->
    {error, {invalid_resource_record, missing_resource_link}};
validate_resource_record(_) ->
    {error, {invalid_resource_record, wrong_type}}.

%%====================================================================
%% Content Manipulation Functions (beamai_mcp compatibility)
%%====================================================================

%% @doc Create annotation from name and value
-spec make_annotation(binary(), term()) -> annotation_type().
make_annotation(Name, Value) when is_binary(Name) ->
    #{name => Name, value => Value}.

%% @doc Convert annotation to record
-spec annotation_to_record(annotation_type()) -> #mcp_annotation{}.
annotation_to_record(#{name := Name, value := Value}) ->
    #mcp_annotation{name = Name, value = Value}.

%% @doc Convert record to annotation map
-spec record_to_annotation(#mcp_annotation{}) -> annotation_type().
record_to_annotation(#mcp_annotation{name = Name, value = Value}) ->
    #{name => Name, value => Value}.

%% @doc Validate content type
-spec validate_content_type(content_type()) -> content_type().
validate_content_type(Type) when Type == text; Type == image; Type == resource; Type == json ->
    Type;
validate_content_type(_) ->
    error({badarg, invalid_content_type}).

%% @doc Check if content record is valid
-spec is_valid_content(#mcp_content{}) -> boolean().
is_valid_content(#mcp_content{type = Type}) ->
    ValidTypes = [?MCP_CONTENT_TYPE_TEXT, ?MCP_CONTENT_TYPE_IMAGE, ?MCP_CONTENT_TYPE_RESOURCE, ?MCP_CONTENT_TYPE_JSON],
    lists:member(Type, ValidTypes);
is_valid_content(_) ->
    false.

%% @doc Get content type from record
-spec get_content_type(#mcp_content{}) -> content_type().
get_content_type(#mcp_content{type = Type}) ->
    case Type of
        ?MCP_CONTENT_TYPE_TEXT -> text;
        ?MCP_CONTENT_TYPE_IMAGE -> image;
        ?MCP_CONTENT_TYPE_RESOURCE -> resource;
        ?MCP_CONTENT_TYPE_JSON -> json;
        _ -> unknown
    end.

%% @doc Convert content record to map
-spec content_record_to_map(#mcp_content{}) -> map().
content_record_to_map(#mcp_content{type = Type, text = Text, data = Data,
                                   mime_type = MimeType, annotations = Annotations,
                                   resource_link = ResourceLink}) ->
    Base = #{<<"type">> => Type},
    Content = case Type of
        ?MCP_CONTENT_TYPE_TEXT ->
            Base#{<<"text">> => Text};
        ?MCP_CONTENT_TYPE_IMAGE ->
            Base#{<<"data">> => Data, <<"mimeType">> => MimeType};
        ?MCP_CONTENT_TYPE_RESOURCE ->
            ResourceMap = case ResourceLink of
                #mcp_resource_link{uri = Uri, mime_type = MimeType} ->
                    #{<<"uri">> => Uri, <<"mimeType">> => MimeType};
                _ -> #{}
            end,
            Base#{<<"resource">> => ResourceMap};
        ?MCP_CONTENT_TYPE_JSON ->
            JsonData = case Text of
                <<>> -> #{};
                _ -> json_decode(Text)
            end,
            Base#{<<"json">> => JsonData}
    end,
    AnnotationsMap = annotations_to_map(Annotations),
    case maps:size(AnnotationsMap) of
        0 -> Content;
        _ -> Content#{<<"annotations">> => AnnotationsMap}
    end.

%% @doc Convert map to content record
-spec map_to_content_record(map()) -> #mcp_content{}.
map_to_content_record(#{<<"type">> := Type} = Map) ->
    Annotations = maps:get(<<"annotations">>, Map, []),
    Records = [annotation_to_record(Ann) || Ann <- Annotations],

    case Type of
        ?MCP_CONTENT_TYPE_TEXT ->
            Text = maps:get(<<"text">>, Map, <<>>),
            #mcp_content{type = Type, text = Text, annotations = Records};
        ?MCP_CONTENT_TYPE_IMAGE ->
            Data = maps:get(<<"data">>, Map, <<>>),
            MimeType = maps:get(<<"mimeType">>, Map, <<"application/octet-stream">>),
            #mcp_content{type = Type, data = Data, mime_type = MimeType, annotations = Records};
        ?MCP_CONTENT_TYPE_RESOURCE ->
            ResourceMap = maps:get(<<"resource">>, Map, #{}),
            Uri = maps:get(<<"uri">>, ResourceMap, <<>>),
            MimeType = maps:get(<<"mimeType">>, ResourceMap, <<"application/octet-stream">>),
            ResourceLink = #mcp_resource_link{uri = Uri, mime_type = MimeType},
            #mcp_content{type = Type, resource_link = ResourceLink, annotations = Records};
        ?MCP_CONTENT_TYPE_JSON ->
            JsonData = maps:get(<<"json">>, Map, #{}),
            Text = json_encode(JsonData),
            #mcp_content{type = Type, text = Text, annotations = Records}
    end.

%%====================================================================
%% Legacy Content Validation Functions (kept for backward compatibility)
%%====================================================================

%% @doc Validate text content
-spec validate_text_content(binary()) -> {ok, binary()} | {error, term()}.
validate_text_content(Text) when is_binary(Text), byte_size(Text) > 0 ->
    {ok, Text};
validate_text_content(_) ->
    {error, invalid_text_content}.

%% @doc Validate image content
-spec validate_image_content(binary(), binary()) -> {ok, {binary(), binary()}} | {error, term()}.
validate_image_content(Data, MimeType)
  when is_binary(Data), byte_size(Data) > 0, is_binary(MimeType), byte_size(MimeType) > 0 ->
    {ok, {Data, MimeType}};
validate_image_content(_, _) ->
    {error, invalid_image_content}.

%% @doc Validate resource content
-spec validate_resource_content(binary(), binary()) -> {ok, {binary(), binary()}} | {error, term()}.
validate_resource_content(Uri, MimeType)
  when is_binary(Uri), byte_size(Uri) > 0, is_binary(MimeType), byte_size(MimeType) > 0 ->
    {ok, {Uri, MimeType}};
validate_resource_content(_, _) ->
    {error, invalid_resource_content}.

%%====================================================================
%% Content Manipulation Functions (legacy, kept for backward compatibility)
%%====================================================================

%% @doc Add annotation to content block
-spec add_annotation(map(), binary(), term()) -> map().
add_annotation(Content, Name, Value) when is_map(Content), is_binary(Name) ->
    Annotations = get_annotations(Content),
    NewAnnotations = Annotations#{Name => Value},
    Content#{<<"annotations">> => NewAnnotations}.

%% @doc Get annotation from content block
-spec get_annotation(map(), binary()) -> term() | undefined.
get_annotation(Content, Name) when is_map(Content), is_binary(Name) ->
    Annotations = get_annotations(Content),
    maps:get(Name, Annotations, undefined).

%% @doc Remove annotation from content block
-spec remove_annotation(map(), binary()) -> map().
remove_annotation(Content, Name) when is_map(Content), is_binary(Name) ->
    Annotations = get_annotations(Content),
    NewAnnotations = maps:remove(Name, Annotations),
    Content#{<<"annotations">> => NewAnnotations}.

%% @doc Check if content has specific annotation
-spec has_annotation(map(), binary()) -> boolean().
has_annotation(Content, Name) when is_map(Content), is_binary(Name) ->
    Annotations = get_annotations(Content),
    maps:is_key(Name, Annotations).

%% @doc Get all annotations from content block
-spec get_annotations(map()) -> map().
get_annotations(Content) when is_map(Content) ->
    maps:get(<<"annotations">>, Content, #{}).

%%====================================================================
%% Conversion Functions to Map Format (legacy, kept for backward compatibility)
%%====================================================================

%% @doc Convert tool record to map (for JSON encoding)
-spec tool_to_map(#mcp_tool{}) -> map().
tool_to_map(#mcp_tool{name = Name, description = Desc, input_schema = Schema,
                       output_schema = OutputSchema}) ->
    Base = #{<<"name">> => Name, <<"description">> => Desc, <<"inputSchema">> => Schema},
    case OutputSchema of
        undefined -> Base;
        _ -> Base#{<<"outputSchema">> => OutputSchema}
    end.

%% @doc Convert resource record to map
-spec resource_to_map(#mcp_resource{}) -> map().
resource_to_map(#mcp_resource{uri = Uri, name = Name, title = Title,
                              description = Desc, mime_type = MimeType}) ->
    Base = #{<<"uri">> => Uri, <<"name">> => Name},
    add_optional_fields(Base, [
        {<<"title">>, Title},
        {<<"description">>, Desc},
        {<<"mimeType">>, MimeType}
    ]).

%% @doc Convert resource template to map
-spec resource_template_to_map(#mcp_resource_template{}) -> map().
resource_template_to_map(#mcp_resource_template{uri_template = UriTemplate,
                                                 name = Name, title = Title,
                                                 description = Desc, mime_type = MimeType}) ->
    Base = #{<<"uriTemplate">> => UriTemplate, <<"name">> => Name},
    add_optional_fields(Base, [
        {<<"title">>, Title},
        {<<"description">>, Desc},
        {<<"mimeType">>, MimeType}
    ]).

%% @doc Convert prompt record to map
-spec prompt_to_map(#mcp_prompt{}) -> map().
prompt_to_map(#mcp_prompt{name = Name, title = Title, description = Desc,
                          arguments = Args}) ->
    Base = #{<<"name">> => Name},
    WithOptional = add_optional_fields(Base, [
        {<<"title">>, Title},
        {<<"description">>, Desc}
    ]),
    case Args of
        [] -> WithOptional;
        _ -> WithOptional#{<<"arguments">> => [prompt_arg_to_map(A) || A <- Args]}
    end.

%% @doc Convert prompt argument to map
-spec prompt_arg_to_map(#mcp_prompt_argument{}) -> map().
prompt_arg_to_map(#mcp_prompt_argument{name = Name, description = Desc, required = Required}) ->
    Base = #{<<"name">> => Name, <<"required">> => Required},
    add_optional_fields(Base, [{<<"description">>, Desc}]).

%% @doc Convert server capabilities to map
-spec server_capabilities_to_map(#mcp_server_capabilities{}) -> map().
server_capabilities_to_map(#mcp_server_capabilities{tools = Tools, resources = Resources,
                                                      prompts = Prompts, logging = Logging}) ->
    Caps = #{},
    Caps1 = add_capability(Caps, <<"tools">>, Tools),
    Caps2 = add_capability(Caps1, <<"resources">>, Resources),
    Caps3 = add_capability(Caps2, <<"prompts">>, Prompts),
    add_capability(Caps3, <<"logging">>, Logging).

%% @doc Convert client capabilities to map
-spec client_capabilities_to_map(#mcp_client_capabilities{}) -> map().
client_capabilities_to_map(#mcp_client_capabilities{roots = Roots, sampling = Sampling,
                                                      elicitation = Elicitation}) ->
    Caps = #{},
    Caps1 = add_capability(Caps, <<"roots">>, Roots),
    Caps2 = add_capability(Caps1, <<"sampling">>, Sampling),
    add_capability(Caps2, <<"elicitation">>, Elicitation).

%% @doc Convert content block to map (identity function)
-spec content_to_map(map()) -> map().
content_to_map(Content) when is_map(Content) ->
    Content.

%% @doc Convert annotation to map
-spec annotation_to_map(annotation_type()) -> map().
annotation_to_map(#{name := Name, value := Value}) ->
    #{<<"name">> => Name, <<"value">> => Value}.

%%====================================================================
%% Internal Helper Functions
%%====================================================================

%% Convert annotations to map
annotations_to_map(Annotations) when is_list(Annotations) ->
    maps:from_list([{Ann#mcp_annotation.name, Ann#mcp_annotation.value} || Ann <- Annotations]);
annotations_to_map(_) ->
    #{}.

%% Convert map to annotations
map_to_annotations(Map) when is_map(Map) ->
    [make_annotation(Name, Value) || {Name, Value} <- maps:to_list(Map)];
map_to_annotations(_) ->
    [].

%% Simple JSON encode function for basic types
json_encode(Term) when is_map(Term) ->
    json_encode_map(Term);
json_encode(List) when is_list(List) ->
    json_encode_list(List);
json_encode(Binary) when is_binary(Binary) ->
    Binary;
json_encode(Number) when is_number(Number) ->
    Number;
json_encode(Bool) when is_boolean(Bool) ->
    Bool;
json_encode(Atom) when is_atom(Atom) ->
    atom_to_binary(Atom, utf8).

json_encode_map(Map) ->
    EncodedPairs = maps:fold(fun(K, V, Acc) ->
        EncodedK = if is_binary(K) -> K; true -> atom_to_binary(K, utf8) end,
        EncodedV = json_encode(V),
        [<<"\"", EncodedK/binary, "\":", json_encode_value(EncodedV)/binary> | Acc]
    end, [], maps:to_list(Map)),
    <<"{", (lists:reverse(EncodedPairs))/binary, "}">>.

json_encode_value(Binary) when is_binary(Binary) ->
    <<$", Binary/binary, $">>;
json_encode_value(Number) when is_number(Number) ->
    integer_to_binary(Number);
json_encode_value(Bool) when is_boolean(Bool) ->
    if Bool -> <<"true">>; true -> <<"false">> end;
json_encode_value(Value) ->
    list_to_binary(io_lib:format("~p", [Value])).

json_encode_list(List) ->
    EncodedItems = [json_encode(Item) || Item <- List],
    <<"[", (lists:join(<<",">>, EncodedItems))/binary, "]">>.

%% Simple JSON decode function for basic types
json_decode(Binary) when is_binary(Binary) ->
    % Simple implementation for demonstration
    % In production, use a proper JSON parser
    try
        case Binary of
            <<"[", Rest/binary>> ->
                json_decode_array(Rest);
            <<"{", Rest/binary>> ->
                json_decode_object(Rest);
            _ ->
                % Try to parse as string
                case byte_size(Binary) > 2 of
                    true ->
                        case binary:part(Binary, {0, 1}) of
                            <<"\"">> ->
                                binary:part(Binary, {1, byte_size(Binary)-2});
                            _ ->
                                Binary % Return as-is for non-string values
                        end;
                    false ->
                        Binary
                end
        end
    catch
        _ -> Binary
    end.

json_decode_array(Binary) ->
    json_decode_array(Binary, []).

json_decode_array(<<"]", _/binary>, Acc) ->
    lists:reverse(Acc);
json_decode_array(Binary, Acc) ->
    % Parse next value
    {Value, Rest} = json_decode_value(Binary),
    json_decode_array(Rest, [Value | Acc]).

json_decode_value(<<$", Rest/binary>>) ->
    json_decode_string(Rest, <<>>);
json_decode_value(<<"{", Rest/binary>>) ->
    {Object, Rest1} = json_decode_object(Rest),
    {Object, Rest1};
json_decode_value(<<"[", Rest/binary>>) ->
    {Array, Rest1} = json_decode_array(Rest, []),
    {Array, Rest1};
json_decode_value(Binary) ->
    % Try to parse as number or boolean
    case binary:split(Binary, <<",">>, [{parts, 2}, {trim, true}]) of
        [Num, Rest] when is_binary(Num) ->
            case try_parse_number(Num) of
                {ok, N} -> {N, Rest};
                error -> {Num, Rest}
            end;
        [Value] -> {Value, <<>>}
    end.

json_decode_string(<<$", Rest/binary>>, Acc) ->
    {Acc, Rest};
json_decode_string(<<H, Rest/binary>>, Acc) ->
    json_decode_string(Rest, <<Acc/binary, H>>).

json_decode_object(Binary) ->
    json_decode_object(Binary, #{}).

json_decode_object(<<"}", _/binary>>, Acc) ->
    {Acc, <<>>};
json_decode_object(Binary, Acc) ->
    % Parse key-value pair
    {Key, Rest1} = json_decode_value(Binary),
    {_, Rest2} = json_decode_value(Rest1), % Skip colon
    {Value, Rest3} = json_decode_value(Rest2),
    json_decode_object(Rest3, Acc#{Key => Value}).

try_parse_number(Binary) ->
    try
        {ok, binary_to_integer(Binary)}
    catch
        error:_ ->
            try
                {ok, binary_to_float(Binary)}
            catch
                error:_ -> error
            end
    end.

%% Add optional fields to map, filtering out undefined values
add_optional_fields(Map, []) -> Map;
add_optional_fields(Map, [{_Key, undefined} | Rest]) ->
    add_optional_fields(Map, Rest);
add_optional_fields(Map, [{Key, Value} | Rest]) ->
    add_optional_fields(Map#{Key => Value}, Rest).

%% Add capability to map, handling different types
add_capability(Map, _Key, false) -> Map;
add_capability(Map, Key, true) -> Map#{Key => #{}};
add_capability(Map, Key, SubCaps) when is_map(SubCaps) -> Map#{Key => SubCaps}.