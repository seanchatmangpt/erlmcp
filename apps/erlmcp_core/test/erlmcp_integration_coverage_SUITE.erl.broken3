%%%-------------------------------------------------------------------
%%% @doc Integration Coverage Test Suite
%%%
%%% Common Test suite for testing integration between erlmcp modules
%%% Focuses on achieving 80%+ coverage across all applications.
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_integration_coverage_SUITE).
-author("erlmcp").

-include_lib("common_test/include/ct.hrl").
-include_lib("kernel/include/logger.hrl").

%% Test server configuration
-define(TEST_SERVER, erlmcp_integration_test_server).
-define(TEST_PORT, 58080).
-define(TIMEOUT, 30000).

%%%=============================================================================
%%% Suite Callbacks
%%%=============================================================================

all() ->
    [
     test_coverage_alert_manager,
     test_coverage_quality_gates,
     test_coverage_compliance_framework,
     test_coverage_policy_enforcer,
     test_coverage_tracer,
     test_coverage_transport_tcp,
     test_coverage_transport_ws,
     test_coverage_validation_modules,
     test_coverage_observability_modules
    ].

init_per_suite(Config) ->
    ct:pal("Starting integration coverage tests~n", []),
    Config.

end_per_suite(_Config) ->
    ct:pal("Integration coverage tests completed~n", []),
    ok.

init_per_testcase(TestCase, Config) ->
    ct:pal("Starting test: ~p~n", [TestCase]),
    Config.

end_per_testcase(_TestCase, _Config) ->
    ok.

%%%=============================================================================
%%% Alert Manager Coverage Tests
%%%=============================================================================

test_coverage_alert_manager(_Config) ->
    ct:pal("Running alert manager coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
        %% Start alert manager
         {ok, Pid} = erlmcp_alert_manager:start_link(#{}),

         %% Add route
         Route = #{
             id => <<"test-route">>,
             name => <<"Test Route">>,
             condition => <<"severity=high">>,
             targets => [<<"slack">>]
         },
         ok = erlmcp_alert_manager:add_route(Route),

         %% Send alert
         Alert = #{
             source => <<"integration-test">>,
             severity => high,
             title => <<"Integration Test Alert">>,
             message => <<"Testing alert coverage">>
         },
         ok = erlmcp_alert_manager:send_alert(Alert),

         %% Verify metrics
         Metrics = erlmcp_alert_manager:get_metrics(),
         ct:pal("Alert metrics: ~p~n", [Metrics]),

         %% Cleanup
         gen_server:stop(Pid),

         ?assert(maps:is_key(total_alerts, Metrics))
     end}
    ].

%%%=============================================================================
%%% Quality Gates Coverage Tests
%%%=============================================================================

test_coverage_quality_gates(_Config) ->
    ct:pal("Running quality gates coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Run all quality gates
         Results = erlmcp_quality_gates:run_all_gates(),
         ct:pal("Quality gates results: ~p~n", [length(Results)]),

         %% Verify structure
         ?assertEqual(8, length(Results)),

         %% Generate report
         Report = erlmcp_quality_gates:generate_report(Results),
         ct:pal("Quality gates report status: ~p~n", [maps:get(overall_status, Report)]),

         ?assert(maps:is_key(overall_status, Report)),
         ?assert(maps:is_key(mandatory_gates, Report))
     end}
    ].

%%%=============================================================================
%%% Compliance Framework Coverage Tests
%%%=============================================================================

test_coverage_compliance_framework(_Config) ->
    ct:pal("Running compliance framework coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Start compliance framework
         {ok, Pid} = erlmcp_compliance_framework:start_link(#{}),

         %% Add compliance rule
         Rule = #{
             id => <<"test-rule">>,
             category => security,
             severity => medium,
             description => <<"Test compliance rule">>,
             check => fun(_) -> true end
         },
         ok = gen_server:call(Pid, {add_rule, Rule}),

         %% Evaluate compliance
         Target = #{type => module, name => <<"test">>, version => <<"1.0.0">>},
         Result = gen_server:call(Pid, {evaluate_compliance, Target}),
         ct:pal("Compliance result: ~p~n", [Result]),

         %% Cleanup
         gen_server:stop(Pid),

         ?assert(is_map(Result))
     end}
    ].

%%%=============================================================================
%%% Policy Enforcer Coverage Tests
%%%=============================================================================

test_coverage_policy_enforcer(_Config) ->
    ct:pal("Running policy enforcer coverage tests...~n", []),
    [
     {timetrap,, fun() ->
         %% Start policy enforcer
         {ok, Pid} = erlmcp_policy_enforcer:start_link(#{}),

         %% Add policy
         Policy = #{
             id => <<"resource-limit">>,
             name => <<"Resource Limit Policy">>,
             type => resource_limit,
             limit => 100,
             window => <<"1m">>
         },
         ok = gen_server:call(Pid, {add_policy, Policy}),

         %% Evaluate policy
         Request = #{type => tool, action => <<"invoke">>, count => 50},
         Decision = gen_server:call(Pid, {evaluate, Request}),
         ct:pal("Policy decision: ~p~n", [Decision]),

         %% Cleanup
         gen_server:stop(Pid),

         ?assert(is_map(Decision))
     end}
    ].

%%%=============================================================================
%%% Tracer Coverage Tests
%%%=============================================================================

test_coverage_tracer(_Config) ->
    ct:pal("Running tracer coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Start tracer
         {ok, Pid} = erlmcp_tracer:start_link(#{}),

         %% Create span
         Span = erlmcp_tracer:create_span(<<"test-operation">>, #{}),
         ct:pal("Created span: ~p~n", [Span]),

         %% Add event
         SpanId = maps:get(span_id, Span),
         Event = #{name => <<"test-event">>, timestamp => os:system_time(millisecond)},
         ok = erlmcp_tracer:add_event(SpanId, Event),

         %% Finish span
         ok = erlmcp_tracer:finish_span(SpanId),

         %% Cleanup
         gen_server:stop(Pid),

         ?assert(is_map(Span)),
         ?assert(is_binary(SpanId))
     end}
    ].

%%%=============================================================================
%%% Transport TCP Coverage Tests
%%%=============================================================================

test_coverage_transport_tcp(_Config) ->
    ct:pal("Running TCP transport coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Test transport initialization
         Opts = #{
             mode => client,
             host => <<"localhost">>,
             port => 0,
             owner => self()
         },
         ?assertMatch({ok, _State}, erlmcp_transport_tcp:transport_init(Opts)),

         %% Test get_info
         Info = erlmcp_transport_tcp:get_info(Opts),
         ?assert(is_map(Info)),

         %% Test message extraction
         Buffer = <<"msg1\nmsg2\nmsg3\n">>,
         {Messages, Remaining} = erlmcp_transport_tcp:extract_messages(Buffer),
         ?assertEqual(3, length(Messages)),
         ?assertEqual(<<>>, Remaining),

         ct:pal("Extracted ~p messages~n", [length(Messages)])
     end}
    ].

%%%=============================================================================
%%% Transport WebSocket Coverage Tests
%%%=============================================================================

test_coverage_transport_ws(_Config) ->
    ct:pal("Running WebSocket transport coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Test WebSocket frame encoding
         Frame = <<129:8, 5:8, "Hello">>,
         ?assert(is_binary(Frame)),
         ?assertEqual(<<129:8, 5:8, "Hello">>, Frame),

         %% Test URL parsing
         WsUrl = <<"ws://localhost:8080/mcp">>,
         ?assertMatch({ok, {ws, <<"localhost">>, 8080, <<"/mcp">>}},
                  parse_ws_url(WsUrl)),

         ct:pal("WebSocket URL parsed: ~p~n", [WsUrl])
     end}
    ].

%%%=============================================================================
%%% Validation Modules Coverage Tests
%%%=============================================================================

test_coverage_validation_modules(_Config) ->
    ct:pal("Running validation modules coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Test URI validator
         ValidURI = <<"file:///valid/path">>,
         ?assertEqual(ok, erlmcp_uri_validator:validate(ValidURI)),

         %% Test security validator
         SecurityResult = erlmcp_security_validator:validate(#{type => security}),
         ?assert(is_map(SecurityResult)),

         %% Test performance validator
         PerfResult = erlmcp_performance_validator:validate(#{type => performance}),
         ?assert(is_map(PerfResult)),

         ct:pal("Validation modules tested~n", [])
     end}
    ].

%%%=============================================================================
%%% Observability Modules Coverage Tests
%%%=============================================================================

test_coverage_observability_modules(_Config) ->
    ct:pal("Running observability modules coverage tests...~n", []),
    [
     {timetrap, 30000, fun() ->
         %% Test metrics
         ?assert(is_function(erlmcp_metrics, increment, 1)),
         ?assertEqual(ok, erlmcp_metrics:increment(test_counter)),

         %% Test counters
         ?assertEqual(ok, erlmcp_counters:increment(test_counter)),
         ?assertEqual(1, erlmcp_counters:value(test_counter)),

         %% Test event logger
         ?assertEqual(ok, erlmcp_event_logger:log(#{level => info, msg => <<"test">>})),

         ct:pal("Observability modules tested~n", [])
     end}
    ].

%%%=============================================================================
%%% Helper Functions
%%%=============================================================================

parse_ws_url(Url) ->
    {ok, {Scheme, _, _, Host, Port, Path}} = http_uri:parse(Url),
    {Scheme, Host, Port, Path}.
