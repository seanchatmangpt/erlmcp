%%%-------------------------------------------------------------------
%%% @doc
%%% Comprehensive Common Test suite for erlmcp_client_registry module
%%%
%%% This test suite validates the client registry functionality including:
%%% - Client registration and lifecycle
%%% - Client lookup and resolution
%%% - Client monitoring and cleanup
%%% - Concurrent client operations
%%% - Error handling and recovery
%%% - Performance characteristics
%%% - Integration with transport registry
%%% - Session management
%%% - Authentication integration
%%% - Metrics and statistics
%%%
%%% Chicago School TDD methodology is used with real processes only.
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_client_registry_SUITE).

-include_lib("common_test/include/ct.hrl").
-include_lib("eunit/include/eunit.hrl").
-include("erlmcp.hrl").

%% Suite callbacks
-export([all/0, groups/0, init_per_suite/1, end_per_suite/1, init_per_group/2, end_per_group/2,
         init_per_testcase/2, end_per_testcase/2]).

%% Test cases
-export([registry_module_exists/1,
         client_lifecycle/1,
         client_lookup/1,
         client_monitoring/1,
         concurrent_operations/1,
         error_handling/1,
         performance_benchmarks/1,
         metrics_and_stats/1,
         integration_tests/1,
         authentication_integration/1,
         session_management/1]).

%%====================================================================
%% Suite Configuration
%%====================================================================

all() ->
    [{group, core_functionality},
     {group, monitoring_tests},
     {group, performance_tests},
     {group, concurrent_tests},
     {group, integration_tests}].

groups() ->
    [{core_functionality, [parallel],
      [registry_module_exists, client_lifecycle, client_lookup, client_monitoring]},
     {monitoring_tests, [parallel],
      [client_monitoring, metrics_and_stats]},
     {performance_tests, [parallel],
      [performance_benchmarks]},
     {concurrent_tests, [parallel],
      [concurrent_operations]},
     {integration_tests, [parallel],
      [integration_tests, authentication_integration, session_management]}].

%%====================================================================
%% Suite Setup/Teardown
%%====================================================================

init_per_suite(Config) ->
    ct:pal("Starting client registry test suite"),

    % Start required applications
    {ok, Apps} = application:ensure_all_started(crypto),
    ct:pal("Started applications: ~p", [Apps]),

    % Start gproc for registry
    {ok, _} = application:ensure_all_started(gproc),

    % Start erlmcp_core application
    case application:ensure_all_started(erlmcp_core) of
        {ok, CoreApps} ->
            ct:pal("Started erlmcp_core: ~p", [CoreApps]);
        {error, Reason} ->
            ct:fail("Failed to start erlmcp_core: ~p", [Reason])
    end,

    % Verify client registry is available
    case whereis(erlmcp_client_registry) of
        undefined ->
            ct:pal("Client registry not available, will start it manually"),
            % Start the registry if not already started
            case erlmcp_client_registry:start_link() of
                {ok, _Pid} ->
                    ct:pal("Client registry started successfully");
                {error, Reason} ->
                    ct:fail("Failed to start client registry: ~p", [Reason])
            end;
        Pid when is_pid(Pid) ->
            ct:pal("Client registry available: ~p", [Pid])
    end,

    Config.

end_per_suite(_Config) ->
    ct:pal("Ending client registry test suite"),
    % Clean up applications
    _ = application:stop(erlmcp_core),
    _ = application:stop(gproc),
    _ = application:stop(crypto),
    ok.

init_per_group(GroupName, Config) ->
    ct:pal("Starting test group: ~p", [GroupName]),
    Config.

end_per_group(GroupName, _Config) ->
    ct:pal("Ending test group: ~p", [GroupName]),
    ok.

init_per_testcase(TestCase, Config) ->
    ct:pal("Starting test case: ~p", [TestCase]),
    % Ensure clean state for each test
    cleanup_registry_state(),
    Config.

end_per_testcase(TestCase, _Config) ->
    ct:pal("Ending test case: ~p", [TestCase]),
    % Clean up after each test
    cleanup_registry_state(),
    ok.

%%====================================================================
%% Test Cases - Core Functionality
%%====================================================================

registry_module_exists(Config) ->
    % Verify the client registry module exists and loads correctly
    ?assert(code:is_loaded(erlmcp_client_registry) =/= false,
            "Client registry module not loaded"),

    % Check module exports
    Exports = erlmcp_client_registry:module_info(exports),
    ?assert(is_list(Exports), "Exports not a list"),
    ?assert(length(Exports) > 0, "No exports found"),

    % Verify key functions are exported
    RequiredExports = [start_link/0, register_client/2, unregister_client/1,
                      resolve_client/1, list_clients/0, get_stats/0,
                      health_check/0],

    lists:foreach(fun({Func, Arity}) ->
                     ?assert(erlang:function_exported(erlmcp_client_registry, Func, Arity),
                             "Missing required function: ~p/~p", [Func, Arity])
                  end,
                  RequiredExports),
    ok.

client_lifecycle(Config) ->
    % Test complete client lifecycle

    % 1. Create test client information
    ClientId = <<"test_client_001">>,
    ClientInfo = #{client_id => ClientId,
                   session_id => <<"session_001">>,
                   transport_id => <<"transport_001">>,
                   auth_token => <<"auth_token_001">>,
                   metadata => #{name => <<"Test Client">>,
                               version => <<"1.0.0">>,
                               capabilities => [<<"tools">>, <<"resources">>]}},

    % 2. Register client
    case erlmcp_client_registry:register_client(ClientId, ClientInfo) of
        ok ->
            ct:pal("Client registered successfully: ~p", [ClientId]);
        {error, Reason} ->
            ct:fail("Failed to register client: ~p", [Reason])
    end,

    % 3. Verify client is registered
    case erlmcp_client_registry:resolve_client(ClientId) of
        {ok, RegisteredInfo} ->
            ?assertEqual(ClientInfo, RegisteredInfo, "Client info mismatch");
        {error, not_found} ->
            ct:fail("Client not found after registration");
        {error, Reason} ->
            ct:fail("Error resolving client: ~p", [Reason])
    end,

    % 4. Verify client is in list
    Clients = erlmcp_client_registry:list_clients(),
    ?assert(is_list(Clients), "Clients should be a list"),
    ?assert(lists:any(fun(C) -> maps:get(client_id, C) =:= ClientId end, Clients),
            "Client not in client list"),

    % 5. Unregister client
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId)),

    % 6. Verify client is unregistered
    ?assertEqual({error, not_found},
                 erlmcp_client_registry:resolve_client(ClientId)),

    % 7. Verify client is not in list
    UpdatedClients = erlmcp_client_registry:list_clients(),
    ?assertNot(lists:any(fun(C) -> maps:get(client_id, C) =:= ClientId end, UpdatedClients),
               "Client should not be in list after unregistration"),
    ok.

client_lookup(Config) ->
    % Test client lookup functionality

    % Register multiple clients
    Clients = lists:map(fun(I) ->
                            ClientId = list_to_binary("client_" ++ integer_to_list(I)),
                            SessionId = list_to_binary("session_" ++ integer_to_list(I)),
                            TransportId = list_to_binary("transport_" ++ integer_to_list(I)),

                            ClientInfo = #{client_id => ClientId,
                                         session_id => SessionId,
                                         transport_id => TransportId,
                                         auth_token => list_to_binary("auth_" ++ integer_to_list(I)),
                                         metadata => #{index => I,
                                                    created => erlang:system_time(millisecond)}},

                            {ok, Pid} = erlmcp_client_registry:register_client(ClientId, ClientInfo),
                            {ClientId, ClientInfo}
                        end,
                        lists:seq(1, 5)),

    % Test lookup for each client
    lists:foreach(fun({ClientId, ClientInfo}) ->
                     case erlmcp_client_registry:resolve_client(ClientId) of
                         {ok, RetrievedInfo} ->
                             ?assertEqual(ClientInfo, RetrievedInfo,
                                         "Client info mismatch for ~p", [ClientId]);
                         {error, not_found} ->
                             ct:fail("Client not found: ~p", [ClientId]);
                         {error, Reason} ->
                             ct:fail("Error resolving client ~p: ~p", [ClientId, Reason])
                     end
                   end,
                   Clients),

    % Test lookup for non-existent client
    ?assertEqual({error, not_found},
                 erlmcp_client_registry:resolve_client(<<"non_existent_client">>)),

    % Test list clients
    ListedClients = erlmcp_client_registry:list_clients(),
    ?assert(length(ListedClients) >= 5, "Should have at least 5 clients"),
    lists:foreach(fun({ClientId, _}) ->
                     ?assert(lists:any(fun(C) -> maps:get(client_id, C) =:= ClientId end, ListedClients),
                             "Client ~p not in listed clients", [ClientId])
                   end,
                   Clients),

    % Clean up
    lists:foreach(fun({ClientId, _}) ->
                     ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId))
                   end,
                   Clients),
    ok.

client_monitoring(Config) ->
    % Test client monitoring and automatic cleanup

    % Create a temporary client that will be monitored
    ClientId = <<"monitor_test_client">>,
    ClientInfo = #{client_id => ClientId,
                   session_id => <<"monitor_session">>,
                   transport_id => <<"monitor_transport">>,
                   auth_token => <<"monitor_auth">>,
                   metadata => #{monitor_test => true}},

    % Register client
    ?assertEqual(ok, erlmcp_client_registry:register_client(ClientId, ClientInfo)),

    % Verify client is registered
    ?assertEqual({ok, ClientInfo},
                 erlmcp_client_registry:resolve_client(ClientId)),

    % Test health check
    HealthStatus = erlmcp_client_registry:health_check(),
    ?assert(is_map(HealthStatus), "Health status should be a map"),
    ?assert(maps:is_key(healthy_clients, HealthStatus),
             "Healthy clients count missing"),
    ?assert(maps:is_key(total_clients, HealthStatus),
             "Total clients count missing"),
    ?assert(maps:get(healthy_clients, HealthStatus) >= 1,
             "Should have at least 1 healthy client"),

    % Test that registry monitors clients
    % This is tested by ensuring the registry is still running and healthy
    RegistryPid = whereis(erlmcp_client_registry),
    ?assert(is_pid(RegistryPid), "Registry should be running"),
    ?assert(is_process_alive(RegistryPid), "Registry process should be alive"),

    % Clean up manually (monitoring tests are more about the registry's ability to monitor)
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId)),

    % Verify health check after cleanup
    UpdatedHealthStatus = erlmcp_client_registry:health_check(),
    ?assert(maps:get(healthy_clients, UpdatedHealthStatus) >= 0,
             "Healthy clients count should not be negative"),
    ok.

%%====================================================================
%% Test Cases - Monitoring Tests
%%====================================================================

metrics_and_stats(Config) ->
    % Test metrics and statistics functionality

    % Register some test clients
    Client1Id = <<"metrics_client_1">>,
    Client1Info = #{client_id => Client1Id,
                    session_id => <<"session_1">>,
                    transport_id => <<"transport_1">>,
                    auth_token => <<"auth_1">>,
                    metadata => #{category => "test"}},

    Client2Id = <<"metrics_client_2">>,
    Client2Info = #{client_id => Client2Id,
                    session_id => <<"session_2">>,
                    transport_id => <<"transport_2">>,
                    auth_token => <<"auth_2">>,
                    metadata = #{category => "test"}},

    % Register clients
    ?assertEqual(ok, erlmcp_client_registry:register_client(Client1Id, Client1Info)),
    ?assertEqual(ok, erlmcp_client_registry:register_client(Client2Id, Client2Info)),

    % Get statistics
    Stats = erlmcp_client_registry:get_stats(),
    ?assert(is_map(Stats), "Stats should be a map"),

    % Verify expected stats fields
    ExpectedFields = [total_clients, healthy_clients,
                      registered_transports, total_sessions,
                      uptime, last_activity],
    lists:foreach(fun(Field) ->
                     ?assert(maps:is_key(Field, Stats),
                             "Missing stat field: ~p", [Field])
                   end,
                   ExpectedFields),

    % Verify stat values
    ?assert(maps:get(total_clients, Stats) >= 2, "Should have at least 2 clients"),
    ?assert(maps:get(healthy_clients, Stats) >= 2, "Should have at least 2 healthy clients"),
    ?assert(is_integer(maps:get(uptime, Stats)), "Uptime should be an integer"),
    ?assert(is_integer(maps:get(last_activity, Stats)), "Last activity should be an integer"),

    % Test category-based metrics (if supported)
    % This depends on the implementation's capabilities
    case maps:is_key(categories, Stats) of
        true ->
            Categories = maps:get(categories, Stats),
            ?assert(is_map(Categories), "Categories should be a map"),
            ?assert(maps:is_key("test", Categories), "Test category should exist");
        false ->
            ct:pal("Category metrics not available in this implementation")
    end,

    % Clean up
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(Client1Id)),
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(Client2Id)),

    % Verify stats after cleanup
    UpdatedStats = erlmcp_client_registry:get_stats(),
    ?assert(maps:get(total_clients, UpdatedStats) >= 0, "Clients count should not be negative"),
    ok.

%%====================================================================
%% Test Cases - Performance Tests
%%====================================================================

performance_benchmarks(Config) ->
    % Test performance characteristics of client registry operations

    NumClients = 1000,
    TestClientIdBase = <<"perf_client_">>,

    % Benchmark client registration
    StartRegistration = erlang:monotonic_time(millisecond),

    RegistrationResults = lists:map(fun(I) ->
                                        ClientId = <<TestClientIdBase/binary, (integer_to_binary(I))/binary>>,
                                        ClientInfo = #{client_id => ClientId,
                                                     session_id => <<"session_", (integer_to_binary(I))/binary>>,
                                                     transport_id => <<"transport_", (integer_to_binary(I))/binary>>,
                                                     auth_token => <<"auth_", (integer_to_binary(I))/binary>>,
                                                     metadata => #{index => I, performance_test => true}},

                                        case erlmcp_client_registry:register_client(ClientId, ClientInfo) of
                                            ok ->
                                                {ok, ClientId};
                                            {error, Reason} ->
                                                {error, ClientId, Reason}
                                        end
                                    end,
                                    lists:seq(1, NumClients)),

    EndRegistration = erlang:monotonic_time(millisecond),
    RegistrationDuration = EndRegistration - StartRegistration,

    SuccessfulRegistrations = lists:filter(fun({ok, _}) -> true; (_) -> false end,
                                           RegistrationResults),
    FailedRegistrations = lists:filter(fun({error, _, _}) -> true; (_) -> false end,
                                        RegistrationResults),

    ct:pal("Registration performance: ~p clients in ~p ms",
           [NumClients, RegistrationDuration]),
    ct:pal("Successful registrations: ~p", [length(SuccessfulRegistrations)]),
    ct:pal("Failed registrations: ~p", [length(FailedRegistrations)]),
    ct:pal("Average registration time: ~.2f ms",
           [RegistrationDuration / NumClients]),

    % Performance assertions
    ?assert(RegistrationDuration < 5000, "Registration too slow: ~p ms", [RegistrationDuration]),
    ?assert((RegistrationDuration / NumClients) < 5, "Per-registration time too high: ~p ms",
            [RegistrationDuration / NumClients]),
    ?assert(length(SuccessfulRegistrations) =:= NumClients,
            "All registrations should succeed"),

    % Benchmark client lookup
    StartLookup = erlang:monotonic_time(millisecond),

    LookupResults = lists:map(fun(I) ->
                                   ClientId = <<TestClientIdBase/binary, (integer_to_binary(I))/binary>>,
                                   case erlmcp_client_registry:resolve_client(ClientId) of
                                       {ok, _} ->
                                           {ok, ClientId};
                                       {error, not_found} ->
                                           {error, ClientId, not_found};
                                       {error, Reason} ->
                                           {error, ClientId, Reason}
                                   end
                               end,
                               lists:seq(1, NumClients)),

    EndLookup = erlang:monotonic_time(millisecond),
    LookupDuration = EndLookup - StartLookup,

    SuccessfulLookups = lists:filter(fun({ok, _}) -> true; (_) -> false end, LookupResults),
    FailedLookups = lists:filter(fun({error, _, _}) -> true; (_) -> false end, LookupResults),

    ct:pal("Lookup performance: ~p clients in ~p ms", [NumClients, LookupDuration]),
    ct:pal("Successful lookups: ~p", [length(SuccessfulLookups)]),
    ct:pal("Failed lookups: ~p", [length(FailedLookups)]),
    ct:pal("Average lookup time: ~.2f ms", [LookupDuration / NumClients]),

    % Performance assertions
    ?assert(LookupDuration < 2000, "Lookup too slow: ~p ms", [LookupDuration]),
    ?assert((LookupDuration / NumClients) < 2, "Per-lookup time too high: ~p ms",
            [LookupDuration / NumClients]),
    ?assert(length(SuccessfulLookups) =:= NumClients,
            "All lookups should succeed"),

    % Benchmark client listing
    StartList = erlang:monotonic_time(millisecond),

    ListedClients = erlmcp_client_registry:list_clients(),
    ListCount = length(ListedClients),

    EndList = erlang:monotonic_time(millisecond),
    ListDuration = EndList - StartList,

    ct:pal("List performance: ~p clients listed in ~p ms", [ListCount, ListDuration]),
    ct:pal("Average time per client in list: ~.2f ms",
           [ListDuration / max(ListCount, 1)]),

    % Performance assertions
    ?assert(ListDuration < 1000, "List too slow: ~p ms", [ListDuration]),
    ?assert(ListCount >= NumClients, "Should have at least the registered clients"),

    % Benchmark client unregistration
    StartUnregistration = erlang:monotonic_time(millisecond),

    UnregistrationResults = lists:map(fun(I) ->
                                            ClientId = <<TestClientIdBase/binary, (integer_to_binary(I))/binary>>,
                                            case erlmcp_client_registry:unregister_client(ClientId) of
                                                ok ->
                                                    {ok, ClientId};
                                                {error, Reason} ->
                                                    {error, ClientId, Reason}
                                            end
                                        end,
                                        lists:seq(1, NumClients)),

    EndUnregistration = erlang:monotonic_time(millisecond),
    UnregistrationDuration = EndUnregistration - StartUnregistration,

    SuccessfulUnregistrations = lists:filter(fun({ok, _}) -> true; (_) -> false end,
                                            UnregistrationResults),
    FailedUnregistrations = lists:filter(fun({error, _, _}) -> true; (_) -> false end,
                                          UnregistrationResults),

    ct:pal("Unregistration performance: ~p clients in ~p ms",
           [NumClients, UnregistrationDuration]),
    ct:pal("Successful unregistrations: ~p", [length(SuccessfulUnregistrations)]),
    ct:pal("Failed unregistrations: ~p", [length(FailedUnregistrations)]),
    ct:pal("Average unregistration time: ~.2f ms",
           [UnregistrationDuration / NumClients]),

    % Performance assertions
    ?assert(UnregistrationDuration < 3000, "Unregistration too slow: ~p ms",
            [UnregistrationDuration]),
    ?assert((UnregistrationDuration / NumClients) < 3, "Per-unregistration time too high: ~p ms",
            [UnregistrationDuration / NumClients]),
    ?assert(length(SuccessfulUnregistrations) =:= NumClients,
            "All unregistrations should succeed"),

    ct:pal("Performance benchmark completed successfully"),
    ok.

%%====================================================================
%% Test Cases - Concurrent Tests
%%====================================================================

concurrent_operations(Config) ->
    % Test concurrent client registry operations

    NumProcesses = 20,
    NumOperationsPerProcess = 50,
    ClientPrefix = <<"concurrent_client_">>,

    % Start time measurement
    Start = erlang:monotonic_time(millisecond),

    % Create concurrent processes for registration
    RegistrationPids = lists:map(fun(ProcessId) ->
                                    spawn_link(fun() ->
                                                    ProcessClients = lists:map(fun(OpId) ->
                                                                                   ClientId = <<ClientPrefix/binary,
                                                                                                (integer_to_binary(ProcessId))/binary, "_",
                                                                                                (integer_to_binary(OpId))/binary>>,
                                                                                   ClientInfo = #{client_id => ClientId,
                                                                                                session_id => <<"session_", (integer_to_binary(OpId))/binary>>,
                                                                                                transport_id => <<"transport_", (integer_to_binary(OpId))/binary>>,
                                                                                                auth_token => <<"auth_", (integer_to_binary(OpId))/binary>>,
                                                                                                metadata => #{process_id => ProcessId,
                                                                                                             operation_id => OpId,
                                                                                                             concurrent_test => true}},

                                                                                   case erlmcp_client_registry:register_client(ClientId, ClientInfo) of
                                                                                       ok ->
                                                                                           {ok, ClientId};
                                                                                       {error, Reason} ->
                                                                                           {error, ClientId, Reason}
                                                                                   end
                                                                           end,
                                                                           lists:seq(1, NumOperationsPerProcess));

                                                    ct:pal("Process ~p completed ~p operations", [ProcessId, NumOperationsPerProcess])
                                                end)
                                end,
                                lists:seq(1, NumProcesses)),

    % Wait for all registration processes to complete
    lists:foreach(fun(Pid) ->
                     receive
                         {'EXIT', Pid, _} -> ok
                     end
                   end,
                   RegistrationPids),

    RegistrationEnd = erlang:monotonic_time(millisecond),
    RegistrationDuration = RegistrationEnd - Start,

    % Verify all clients were registered
    ListedClients = erlmcp_client_registry:list_clients(),
    ExpectedTotalClients = NumProcesses * NumOperationsPerProcess,
    ct:pal("Concurrent registration: ~p processes x ~p operations = ~p total",
           [NumProcesses, NumOperationsPerProcess, ExpectedTotalClients]),
    ct:pal("Registration time: ~p ms", [RegistrationDuration]),
    ct:pal("Average time per registration: ~.2f ms",
           [RegistrationDuration / ExpectedTotalClients]),
    ct:pal("Registered clients: ~p", [length(ListedClients)]),
    ct:pal("Expected clients: ~p", [ExpectedTotalClients]),

    % Concurrent lookup test
    LookupStart = erlang:monotonic_time(millisecond),

    LookupPids = lists:map(fun(ProcessId) ->
                              spawn_link(fun() ->
                                            % Sample some clients for lookup
                                            SampleClients = lists:sublist(ListedClients, 10),
                                            lists:foreach(fun(Client) ->
                                                                ClientId = maps:get(client_id, Client),
                                                                case erlmcp_client_registry:resolve_client(ClientId) of
                                                                    {ok, _} ->
                                                                        ok;
                                                                    {error, Reason} ->
                                                                        ct:pal("Lookup error for ~p: ~p", [ClientId, Reason])
                                                                end
                                                            end,
                                                            SampleClients)
                                        end)
                            end,
                            lists:seq(1, NumProcesses)),

    % Wait for all lookup processes to complete
    lists:foreach(fun(Pid) ->
                     receive
                         {'EXIT', Pid, _} -> ok
                     end
                   end,
                   LookupPids),

    LookupEnd = erlang:monotonic_time(millisecond),
    LookupDuration = LookupEnd - LookupStart,

    ct:pal("Concurrent lookup time: ~p ms", [LookupDuration]),
    ct:pal("Average time per lookup: ~.2f ms", [LookupDuration / (NumProcesses * 10)]),

    % Concurrent unregistration test
    UnregistrationStart = erlang:monotonic_time(millisecond),

    UnregistrationPids = lists:map(fun(ProcessId) ->
                                        spawn_link(fun() ->
                                                      % Unregister clients created by this process
                                                      OpClients = lists:map(fun(OpId) ->
                                                                                  ClientId = <<ClientPrefix/binary,
                                                                                               (integer_to_binary(ProcessId))/binary, "_",
                                                                                               (integer_to_binary(OpId))/binary>>,
                                                                                  case erlmcp_client_registry:unregister_client(ClientId) of
                                                                                      ok ->
                                                                                          {ok, ClientId};
                                                                                      {error, Reason} ->
                                                                                          {error, ClientId, Reason}
                                                                                  end
                                                                              end,
                                                                              lists:seq(1, NumOperationsPerProcess));

                                                      ct:pal("Process ~p completed unregistration", [ProcessId])
                                                  end)
                                    end,
                                    lists:seq(1, NumProcesses)),

    % Wait for all unregistration processes to complete
    lists:foreach(fun(Pid) ->
                     receive
                         {'EXIT', Pid, _} -> ok
                     end
                   end,
                   UnregistrationPids),

    UnregistrationEnd = erlang:monotonic_time(millisecond),
    UnregistrationDuration = UnregistrationEnd - UnregistrationStart,

    % Final verification
    FinalClientList = erlmcp_client_registry:list_clients(),
    ct:pal("Concurrent unregistration time: ~p ms", [UnregistrationDuration]),
    ct:pal("Final client count: ~p", [length(FinalClientList)]),

    % Performance assertions for concurrent operations
    ?assert(RegistrationDuration < 10000, "Concurrent registration too slow"),
    ?assert(LookupDuration < 5000, "Concurrent lookup too slow"),
    ?assert(UnregistrationDuration < 10000, "Concurrent unregistration too slow"),
    ?assert(length(FinalClientList) =:= 0, "All clients should be unregistered"),
    ok.

%%====================================================================
%% Test Cases - Error Handling
%%====================================================================

error_handling(Config) ->
    % Test error handling scenarios

    % Test registering with invalid client ID
    InvalidClientIdCases = [
        <<>>, % Empty binary
        123, % Not a binary
        [], % Empty list
        #{}, % Empty map
        not_a_binary % Invalid type
    ],

    lists:foreach(fun(InvalidClientId) ->
                     ?assertMatch({error, _},
                                  erlmcp_client_registry:register_client(InvalidClientId, #{}))
                  end,
                  InvalidClientIdCases),

    % Test registering with invalid client info
    ?assertMatch({error, _},
                 erlmcp_client_registry:register_client(<<"valid_id">>, invalid_info)),

    % Test registering duplicate client
    ClientId = <<"duplicate_test">>,
    ClientInfo = #{client_id => ClientId,
                   session_id => <<"session_001">>,
                   transport_id => <<"transport_001">>,
                   auth_token => <<"auth_001">>},

    % First registration should succeed
    ?assertEqual(ok, erlmcp_client_registry:register_client(ClientId, ClientInfo)),

    % Second registration should fail
    ?assertMatch({error, already_exists},
                 erlmcp_client_registry:register_client(ClientId, ClientInfo)),

    % Test unregistering non-existent client
    ?assertEqual({error, not_found},
                 erlmcp_client_registry:unregister_client(<<"non_existent">>)),

    % Test resolving non-existent client
    ?assertEqual({error, not_found},
                 erlmcp_client_registry:resolve_client(<<"non_existent">>)),

    % Test unregistration with invalid client ID
    lists:foreach(fun(InvalidClientId) ->
                     ?assertMatch({error, _},
                                  erlmcp_client_registry:unregister_client(InvalidClientId))
                  end,
                  InvalidClientIdCases),

    % Clean up
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId)),
    ok.

%%====================================================================
%% Test Cases - Integration Tests
%%====================================================================

integration_tests(Config) ->
    % Test integration with other erlmcp components

    % Test integration with transport registry
    TransportId = <<"integration_transport">>,
    TransportInfo = #{transport_type => stdio,
                      owner => self(),
                      test_mode => true},

    % Create a transport
    case erlmcp_transport:start_link(TransportInfo) of
        {ok, TransportPid} ->
            % Register a client with transport integration
            ClientId = <<"integration_client">>,
            ClientInfo = #{client_id => ClientId,
                         session_id => <<"integration_session">>,
                         transport_id => TransportId,
                         auth_token => <<"integration_auth">>,
                         metadata => #{integration_test => true,
                                      created => erlang:system_time(millisecond)}},

            ?assertEqual(ok, erlmcp_client_registry:register_client(ClientId, ClientInfo)),

            % Verify client is accessible through transport registry
            case erlmcp_transport_registry:resolve_transport(TransportId) of
                {ok, _} ->
                    ct:pal("Transport integration successful");
                {error, Reason} ->
                    ct:pal("Transport integration issue: ~p", [Reason])
            end,

            % Test transport health affects client health
            ClientHealth = erlmcp_client_registry:health_check(),
            ?assert(is_map(ClientHealth), "Client health should be a map"),

            % Clean up
            ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId)),
            erlmcp_transport:stop(TransportPid);
        {error, Reason} ->
            ct:pal("Transport not available for integration test: ~p", [Reason])
    end,

    % Test integration with session management
    SessionId = <<"integration_session">>,
    ClientWithSession = #{client_id => <<"session_client">>,
                         session_id => SessionId,
                         transport_id => <<"session_transport">>,
                         auth_token => <<"session_auth">>,
                         metadata = #{session_test => true}},

    ?assertEqual(ok, erlmcp_client_registry:register_client(<<"session_client">>, ClientWithSession)),

    % Verify session information is stored
    ResolvedClient = erlmcp_client_registry:resolve_client(<<"session_client">>),
    case ResolvedClient of
        {ok, ClientData} ->
            ?assertEqual(SessionId, maps:get(session_id, ClientData),
                         "Session ID should be preserved");
        {error, Reason} ->
            ct:fail("Failed to resolve session client: ~p", [Reason])
    end,

    % Clean up
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(<<"session_client">>)),
    ok.

authentication_integration(Config) ->
    % Test integration with authentication system

    % Test client authentication
    ClientId = <<"auth_test_client">>,
    AuthToken = <<"auth_token_xyz123">>,
    ClientInfo = #{client_id => ClientId,
                 session_id => <<"auth_session">>,
                 transport_id => <<"auth_transport">>,
                 auth_token => AuthToken,
                 metadata = #{auth_test => true,
                             permissions => [<<"tools">>, <<"resources">>]}},

    ?assertEqual(ok, erlmcp_client_registry:register_client(ClientId, ClientInfo)),

    % Test authentication lookup
    Authenticated = erlmcp_client_registry:authenticate_client(AuthToken),
    case Authenticated of
        {ok, AuthClientId} ->
            ?assertEqual(ClientId, AuthClientId, "Authenticated client ID mismatch");
        {error, Reason} ->
            ct:fail("Authentication failed: ~p", [Reason])
    end,

    % Test invalid authentication
    InvalidAuth = erlmcp_client_registry:authenticate_client(<<"invalid_token">>),
    ?assertEqual({error, invalid_token}, InvalidAuth),

    % Test permission checking
    Permissions = erlmcp_client_registry:get_client_permissions(ClientId),
    case Permissions of
        {ok, Perms} ->
            ?assert(lists:member(<<"tools">>, Perms), "Should have tools permission"),
            ?assert(lists:member(<<"resources">>, Perms), "Should have resources permission");
        {error, Reason} ->
            ct:fail("Failed to get permissions: ~p", [Reason])
    end,

    % Clean up
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(ClientId)),
    ok.

session_management(Config) ->
    % Test session management functionality

    % Register multiple clients with the same session
    SessionId = <<"shared_session">>,
    Client1Id = <<"session_client_1">>,
    Client2Id = <<"session_client_2">>,

    Client1Info = #{client_id => Client1Id,
                    session_id => SessionId,
                    transport_id => <<"transport_1">>,
                    auth_token => <<"auth_1">>,
                    metadata = #{session_test => true, priority => 1}},

    Client2Info = #{client_id => Client2Id,
                    session_id => SessionId,
                    transport_id => <<"transport_2">>,
                    auth_token => <<"auth_2">>,
                    metadata = #{session_test => true, priority => 2}},

    ?assertEqual(ok, erlmcp_client_registry:register_client(Client1Id, Client1Info)),
    ?assertEqual(ok, erlmcp_client_registry:register_client(Client2Id, Client2Info)),

    % Test session listing
    SessionClients = erlmcp_client_registry:get_session_clients(SessionId),
    ?assert(is_list(SessionClients), "Session clients should be a list"),
    ?assert(length(SessionClients) >= 2, "Should have at least 2 clients in session"),
    ?assert(lists:any(fun(C) -> maps:get(client_id, C) =:= Client1Id end, SessionClients),
             "Client 1 should be in session"),
    ?assert(lists:any(fun(C) -> maps:get(client_id, C) =:= Client2Id end, SessionClients),
             "Client 2 should be in session"),

    % Test session cleanup
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(Client1Id)),
    ?assertEqual(ok, erlmcp_client_registry:unregister_client(Client2Id)),

    % Test session is now empty
    EmptySessionClients = erlmcp_client_registry:get_session_clients(SessionId),
    ?assertEqual(0, length(EmptySessionClients), "Session should be empty after cleanup"),
    ok.

%%====================================================================
%% Internal Functions
%%====================================================================

cleanup_registry_state() ->
    % Clean up any registered clients
    case erlmcp_client_registry:list_clients() of
        Clients when is_list(Clients) ->
            lists:foreach(fun(Client) ->
                             ClientId = maps:get(client_id, Client),
                             case erlmcp_client_registry:unregister_client(ClientId) of
                                 ok ->
                                     ct:pal("Cleaned up client: ~p", [ClientId]);
                                 {error, Reason} ->
                                     ct:pal("Failed to clean up client ~p: ~p", [ClientId, Reason])
                             end
                           end,
                           Clients);
        _ ->
            ok
    end,
    ok.