%%%-------------------------------------------------------------------
%%% @doc Tests for erlmcp_request_manager module
%%%
%%% Chicago TDD Test Suite for sophisticated request management system
%%% Tests: request tracking, priority handling, timeout, cancellation,
%%% concurrent processing, caching, error handling, monitoring
%%%
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_request_manager_tests).

-include_lib("eunit/include/eunit.hrl").
-include_lib("eunit/include/eunit.hrl").
-include("erlmcp.hrl").

%%====================================================================
%% Test Macros and Helper Functions
%%====================================================================

%% Test configuration
-define(TEST_TIMEOUT, 5000).
-define(MAX_CONCURRENT_REQUESTS, 10).
-define(DEFAULT_TIMEOUT_MS, 30000).
-define(DEFAULT_PRIORITY, 5).

%% Mock data
-define(TEST_REQUEST_ID, 12345).
-define(TEST_CLIENT_PID, self()).

%%====================================================================
%% Test Suites
%%====================================================================

request_manager_test_() ->
    {setup,
     fun setup/0,
     fun cleanup/1,
     [
        %% Basic functionality tests
        {"request registration and tracking", fun test_request_registration/0},
        {"request ID correlation", fun test_request_id_correlation/0},
        {"priority handling", fun test_priority_handling/0},
        {"timeout handling", fun test_timeout_handling/0},

        %% Concurrent processing tests
        {"concurrent request processing", fun test_concurrent_processing/0},
        {"request cancellation", fun test_request_cancellation/0},
        {"priority-based ordering", fun test_priority_ordering/0},

        %% Caching and deduplication tests
        {"result caching", fun test_result_caching/0},
        {"request deduplication", fun test_request_deduplication/0},

        %% Error handling tests
        {"error handling and recovery", fun test_error_handling/0},
        {"timeout recovery", fun test_timeout_recovery/0},
        {"cancellation recovery", fun test_cancellation_recovery/0},

        %% Monitoring and metrics tests
        {"metrics collection", fun test_metrics_collection/0},
        {"request tracking monitoring", fun test_request_tracking_monitoring/0},

        %% Integration tests
        {"end-to-end request flow", fun test_end_to_end_flow/0},
        {"stress testing", fun test_stress_conditions/0}
     ]}.

%%====================================================================
%% Setup and Cleanup Functions
%%====================================================================

setup() ->
    %% Ensure request manager is started
    case erlmcp_request_manager:start_link() of
        {ok, _Pid} -> ok;
        {error, {already_started, _Pid}} -> ok;
        Error -> exit(Error)
    end,

    %% Clear any existing requests
    erlmcp_request_manager:clear_all_requests(),

    %% Mock some test data
    mock_test_data(),

    ok.

cleanup(_) ->
    %% Clear all requests
    erlmcp_request_manager:clear_all_requests(),

    %% Stop the request manager
    erlmcp_request_manager:stop(),

    ok.

%%====================================================================
%% Test Functions - Basic Functionality
%%====================================================================

test_request_registration() ->
    %% Test successful request registration
    RequestData = #{method => <<"test">>, params => #{}, priority => ?DEFAULT_PRIORITY},
    Result = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, ?TEST_CLIENT_PID, ?DEFAULT_TIMEOUT_MS),

    ?assertEqual(ok, Result),

    %% Verify request is tracked
    TrackedRequest = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertMatch({ok, _}, TrackedRequest),

    %% Verify request details
    {ok, RequestInfo} = TrackedRequest,
    ?assertEqual(?TEST_REQUEST_ID, RequestInfo#request_info.id),
    ?assertEqual(?TEST_CLIENT_PID, RequestInfo#request_info.client_pid),
    ?assertEqual(?DEFAULT_TIMEOUT_MS, RequestInfo#request_info.timeout_ms),
    ?assertEqual(pending, RequestInfo#request_info.status).

test_request_id_correlation() ->
    %% Test multiple request IDs
    RequestData1 = #{method => <<"test1">>, params => #{key => value1}},
    RequestData2 = #{method => <<"test2">>, params => #{key => value2}},

    %% Register multiple requests
    ok = erlmcp_request_manager:register_request(1, RequestData1, self(), ?DEFAULT_TIMEOUT_MS),
    ok = erlmcp_request_manager:register_request(2, RequestData2, self(), ?DEFAULT_TIMEOUT_MS),

    %% Verify individual requests
    {ok, Request1} = erlmcp_request_manager:get_request(1),
    {ok, Request2} = erlmcp_request_manager:get_request(2),

    ?assertEqual(1, Request1#request_info.id),
    ?assertEqual(2, Request2#request_info.id),
    ?assertNotEqual(Request1#request_info.timestamp, Request2#request_info.timestamp),

    %% Test non-existent request
    {error, not_found} = erlmcp_request_manager:get_request(999).

test_priority_handling() ->
    %% Test different priority levels
    HighPriorityRequest = #{method => <<"high">>, params => #{}, priority => 1},
    LowPriorityRequest = #{method => <<"low">>, params => #{}, priority => 10},

    %% Register requests with different priorities
    ok = erlmcp_request_manager:register_request(1, HighPriorityRequest, self(), ?DEFAULT_TIMEOUT_MS),
    ok = erlmcp_request_manager:register_request(2, LowPriorityRequest, self(), ?DEFAULT_TIMEOUT_MS),

    %% Get requests and verify priorities
    {ok, HighRequest} = erlmcp_request_manager:get_request(1),
    {ok, LowRequest} = erlmcp_request_manager:get_request(2),

    ?assertEqual(1, HighRequest#request_info.priority),
    ?assertEqual(10, LowRequest#request_info.priority).

test_timeout_handling() ->
    %% Test timeout behavior
    ShortTimeout = 100, %% 100ms timeout
    RequestData = #{method => <<"timeout_test">>, params => #{}, priority => ?DEFAULT_PRIORITY},

    %% Register request with short timeout
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ShortTimeout),

    %% Wait for timeout to occur
    timer:sleep(ShortTimeout + 50),

    %% Check if request was marked as timeout
    {ok, RequestInfo} = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertEqual(timeout, RequestInfo#request_info.status).

%%====================================================================
%% Test Functions - Concurrent Processing
%%====================================================================

test_concurrent_processing() ->
    %% Test multiple concurrent requests
    NumRequests = 5,

    %% Register multiple requests concurrently
    Requests = lists:seq(1, NumRequests),
    lists:foreach(fun(Id) ->
        RequestData = #{method => <<"concurrent_test">>, params => #{id => Id}, priority => ?DEFAULT_PRIORITY},
        ok = erlmcp_request_manager:register_request(Id, RequestData, self(), ?DEFAULT_TIMEOUT_MS)
    end, Requests),

    %% Verify all requests are registered
    lists:foreach(fun(Id) ->
        {ok, RequestInfo} = erlmcp_request_manager:get_request(Id),
        ?assertEqual(pending, RequestInfo#request_info.status)
    end, Requests),

    %% Process requests
    lists:foreach(fun(Id) ->
        erlmcp_request_manager:update_request_status(Id, processing)
    end, Requests),

    %% Verify status update
    lists:foreach(fun(Id) ->
        {ok, RequestInfo} = erlmcp_request_manager:get_request(Id),
        ?assertEqual(processing, RequestInfo#request_info.status)
    end, Requests).

test_request_cancellation() ->
    %% Test request cancellation
    RequestData = #{method => <<"cancel_test">>, params => #{}, priority => ?DEFAULT_PRIORITY},

    %% Register request
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ?DEFAULT_TIMEOUT_MS),

    %% Cancel request
    Result = erlmcp_request_manager:cancel_request(?TEST_REQUEST_ID),
    ?assertEqual(ok, Result),

    %% Verify cancellation
    {ok, RequestInfo} = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertEqual(cancelled, RequestInfo#request_info.status).

test_priority_ordering() ->
    %% Test that requests are ordered by priority
    Requests = [
        {5, #{method => <<"low">>, params => #{}}},
        {1, #{method => <<"high">>, params => #{}}},
        {3, #{method => <<"medium">>, params => #{}}}
    ],

    %% Register requests
    lists:foreach(fun({Priority, Data}) ->
        Id = Priority, %% Use priority as ID for simplicity
        ok = erlmcp_request_manager:register_request(Id, Data#{priority => Priority}, self(), ?DEFAULT_TIMEOUT_MS)
    end, Requests),

    %% Get priority queue
    PriorityQueue = erlmcp_request_manager:get_priority_queue(),
    ?assertMatch([1, 3, 5], PriorityQueue), %% Should be ordered by priority (1=highest)

%%====================================================================
%% Test Functions - Caching and Deduplication
%%====================================================================

test_result_caching() ->
    %% Test result caching functionality
    RequestData = #{method => <<"cache_test">>, params => #{test => true}},
    Result = #{success => true, data => [1, 2, 3]},

    %% Register and complete request
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ?DEFAULT_TIMEOUT_MS),
    ok = erlmcp_request_manager:complete_request(?TEST_RESULT_ID, Result),

    %% Verify result is cached
    CachedResult = erlmcp_request_manager:get_cached_result(?TEST_REQUEST_ID),
    ?assertMatch({ok, _}, CachedResult),

    %% Test cache expiration (if implemented)
    %% timer:sleep(CacheTTL + 100),
    %% {error, not_found} = erlmcp_request_manager:get_cached_result(?TEST_REQUEST_ID).

test_request_deduplication() ->
    %% Test request deduplication
    RequestData = #{method => <<"dedup_test">>, params => #{test => true}},

    %% Register duplicate request
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ?DEFAULT_TIMEOUT_MS),

    %% Try to register same request again
    Result = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ?DEFAULT_TIMEOUT_MS),

    %% Should return duplicate error
    ?assertMatch({error, duplicate_request}, Result).

%%====================================================================
%% Test Functions - Error Handling
%%====================================================================

test_error_handling() ->
    %% Test various error conditions
    RequestData = #{method => <<"error_test">>, params => #{}, priority => ?DEFAULT_PRIORITY},

    %% Test with invalid request ID
    {error, invalid_request_id} = erlmcp_request_manager:register_request(-1, RequestData, self(), ?DEFAULT_TIMEOUT_MS),

    %% Test with invalid timeout
    {error, invalid_timeout} = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), -1000),

    %% Test cancellation of non-existent request
    {error, not_found} = erlmcp_request_manager:cancel_request(999).

test_timeout_recovery() ->
    %% Test timeout recovery mechanism
    RequestData = #{method => <<"recovery_test">>, params => {}, priority => ?DEFAULT_PRIORITY},

    %% Register request with very short timeout
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), 50),

    %% Wait for timeout
    timer:sleep(100),

    %% Try to recover/complete the request
    {error, timeout} = erlmcp_request_manager:complete_request(?TEST_REQUEST_ID, success),

    %% Verify request is in timeout state
    {ok, RequestInfo} = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertEqual(timeout, RequestInfo#request_info.status).

test_cancellation_recovery() ->
    %% Test cancellation recovery
    RequestData = #{method => <<"cancel_recovery">>, params => {}, priority => ?DEFAULT_PRIORITY},

    %% Register and cancel request
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ?DEFAULT_TIMEOUT_MS),
    ok = erlmcp_request_manager:cancel_request(?TEST_REQUEST_ID),

    %% Verify cancellation
    {ok, RequestInfo} = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertEqual(cancelled, RequestInfo#request_info.status),

    %% Try to complete cancelled request
    {error, cancelled} = erlmcp_request_manager:complete_request(?TEST_REQUEST_ID, success).

%%====================================================================
%% Test Functions - Monitoring and Metrics
%%====================================================================

test_metrics_collection() ->
    %% Test metrics collection
    RequestData = #{method => <<"metrics_test">>, params => {}, priority => ?DEFAULT_PRIORITY},

    %% Register some requests
    lists:foreach(fun(Id) ->
        ok = erlmcp_request_manager:register_request(Id, RequestData, self(), ?DEFAULT_TIMEOUT_MS)
    end, lists:seq(1, 5)),

    %% Complete some requests
    lists:foreach(fun(Id) ->
        erlmcp_request_manager:complete_request(Id, success)
    end, lists:seq(1, 3)),

    %% Get metrics
    Metrics = erlmcp_request_manager:get_metrics(),
    ?assertMatch(#{total_requests := 5, completed := 3, pending := 2}, Metrics).

test_request_tracking_monitoring() ->
    %% Test request tracking monitoring
    RequestData = #{method => <<"monitor_test">>, params => {}, priority => ?DEFAULT_PRIORITY},

    %% Register requests
    ok = erlmcp_request_manager:register_request(1, RequestData, self(), ?DEFAULT_TIMEOUT_MS),
    ok = erlmcp_request_manager:register_request(2, RequestData, self(), ?DEFAULT_TIMEOUT_MS),

    %% Get active requests
    ActiveRequests = erlmcp_request_manager:get_active_requests(),
    ?assertEqual(2, length(ActiveRequests)),

    %% Update status and verify
    ok = erlmcp_request_manager:update_request_status(2, completed),
    UpdatedActive = erlmcp_request_manager:get_active_requests(),
    ?assertEqual(1, length(UpdatedActive)).

%%====================================================================
%% Test Functions - Integration and Stress Tests
%%====================================================================

test_end_to_end_flow() ->
    %% Test complete request flow: register -> process -> complete
    RequestData = #{method => <<"end_to_end">>, params => #{key => value}, priority => 5},
    ExpectedResult = #{result => success, data => [1, 2, 3]},

    %% Step 1: Register request
    ok = erlmcp_request_manager:register_request(?TEST_REQUEST_ID, RequestData, self(), ?DEFAULT_TIMEOUT_MS),

    %% Step 2: Check registration
    {ok, RequestInfo} = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertEqual(pending, RequestInfo#request_info.status),

    %% Step 3: Start processing
    ok = erlmcp_request_manager:update_request_status(?TEST_REQUEST_ID, processing),

    %% Step 4: Complete request
    ok = erlmcp_request_manager:complete_request(?TEST_REQUEST_ID, ExpectedResult),

    %% Step 5: Verify completion
    {ok, CompletedRequest} = erlmcp_request_manager:get_request(?TEST_REQUEST_ID),
    ?assertEqual(completed, CompletedRequest#request_info.status),
    ?assertEqual(ExpectedResult, erlmcp_request_manager:get_cached_result(?TEST_REQUEST_ID)).

test_stress_conditions() ->
    %% Test stress conditions with many concurrent requests
    NumRequests = ?MAX_CONCURRENT_REQUESTS,

    %% Register many requests concurrently
    Requests = lists:seq(1, NumRequests),
    lists:foreach(fun(Id) ->
        RequestData = #{method => <<"stress">>, params => #{id => Id}, priority := random:uniform(10)},
        ok = erlmcp_request_manager:register_request(Id, RequestData, self(), ?DEFAULT_TIMEOUT_MS)
    end, Requests),

    %% Verify all requests are registered
    lists:foreach(fun(Id) ->
        {ok, _} = erlmcp_request_manager:get_request(Id)
    end, Requests),

    %% Process and complete all requests
    lists:foreach(fun(Id) ->
        ok = erlmcp_request_manager:update_request_status(Id, processing),
        ok = erlmcp_request_manager:complete_request(Id, #{success => true, id => Id})
    end, Requests),

    %% Verify final state
    Metrics = erlmcp_request_manager:get_metrics(),
    ?assertEqual(NumRequests, Metrics#metrics.total_requests),
    ?assertEqual(NumRequests, Metrics#metrics.completed),
    ?assertEqual(0, Metrics#metrics.pending).

%%====================================================================
%% Helper Functions
%%====================================================================

mock_test_data() ->
    %% Helper function to mock test data if needed
    ok.

%% Generate random priority
random_priority() ->
    random:uniform(10).

%% Generate test request data
test_request_data(Method) ->
    #{method => Method, params => #{test => true}, priority => random_priority()}.