%%%====================================================================
%%% @doc Test Suite for erlmcp_apps_server
%%%
%%% Tests:
%%% - App registration and validation
%%% - App lifecycle (start, stop, crash recovery)
%%% - App status queries
%%% - Manifest validation
%%% - Error counting and tracking
%%% - Unregistration and cleanup
%%%
%%% Chicago School TDD: Real gen_server, real processes, state-based verification
%%% Target: 80%+ coverage
%%% @end
%%%====================================================================
-module(erlmcp_apps_server_tests).

-include_lib("eunit/include/eunit.hrl").
-include("erlmcp.hrl").

%%%====================================================================
%%% Test Fixtures
%%%====================================================================

apps_server_test_() ->
    {foreach,
     fun setup/0,
     fun cleanup/1,
     [fun test_register_app/1,
      fun test_register_app_invalid_manifest/1,
      fun test_register_app_duplicate/1,
      fun test_register_app_too_many/1,
      fun test_get_apps/1,
      fun test_start_app/1,
      fun test_start_app_not_found/1,
      fun test_start_app_already_running/1,
      fun test_stop_app/1,
      fun test_stop_app_not_found/1,
      fun test_stop_app_not_running/1,
      fun test_get_app_status/1,
      fun test_app_crash_recovery/1,
      fun test_unregister_app/1,
      fun test_unregister_app_still_running/1]}.

%%%====================================================================
%%% Setup and Teardown
%%%====================================================================

setup() ->
    %% Start the apps server gen_server
    {ok, Pid} = erlmcp_apps_server:start_link(),
    Pid.

cleanup(Pid) ->
    case is_process_alive(Pid) of
        true ->
            gen_server:stop(Pid),
            timer:sleep(50);
        false ->
            ok
    end.

%%%====================================================================
%%% Test Functions
%%%====================================================================

%% @doc Test successful app registration
test_register_app(_Pid) ->
    AppId = <<"test_app_1">>,
    Manifest = #{<<"name">> => <<"Test App">>,
                <<"version">> => <<"1.0.0">>},
    Permissions = [<<"read">>, <<"write">>],

    ?assertEqual(ok,
                 erlmcp_apps_server:register_app(AppId, Manifest, Permissions)),

    %% Verify app is registered
    {ok, Apps} = erlmcp_apps_server:get_apps(),
    ?assertEqual(1, length(Apps)),
    ?assertEqual(AppId, maps:get(id, hd(Appps))).

%% @doc Test registering app with invalid manifest
test_register_app_invalid_manifest(_Pid) ->
    AppId = <<"invalid_app">>,

    %% Missing required fields
    InvalidManifest1 = #{<<"name">> => <<"Invalid App">>},

    ?assertEqual({error, invalid_manifest},
                 erlmcp_apps_server:register_app(AppId,
                                                   InvalidManifest1,
                                                   [])),

    %% Invalid version format
    InvalidManifest2 = #{<<"name">> => <<"Invalid App">>,
                         <<"version">> => <<"not_semver">>},

    ?assertEqual({error, invalid_manifest},
                 erlmcp_apps_server:register_app(<<"invalid_app2">>,
                                                   InvalidManifest2,
                                                   [])).

%% @doc Test duplicate app registration
test_register_app_duplicate(_Pid) ->
    AppId = <<"duplicate_app">>,
    Manifest = #{<<"name">> => <<"Duplicate">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    ?assertEqual({error, already_registered},
                 erlmcp_apps_server:register_app(AppId, Manifest, [])).

%% @doc Test app limit enforcement
test_register_app_too_many(_Pid) ->
    %% Register apps up to limit
    Manifest = #{<<"name">> => <<"App">>,
                <<"version">> => <<"1.0.0">>},

    lists:foreach(fun(N) ->
        AppId = <<"app_", (integer_to_binary(N))/binary>>,
        ok = erlmcp_apps_server:register_app(AppId, Manifest, [])
    end, lists:seq(1, 100)),

    %% Try to register one more - should fail
    ?assertEqual({error, too_many_apps},
                 erlmcp_apps_server:register_app(<<"app_101">>,
                                                   Manifest,
                                                   [])).

%% @doc Test getting all apps
test_get_apps(_Pid) ->
    %% Initially empty
    {ok, Apps0} = erlmcp_apps_server:get_apps(),
    ?assertEqual(0, length(Apps0)),

    %% Register multiple apps
    Manifest1 = #{<<"name">> => <<"App1">>, <<"version">> => <<"1.0.0">>},
    Manifest2 = #{<<"name">> => <<"App2">>, <<"version">> => <<"2.0.0">>},

    ok = erlmcp_apps_server:register_app(<<"app1">>, Manifest1, []),
    ok = erlmcp_apps_server:register_app(<<"app2">>, Manifest2, []),

    {ok, Apps1} = erlmcp_apps_server:get_apps(),
    ?assertEqual(2, length(Apps1)).

%% @doc Test starting an app
test_start_app(_Pid) ->
    AppId = <<"startable_app">>,
    Manifest = #{<<"name">> => <<"Startable">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    %% Start the app
    {ok, AppPid} = erlmcp_apps_server:start_app(AppId, #{debug => true}),

    ?assert(is_pid(AppPid)),
    ?assert(is_process_alive(AppPid)),

    %% Verify status
    {ok, Status, _Metadata} = erlmcp_apps_server:get_app_status(AppId),
    ?assertEqual(running, Status).

%% @doc Test starting non-existent app
test_start_app_not_found(_Pid) ->
    ?assertEqual({error, not_found},
                 erlmcp_apps_server:start_app(<<"nonexistent">>, #{})).

%% @doc Test starting already running app
test_start_app_already_running(_Pid) ->
    AppId = <<"already_running">>,
    Manifest = #{<<"name">> => <<"Running">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    {ok, _Pid} = erlmcp_apps_server:start_app(AppId, #{}),

    %% Try to start again
    ?assertEqual({error, already_running},
                 erlmcp_apps_server:start_app(AppId, #{})).

%% @doc Test stopping an app
test_stop_app(_Pid) ->
    AppId = <<"stoppable_app">>,
    Manifest = #{<<"name">> => <<"Stoppable">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    {ok, _Pid} = erlmcp_apps_server:start_app(AppId, #{}),

    %% Stop the app
    ?assertEqual(ok, erlmcp_apps_server:stop_app(AppId)),

    %% Verify status
    {ok, Status, _Metadata} = erlmcp_apps_server:get_app_status(AppId),
    ?assertEqual(stopped, Status).

%% @doc Test stopping non-existent app
test_stop_app_not_found(_Pid) ->
    ?assertEqual({error, not_found},
                 erlmcp_apps_server:stop_app(<<"nonexistent">>)).

%% @doc Test stopping app that's not running
test_stop_app_not_running(_Pid) ->
    AppId = <<"not_running">>,
    Manifest = #{<<"name">> => <<"Not Running">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    ?assertEqual({error, not_running},
                 erlmcp_apps_server:stop_app(AppId)).

%% @doc Test getting app status
test_get_app_status(_Pid) ->
    AppId = <<"status_app">>,
    Manifest = #{<<"name">> => <<"Status">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    %% Get status when stopped
    {ok, Status, Metadata} = erlmcp_apps_server:get_app_status(AppId),
    ?assertEqual(stopped, Status),
    ?assert(maps:is_key(started_at, Metadata)),
    ?assert(maps:is_key(error_count, Metadata)),

    %% Start app and check status again
    {ok, _Pid} = erlmcp_apps_server:start_app(AppId, #{}),

    {ok, RunningStatus, _} = erlmcp_apps_server:get_app_status(AppId),
    ?assertEqual(running, RunningStatus).

%% @doc Test app crash recovery
test_app_crash_recovery(_Pid) ->
    AppId = <<"crash_app">>,
    Manifest = #{<<"name">> => <<"Crash">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    {ok, AppPid} = erlmcp_apps_server:start_app(AppId, #{}),

    %% Crash the app
    exit(AppPid, kill),

    %% Wait for monitor to detect crash
    timer:sleep(100),

    %% Verify status changed to crashed
    {ok, Status, Metadata} = erlmcp_apps_server:get_app_status(AppId),
    ?assertEqual(crashed, Status),
    ?assertEqual(1, maps:get(error_count, Metadata)),

    %% App should be startable again after crash
    {ok, _NewPid} = erlmcp_apps_server:start_app(AppId, #{}).

%% @doc Test unregistering an app
test_unregister_app(_Pid) ->
    AppId = <<"unregister_app">>,
    Manifest = #{<<"name">> => <<"Unregister">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    %% Unregister the app
    ?assertEqual(ok, erlmcp_apps_server:unregister_app(AppId)),

    %% Verify app is gone
    ?assertEqual({error, not_found},
                 erlmcp_apps_server:get_app_status(AppId)).

%% @doc Test unregistering a running app
test_unregister_app_still_running(_Pid) ->
    AppId = <<"running_unregister">>,
    Manifest = #{<<"name">> => <<"Running">>,
                <<"version">> => <<"1.0.0">>},

    ok = erlmcp_apps_server:register_app(AppId, Manifest, []),

    {ok, _Pid} = erlmcp_apps_server:start_app(AppId, #{}),

    %% Cannot unregister running app
    ?assertEqual({error, still_running},
                 erlmcp_apps_server:unregister_app(AppId)).

%%%====================================================================
%%% Test Helper Functions
%%%====================================================================

%% @doc Test version validation
test_version_validation_test() ->
    %% Valid versions
    ?assertEqual(ok,
                 erlmcp_apps_server:validate_version(<<"1.0.0">>)),
    ?assertEqual(ok,
                 erlmcp_apps_server:validate_version(<<"10.20.30">>)),

    %% Invalid versions
    ?assertEqual(error,
                 erlmcp_apps_server:validate_version(<<"1.0">>)),
    ?assertEqual(error,
                 erlmcp_apps_server:validate_version(<<"v1.0.0">>)),
    ?assertEqual(error,
                 erlmcp_apps_server:validate_version(<<"not_a_version">>)).
