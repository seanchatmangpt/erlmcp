%%%====================================================================
%%% @doc Test Suite for erlmcp_transport_registry
%%%
%%% Tests:
%%% - Transport registration and deregistration
%%% - Transport resolution and lookup
%%% - Type registration and retrieval
%%% - Process monitoring and automatic cleanup
%%% - ETS table operations and statistics
%%% - Health checks
%%%
%%% Chicago School TDD: Real gen_server, real processes, state-based verification
%%% Target: 80%+ coverage
%%% @end
%%%====================================================================
-module(erlmcp_transport_registry_tests).

-include_lib("eunit/include/eunit.hrl").

%%%====================================================================
%%% Test Fixtures
%%%====================================================================

transport_registry_test_() ->
    {foreach,
     fun setup/0,
     fun cleanup/1,
     [fun test_register_transport/1,
      fun test_register_duplicate_transport/1,
      fun test_unregister_transport/1,
      fun test_resolve_transport/1,
      fun test_list_transports/1,
      fun test_register_type/1,
      fun test_get_type/1,
      fun test_transport_monitor_cleanup/1,
      fun test_get_stats/1,
      fun test_health_check/1,
      fun test_concurrent_registration/1,
      fun test_dead_process_cleanup/1]}.

%%%====================================================================
%%% Setup and Teardown
%%%====================================================================

setup() ->
    %% Start the transport registry gen_server
    {ok, Pid} = erlmcp_transport_registry:start_link(),
    Pid.

cleanup(Pid) ->
    case is_process_alive(Pid) of
        true ->
            gen_server:stop(Pid),
            timer:sleep(50);
        false ->
            ok
    end.

%%%====================================================================
%%% Test Functions
%%%====================================================================

%% @doc Test successful transport registration
test_register_transport(_Pid) ->
    %% Create a real transport process
    TransportPid = spawn(fun() -> receive stop -> ok end end),

    %% Register transport
    TransportId = test_transport_1,
    Config = #{type => stdio, options => #{}, metadata => #{test => true}},

    ?assertEqual(ok,
                 erlmcp_transport_registry:register_transport(TransportId,
                                                              TransportPid,
                                                              Config)),

    %% Verify transport is registered (state-based verification)
    ?assertMatch({ok, TransportPid, Config},
                 erlmcp_transport_registry:resolve_transport(TransportId)),

    %% Cleanup
    TransportPid ! stop.

%% @doc Test duplicate transport registration returns error
test_register_duplicate_transport(_Pid) ->
    TransportPid = spawn(fun() -> receive stop -> ok end end),
    TransportId = test_transport_2,
    Config = #{type => tcp},

    %% Register first time
    ?assertEqual(ok,
                 erlmcp_transport_registry:register_transport(TransportId,
                                                              TransportPid,
                                                              Config)),

    %% Register second time - should fail
    ?assertEqual({error, already_registered},
                 erlmcp_transport_registry:register_transport(TransportId,
                                                              TransportPid,
                                                              Config)),

    %% Cleanup
    TransportPid ! stop.

%% @doc Test transport unregistration
test_unregister_transport(_Pid) ->
    TransportPid = spawn(fun() -> receive stop -> ok end end),
    TransportId = test_transport_3,
    Config = #{type => http},

    %% Register transport
    ok = erlmcp_transport_registry:register_transport(TransportId,
                                                       TransportPid,
                                                       Config),

    %% Unregister transport
    ?assertEqual(ok, erlmcp_transport_registry:unregister_transport(TransportId)),

    %% Verify transport is gone (state-based verification)
    ?assertEqual({error, not_found},
                 erlmcp_transport_registry:resolve_transport(TransportId)),

    %% Cleanup
    TransportPid ! stop.

%% @doc Test resolving a non-existent transport returns error
test_resolve_transport(_Pid) ->
    ?assertEqual({error, not_found},
                 erlmcp_transport_registry:resolve_transport(nonexistent_transport)).

%% @doc Test listing all registered transports
test_list_transports(_Pid) ->
    %% Initially empty
    ?assertEqual([], erlmcp_transport_registry:list_transports()),

    %% Register multiple transports
    Pid1 = spawn(fun() -> receive stop -> ok end end),
    Pid2 = spawn(fun() -> receive stop -> ok end end),

    Config1 = #{type => stdio},
    Config2 = #{type => tcp},

    ok = erlmcp_transport_registry:register_transport(transport_a, Pid1, Config1),
    ok = erlmcp_transport_registry:register_transport(transport_b, Pid2, Config2),

    %% List transports
    List = erlmcp_transport_registry:list_transports(),

    ?assertEqual(2, length(List)),
    ?assert(lists:keymember(transport_a, 1, List)),
    ?assert(lists:keymember(transport_b, 1, List)),

    %% Cleanup
    Pid1 ! stop,
    Pid2 ! stop.

%% @doc Test transport type registration
test_register_type(_Pid) ->
    %% Register a custom transport type
    ?assertEqual(ok,
                 erlmcp_transport_registry:register_type(custom_transport,
                                                          erlmcp_transport_custom)),

    %% Retrieve the type
    ?assertMatch({ok, erlmcp_transport_custom},
                 erlmcp_transport_registry:get_type(custom_transport)),

    %% Duplicate registration should fail
    ?assertEqual({error, already_exists},
                 erlmcp_transport_registry:register_type(custom_transport,
                                                          another_module)).

%% @doc Test getting unknown transport type
test_get_type(_Pid) ->
    ?assertEqual({error, unknown_type},
                 erlmcp_transport_registry:get_type(unknown_type)).

%% @doc Test automatic cleanup when monitored process dies
test_transport_monitor_cleanup(_Pid) ->
    TransportPid = spawn(fun() -> receive stop -> ok end end),
    TransportId = test_transport_4,
    Config = #{type => websocket},

    %% Register transport (process is monitored)
    ok = erlmcp_transport_registry:register_transport(TransportId,
                                                       TransportPid,
                                                       Config),

    %% Verify registered
    ?assertMatch({ok, TransportPid, _},
                 erlmcp_transport_registry:resolve_transport(TransportId)),

    %% Kill the transport process
    exit(TransportPid, kill),

    %% Wait for monitor DOWN message to be processed
    timer:sleep(100),

    %% Verify automatic cleanup (state-based verification)
    ?assertEqual({error, not_found},
                 erlmcp_transport_registry:resolve_transport(TransportId)).

%% @doc Test getting registry statistics
test_get_stats(_Pid) ->
    %% Initial stats
    Stats0 = erlmcp_transport_registry:get_stats(),

    ?assert(is_map(Stats0)),
    ?assert(maps:is_key(transport_count, Stats0)),
    ?assert(maps:is_key(type_count, Stats0)),
    ?assert(maps:is_key(monitor_count, Stats0)),
    ?assert(maps:is_key(memory, Stats0)),

    %% Register a transport
    TransportPid = spawn(fun() -> receive stop -> ok end end),
    Config = #{type => sse},

    ok = erlmcp_transport_registry:register_transport(test_transport_5,
                                                       TransportPid,
                                                       Config),

    %% Stats should update
    Stats1 = erlmcp_transport_registry:get_stats(),
    ?assertEqual(maps:get(transport_count, Stats0) + 1,
                 maps:get(transport_count, Stats1)),
    ?assertEqual(maps:get(monitor_count, Stats0) + 1,
                 maps:get(monitor_count, Stats1)),

    %% Cleanup
    TransportPid ! stop.

%% @doc Test health check functionality
test_health_check(_Pid) ->
    %% Initial health check
    Health0 = erlmcp_transport_registry:health_check(),

    ?assertMatch(#{status := healthy}, Health0),
    ?assert(maps:is_key(transport_count, Health0)),
    ?assert(maps:is_key(active_monitors, Health0)),

    %% Register transport
    TransportPid = spawn(fun() -> receive stop -> ok end end),
    Config = #{type => stdio},

    ok = erlmcp_transport_registry:register_transport(test_transport_6,
                                                       TransportPid,
                                                       Config),

    %% Health should still be healthy (process alive)
    Health1 = erlmcp_transport_registry:health_check(),
    ?assertEqual(healthy, maps:get(status, Health1)),

    %% Cleanup
    TransportPid ! stop.

%% @doc Test concurrent transport registration
test_concurrent_registration(_Pid) ->
    %% Spawn 10 processes registering concurrently
    Parent = self(),

    Pids = [spawn(fun() ->
        TransportPid = spawn(fun() -> receive stop -> ok end end),
        TransportId = list_to_atom("concurrent_transport_" ++ integer_to_list(N)),
        Config = #{type => tcp},

        Result = erlmcp_transport_registry:register_transport(TransportId,
                                                              TransportPid,
                                                              Config),
        Parent ! {registered, N, Result, TransportPid}
    end) || N <- lists:seq(1, 10)],

    %% Wait for all registrations
    Results = [receive
        {registered, N, Result, TPid} ->
            {N, Result, TPid}
    end || _ <- Pids],

    %% All should succeed
    ?assertEqual(10, length([R || {_, R, _} <- Results, R =:= ok])),

    %% Cleanup
    [{_, _, TPid} ! stop || {_, _, TPid} <- Results].

%% @doc Test cleanup of dead process on registration attempt
test_dead_process_cleanup(_Pid) ->
    %% Create and immediately kill a process
    DeadPid = spawn(fun() -> ok end),
    timer:sleep(10), %% Let it exit

    %% Try to register dead process - should fail
    ?assertEqual({error, process_not_alive},
                 erlmcp_transport_registry:register_transport(dead_transport,
                                                              DeadPid,
                                                              #{})).

