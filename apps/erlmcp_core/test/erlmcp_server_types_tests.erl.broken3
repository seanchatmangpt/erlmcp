%%%-------------------------------------------------------------------
%%% @doc erlmcp_server_types - Comprehensive Test Suite
%%%
%%% Chicago TDD implementation for erlmcp_server_types module.
%%% Tests cover all type definitions, validation, and functionality.
%%%
%%% Test Strategy:
%%% 1. Constructor function tests
%%% 2. Validation function tests
%%% 3. Capability negotiation tests
%%% 4. Server state management tests
%%% 5. Tool/resource/prompt registration tests
%%% 6. Error handling tests
%%% 7. Session management tests
%%%
%%% @end
%%%-------------------------------------------------------------------
-module(erlmcp_server_types_tests).

-include_lib("eunit/include/eunit.hrl").
-include("erlmcp.hrl").

%%====================================================================
%% Test Entry Points
%%====================================================================

server_types_test_() ->
    {setup,
     fun setup/0,
     fun cleanup/1,
     [
        %% Capability tests
        capability_constructors_test(),
        capability_validation_test(),
        capability_negotiation_test(),

        %% Configuration tests
        configuration_builder_test(),

        %% Server state tests
        server_state_test(),
        server_ready_test(),

        %% Tool management tests
        tool_registration_test(),
        tool_validation_test(),

        %% Resource management tests
        resource_registration_test(),
        resource_validation_test(),

        %% Prompt management tests
        prompt_registration_test(),
        prompt_validation_test(),

        %% Error handling tests
        error_handling_test(),
        result_handling_test(),

        %% Session management tests
        session_management_test(),
        session_validation_test()
     ]
    }.

%%====================================================================
%% Setup and Cleanup
%%====================================================================

setup() ->
    %% Initialize test data
    ok.

cleanup(_) ->
    %% Cleanup any test state
    ok.

%%====================================================================
%% Capability Constructor Tests
%%====================================================================

capability_constructors_test_() ->
    [
        {"default_server_capabilities creates correct structure",
            fun default_server_capabilities_test/0},
        {"default_client_capabilities creates correct structure",
            fun default_client_capabilities_test/0}
    ].

default_server_capabilities_test() ->
    Caps = erlmcp_server_types:default_server_capabilities(),

    %% Check record structure
    ?assert(is_record(Caps, mcp_server_capabilities)),

    %% Check default values
    ?assert(is_record(Caps#mcp_server_capabilities.resources, mcp_resources_capability)),
    ?assert(is_record(Caps#mcp_server_capabilities.tools, mcp_tools_capability)),
    ?assert(is_record(Caps#mcp_server_capabilities.prompts, mcp_prompts_capability)),
    ?assert(is_record(Caps#mcp_server_capabilities.logging, mcp_logging_capability)),
    ?assert(is_record(Caps#mcp_server_capabilities.sampling, mcp_sampling_capability)),
    ?assert(is_record(Caps#mcp_server_capabilities.roots, mcp_roots_capability)),

    %% Check feature flags are disabled by default
    ?assertEqual(false, Caps#mcp_server_capabilities.resources#mcp_resources_capability.subscribe),
    ?assertEqual(false, Caps#mcp_server_capabilities.tools#mcp_tools_capability.listChanged),
    ?assertEqual(false, Caps#mcp_server_capabilities.prompts#mcp_prompts_capability.listChanged),
    ?assertEqual(false, Caps#mcp_server_capabilities.roots#mcp_roots_capability.list_changed),

    ok.

default_client_capabilities_test() ->
    Caps = erlmcp_server_types:default_client_capabilities(),

    %% Check record structure
    ?assert(is_record(Caps, mcp_client_capabilities)),

    %% Check default values
    ?assert(is_record(Caps#mcp_client_capabilities.tools, mcp_tools_capability)),
    ?assertEqual(undefined, Caps#mcp_client_capabilities.roots),
    ?assertEqual(undefined, Caps#mcp_client_capabilities.sampling),
    ?assertEqual(undefined, Caps#mcp_client_capabilities.experimental),

    %% Check tools capability
    ?assertEqual(false, Caps#mcp_client_capabilities.tools#mcp_tools_capability.listChanged),

    ok.

%%====================================================================
%% Capability Validation Tests
%%====================================================================

capability_validation_test_() ->
    [
        {"validate_server_capabilities accepts valid capabilities",
            fun validate_server_capabilities_valid_test/0},
        {"validate_server_capabilities rejects invalid capabilities",
            fun validate_server_capabilities_invalid_test/0},
        {"validate_client_capabilities accepts valid capabilities",
            fun validate_client_capabilities_valid_test/0},
        {"validate_client_capabilities rejects invalid capabilities",
            fun validate_client_capabilities_invalid_test/0}
    ].

validate_server_capabilities_valid_test() ->
    %% Test with valid server capabilities
    ValidCaps = #mcp_server_capabilities{
        resources = #mcp_resources_capability{subscribe = true, listChanged = true},
        tools = #mcp_tools_capability{listChanged = true},
        prompts = #mcp_prompts_capability{listChanged = true},
        logging = #mcp_logging_capability{},
        sampling = #mcp_sampling_capability{},
        roots = #mcp_roots_capability{list_changed = true}
    },

    ?assertEqual(ok, erlmcp_server_types:validate_server_capabilities(ValidCaps)),

    ok.

validate_server_capabilities_invalid_test() ->
    %% Test with invalid tool capability structure
    InvalidCaps = #mcp_server_capabilities{
        tools = invalid_structure  %% Wrong type
    },

    %% Should return error
    ?assertMatch({error, _}, erlmcp_server_types:validate_server_capabilities(InvalidCaps)),

    ok.

validate_client_capabilities_valid_test() ->
    %% Test with valid client capabilities
    ValidCaps = #mcp_client_capabilities{
        tools = #mcp_tools_capability{listChanged = true},
        roots = undefined,
        sampling = #mcp_sampling_capability{modelPreferences = #{}}
    },

    ?assertEqual(ok, erlmcp_server_types:validate_client_capabilities(ValidCaps)),

    ok.

validate_client_capabilities_invalid_test() ->
    %% Test with invalid sampling capability
    InvalidCaps = #mcp_client_capabilities{
        sampling = invalid_structure  %% Wrong type
    },

    %% Should return error
    ?assertMatch({error, _}, erlmcp_server_types:validate_client_capabilities(InvalidCaps)),

    ok.

%%====================================================================
%% Capability Negotiation Tests
%%====================================================================

capability_negotiation_test_() ->
    [
        {"negotiate_capabilities creates correct intersection",
            fun negotiate_capabilities_test/0}
    ].

negotiate_capabilities_test() ->
    ServerCaps = #mcp_server_capabilities{
        resources = #mcp_resources_capability{subscribe = true, listChanged = true},
        tools = #mcp_tools_capability{listChanged = true},
        prompts = #mcp_prompts_capability{listChanged = true},
        logging = #mcp_logging_capability{},
        sampling = #mcp_sampling_capability{},
        roots = #mcp_roots_capability{list_changed = true}
    },

    ClientCaps = #mcp_client_capabilities{
        tools = #mcp_tools_capability{listChanged = false},
        roots = undefined,
        sampling = undefined,
        experimental = undefined
    },

    NegotiatedCaps = erlmcp_server_types:negotiate_capabilities(ServerCaps, ClientCaps),

    %% Check that negotiated capabilities respect client limitations
    ?assertEqual(false, NegotiatedCaps#mcp_server_capabilities.tools#mcp_tools_capability.listChanged),
    ?assertEqual(true, is_record(NegotiatedCaps#mcp_server_capabilities.resources, mcp_resources_capability)),
    ?assertEqual(true, is_record(NegotiatedCaps#mcp_server_capabilities.prompts, mcp_prompts_capability)),

    ok.

%%====================================================================
%% Configuration Builder Tests
%%====================================================================

configuration_builder_test_() ->
    [
        {"build_server_config creates valid configuration with defaults",
            fun build_server_config_defaults_test/0},
        {"build_server_config applies options correctly",
            fun build_server_config_options_test/0},
        {"build_server_config enables capabilities based on content",
            fun build_server_config_capabilities_test/0}
    ].

build_server_config_defaults_test() ->
    ServerInfo = #{
        name => <<"test-server">>,
        version => <<"1.0.0">>
    },

    Config = erlmcp_server_types:build_server_config(ServerInfo),

    %% Check basic structure
    ?assert(is_map(Config)),
    ?assert(maps:is_key(server_info, Config)),
    ?assert(maps:is_key(capabilities, Config)),
    ?assert(maps:is_key(options, Config)),

    %% Check default values
    ?assertEqual(300000, maps:get(session_timeout, Config)),
    ?assertEqual(100, maps:get(max_concurrent_requests, Config)),

    ok.

build_server_config_options_test() ->
    ServerInfo = #{
        name => <<"test-server">>,
        version => <<"1.0.0">>
    },

    Options = #{
        session_timeout => 60000,
        max_concurrent_requests => 50,
        enable_logging => false
    },

    Config = erlmcp_server_types:build_server_config(ServerInfo, Options),

    %% Check that options are applied
    ?assertEqual(60000, maps:get(session_timeout, Config)),
    ?assertEqual(50, maps:get(max_concurrent_requests, Config)),
    ?assertEqual(false, maps:get(enable_logging, Config)),

    ok.

build_server_config_capabilities_test() ->
    %% Test with tools that should enable capabilities
    ServerInfo = #{
        name => <<"test-server">>,
        version => <<"1.0.0">>,
        tools => [
            #mcp_tool{
                name = <<"test-tool">>,
                description = <<"Test tool">>,
                input_schema = #{type => object}
            }
        ]
    },

    Config = erlmcp_server_types:build_server_config(ServerInfo),

    %% Check that tools capability is enabled
    Caps = maps:get(capabilities, Config),
    ?assertEqual(true, Caps#mcp_server_capabilities.tools#mcp_tools_capability.listChanged),

    ok.

%%====================================================================
%% Server State Tests
%%====================================================================

server_state_test_() ->
    [
        {"new_server_state creates valid default state",
            fun new_server_state_default_test/0},
        {"new_server_state from config creates valid state",
            fun new_server_state_from_config_test/0}
    ].

new_server_state_default_test() ->
    State = erlmcp_server_types:new_server_state(),

    %% Check basic structure
    ?assert(is_map(State)),
    ?assert(maps:is_key(config, State)),
    ?assert(maps:is_key(phase, State)),
    ?assert(maps:is_key(active_sessions, State)),
    ?assert(maps:is_key(registered_tools, State)),
    ?assert(maps:is_key(registered_resources, State)),
    ?assert(maps:is_key(registered_prompts, State)),

    %% Check default values
    ?assertEqual(initial, maps:get(phase, State)),
    ?assertEqual(1, maps:get(next_session_id, State)),
    ?assertEqual(maps:new(), maps:get(active_sessions, State)),
    ?assertEqual(maps:new(), maps:get(registered_tools, State)),
    ?assertEqual(maps:new(), maps:get(registered_resources, State)),
    ?assertEqual(maps:new(), maps:get(registered_prompts, State)),

    ok.

new_server_state_from_config_test() ->
    Config = erlmcp_server_types:build_server_config(#{
        name => <<"test-server">>,
        version => <<"1.0.0">>
    }),

    State = erlmcp_server_types:new_server_state(Config),

    %% Check that config is properly set
    ?assertEqual(Config, maps:get(config, State)),

    ok.

server_ready_test_() ->
    [
        {"is_server_ready returns false for initial state",
            fun is_server_ready_initial_test/0},
        {"is_server_ready returns true for ready state",
            fun is_server_ready_true_test/0},
        {"is_server_ready returns false for other phases",
            fun is_server_ready_false_test/0}
    ].

is_server_ready_initial_test() ->
    State = erlmcp_server_types:new_server_state(),
    ?assertEqual(false, erlmcp_server_types:is_server_ready(State)),

    ok.

is_server_ready_true_test() ->
    State = erlmcp_server_types:new_server_state(),
    ReadyState = State#{phase => ready},
    ?assertEqual(true, erlmcp_server_types:is_server_ready(ReadyState)),

    ok.

is_server_ready_false_test() ->
    State = erlmcp_server_types:new_server_state(),
    BusyState = State#{phase => busy},
    ?assertEqual(false, erlmcp_server_types:is_server_ready(BusyState)),

    ok.

%%====================================================================
%% Tool Management Tests
%%====================================================================

tool_registration_test_() ->
    [
        {"build_tool_info creates correct registration info",
            fun build_tool_info_test/0}
    ].

build_tool_info_test() ->
    Tool = #mcp_tool{
        name = <<"test-tool">>,
        description = <<"Test tool description">>,
        input_schema = #{type => object, properties => #{}},
        metadata = #{},
        experimental = undefined,
        version = <<"1.0.0">>,
        deprecated = false
    },

    Handler = fun(_) -> {ok, <<"test result">>} end,

    {ToolName, ToolInfo} = erlmcp_server_types:build_tool_info({Tool, Handler}),

    %% Check tool name
    ?assertEqual(<<"test-tool">>, ToolName),

    %% Check tool info structure
    ?assert(is_map(ToolInfo)),
    ?assert(maps:is_key(tool, ToolInfo)),
    ?assert(maps:is_key(handler, ToolInfo)),
    ?assert(maps:is_key(metrics, ToolInfo)),
    ?assert(maps:is_key(registered_at, ToolInfo)),

    %% Check tool structure
    ?assertEqual(Tool, maps:get(tool, ToolInfo)),
    ?assertEqual(Handler, maps:get(handler, ToolInfo)),

    ok.

tool_validation_test_() ->
    [
        {"validate_tool_registration accepts valid tool",
            fun validate_tool_registration_valid_test/0},
        {"validate_tool_registration rejects tool with empty name",
            fun validate_tool_registration_empty_name_test/0},
        {"validate_tool_registration rejects tool with invalid handler",
            fun validate_tool_registration_invalid_handler_test/0},
        {"validate_tool_registration rejects tool with long description",
            fun validate_tool_registration_long_description_test/0}
    ].

validate_tool_registration_valid_test() ->
    Tool = #mcp_tool{
        name = <<"valid-tool">>,
        description = <<"Valid description">>,
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, <<"result">>} end,

    ?assertEqual(ok, erlmcp_server_types:validate_tool_registration({Tool, Handler})),

    ok.

validate_tool_registration_empty_name_test() ->
    Tool = #mcp_tool{
        name = <<>>,
        description = <<"Valid description">>,
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, <<"result">>} end,

    ?assertMatch({error, _}, erlmcp_server_types:validate_tool_registration({Tool, Handler})),

    ok.

validate_tool_registration_invalid_handler_test() ->
    Tool = #mcp_tool{
        name = <<"test-tool">>,
        description = <<"Valid description">>,
        input_schema = #{type => object, properties => #{}}
    },

    InvalidHandler = not_a_function,

    ?assertMatch({error, _}, erlmcp_server_types:validate_tool_registration({Tool, InvalidHandler})),

    ok.

validate_tool_registration_long_description_test() ->
    %% Create a very long description
    LongDesc = binary:copy(<<"x">>, 10001),

    Tool = #mcp_tool{
        name = <<"test-tool">>,
        description = LongDesc,
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, <<"result">>} end,

    ?assertMatch({error, _}, erlmcp_server_types:validate_tool_registration({Tool, Handler})),

    ok.

%%====================================================================
%% Resource Management Tests
%%====================================================================

resource_registration_test_() ->
    [
        {"build_resource_info creates correct registration info",
            fun build_resource_info_test/0}
    ].

build_resource_info_test() ->
    Resource = #mcp_resource{
        uri = <<"https://example.com/resource">>,
        name = <<"test-resource">>,
        description = <<"Test resource description">>,
        mime_type = <<"application/json">>,
        metadata = #{},
        audience = undefined,
        priority = undefined,
        last_modified = undefined,
        annotations = undefined,
        size = undefined
    },

    Handler = fun() -> {ok, <<"{\"data\": \"test\"}">>} end,

    {ResourceURI, ResourceInfo} = erlmcp_server_types:build_resource_info({Resource, Handler}),

    %% Check resource URI
    ?assertEqual(<<"https://example.com/resource">>, ResourceURI),

    %% Check resource info structure
    ?assert(is_map(ResourceInfo)),
    ?assert(maps:is_key(resource, ResourceInfo)),
    ?assert(maps:is_key(handler, ResourceInfo)),
    ?assert(maps:is_key(cached_data, ResourceInfo)),
    ?assert(maps:is_key(cache_expires, ResourceInfo)),
    ?assert(maps:is_key(metrics, ResourceInfo)),
    ?assert(maps:is_key(registered_at, ResourceInfo)),

    ok.

resource_validation_test_() ->
    [
        {"validate_resource_registration accepts valid resource",
            fun validate_resource_registration_valid_test/0},
        {"validate_resource_registration rejects resource with empty URI",
            fun validate_resource_registration_empty_uri_test/0},
        {"validate_resource_registration rejects resource with invalid handler",
            fun validate_resource_registration_invalid_handler_test/0},
        {"validate_resource_registration rejects resource with invalid URI",
            fun validate_resource_registration_invalid_uri_test/0}
    ].

validate_resource_registration_valid_test() ->
    Resource = #mcp_resource{
        uri = <<"https://example.com/resource">>,
        name = <<"test-resource">>,
        description = <<"Valid resource">>,
        mime_type = <<"application/json">>
    },

    Handler = fun() -> {ok, <<"{\"data\": \"test\"}">>} end,

    ?assertEqual(ok, erlmcp_server_types:validate_resource_registration({Resource, Handler})),

    ok.

validate_resource_registration_empty_uri_test() ->
    Resource = #mcp_resource{
        uri = <<>>,
        name = <<"test-resource">>,
        description = <<"Valid resource">>,
        mime_type = <<"application/json">>
    },

    Handler = fun() -> {ok, <<"{\"data\": \"test\"}">>} end,

    ?assertMatch({error, _}, erlmcp_server_types:validate_resource_registration({Resource, Handler})),

    ok.

validate_resource_registration_invalid_handler_test() ->
    Resource = #mcp_resource{
        uri = <<"https://example.com/resource">>,
        name = <<"test-resource">>,
        description = <<"Valid resource">>,
        mime_type = <<"application/json">>
    },

    InvalidHandler = not_a_function,

    ?assertMatch({error, _}, erlmcp_server_types:validate_resource_registration({Resource, InvalidHandler})),

    ok.

validate_resource_registration_invalid_uri_test() ->
    Resource = #mcp_resource{
        uri = <<"invalid-uri">>,  %% Missing scheme
        name = <<"test-resource">>,
        description = <<"Valid resource">>,
        mime_type = <<"application/json">>
    },

    Handler = fun() -> {ok, <<"{\"data\": \"test\"}">>} end,

    ?assertMatch({error, _}, erlmcp_server_types:validate_resource_registration({Resource, Handler})),

    ok.

%%====================================================================
%% Prompt Management Tests
%%====================================================================

prompt_registration_test_() ->
    [
        {"build_prompt_info creates correct registration info",
            fun build_prompt_info_test/0}
    ].

build_prompt_info_test() ->
    Argument = #mcp_prompt_argument{
        name = <<"topic">>,
        description = <<"The topic to discuss">>,
        required = true
    },

    Prompt = #mcp_prompt{
        name = <<"discuss-topic">>,
        description = <<"Discuss a specific topic">>,
        arguments = [Argument],
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, [#{role => assistant, content => <<"Hello!">>}]} end,

    {PromptName, PromptInfo} = erlmcp_server_types:build_prompt_info({Prompt, Handler}),

    %% Check prompt name
    ?assertEqual(<<"discuss-topic">>, PromptName),

    %% Check prompt info structure
    ?assert(is_map(PromptInfo)),
    ?assert(maps:is_key(prompt, PromptInfo)),
    ?assert(maps:is_key(handler, PromptInfo)),
    ?assert(maps:is_key(metrics, PromptInfo)),
    ?assert(maps:is_key(registered_at, PromptInfo)),

    ok.

prompt_validation_test_() ->
    [
        {"validate_prompt_registration accepts valid prompt",
            fun validate_prompt_registration_valid_test/0},
        {"validate_prompt_registration rejects prompt with empty name",
            fun validate_prompt_registration_empty_name_test/0},
        {"validate_prompt_registration rejects prompt with invalid handler",
            fun validate_prompt_registration_invalid_handler_test/0},
        {"validate_prompt_registration rejects prompt with invalid arguments",
            fun validate_prompt_registration_invalid_arguments_test/0}
    ].

validate_prompt_registration_valid_test() ->
    Argument = #mcp_prompt_argument{
        name = <<"topic">>,
        description = <<"The topic to discuss">>,
        required = true
    },

    Prompt = #mcp_prompt{
        name = <<"discuss-topic">>,
        description = <<"Discuss a specific topic">>,
        arguments = [Argument],
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, [#{role => assistant, content => <<"Hello!">>}]} end,

    ?assertEqual(ok, erlmcp_server_types:validate_prompt_registration({Prompt, Handler})),

    ok.

validate_prompt_registration_empty_name_test() ->
    Prompt = #mcp_prompt{
        name = <<>>,
        description = <<"Valid prompt description">>,
        arguments = [],
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, []} end,

    ?assertMatch({error, _}, erlmcp_server_types:validate_prompt_registration({Prompt, Handler})),

    ok.

validate_prompt_registration_invalid_handler_test() ->
    Prompt = #mcp_prompt{
        name = <<"test-prompt">>,
        description = <<"Valid prompt description">>,
        arguments = [],
        input_schema = #{type => object, properties => #{}}
    },

    InvalidHandler = not_a_function,

    ?assertMatch({error, _}, erlmcp_server_types:validate_prompt_registration({Prompt, InvalidHandler})),

    ok.

validate_prompt_registration_invalid_arguments_test() ->
    %% Test with invalid arguments structure
    InvalidArgs = invalid_arguments_structure,

    Prompt = #mcp_prompt{
        name = <<"test-prompt">>,
        description = <<"Valid prompt description">>,
        arguments = InvalidArgs,
        input_schema = #{type => object, properties => #{}}
    },

    Handler = fun(_) -> {ok, []} end,

    ?assertMatch({error, _}, erlmcp_server_types:validate_prompt_registration({Prompt, Handler})),

    ok.

%%====================================================================
%% Error Handling Tests
%%====================================================================

error_handling_test_() ->
    [
        {"server_error creates correct error structure",
            fun server_error_test/0},
        {"server_error includes timestamp and module",
            fun server_error_metadata_test/0}
    ].

server_error_test() ->
    Error = erlmcp_server_types:server_error(-32001, <<"Resource not found">>),

    ?assertMatch({error, ErrorMap}, Error),
    ?assert(is_map(ErrorMap)),
    ?assertEqual(-32001, maps:get(code, ErrorMap)),
    ?assertEqual(<<"Resource not found">>, maps:get(message, ErrorMap)),
    ?assert(maps:is_key(timestamp, ErrorMap)),
    ?assert(maps:is_key(module, ErrorMap)),

    ok.

server_error_metadata_test() ->
    %% Test error creation with state
    State = erlmcp_server_types:new_server_state(),
    Error = erlmcp_server_types:server_error(-32002, <<"Tool not found">>, State),

    ?assertMatch({error, ErrorMap, ErrorState}, Error),
    ?assertEqual(erlmcp_server_types, maps:get(module, ErrorMap)),
    ?assert(is_integer(maps:get(line, ErrorMap))),
    ?assertEqual(State, ErrorState),

    ok.

result_handling_test_() ->
    [
        {"server_result creates success result",
            fun server_result_success_test/0},
        {"server_result creates success result with state",
            fun server_result_success_with_state_test/0},
        {"is_server_success correctly identifies success",
            fun is_server_success_test/0}
    ].

server_result_success_test() ->
    Result = erlmcp_server_types:server_result(<<"success">>),

    ?assertMatch({ok, <<"success">>}, Result),

    ok.

server_result_success_with_state_test() ->
    State = erlmcp_server_types:new_server_state(),
    Result = erlmcp_server_types:server_result(<<"success">>, State),

    ?assertMatch({ok, <<"success">>, ResultState}, Result),
    ?assertEqual(State, ResultState),

    ok.

is_server_success_test() ->
    %% Test success results
    Success1 = {ok, result},
    Success2 = {ok, result, state},
    Error1 = {error, error_map},
    Error2 = {error, error_map, state},

    ?assertEqual(true, erlmcp_server_types:is_server_success(Success1)),
    ?assertEqual(true, erlmcp_server_types:is_server_success(Success2)),
    ?assertEqual(false, erlmcp_server_types:is_server_success(Error1)),
    ?assertEqual(false, erlmcp_server_types:is_server_success(Error2)),

    ok.

%%====================================================================
%% Session Management Tests
%%====================================================================

session_management_test_() ->
    [
        {"create_session_info creates valid session info",
            fun create_session_info_test/0},
        {"update_session_info updates activity and request count",
            fun update_session_activity_test/0}
    ].

create_session_info_test() ->
    ClientInfo = #{
        name => <<"test-client">>,
        version => <<"1.0.0">>,
        capabilities = erlmcp_server_types:default_client_capabilities(),
        metadata => #{},
        connected_at => erlang:system_time(millisecond),
        remote_address => undefined,
        user_agent => undefined
    },

    ClientCaps = erlmcp_server_types:default_client_capabilities(),

    SessionInfo = erlmcp_server_types:create_session_info(ClientInfo, ClientCaps),

    %% Check basic structure
    ?assert(is_map(SessionInfo)),
    ?assert(maps:is_key(id, SessionInfo)),
    ?assert(maps:is_key(client_info, SessionInfo)),
    ?assert(maps:is_key(capabilities, SessionInfo)),
    ?assert(maps:is_key(protocol_version, SessionInfo)),
    ?assert(maps:is_key(created_at, SessionInfo)),
    ?assert(maps:is_key(last_activity, SessionInfo)),
    ?assert(maps:is_key(request_count, SessionInfo)),
    ?assert(maps:is_key(subscription_list, SessionInfo)),

    %% Check session ID is generated
    ?assert(is_binary(maps:get(id, SessionInfo))),

    %% Check timestamps are current
    CreatedAt = maps:get(created_at, SessionInfo),
    LastActivity = maps:get(last_activity, SessionInfo),
    Now = erlang:system_time(millisecond),
    ?assert(Now - CreatedAt < 1000),
    ?assert(Now - LastActivity < 1000),

    ok.

update_session_activity_test() ->
    InitialInfo = erlmcp_server_types:create_session_info(#{
        name => <<"test-client">>,
        version => <<"1.0.0">>,
        capabilities = erlmcp_server_types:default_client_capabilities(),
        metadata => #{},
        connected_at => erlang:system_time(millisecond)
    }, erlmcp_server_types:default_client_capabilities()),

    NewTimestamp = erlang:system_time(millisecond) + 1000,
    UpdatedInfo = erlmcp_server_types:update_session_activity(InitialInfo, NewTimestamp),

    %% Check that activity is updated
    ?assertEqual(NewTimestamp, maps:get(last_activity, UpdatedInfo)),

    %% Check that request count is incremented
    ?assertEqual(1, maps:get(request_count, UpdatedInfo)),

    ok.

session_validation_test_() ->
    [
        {"is_session_valid accepts recent session",
            fun is_session_valid_recent_test/0},
        {"is_session_valid rejects old session",
            fun is_session_valid_old_test/0}
    ].

is_session_valid_recent_test() ->
    RecentSession = erlmcp_server_types:create_session_info(#{
        name => <<"test-client">>,
        version => <<"1.0.0">>,
        capabilities = erlmcp_server_types:default_client_capabilities(),
        metadata => #{},
        connected_at => erlang:system_time(millisecond)
    }, erlmcp_server_types:default_client_capabilities()),

    %% Session should be valid (within 5 minutes)
    ?assertEqual(true, erlmcp_server_types:is_session_valid(RecentSession)),

    ok.

is_session_valid_old_test() ->
    %% Create session with old timestamp (6 minutes ago)
    OldTimestamp = erlang:system_time(millisecond) - 360000,

    OldSession = #{
        id => <<"old-session">>,
        last_activity => OldTimestamp,
        request_count => 10,
        subscription_list => []
    },

    %% Session should be invalid (older than 5 minutes)
    ?assertEqual(false, erlmcp_server_types:is_session_valid(OldSession)),

    ok.